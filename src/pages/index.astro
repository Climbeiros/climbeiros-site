---
import Layout from '../layouts/Layout.astro';
import RopeDivider from '../components/RopeDivider.astro';
import { getSiteConfig } from '../lib/supabase';
import { getAgenda, getNovidades, partesData, dataCurta, fimDoEvento } from '../lib/acontece';

const config = await getSiteConfig();
const headline = config.home_headline || 'Amigos que escalam juntos';
const fotoCapa = config.home_foto_capa || '/hero-capa.jpg';

// Bloco "Acabou de chegar": próximo evento + últimas novidades (página Acontece).
// O site é estático, então a escolha do "próximo evento" é feita no navegador
// de quem visita (script no fim da página): aqui só separamos os eventos com
// data confirmada que ainda não tinham passado no dia do deploy.
const hojeBuild = new Date().toISOString().slice(0, 10);
const [agendaHome, novidadesHome] = await Promise.all([getAgenda(), getNovidades(3)]);
const eventosFuturos = agendaHome.filter((e) => fimDoEvento(e) >= hojeBuild && !e.data_a_confirmar).slice(0, 8);
const cardsNovidades = novidadesHome.slice(0, 3);
const linkWhatsAppHome = config.whatsapp_comunidade || '';

// Passos do bloco "Começou agora?" (logo abaixo do topo). Pra mudar um texto
// ou link, é só editar aqui.
const passosIniciante = [
  { titulo: 'Entenda os tipos', texto: 'Boulder, top rope, guiada: o que é cada um e qual combina com você.', link: 'Tipos de escalada', href: '/escalada101/tipos-de-escalada' },
  { titulo: 'Ache uma academia', texto: 'O melhor lugar pra começar. Busque pela sua cidade e faça uma aula experimental.', link: 'Ver academias', href: '/academias' },
  { titulo: 'Veja o que precisa', texto: 'Na academia dá pra alugar sapatilha e cadeirinha. Comprar o seu equipamento pode esperar.', link: 'Equipamentos', href: '/escalada101/equipamentos' },
  { titulo: 'Fale a língua', texto: 'Cadena, crux, beta, vacou… aprenda as gírias com flashcards e quiz.', link: 'Vocabulário', href: '/escalada101/vocabulario' },
];
const passosEvoluir = [
  { titulo: 'Refine a técnica', texto: 'Bandeira, joelho caído, gancho de calcanhar: as técnicas e posições, em português e inglês.', link: 'Técnicas & posições', href: '/crux/tecnicas' },
  { titulo: 'Entenda os graus', texto: 'Por que um 9a brasileiro não é um 9a francês, com tabela de conversão entre as escalas.', link: 'Graduação', href: '/escalada101/graduacao-brasileira-x-gringa' },
  { titulo: 'Saia pra rocha', texto: 'Locais e setores de escalada catalogados, com croqui e como chegar.', link: 'Rotas & setores', href: '/rotas' },
  { titulo: 'Evolua com um guia', texto: 'Cursos e saídas com guias e instrutores indicados pela comunidade.', link: 'Guias & cursos', href: '/cursos' },
];
const passosRocha = [
  { titulo: 'Descubra novos picos', texto: 'Mapa com os locais catalogados pela comunidade. Filtre por estado e tipo de escalada.', link: 'Ver o mapa', href: '/rotas' },
  { titulo: 'Escale com quem conhece', texto: 'Guias e instrutores que atuam em cada região, pra conhecer um pico novo com segurança.', link: 'Guias & cursos', href: '/cursos' },
  { titulo: 'Encontre a galera', texto: 'Festivais, encontros de montanha e eventos da comunidade pelo Brasil.', link: 'Agenda', href: '/acontece' },
  { titulo: 'Ajude a mapear', texto: 'Conhece um pico que ainda não está aqui, ou tem uma dica de acesso? Conta pra gente.', link: 'Falar com a gente', href: '/contato' },
];
const trilhas = [
  { id: 'comecando', aba: 'Estou começando', rotulo: 'Começou agora?', titulo: 'Seu primeiro mês na escalada', intro: 'Nunca escalou ou acabou de começar? Siga esses quatro passos, no seu ritmo. Ninguém precisa subir sozinho.', passos: passosIniciante, tudo: { texto: 'Ver tudo do Escalada 101', href: '/escalada101' } },
  { id: 'evoluir', aba: 'Já escalo', rotulo: 'Já escala?', titulo: 'Pronto pro próximo nível', intro: 'Já pegou o jeito na academia? Hora de afinar a técnica, entender os graus e partir pra rocha com segurança.', passos: passosEvoluir, tudo: { texto: 'Ver tudo do Crux', href: '/crux' } },
  { id: 'rocha', aba: 'Vou pra rocha', rotulo: 'Já vai pra rocha?', titulo: 'Conheça outros lugares', intro: 'Já escala em rocha e quer variar? Descubra picos novos, vá com quem conhece a região e encontre a galera nos eventos.', passos: passosRocha, tudo: { texto: 'Ver rotas & setores', href: '/rotas' } },
];
---
<Layout
  titulo="Início"
  tituloCompleto="Climbeiros · Comunidade de escalada no Brasil"
  descricao="Comunidade de escalada no Brasil: locais e setores com croquis, academias, guias e cursos, conteúdo pra quem está começando, agenda de eventos e cupons de equipamentos outdoor."
>
  <section class="hero">
    <div class="hero__imagem">
      <img src={fotoCapa} alt="Escalador em uma via de escalada" />
      <div class="hero__sombra"></div>
    </div>
    <div class="container hero__conteudo">
      <p class="eyebrow hero__eyebrow">Comunidade de escalada no Brasil</p>
      <h1 class="hero__titulo">{headline}</h1>
    </div>
    <!-- Abas das trilhas, presas na base da foto. A aba escolhida "encaixa" no bloco creme logo abaixo. -->
    <div class="hero__trilhas">
      <div class="container">
        <p class="hero__pergunta">Por onde você quer começar?</p>
        <div class="comecou__abas" role="tablist" aria-label="Escolha sua trilha">
          {trilhas.map((t, i) => (
            <button type="button" role="tab" class="comecou__aba" id={`aba-${t.id}`} aria-controls={`trilha-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'}>{t.aba}</button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- "Começou agora?": trilhas em 4 passos (iniciante / quem já escala / quem já vai pra rocha). As abas trocam a trilha. -->
  <section class="secao secao--creme comecou">
    <div class="container">
      {trilhas.map((t, i) => (
        <div class="comecou__painel" id={`trilha-${t.id}`} role="tabpanel" aria-labelledby={`aba-${t.id}`} hidden={i !== 0}>
          <div class="comecou__topo">
            <div>
              <p class="eyebrow">{t.rotulo}</p>
              <h2>{t.titulo}</h2>
              <p class="comecou__intro">{t.intro}</p>
            </div>
            <a href={t.tudo.href} class="comecou__tudo">{t.tudo.texto} →</a>
          </div>
          <ol class="trilha">
            {t.passos.map((p, n) => (
              <li class="trilha__passo">
                <a href={p.href}>
                  <span class="trilha__num">{n + 1}</span>
                  <h3>{p.titulo}</h3>
                  <p>{p.texto}</p>
                  <span class="trilha__link">{p.link} →</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  {(eventosFuturos.length > 0 || cardsNovidades.length > 0) && (
    <section class="secao secao--creme">
      <div class="container">
        <div class="chegou__topo">
          <h2>Novidades</h2>
          <a href="/acontece">Tudo que acontece →</a>
        </div>
        <div class="chegou__grade">
          {eventosFuturos.map((e) => { const d = partesData(e.data); return (
            <a href="/acontece#agenda" class={`chegou__card chegou__card--evento chegou__card--${e.organizador_tipo}`} data-data={e.data} data-fim={fimDoEvento(e)} hidden>
              <span class="chegou__tipo">Próximo evento</span>
              <strong>{e.titulo}</strong>
              <span>{Number(d.dia)} {d.mes.toLowerCase()}{fimDoEvento(e) !== e.data ? ` a ${dataCurta(fimDoEvento(e))}` : ''} · {e.organizador}</span>
            </a>
          ); })}
          {cardsNovidades.map((n, i) => (
            <a href={n.href} class="chegou__card" data-novidade={i}>
              <span class="chegou__tipo">{n.tipo}</span>
              <strong>{n.titulo}</strong>
              <span>{n.texto ?? dataCurta(n.data)}</span>
            </a>
          ))}
        </div>
        {linkWhatsAppHome && (
          <p class="chegou__wpp">Fique sabendo de tudo pelo WhatsApp: <a href={linkWhatsAppHome} target="_blank" rel="noopener">entrar na comunidade</a></p>
        )}
      </div>
    </section>
  )}

  <RopeDivider />

  <section class="secao secao--verde">
    <div class="container secao-cta">
      <h2>Sua academia ou curso ainda não está aqui?</h2>
      <p>O Climbeiros é feito pela e para a comunidade. Fale com a gente e vamos incluir.</p>
      <a href="/contato" class="botao">Entrar em contato</a>
    </div>
  </section>
</Layout>

<script>
  // Abas do bloco "Começou agora?": mostra a trilha escolhida e esconde a outra.
  document.querySelectorAll<HTMLButtonElement>('.comecou__aba').forEach((aba) => {
    aba.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.comecou__aba').forEach((outra) => {
        const ativa = outra === aba;
        outra.setAttribute('aria-selected', ativa ? 'true' : 'false');
        const painel = document.getElementById(outra.getAttribute('aria-controls') || '');
        if (painel) painel.hidden = !ativa;
      });
    });
  });
</script>

<style>
  .hero {
    position: relative;
    /* Faixa mais baixa (46% da tela, entre 340 e 460 px) pra o conteúdo aparecer logo. */
    min-height: clamp(340px, 46vh, 460px);
    display: flex;
    align-items: flex-end;
    color: var(--branco);
  }
  .hero__imagem {
    position: absolute;
    inset: 0;
  }
  .hero__imagem img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Desce o enquadramento pra mostrar mais parede e menos céu. */
    object-position: center 64%;
  }
  .hero__sombra {
    position: absolute;
    inset: 0;
    /* Escurece a foto toda um pouco (e mais embaixo) pra o título e as abas aparecerem bem. */
    background: linear-gradient(180deg, rgba(42,31,22,0.15) 0%, rgba(42,31,22,0.35) 35%, rgba(42,31,22,0.7) 70%, rgba(42,31,22,0.9) 100%);
  }
  .hero__conteudo {
    position: relative;
    /* Ocupa a largura toda: sem isso a caixa encolhe e o título fica centralizado. */
    width: 100%;
    padding-bottom: 132px;
    padding-top: 72px;
  }
  .hero__trilhas { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; }
  .hero__pergunta { margin: 0 0 12px; font-family: 'Oswald', sans-serif; font-weight: 500; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--creme-claro); }
  .hero__pergunta::before { content: ""; display: inline-block; width: 28px; height: 2px; background: var(--laranja); vertical-align: middle; margin-right: 10px; }
  @media (max-width: 640px) {
    /* No celular a foto (vertical) fica mais baixa e mostra a parede, não o céu. */
    .hero { min-height: 0; }
    .hero__conteudo { padding-top: 40px; padding-bottom: 120px; }
    .hero__imagem img { object-position: center 58%; }
    .hero__pergunta { font-size: 0.88rem; margin-bottom: 10px; }
  }
  .hero__eyebrow { color: var(--branco); font-size: 0.9rem; text-shadow: 0 2px 12px rgba(0,0,0,0.55); }
  .hero__eyebrow::before { background: var(--branco); }

  .hero__titulo {
    color: var(--branco);
    max-width: 680px;
    font-size: clamp(2rem, 4.2vw, 3rem);
    text-shadow: 0 2px 12px rgba(0,0,0,0.55);
  }

  /* Bloco "Acabou de chegar" (dados da página Acontece) */
  .chegou__topo { display: flex; flex-wrap: wrap; gap: 12px; align-items: baseline; justify-content: space-between; margin-bottom: 16px; }
  .chegou__topo h2 { margin: 0; }
  .chegou__topo a { font-weight: 600; }
  .chegou__grade { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .chegou__card {
    display: grid; gap: 4px; align-content: start; background: var(--branco); color: var(--marrom);
    border-radius: var(--raio); box-shadow: var(--sombra); padding: 16px; border-top: 4px solid var(--verde);
  }
  .chegou__card:hover { text-decoration: none; transform: translateY(-2px); }
  .chegou__card[hidden] { display: none; }
  .chegou__card strong { font-size: 1.05rem; }
  .chegou__card span:last-child { font-size: .9rem; opacity: .8; }
  .chegou__card--evento { --c: var(--laranja); border-top-color: var(--c); }
  .chegou__card--academia { --c: var(--verde-escuro); }
  .chegou__card--comunidade { --c: #8a5a14; }
  .chegou__tipo { font-family: var(--fonte-display); text-transform: uppercase; letter-spacing: .08em; font-size: .72rem; color: var(--verde-escuro); }
  .chegou__card--evento .chegou__tipo { color: var(--c); }
  .chegou__wpp { margin: 18px 0 0; }

  .secao-cta {
    text-align: center;
  }
  .secao-cta p { max-width: 520px; margin: 0 auto 24px; opacity: 0.9; }
  /* ---- "Começou agora?" ---- */
  .comecou__abas { display: flex; gap: 6px; }
  .comecou__aba { font-family: 'Oswald', sans-serif; font-weight: 600; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.04em; border: 0; border-radius: 12px 12px 0 0; padding: 14px 24px; background: rgba(42, 31, 22, 0.55); color: var(--creme-claro); cursor: pointer; backdrop-filter: blur(4px); }
  .comecou__aba:hover { background: rgba(42, 31, 22, 0.75); }
  .comecou__aba[aria-selected="true"] { background: var(--creme-claro); color: var(--verde-escuro); }
  .comecou__aba:focus-visible { outline: 3px solid var(--laranja); outline-offset: -3px; }
  .comecou { padding-top: 48px; }
  .comecou__painel[hidden] { display: none; }
  .comecou__topo { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px 24px; margin-bottom: 28px; }
  .comecou__topo h2 { margin: 0; }
  .comecou__intro { margin: 10px 0 0; max-width: 560px; line-height: 1.55; }
  .comecou__tudo { font-weight: 600; color: var(--laranja); text-decoration: none; white-space: nowrap; }
  .comecou__tudo:hover { text-decoration: underline; }
  .trilha { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; position: relative; }
  .trilha::before { content: ""; position: absolute; left: 28px; right: 28px; top: 27px; border-top: 3px dashed rgba(61, 84, 57, 0.35); }
  .trilha__passo { position: relative; }
  .trilha__passo a { display: flex; flex-direction: column; gap: 10px; height: 100%; background: #fffdf7; border: 1px solid #eadfc4; border-radius: 14px; padding: 0 18px 18px; text-decoration: none; color: var(--marrom); transition: transform 0.15s, box-shadow 0.15s; }
  .trilha__passo a:hover { transform: translateY(-3px); box-shadow: 0 14px 26px -18px rgba(42, 31, 22, 0.5); }
  .trilha__num { width: 56px; height: 56px; border-radius: 50%; background: var(--verde-escuro); color: var(--creme); font-family: 'Oswald', sans-serif; font-weight: 700; font-size: 1.5rem; display: grid; place-items: center; border: 4px solid var(--creme-claro); position: relative; z-index: 1; }
  .trilha__passo:last-child .trilha__num { background: var(--laranja); color: #fff; }
  .trilha__passo h3 { font-family: 'Oswald', sans-serif; font-size: 1.15rem; line-height: 1.15; text-transform: uppercase; margin: 2px 0 0; color: var(--marrom); }
  .trilha__passo p { margin: 0; font-size: 0.93rem; line-height: 1.5; flex: 1; }
  .trilha__link { font-weight: 600; font-size: 0.9rem; color: var(--laranja); }
  @media (max-width: 860px) {
    .trilha { grid-template-columns: 1fr 1fr; }
    .trilha::before { display: none; }
  }
  @media (max-width: 520px) {
    .comecou__abas { gap: 4px; }
    .comecou__aba { flex: 1; padding: 12px 6px; font-size: 0.82rem; line-height: 1.15; text-align: center; }
    .trilha { grid-template-columns: 1fr; }
    .trilha__passo a { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 14px; }
    .trilha__num { width: 44px; height: 44px; font-size: 1.2rem; border: 0; }
    .trilha__passo h3 { flex: 1; }
    .trilha__passo p { flex-basis: 100%; }
  }
</style>

<script>
  // "Próximo evento": mostra só o primeiro evento que ainda não passou (pela
  // data de hoje de quem visita). Se tiver evento, a 3ª novidade sai pra
  // manter 3 cards; se não tiver, ficam as 3 novidades.
  const d = new Date();
  const hoje = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const proximo = Array.from(document.querySelectorAll<HTMLElement>('.chegou__card--evento'))
    .find((c) => (c.dataset.fim || c.dataset.data || '') >= hoje);
  if (proximo) {
    proximo.hidden = false;
    const terceira = document.querySelector<HTMLElement>('.chegou__card[data-novidade="2"]');
    if (terceira) terceira.hidden = true;
  }
</script>
