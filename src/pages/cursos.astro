---
// src/pages/cursos.astro
// Página de Guias & Cursos — lê os guias direto de "inscricoes_guias" (o
// próprio formulário de inscrição é a fonte; não existe mais tabela curada
// separada) e os cursos de "cursos". O formulário "É guia e quer aparecer
// aqui?" grava em "inscricoes_guias"; aprovar no painel de pendências já
// deixa a linha visível aqui (RLS filtra processado=true e rejeitado=false).
// Site estático: depois de aprovar no painel, é preciso um novo deploy na
// Vercel pra publicar (o painel já dispara isso sozinho).
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase";
import { linkInstagram, usuarioInstagram, linkWhatsApp } from "../lib/contatos";
import FormGuia from "../components/FormGuia.astro";
const { data: guias } = await supabase
  .from("inscricoes_guias")
  .select("*")
  .order("ordem", { ascending: true });
// Avaliações dos guias: a view só devolve as aprovadas (sem e-mail).
const { data: avaliacoesGuias } = await supabase
  .from("avaliacoes_guias_publicas")
  .select("*")
  .order("enviado_em", { ascending: false });
const avaliacoesPorGuia = new Map();
for (const av of avaliacoesGuias ?? []) {
  if (!avaliacoesPorGuia.has(av.guia_id)) avaliacoesPorGuia.set(av.guia_id, []);
  avaliacoesPorGuia.get(av.guia_id).push(av);
}
function resumoAvaliacoes(guiaId) {
  const lista = avaliacoesPorGuia.get(guiaId) ?? [];
  if (lista.length === 0) return null;
  const media = lista.reduce((soma, a) => soma + a.nota, 0) / lista.length;
  return { media: media.toFixed(1), total: lista.length };
}
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;
const { data: cursos } = await supabase
  .from("cursos")
  .select("*")
  .eq("publicado", true)
  .order("ordem", { ascending: true });
// Locais: usados pra mostrar em quais lugares cada guia atua (locais_ids)
// e pra dar a lista de nomes conhecidos no campo do formulário de inscrição.
const { data: locais } = await supabase
  .from("locais")
  .select("id, nome, cidade, estado")
  .order("estado", { ascending: true })
  .order("nome", { ascending: true });
const locaisPorId = new Map((locais ?? []).map((l) => [l.id, l.nome]));
// Agrupa os locais por estado só pra organizar o <select> do formulário
// (fica mais fácil de achar o local em vez de uma lista única de 20+ itens).
const locaisPorEstado = new Map();
for (const l of locais ?? []) {
  const estado = l.estado || "Outros";
  if (!locaisPorEstado.has(estado)) locaisPorEstado.set(estado, []);
  locaisPorEstado.get(estado).push(l);
}
// Quantos locais aparecem no card antes do botão "+N locais".
const MAX_LOCAIS = 4;
function nomesDosLocais(locaisIds) {
  return (locaisIds ?? []).map((id) => locaisPorId.get(id)).filter(Boolean);
}
// Texto livre do formulário ("Atua em algum local que não está na lista?").
// Junta as quebras de linha e espaços extras numa linha só.
function textoLocais(texto) {
  return (texto || "").split(/\n+/).map((t) => t.trim()).filter(Boolean).join(" · ").replace(/\s{2,}/g, " ");
}
const cursosPorGuia = new Map();
for (const c of cursos ?? []) {
  if (!cursosPorGuia.has(c.guia_id)) cursosPorGuia.set(c.guia_id, []);
  cursosPorGuia.get(c.guia_id).push(c);
}
function iniciais(nome) {
  return (nome || "").split(" ").map((p) => p[0]).filter(Boolean).slice(0, 2).join("").toUpperCase();
}
function nivelClasse(nivel) {
  const n = (nivel || "").toLowerCase();
  if (n.includes("inici")) return "lv-ini";
  if (n.includes("interm")) return "lv-int";
  if (n.includes("avan")) return "lv-adv";
  return "lv-all";
}
// Tira acentos e deixa minúsculo, pra busca achar "sao paulo" em "São Paulo".
function normalizar(texto) {
  return (texto || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
}
// Deixa a cidade com a primeira letra de cada palavra maiúscula, pra
// "teresópolis" e "Teresópolis" virarem uma opção só no filtro.
function capitalizar(texto) {
  const minusculas = ["de", "da", "do", "das", "dos", "e"];
  return (texto || "").trim().toLowerCase().split(/\s+/)
    .map((p, i) => (i > 0 && minusculas.includes(p)) ? p : p.charAt(0).toUpperCase() + p.slice(1))
    .join(" ");
}
// Opções dos filtros: só o que realmente existe nos guias cadastrados.
const especialidadesDisponiveis = [...new Set((guias ?? []).flatMap((g) => g.especialidades_lista ?? []).map((e) => e.trim()).filter(Boolean))]
  .sort((a, b) => a.localeCompare(b, "pt-BR"));
const estadosDisponiveis = [...new Set((guias ?? []).map((g) => (g.uf || "").trim().toUpperCase()).filter(Boolean))].sort();
const cidadesMap = new Map();
for (const g of guias ?? []) {
  if (!g.cidade) continue;
  const chave = normalizar(g.cidade) + "|" + (g.uf || "").toUpperCase();
  if (!cidadesMap.has(chave)) cidadesMap.set(chave, { nome: capitalizar(g.cidade), chave: normalizar(g.cidade), uf: (g.uf || "").toUpperCase() });
}
const cidadesDisponiveis = [...cidadesMap.values()].sort((a, b) => a.nome.localeCompare(b.nome, "pt-BR"));
---
<Layout titulo="Guias & Cursos" descricao="Guias e instrutores de escalada e montanhismo indicados pela comunidade Climbeiros, com os locais onde cada um atua e cursos para começar ou evoluir na escalada.">
  <!-- TOPO + BUSCA (lado a lado no computador, empilhado no celular) -->
  <section class="secao">
    <div class="container">
      <div class="topo-grade">
        <div class="topo-texto">
          <p class="eyebrow">Aprenda com quem vive a rocha</p>
          <h1>Guias &amp; cursos</h1>
          <p class="topo-lead">
            Guias e instrutores que foram indicados ou já escalaram com a gente, cada
            um com sua especialidade. O contato é direto: você combina data, local e
            valores com o próprio guia.
          </p>
          <a class="topo-link" href="#seja-guia">É guia? Apareça aqui →</a>
        </div>
        {guias && guias.length > 0 && (
          <div class="busca-guias">
            <h2>Encontre seu guia</h2>
            <input
              type="search"
              id="busca-guia"
              placeholder="Nome, cidade ou especialidade..."
              aria-label="Buscar guia por nome, cidade ou especialidade"
            />
            <div class="filtros">
              {especialidadesDisponiveis.length > 0 && (
                <label class="filtro-campo">
                  Especialidade
                  <select id="filtro-espec">
                    <option value="">Todas</option>
                    {especialidadesDisponiveis.map((e) => <option value={normalizar(e)}>{e}</option>)}
                  </select>
                </label>
              )}
              {estadosDisponiveis.length > 0 && (
                <label class="filtro-campo">
                  Estado
                  <select id="filtro-uf">
                    <option value="">Todos</option>
                    {estadosDisponiveis.map((uf) => <option value={uf}>{uf}</option>)}
                  </select>
                </label>
              )}
              {cidadesDisponiveis.length > 0 && (
                <label class="filtro-campo">
                  Cidade
                  <select id="filtro-cidade">
                    <option value="">Todas</option>
                    {cidadesDisponiveis.map((c) => <option value={c.chave} data-uf={c.uf}>{c.nome}{c.uf ? ` (${c.uf})` : ""}</option>)}
                  </select>
                </label>
              )}
              <button type="button" id="filtro-limpar" class="botao botao--secundario" hidden>Limpar</button>
            </div>
            <p id="busca-guia-status" class="busca-status" role="status"></p>
          </div>
        )}
      </div>
      {(!guias || guias.length === 0) && (
        <p class="vazio">Em breve nossa rede de guias estará por aqui. 🧗</p>
      )}
      <div class="guides">
        {guias?.map((g) => (
          <article
            class="guide"
            id={`guia-${g.id}`}
            data-busca={normalizar([g.nome, g.cidade, g.uf, ...(g.especialidades_lista ?? []), ...nomesDosLocais(g.locais_ids), g.locais_interesse].filter(Boolean).join(" "))}
            data-espec={(g.especialidades_lista ?? []).map((e) => normalizar(e)).join("|")}
            data-uf={(g.uf || "").trim().toUpperCase()}
            data-cidade={normalizar(g.cidade)}
          >
            <div class="head">
              {g.foto_url ? (
                <button type="button" class="photo-btn" data-foto={g.foto_url} data-nome={g.nome} aria-label={`Ampliar foto de ${g.nome}`}>
                  <img class="photo-img" src={g.foto_url} alt={g.nome} />
                </button>
              ) : (
                <div class="photo">{iniciais(g.nome)}</div>
              )}
              <div>
                <h3>{g.nome}</h3>
                {(g.cidade || g.uf) && (
                  <div class="base">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
                    {[g.cidade?.trim(), g.uf?.trim()].filter(Boolean).join(" · ")}
                  </div>
                )}
              </div>
            </div>
            <div class="body">
              {g.bio && (
                <div class="bloco bio-bloco">
                  <div class="lbl">Sobre</div>
                  <p class="bio">{g.bio.trim()}</p>
                  <button type="button" class="ler-mais" hidden>Ler mais</button>
                </div>
              )}
              {g.especialidades_lista?.length > 0 && (
                <div class="bloco">
                  <div class="lbl">Especialidades</div>
                  <div class="chips">
                    {g.especialidades_lista.map((e) => <span class="chip">{e}</span>)}
                  </div>
                </div>
              )}
              {(nomesDosLocais(g.locais_ids).length > 0 || textoLocais(g.locais_interesse)) && (
                <div class="bloco">
                  <div class="lbl">Atua em</div>
                  {nomesDosLocais(g.locais_ids).length > 0 && (
                  <p class="locais">
                    {nomesDosLocais(g.locais_ids).map((nome, i) => (
                      <span class:list={['local', { extra: i >= MAX_LOCAIS }]}>{nome}</span>
                    ))}
                    {nomesDosLocais(g.locais_ids).length > MAX_LOCAIS && (
                      <button type="button" class="locais-mais" aria-label="Ver todos os locais">+{nomesDosLocais(g.locais_ids).length - MAX_LOCAIS}</button>
                    )}
                  </p>
                  )}
                  {textoLocais(g.locais_interesse) && (
                    <p class="locais-texto">
                      {nomesDosLocais(g.locais_ids).length > 0 && <strong>Também: </strong>}
                      {textoLocais(g.locais_interesse)}
                    </p>
                  )}
                </div>
              )}
              {cursosPorGuia.get(g.id)?.length > 0 && (
                <div class="bloco">
                  <div class="lbl">Cursos que oferece</div>
                  <ul class="courses">
                    {cursosPorGuia.get(g.id).map((c) => (
                      <li>
                        {c.titulo}
                        {c.nivel && <span class={`level ${nivelClasse(c.nivel)}`}>{c.nivel}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {g.cursos_oferecidos?.trim() && (
                <div class="bloco bio-bloco cursos-oferecidos">
                  <div class="lbl">Cursos oferecidos</div>
                  <p class="bio cursos-texto">{g.cursos_oferecidos.trim()}</p>
                  <button type="button" class="ler-mais" hidden>Ler mais</button>
                </div>
              )}
              {g.certificacao && (
                <details class="cert">
                  <summary>Ver certificações</summary>
                  <p>{g.certificacao}</p>
                </details>
              )}
              {g.cupom_codigo?.trim() && (
                <div class="cupom-guia">
                  <div class="cupom-guia__topo">
                    <span class="cupom-guia__lbl">Cupom Climbeiros</span>
                    <button type="button" class="cupom-guia__codigo" data-codigo={g.cupom_codigo.trim()} title="Copiar código">
                      <span class="cupom-guia__texto">{g.cupom_codigo.trim()}</span>
                      <span class="cupom-guia__acao">Copiar</span>
                    </button>
                  </div>
                  {g.cupom_desc?.trim() && <p class="cupom-guia__desc">{g.cupom_desc.trim()}</p>}
                </div>
              )}
              <div class="card__avaliacoes">
                {resumoAvaliacoes(g.id) ? (
                  <p class="avaliacao-resumo">
                    <span class="avaliacao-resumo__estrelas" aria-hidden="true">★</span>
                    <strong>{resumoAvaliacoes(g.id).media}</strong> · {resumoAvaliacoes(g.id).total} avaliaç{resumoAvaliacoes(g.id).total === 1 ? 'ão' : 'ões'}
                  </p>
                ) : (
                  <p class="avaliacao-resumo avaliacao-resumo--vazia">Ainda sem avaliações</p>
                )}
                <details class="avaliacao-detalhes">
                  <summary>Ver e deixar uma avaliação</summary>
                  {(avaliacoesPorGuia.get(g.id) ?? []).length > 0 && (
                    <ul class="avaliacao-lista">
                      {avaliacoesPorGuia.get(g.id).map((c) => (
                        <li class="avaliacao-item">
                          <div class="avaliacao-item__topo">
                            <span class="avaliacao-item__estrelas" aria-hidden="true">{'★'.repeat(c.nota)}{'☆'.repeat(5 - c.nota)}</span>
                            <strong>{c.nome}</strong>
                          </div>
                          {c.comentario && <p class="avaliacao-item__comentario">{c.comentario}</p>}
                        </li>
                      ))}
                    </ul>
                  )}
                  <form
                    class="form-avaliacao"
                    data-guia-id={g.id}
                    data-supabase-url={supabaseUrl}
                    data-supabase-key={supabaseKey}
                  >
                    <fieldset class="estrelas-input">
                      <legend>Sua nota</legend>
                      {[5, 4, 3, 2, 1].map((n) => (
                        <>
                          <input type="radio" name="nota" id={`nota-guia-${g.id}-${n}`} value={n} required />
                          <label for={`nota-guia-${g.id}-${n}`} title={`${n} estrela${n > 1 ? 's' : ''}`}>★</label>
                        </>
                      ))}
                    </fieldset>
                    <label>
                      Comentário (opcional)
                      <textarea name="comentario" rows="3" maxlength="2000" placeholder="Como foi sua experiência com esse guia?"></textarea>
                    </label>
                    <label>
                      Seu nome
                      <input type="text" name="nome" maxlength="120" required />
                    </label>
                    <label>
                      Seu e-mail
                      <input type="email" name="email" maxlength="200" required />
                      <small>Não é exibido publicamente, usamos só pra contato, se precisar.</small>
                    </label>
                    {/* honeypot: campo escondido para visitantes reais, bots costumam preencher */}
                    <input type="text" name="site" class="campo-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
                    <button type="submit" class="botao botao--pequeno">Enviar avaliação</button>
                    <p class="form-status" role="status"></p>
                    <p class="form-avaliacao-aviso">
                      Sua avaliação passa por uma checagem da equipe do Climbeiros antes de aparecer aqui.
                    </p>
                  </form>
                </details>
              </div>
              <div class="contact">
                {linkWhatsApp(g.telefone) && (
                  <a class="cbtn c-ic c-wa" href={linkWhatsApp(g.telefone)} target="_blank" rel="noopener" title="WhatsApp" aria-label={`WhatsApp de ${g.nome}`}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3a.4.4 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3Z"/></svg>
                  </a>
                )}
                {usuarioInstagram(g.instagram) && (
                  <a class="cbtn c-ig" href={linkInstagram(g.instagram)} target="_blank" rel="noopener" title="Instagram">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                    <span>@{usuarioInstagram(g.instagram)}</span>
                  </a>
                )}
                {g.email && (
                  <a class="cbtn c-ic c-em" href={`mailto:${g.email}`} title="E-mail" aria-label={`E-mail de ${g.nome}`}>
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="vazio" id="sem-resultado" hidden>Nenhum guia encontrado com esses filtros. Tente limpar a busca.</p>
      <p class="safety">
        Os guias/instrutores são profissionais independentes. Os Climbeiros fazem a ponte entre
        você e eles; a contratação, os valores e a responsabilidade pelo curso são
        combinados diretamente com cada profissional. Recomendamos sempre verificar
        certificação e seguro antes de qualquer atividade.
      </p>
    </div>
  </section>
  <!-- COMO FUNCIONA -->
  <section class="how">
    <div class="container">
      <div class="k">Como funciona</div>
      <h2>Três passos até a rocha</h2>
      <div class="steps">
        <div class="step"><div class="n">01</div><h4>Escolha o guia</h4><p>Navegue pelas especialidades e encontre o guia certo para o que você quer aprender.</p></div>
        <div class="step"><div class="n">02</div><h4>Fale direto</h4><p>Chame no WhatsApp, Instagram ou e-mail. Combine data, local, nível e valores com o guia.</p></div>
        <div class="step"><div class="n">03</div><h4>Suba com segurança</h4><p>Curta a experiência com quem entende do terreno — check de segurança sempre.</p></div>
      </div>
    </div>
  </section>
  <!-- SEJA GUIA (com formulário que grava no Supabase) -->
  <section class="beguide" id="seja-guia">
    <div class="container">
      <div class="box">
        <h2>É guia/instrutor e quer aparecer aqui?</h2>
        <p>Se você é guia/instrutor de escalada ou montanhismo e quer fazer parte da nossa
          rede, preencha abaixo, é gratuito! A gente adora conhecer gente boa da vertical.</p>
        <FormGuia />
      </div>
    </div>
  </section>
  <!-- Foto ampliada do guia (abre ao clicar na foto do card) -->
  <dialog class="foto-modal" id="foto-modal" aria-label="Foto do guia">
    <button type="button" class="foto-fechar" id="foto-fechar" aria-label="Fechar">×</button>
    <img id="foto-modal-img" src="" alt="" />
    <p id="foto-modal-nome" class="foto-nome"></p>
  </dialog>
</Layout>
<script>
  // Cards dos guias:
  // - "Ler mais" na apresentação (só aparece se o texto foi cortado);
  // - "+N" pra mostrar todos os locais;
  // - nome do Instagram sempre inteiro: se não couber, a letra diminui um
  //   pouco, e os 3 botões de contato ficam sempre na mesma linha.
  function ativarLerMais() {
    document.querySelectorAll<HTMLElement>('.bio-bloco').forEach((b) => {
      const p = b.querySelector<HTMLElement>('.bio');
      const btn = b.querySelector<HTMLButtonElement>('.ler-mais');
      if (!p || !btn || btn.dataset.pronto) return;
      if (p.scrollHeight > p.clientHeight + 2) {
        btn.hidden = false;
        btn.dataset.pronto = '1';
      }
    });
  }
  document.querySelectorAll<HTMLButtonElement>('.ler-mais').forEach((btn) =>
    btn.addEventListener('click', () => {
      const p = btn.parentElement?.querySelector('.bio');
      const aberto = p?.classList.toggle('aberto');
      btn.textContent = aberto ? 'Ler menos' : 'Ler mais';
    })
  );
  document.querySelectorAll<HTMLButtonElement>('.locais-mais').forEach((b) =>
    b.addEventListener('click', () => b.parentElement?.classList.add('aberto'))
  );
  function ajustarInsta() {
    document.querySelectorAll<HTMLElement>('.guide .c-ig').forEach((b) => {
      const t = b.querySelector<HTMLElement>('span');
      if (!t || b.offsetParent === null) return;
      let f = 13.6;
      t.style.fontSize = f + 'px';
      while (b.scrollWidth > b.clientWidth && f > 10) { f -= 0.4; t.style.fontSize = f + 'px'; }
    });
  }
  ativarLerMais();
  ajustarInsta();
  document.fonts?.ready.then(() => { ativarLerMais(); ajustarInsta(); });
  window.addEventListener('resize', ajustarInsta);

  // ---------- BUSCA E FILTROS DE GUIAS ----------
  // Tudo acontece no navegador: os cards já estão na página, a gente só
  // esconde os que não batem com a busca e os filtros escolhidos.
  const normalizar = (t) => (t || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
  const campoBusca = document.getElementById('busca-guia');
  const filtroEspec = document.getElementById('filtro-espec');
  const filtroUf = document.getElementById('filtro-uf');
  const filtroCidade = document.getElementById('filtro-cidade');
  const botaoLimpar = document.getElementById('filtro-limpar');
  const statusBusca = document.getElementById('busca-guia-status');
  const semResultado = document.getElementById('sem-resultado');
  const cards = Array.from(document.querySelectorAll('.guides .guide'));
  // Quando escolhe um estado, a lista de cidades mostra só as daquele estado
  function atualizarCidades() {
    if (!filtroCidade) return;
    const uf = filtroUf?.value || '';
    for (const opt of Array.from(filtroCidade.options)) {
      if (!opt.value) continue;
      opt.hidden = !!uf && opt.dataset.uf !== uf;
    }
    const escolhida = filtroCidade.selectedOptions[0];
    if (escolhida && escolhida.hidden) filtroCidade.value = '';
  }
  function aplicarFiltrosGuias() {
    const termos = normalizar(campoBusca?.value).split(/\s+/).filter(Boolean);
    const espec = filtroEspec?.value || '';
    const uf = filtroUf?.value || '';
    const cidade = filtroCidade?.value || '';
    let visiveis = 0;
    for (const card of cards) {
      const d = card.dataset;
      const ok =
        termos.every((t) => (d.busca || '').includes(t)) &&
        (!espec || (d.espec || '').split('|').includes(espec)) &&
        (!uf || d.uf === uf) &&
        (!cidade || d.cidade === cidade);
      card.hidden = !ok;
      if (ok) visiveis++;
    }
    const filtrando = termos.length > 0 || espec || uf || cidade;
    if (botaoLimpar) botaoLimpar.hidden = !filtrando;
    if (semResultado) semResultado.hidden = visiveis > 0;
    if (statusBusca) {
      statusBusca.textContent = filtrando && visiveis > 0
        ? `${visiveis} ${visiveis === 1 ? 'guia encontrado' : 'guias encontrados'}`
        : '';
    }
  }
  campoBusca?.addEventListener('input', aplicarFiltrosGuias);
  filtroEspec?.addEventListener('change', aplicarFiltrosGuias);
  filtroCidade?.addEventListener('change', aplicarFiltrosGuias);
  filtroUf?.addEventListener('change', () => { atualizarCidades(); aplicarFiltrosGuias(); });
  botaoLimpar?.addEventListener('click', () => {
    if (campoBusca) campoBusca.value = '';
    if (filtroEspec) filtroEspec.value = '';
    if (filtroUf) filtroUf.value = '';
    if (filtroCidade) filtroCidade.value = '';
    atualizarCidades();
    aplicarFiltrosGuias();
    campoBusca?.focus();
  });
  // ---------- CUPOM: copiar o código ao clicar ----------
  document.querySelectorAll('.cupom-guia__codigo').forEach((botao) => {
    botao.addEventListener('click', async () => {
      const acao = botao.querySelector('.cupom-guia__acao');
      try {
        await navigator.clipboard.writeText(botao.dataset.codigo || '');
        if (acao) acao.textContent = 'Copiado!';
      } catch {
        if (acao) acao.textContent = 'Selecione e copie';
      }
      setTimeout(() => { if (acao) acao.textContent = 'Copiar'; }, 2000);
    });
  });
  // ---------- FOTO AMPLIADA ----------
  const modal = document.getElementById('foto-modal');
  const modalImg = document.getElementById('foto-modal-img');
  const modalNome = document.getElementById('foto-modal-nome');
  document.querySelectorAll('.photo-btn').forEach((btnFoto) => {
    btnFoto.addEventListener('click', () => {
      if (!modal || !modalImg) return;
      modalImg.src = btnFoto.dataset.foto || '';
      modalImg.alt = btnFoto.dataset.nome || '';
      if (modalNome) modalNome.textContent = btnFoto.dataset.nome || '';
      modal.showModal();
    });
  });
  document.getElementById('foto-fechar')?.addEventListener('click', () => modal?.close());
  // Clicar fora da foto (no fundo escuro) também fecha
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
</script>
<script>
  // Envio das avaliações de guias (mesmo fluxo das academias).
  import { createClient } from '@supabase/supabase-js';

  document.querySelectorAll<HTMLFormElement>('.form-avaliacao').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form-status');
    const botao = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status || !botao) return;
      const dados = new FormData(form);

      // Honeypot: campo escondido que só um bot preencheria.
      if (dados.get('site')) {
        status.textContent = 'Avaliação enviada!';
        form.reset();
        return;
      }

      const nota = dados.get('nota');
      if (!nota) {
        status.textContent = 'Escolha uma nota de 1 a 5 estrelas.';
        return;
      }

      botao.disabled = true;
      status.textContent = 'Enviando...';
      try {
        const supabase = createClient(form.dataset.supabaseUrl!, form.dataset.supabaseKey!);
        const { error } = await supabase.from('avaliacoes_guias').insert({
          guia_id: Number(form.dataset.guiaId),
          nome: dados.get('nome'),
          email: dados.get('email'),
          nota: Number(nota),
          comentario: dados.get('comentario') || null,
        });
        if (error) {
          status.textContent = 'Erro ao enviar: ' + error.message;
        } else {
          status.textContent = 'Obrigado! Sua avaliação passará por uma checagem antes de aparecer no site.';
          form.reset();
        }
      } catch (err) {
        status.textContent = 'Erro inesperado: ' + (err instanceof Error ? err.message : String(err));
      }
      botao.disabled = false;
    });
  });
</script>
