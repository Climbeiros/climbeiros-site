---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import type { Local, Setor } from '../lib/supabase';

const { data: locais } = await supabase
  .from('locais')
  .select('*')
  .order('estado')
  .order('cidade')
  .order('nome') as { data: Local[] | null };

const { data: setores } = await supabase
  .from('setores')
  .select('*')
  .not('local_id', 'is', null) as { data: Setor[] | null };

const locaisComCoordenadas = (locais ?? []).filter((l) => l.latitude && l.longitude);

function setoresDoLocal(localId: string) {
  return (setores ?? []).filter((s) => s.local_id === localId);
}

// Agrupa os setores de um local por "lado" (quando houver). Setores sem lado
// ficam soltos; os com lado ficam agrupados sob o nome do lado.
function ladosDoLocal(localId: string) {
  const doLocal = setoresDoLocal(localId);
  const semLado = doLocal.filter((s) => !s.lado);
  const nomesLados = [...new Set(doLocal.filter((s) => s.lado).map((s) => s.lado as string))];
  return {
    semLado,
    lados: nomesLados.map((lado) => ({
      lado,
      setores: doLocal.filter((s) => s.lado === lado),
    })),
  };
}
---
<Layout titulo="Rotas & Setores" descricao="Locais de escalada catalogados pela comunidade Climbeiros.">
  <section class="secao">
    <div class="container">
      <p class="eyebrow">Onde escalar</p>
      <h1>Rotas & Setores</h1>
      <p>Explore os locais de escalada catalogados pela comunidade. Cada local pode ter um ou mais setores, cada um com croqui, dicas de acesso, hospedagens, guias e avaliações. Clique num pin do mapa ou busque por cidade/CEP pra filtrar.</p>

      {locais && locais.length > 0 && (
        <>
          <div class="busca-local">
            <input
              type="text"
              id="busca-cidade"
              placeholder="Buscar por cidade ou CEP..."
              aria-label="Buscar locais por cidade ou CEP"
            />
            <button type="button" id="busca-botao" class="botao">Buscar</button>
            <button type="button" id="busca-limpar" class="botao botao--secundario" hidden>Limpar</button>
          </div>
          <p id="busca-status" class="busca-status" role="status"></p>
        </>
      )}
    </div>

    {locaisComCoordenadas.length > 0 && (
      <div class="container">
        <div id="mapa" class="mapa"></div>
      </div>
    )}

    <div class="container">
      {(!locais || locais.length === 0) && (
        <p>Ainda estamos catalogando os primeiros locais. Volte em breve!</p>
      )}

      <div class="lista-setores" id="lista-setores">
        {locais?.map((local) => {
          const { semLado, lados } = ladosDoLocal(local.id);
          const totalSetores = semLado.length + lados.reduce((n, l) => n + l.setores.length, 0);
          return (
            <article class="setor-card" id={`local-${local.id}`} data-cidade={(local.cidade || '').toLowerCase()}>
              <div class="setor-card__cabecalho">
                <div>
                  <h2>
                    {local.slug ? (
                      <a class="setor-card__link" href={`/rotas/${local.slug}`}>{local.nome}</a>
                    ) : (
                      local.nome
                    )}
                  </h2>
                  <p class="setor-card__local">{[local.regiao, local.cidade, local.estado].filter(Boolean).join(' · ')}</p>
                </div>
              </div>
              {local.descricao && <p>{local.descricao}</p>}

              {totalSetores > 1 && (
                <div class="setor-card__setores">
                  {lados.map((l) => (
                    <p class="setor-card__lado">
                      <strong>Lado {l.lado}:</strong> {l.setores.map((s) => s.nome).join(', ')}
                    </p>
                  ))}
                  {semLado.length > 0 && lados.length > 0 && (
                    <p class="setor-card__lado">{semLado.map((s) => s.nome).join(', ')}</p>
                  )}
                  {lados.length === 0 && (
                    <p class="setor-card__lado">Setores: {semLado.map((s) => s.nome).join(', ')}</p>
                  )}
                </div>
              )}

              {local.slug && (
                <a href={`/rotas/${local.slug}`} class="botao botao--pequeno setor-card__detalhes">
                  Ver setores e croquis →
                </a>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<script type="application/json" id="dados-locais" set:html={JSON.stringify(locaisComCoordenadas)}></script>

<script>
  const locais = JSON.parse(document.getElementById('dados-locais')?.textContent || '[]');
  let mapa;
  let L;
  const marcadores = {}; // local id -> Leaflet marker

  function normalizar(texto) {
    return texto
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();
  }

  async function buscarCidadePorCep(cep) {
    const resposta = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
    const dados = await resposta.json();
    if (dados.erro) return null;
    return dados.localidade;
  }

  function filtrar(cidade) {
    const termo = normalizar(cidade);
    let visiveis = 0;
    const idsVisiveis = new Set();

    document.querySelectorAll('#lista-setores .setor-card').forEach((card) => {
      const cidadeCard = normalizar(card.dataset.cidade || '');
      const bate = !termo || cidadeCard.includes(termo);
      card.hidden = !bate;
      if (bate) {
        visiveis++;
        idsVisiveis.add(card.id.replace('local-', ''));
      }
    });

    // Atualiza os pins do mapa junto com os cards
    if (mapa) {
      const bounds = [];
      Object.entries(marcadores).forEach(([id, marker]) => {
        if (idsVisiveis.has(id)) {
          if (!mapa.hasLayer(marker)) marker.addTo(mapa);
          bounds.push(marker.getLatLng());
        } else {
          mapa.removeLayer(marker);
        }
      });
      if (bounds.length === 1) {
        mapa.setView(bounds[0], 11);
      } else if (bounds.length > 1) {
        mapa.fitBounds(bounds, { padding: [30, 30] });
      }
    }

    return visiveis;
  }

  const input = document.getElementById('busca-cidade');
  const botaoBuscar = document.getElementById('busca-botao');
  const botaoLimpar = document.getElementById('busca-limpar');
  const status = document.getElementById('busca-status');

  async function executarBusca() {
    if (!input || !status) return;
    const valor = input.value.trim();
    if (!valor) {
      filtrar('');
      status.textContent = '';
      botaoLimpar?.setAttribute('hidden', '');
      return;
    }

    const somenteNumeros = valor.replace(/\D/g, '');
    let cidadeParaFiltrar = valor;

    if (somenteNumeros.length === 8) {
      status.textContent = 'Buscando cidade pelo CEP...';
      const cidade = await buscarCidadePorCep(somenteNumeros);
      if (!cidade) {
        status.textContent = 'CEP não encontrado. Tente digitar o nome da cidade.';
        return;
      }
      cidadeParaFiltrar = cidade;
    }

    const encontrados = filtrar(cidadeParaFiltrar);
    status.textContent = encontrados > 0
      ? `${encontrados} local(is) encontrado(s) em ${cidadeParaFiltrar}.`
      : `Nenhum local encontrado em ${cidadeParaFiltrar} ainda.`;
    botaoLimpar?.removeAttribute('hidden');
  }

  botaoBuscar?.addEventListener('click', executarBusca);
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') executarBusca();
  });
  botaoLimpar?.addEventListener('click', () => {
    if (input) input.value = '';
    filtrar('');
    if (status) status.textContent = '';
    botaoLimpar?.setAttribute('hidden', '');
  });

  if (locais.length > 0) {
    import('leaflet').then((mod) => {
      L = mod;

      // Corrige um bug conhecido do Leaflet dentro de bundlers (Vite/Astro):
      // os ícones padrão do pin não são encontrados automaticamente.
      const iconePin = L.icon({
        iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
        iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
        shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41],
      });

      mapa = L.map('mapa').setView([locais[0].latitude, locais[0].longitude], 6);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap',
      }).addTo(mapa);

      const bounds = [];
      locais.forEach((l) => {
        const marker = L.marker([l.latitude, l.longitude], { icon: iconePin }).addTo(mapa);
        marker.bindPopup(`<strong>${l.nome}</strong><br/><a href="#local-${l.id}">Ver detalhes</a>`);
        marcadores[l.id] = marker;
        bounds.push([l.latitude, l.longitude]);
      });
      if (bounds.length > 1) mapa.fitBounds(bounds, { padding: [30, 30] });
    });
  }
</script>

<style is:global>
  @import 'leaflet/dist/leaflet.css';
</style>

<style>
  .busca-local {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 20px 0 8px;
  }
  .busca-local input {
    flex: 1;
    min-width: 220px;
    font-family: var(--fonte-corpo);
    font-size: 1rem;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid rgba(42,31,22,0.25);
    color: var(--marrom);
  }
  .busca-status {
    font-size: 0.9rem;
    opacity: 0.8;
    margin-bottom: 8px;
    min-height: 1.2em;
  }
  .mapa {
    height: 380px;
    border-radius: var(--raio);
    margin: 12px 0 40px;
    box-shadow: var(--sombra);
  }
  .lista-setores {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .setor-card {
    background: var(--branco);
    border: 1px solid rgba(42,31,22,0.08);
    border-radius: var(--raio);
    box-shadow: var(--sombra);
    padding: 24px;
  }
  .setor-card__cabecalho {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .setor-card__local { opacity: 0.7; font-size: 0.9rem; margin-top: -8px; }
  .setor-card__link { color: inherit; text-decoration: none; }
  .setor-card__link:hover { text-decoration: underline; }
  .setor-card__setores { margin-top: 8px; display: flex; flex-direction: column; gap: 4px; }
  .setor-card__lado { font-size: 0.9rem; opacity: 0.85; }
  .setor-card__detalhes { display: inline-block; margin-top: 14px; }
</style>
