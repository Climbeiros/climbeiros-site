---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import type { Local, Setor } from '../lib/supabase';
import AvisoConstrucao from '../components/AvisoConstrucao.astro';
import BotaoFeedback from '../components/BotaoFeedback.astro';
import { normalizar, siglaEstado, textoEstado, listarCidades } from '../lib/busca';
import { resumoVias } from '../lib/graus';

const { data: locais } = await supabase
  .from('locais')
  .select('*')
  .order('estado')
  .order('cidade')
  .order('nome') as { data: Local[] | null };

const { data: setores } = await supabase
  .from('setores')
  .select('*')
  .not('local_id', 'is', null) as { data: Setor[] | null };

// Vias/boulders (só grau, tipo e setor), pra mostrar no card quanto cada
// local já tem cadastrado. Busca em páginas de 1000 (limite do Supabase).
const rotasResumo: { setor_id: string | null; grau: string | null; tipo: string | null }[] = [];
for (let inicio = 0; ; inicio += 1000) {
  const { data } = await supabase.from('rotas').select('setor_id, grau, tipo').range(inicio, inicio + 999);
  rotasResumo.push(...(data ?? []));
  if (!data || data.length < 1000) break;
}

function rotasDoLocal(localId: string) {
  const ids = new Set(setoresDoLocal(localId).map((s) => s.id));
  return rotasResumo.filter((r) => r.setor_id && ids.has(r.setor_id));
}

// Selo do card: "168 vias · 3º a 9º A · 15 setores", "4 setores · vias em breve"
// ou "Em mapeamento" (local cadastrado, mas ainda sem setores).
function seloDoLocal(localId: string) {
  const nSetores = setoresDoLocal(localId).length;
  const vias = rotasDoLocal(localId);
  const textoSetores = nSetores ? `${nSetores} ${nSetores === 1 ? 'setor' : 'setores'}` : '';
  if (vias.length) return { completo: true, texto: [resumoVias(vias), textoSetores].filter(Boolean).join(' · ') };
  if (nSetores) return { completo: false, texto: `${textoSetores} · vias em breve` };
  return { completo: false, texto: 'Em mapeamento' };
}

// Locais com vias cadastradas aparecem primeiro (os mais completos no topo);
// o resto segue na ordem de estado, cidade e nome.
const locaisOrdenados = [...(locais ?? [])].sort(
  (a, b) => rotasDoLocal(b.id).length - rotasDoLocal(a.id).length,
);

const locaisComCoordenadas = locaisOrdenados
  .filter((l) => l.latitude && l.longitude)
  .map((l) => ({ ...l, selo: seloDoLocal(l.id).texto }));

// Opções pros filtros: estados e tipos de escalada realmente presentes nos locais cadastrados.
const estadosDisponiveis = [...new Set((locais ?? []).map((l) => siglaEstado(l.estado)).filter(Boolean))].sort();
const tiposDisponiveis = [...new Set((locais ?? []).flatMap((l) => l.tipos ?? []))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
const cidadesDisponiveis = listarCidades(locais ?? []);

function setoresDoLocal(localId: string) {
  return (setores ?? []).filter((s) => s.local_id === localId);
}

// Agrupa os setores de um local por "lado" (quando houver). Setores sem lado
// ficam soltos; os com lado ficam agrupados sob o nome do lado.
function ladosDoLocal(localId: string) {
  const doLocal = setoresDoLocal(localId);
  const semLado = doLocal.filter((s) => !s.lado);
  const nomesLados = [...new Set(doLocal.filter((s) => s.lado).map((s) => s.lado as string))];
  return {
    semLado,
    lados: nomesLados.map((lado) => ({
      lado,
      setores: doLocal.filter((s) => s.lado === lado),
    })),
  };
}
---
<Layout titulo="Rotas & Setores" descricao="Mapa de locais e setores de escalada no Brasil: croquis, como chegar, previsão do tempo, hospedagens e guias. Busque por cidade, estado ou tipo de escalada (esportiva, boulder, trad).">
  <section class="secao">
    <div class="container">
      <p class="eyebrow">Onde escalar</p>
      <h1>Rotas & Setores</h1>
      <p>Encontre onde escalar: busque por local, cidade ou CEP, filtre por tipo, ou clique num pin do mapa. Os locais com vias já cadastradas aparecem primeiro.</p>

      <AvisoConstrucao />

      {locais && locais.length > 0 && (
        <>
          <div class="painel-busca">
            <h2>Encontre um local</h2>
            <input
              type="search"
              id="busca-local"
              placeholder="Local, setor, cidade, estado ou CEP..."
              aria-label="Buscar locais por nome, setor, cidade, estado ou CEP"
            />
            <div class="filtros">
              {tiposDisponiveis.length > 0 && (
                <label class="filtro-campo">
                  Tipo
                  <select id="filtro-tipo">
                    <option value="">Todos</option>
                    {tiposDisponiveis.map((t) => <option value={normalizar(t)}>{t}</option>)}
                  </select>
                </label>
              )}
              {estadosDisponiveis.length > 0 && (
                <label class="filtro-campo">
                  Estado
                  <select id="filtro-uf">
                    <option value="">Todos</option>
                    {estadosDisponiveis.map((uf) => <option value={uf}>{uf}</option>)}
                  </select>
                </label>
              )}
              {cidadesDisponiveis.length > 0 && (
                <label class="filtro-campo">
                  Cidade
                  <select id="filtro-cidade">
                    <option value="">Todas</option>
                    {cidadesDisponiveis.map((c) => <option value={c.chave} data-uf={c.uf}>{c.nome}{c.uf ? ` (${c.uf})` : ''}</option>)}
                  </select>
                </label>
              )}
              <button type="button" id="filtro-limpar" class="botao botao--secundario" hidden>Limpar</button>
            </div>
            <p id="busca-status" class="busca-status" role="status"></p>
          </div>
        </>
      )}
    </div>

    {locaisComCoordenadas.length > 0 && (
      <div class="container">
        <div id="mapa" class="mapa"></div>
      </div>
    )}

    <div class="container">
      {(!locais || locais.length === 0) && (
        <p>Ainda estamos catalogando os primeiros locais. Volte em breve!</p>
      )}

      <div class="lista-setores" id="lista-setores">
        {locaisOrdenados.map((local) => {
          const { semLado, lados } = ladosDoLocal(local.id);
          const selo = seloDoLocal(local.id);
          const totalSetores = semLado.length + lados.reduce((n, l) => n + l.setores.length, 0);
          return (
            <article
              class="setor-card"
              id={`local-${local.id}`}
              data-busca={normalizar([
                local.nome, local.regiao, local.cidade, textoEstado(local.estado),
                ...(local.tipos ?? []), ...setoresDoLocal(local.id).map((s) => s.nome),
              ].filter(Boolean).join(' '))}
              data-uf={siglaEstado(local.estado)}
              data-cidade={normalizar(local.cidade)}
              data-tipos={(local.tipos ?? []).map((t) => normalizar(t)).join('|')}
            >
              {local.imagem_capa_url && (
                <img class="setor-card__capa" src={local.imagem_capa_url} alt={local.nome} loading="lazy" />
              )}
              <div class="setor-card__corpo">
                <div class="setor-card__cabecalho">
                  <div>
                    <h2>
                      {local.slug ? (
                        <a class="setor-card__link" href={`/rotas/${local.slug}`}>{local.nome}</a>
                      ) : (
                        local.nome
                      )}
                    </h2>
                    <p class="setor-card__local">{[local.regiao, local.cidade, siglaEstado(local.estado)].filter(Boolean).join(' · ')}</p>
                  </div>
                  <button
                    type="button"
                    class="botao-compartilhar"
                    data-url={local.slug ? `/rotas/${local.slug}` : ''}
                    data-nome={local.nome}
                    title="Compartilhar"
                    aria-label={`Compartilhar ${local.nome}`}
                  >↗</button>
                </div>
                <p class:list={['setor-card__selo', { 'setor-card__selo--completo': selo.completo }]}>
                  {selo.completo ? '✓ ' : ''}{selo.texto}
                </p>
                {local.tipos && local.tipos.length > 0 && (
                  <div class="setor-card__tags">
                    {local.tipos.map((t) => <span class="tag-tipo">{t}</span>)}
                  </div>
                )}
                {local.descricao && <p>{local.descricao}</p>}

                {totalSetores > 1 && (
                  <div class="setor-card__setores">
                    {lados.map((l) => (
                      <p class="setor-card__lado">
                        <strong>Lado {l.lado}:</strong> {l.setores.map((s) => s.nome).join(', ')}
                      </p>
                    ))}
                    {semLado.length > 0 && lados.length > 0 && (
                      <p class="setor-card__lado">{semLado.map((s) => s.nome).join(', ')}</p>
                    )}
                    {lados.length === 0 && (
                      <p class="setor-card__lado">Setores: {semLado.map((s) => s.nome).join(', ')}</p>
                    )}
                  </div>
                )}

                {local.slug && (
                  <a href={`/rotas/${local.slug}`} class="botao botao--pequeno setor-card__detalhes">
                    {totalSetores > 0 ? 'Ver setores e croquis →' : 'Ver local →'}
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
      <p class="vazio-busca" id="sem-resultado" hidden>Nenhum local encontrado com esses filtros. Tente limpar a busca.</p>
    </div>
  </section>
  <BotaoFeedback pagina="Rotas & Setores (lista)" />
</Layout>

<script type="application/json" id="dados-locais" set:html={JSON.stringify(locaisComCoordenadas)}></script>

<script>
  import { ativarBusca } from '../lib/filtros-cliente';

  const locais = JSON.parse(document.getElementById('dados-locais')?.textContent || '[]');
  let mapa;
  let L;
  const marcadores = {}; // local id -> Leaflet marker

  // Mostra no mapa só os pins dos locais que sobraram na busca/filtros
  // e aproxima o mapa deles.
  function atualizarMapa(visiveis) {
    if (!mapa) return;
    const idsVisiveis = new Set(visiveis.map((card) => card.id.replace('local-', '')));
    const bounds = [];
    Object.entries(marcadores).forEach(([id, marker]) => {
      if (idsVisiveis.has(id)) {
        if (!mapa.hasLayer(marker)) marker.addTo(mapa);
        bounds.push(marker.getLatLng());
      } else {
        mapa.removeLayer(marker);
      }
    });
    if (bounds.length === 1) {
      mapa.setView(bounds[0], 11);
    } else if (bounds.length > 1) {
      mapa.fitBounds(bounds, { padding: [30, 30] });
    }
  }

  // Busca livre + filtros de Tipo, Estado e Cidade (mesmo padrão de Guias e Academias).
  ativarBusca({
    cards: Array.from(document.querySelectorAll('#lista-setores .setor-card')),
    campoBusca: document.getElementById('busca-local'),
    filtroUf: document.getElementById('filtro-uf'),
    filtroCidade: document.getElementById('filtro-cidade'),
    filtrosExtras: [{ select: document.getElementById('filtro-tipo'), campo: 'tipos' }],
    botaoLimpar: document.getElementById('filtro-limpar'),
    status: document.getElementById('busca-status'),
    semResultado: document.getElementById('sem-resultado'),
    rotulo: ['local encontrado', 'locais encontrados'],
    aoFiltrar: atualizarMapa,
  });

  // ---- Botão de compartilhar (Web Share API, com fallback pra copiar o link) ----
  document.querySelectorAll('.botao-compartilhar').forEach((botao) => {
    botao.addEventListener('click', async () => {
      const caminho = botao.dataset.url;
      if (!caminho) return;
      const url = `${window.location.origin}${caminho}`;
      const nome = botao.dataset.nome || 'Climbeiros';
      try {
        if (navigator.share) {
          await navigator.share({ title: nome, text: `Confira ${nome} no Climbeiros`, url });
        } else {
          await navigator.clipboard.writeText(url);
          const original = botao.textContent;
          botao.textContent = '✓';
          setTimeout(() => { botao.textContent = original; }, 1500);
        }
      } catch {
        // Usuário cancelou o compartilhamento nativo, ou o navegador bloqueou — sem problema.
      }
    });
  });

  if (locais.length > 0) {
    import('leaflet').then((mod) => {
      L = mod;

      // Corrige um bug conhecido do Leaflet dentro de bundlers (Vite/Astro):
      // os ícones padrão do pin não são encontrados automaticamente.
      const iconePin = L.icon({
        iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
        iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
        shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41],
      });

      mapa = L.map('mapa').setView([locais[0].latitude, locais[0].longitude], 6);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap',
      }).addTo(mapa);

      const bounds = [];
      locais.forEach((l) => {
        const marker = L.marker([l.latitude, l.longitude], { icon: iconePin }).addTo(mapa);
        const esc = (t) => String(t ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
        const lugar = [l.cidade, l.estado].filter(Boolean).join('/');
        const tipos = (l.tipos ?? []).join(', ');
        const link = l.slug ? `/rotas/${l.slug}` : `#local-${l.id}`;
        marker.bindPopup(
          `<strong>${esc(l.nome)}</strong>` +
          (lugar ? `<br/><small>${esc(lugar)}</small>` : '') +
          (tipos ? `<br/>${esc(tipos)}` : '') +
          (l.selo ? `<br/><em>${esc(l.selo)}</em>` : '') +
          `<br/><a href="${link}">Ver local →</a>`
        );
        marcadores[l.id] = marker;
        bounds.push([l.latitude, l.longitude]);
      });
      if (bounds.length > 1) mapa.fitBounds(bounds, { padding: [30, 30] });
    });
  }
</script>

<style is:global>
  @import 'leaflet/dist/leaflet.css';
</style>

<style>
  .mapa {
    height: 380px;
    border-radius: var(--raio);
    margin: 12px 0 40px;
    box-shadow: var(--sombra);
    position: relative;
    z-index: 0;
  }
  .lista-setores {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .setor-card {
    background: var(--branco);
    border: 1px solid rgba(42,31,22,0.08);
    border-radius: var(--raio);
    box-shadow: var(--sombra);
    overflow: hidden;
  }
  .setor-card__capa {
    display: block;
    width: 100%;
    height: 160px;
    object-fit: cover;
  }
  .setor-card__corpo { padding: 24px; }
  .setor-card__cabecalho {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .setor-card__local { opacity: 0.7; font-size: 0.9rem; margin-top: -8px; }
  .setor-card__link { color: inherit; text-decoration: none; }
  .setor-card__link:hover { text-decoration: underline; }
  .setor-card__selo {
    display: inline-block;
    margin: 6px 0 2px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--marrom);
    opacity: 0.8;
  }
  .setor-card__selo--completo { color: var(--verde-escuro); opacity: 1; }
  .setor-card__tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 4px; }
  .tag-tipo {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-weight: 600;
    background: var(--creme-claro);
    color: var(--verde-escuro);
    border: 1px solid rgba(42,31,22,0.12);
    padding: 3px 9px;
    border-radius: 30px;
  }
  .setor-card__setores { margin-top: 8px; display: flex; flex-direction: column; gap: 4px; }
  .setor-card__lado { font-size: 0.9rem; opacity: 0.85; }
  .setor-card__detalhes { display: inline-block; margin-top: 14px; }
  .botao-compartilhar {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(42,31,22,0.15);
    background: var(--creme-claro);
    color: var(--verde-escuro);
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.15s;
  }
  .botao-compartilhar:hover { transform: translateY(-2px); }
</style>
