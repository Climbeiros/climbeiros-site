---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import type { Local, Setor } from '../lib/supabase';
import AvisoConstrucao from '../components/AvisoConstrucao.astro';
import BotaoFeedback from '../components/BotaoFeedback.astro';

const { data: locais } = await supabase
  .from('locais')
  .select('*')
  .order('estado')
  .order('cidade')
  .order('nome') as { data: Local[] | null };

const { data: setores } = await supabase
  .from('setores')
  .select('*')
  .not('local_id', 'is', null) as { data: Setor[] | null };

const locaisComCoordenadas = (locais ?? []).filter((l) => l.latitude && l.longitude);

// Opções pros filtros: estados e tipos de escalada realmente presentes nos locais cadastrados.
const estadosDisponiveis = [...new Set((locais ?? []).map((l) => l.estado).filter(Boolean))].sort() as string[];
const tiposDisponiveis = [...new Set((locais ?? []).flatMap((l) => l.tipos ?? []))].sort();

function setoresDoLocal(localId: string) {
  return (setores ?? []).filter((s) => s.local_id === localId);
}

// Agrupa os setores de um local por "lado" (quando houver). Setores sem lado
// ficam soltos; os com lado ficam agrupados sob o nome do lado.
function ladosDoLocal(localId: string) {
  const doLocal = setoresDoLocal(localId);
  const semLado = doLocal.filter((s) => !s.lado);
  const nomesLados = [...new Set(doLocal.filter((s) => s.lado).map((s) => s.lado as string))];
  return {
    semLado,
    lados: nomesLados.map((lado) => ({
      lado,
      setores: doLocal.filter((s) => s.lado === lado),
    })),
  };
}
---
<Layout titulo="Rotas & Setores" descricao="Locais de escalada catalogados pela comunidade Climbeiros.">
  <section class="secao">
    <div class="container">
      <p class="eyebrow">Onde escalar</p>
      <h1>Rotas & Setores</h1>
      <p>Explore os locais de escalada catalogados pela comunidade. Cada local pode ter um ou mais setores, cada um com croqui e dicas de acesso; hospedagens, guias e avaliações ficam na página do local. Clique num pin do mapa, busque pelo nome do local, cidade ou CEP, ou filtre por tipo e estado.</p>

      <AvisoConstrucao />

      {locais && locais.length > 0 && (
        <>
          <div class="busca-local">
            <input
              type="text"
              id="busca-cidade"
              placeholder="Buscar por nome do local, cidade ou CEP..."
              aria-label="Buscar locais por nome, cidade ou CEP"
            />
            <button type="button" id="busca-botao" class="botao">Buscar</button>
            <button type="button" id="busca-limpar" class="botao botao--secundario" hidden>Limpar</button>
          </div>

          <div class="filtros">
            {tiposDisponiveis.length > 0 && (
              <label class="filtro-campo">
                Tipo
                <select id="filtro-tipo">
                  <option value="">Todos</option>
                  {tiposDisponiveis.map((t) => <option value={t}>{t}</option>)}
                </select>
              </label>
            )}
            {estadosDisponiveis.length > 0 && (
              <label class="filtro-campo">
                Estado
                <select id="filtro-estado">
                  <option value="">Todos</option>
                  {estadosDisponiveis.map((uf) => <option value={uf}>{uf}</option>)}
                </select>
              </label>
            )}
          </div>

          <p id="busca-status" class="busca-status" role="status"></p>
        </>
      )}
    </div>

    {locaisComCoordenadas.length > 0 && (
      <div class="container">
        <div id="mapa" class="mapa"></div>
      </div>
    )}

    <div class="container">
      {(!locais || locais.length === 0) && (
        <p>Ainda estamos catalogando os primeiros locais. Volte em breve!</p>
      )}

      <div class="lista-setores" id="lista-setores">
        {locais?.map((local) => {
          const { semLado, lados } = ladosDoLocal(local.id);
          const totalSetores = semLado.length + lados.reduce((n, l) => n + l.setores.length, 0);
          return (
            <article
              class="setor-card"
              id={`local-${local.id}`}
              data-cidade={(local.cidade || '').toLowerCase()}
              data-nome={(local.nome || '').toLowerCase()}
              data-estado={local.estado || ''}
              data-tipos={(local.tipos || []).join('|')}
            >
              {local.imagem_capa_url ? (
                <img class="setor-card__capa" src={local.imagem_capa_url} alt={local.nome} loading="lazy" />
              ) : (
                <div class="setor-card__capa setor-card__capa--vazia" aria-hidden="true">🏔️</div>
              )}
              <div class="setor-card__corpo">
                <div class="setor-card__cabecalho">
                  <div>
                    <h2>
                      {local.slug ? (
                        <a class="setor-card__link" href={`/rotas/${local.slug}`}>{local.nome}</a>
                      ) : (
                        local.nome
                      )}
                    </h2>
                    <p class="setor-card__local">{[local.regiao, local.cidade, local.estado].filter(Boolean).join(' · ')}</p>
                  </div>
                  <button
                    type="button"
                    class="botao-compartilhar"
                    data-url={local.slug ? `/rotas/${local.slug}` : ''}
                    data-nome={local.nome}
                    title="Compartilhar"
                    aria-label={`Compartilhar ${local.nome}`}
                  >↗</button>
                </div>
                {local.tipos && local.tipos.length > 0 && (
                  <div class="setor-card__tags">
                    {local.tipos.map((t) => <span class="tag-tipo">{t}</span>)}
                  </div>
                )}
                {local.descricao && <p>{local.descricao}</p>}

                {totalSetores > 1 && (
                  <div class="setor-card__setores">
                    {lados.map((l) => (
                      <p class="setor-card__lado">
                        <strong>Lado {l.lado}:</strong> {l.setores.map((s) => s.nome).join(', ')}
                      </p>
                    ))}
                    {semLado.length > 0 && lados.length > 0 && (
                      <p class="setor-card__lado">{semLado.map((s) => s.nome).join(', ')}</p>
                    )}
                    {lados.length === 0 && (
                      <p class="setor-card__lado">Setores: {semLado.map((s) => s.nome).join(', ')}</p>
                    )}
                  </div>
                )}

                {local.slug && (
                  <a href={`/rotas/${local.slug}`} class="botao botao--pequeno setor-card__detalhes">
                    Ver setores e croquis →
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
  <BotaoFeedback pagina="Rotas & Setores (lista)" />
</Layout>

<script type="application/json" id="dados-locais" set:html={JSON.stringify(locaisComCoordenadas)}></script>

<script>
  const locais = JSON.parse(document.getElementById('dados-locais')?.textContent || '[]');
  let mapa;
  let L;
  const marcadores = {}; // local id -> Leaflet marker

  function normalizar(texto) {
    return texto
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .trim();
  }

  async function buscarCidadePorCep(cep) {
    const resposta = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
    const dados = await resposta.json();
    if (dados.erro) return null;
    return dados.localidade;
  }

  const filtroTipo = document.getElementById('filtro-tipo');
  const filtroEstado = document.getElementById('filtro-estado');

  // Aplica busca de nome/cidade + filtros de tipo/estado juntos. Um card só fica
  // visível se bater com os três critérios (cada um vazio conta como "vale tudo").
  function aplicarFiltros(termoBusca) {
    const termo = normalizar(termoBusca || '');
    const tipoEscolhido = filtroTipo?.value || '';
    const estadoEscolhido = filtroEstado?.value || '';
    let visiveis = 0;
    const idsVisiveis = new Set();

    document.querySelectorAll('#lista-setores .setor-card').forEach((card) => {
      const cidadeCard = normalizar(card.dataset.cidade || '');
      const nomeCard = normalizar(card.dataset.nome || '');
      const bateTexto = !termo || cidadeCard.includes(termo) || nomeCard.includes(termo);
      const bateEstado = !estadoEscolhido || card.dataset.estado === estadoEscolhido;
      const tiposCard = (card.dataset.tipos || '').split('|').filter(Boolean);
      const bateTipo = !tipoEscolhido || tiposCard.includes(tipoEscolhido);
      const bate = bateTexto && bateEstado && bateTipo;
      card.hidden = !bate;
      if (bate) {
        visiveis++;
        idsVisiveis.add(card.id.replace('local-', ''));
      }
    });

    // Atualiza os pins do mapa junto com os cards
    if (mapa) {
      const bounds = [];
      Object.entries(marcadores).forEach(([id, marker]) => {
        if (idsVisiveis.has(id)) {
          if (!mapa.hasLayer(marker)) marker.addTo(mapa);
          bounds.push(marker.getLatLng());
        } else {
          mapa.removeLayer(marker);
        }
      });
      if (bounds.length === 1) {
        mapa.setView(bounds[0], 11);
      } else if (bounds.length > 1) {
        mapa.fitBounds(bounds, { padding: [30, 30] });
      }
    }

    return visiveis;
  }

  const input = document.getElementById('busca-cidade');
  const botaoBuscar = document.getElementById('busca-botao');
  const botaoLimpar = document.getElementById('busca-limpar');
  const status = document.getElementById('busca-status');

  async function executarBusca() {
    if (!input || !status) return;
    const valor = input.value.trim();
    if (!valor) {
      const encontrados = aplicarFiltros('');
      status.textContent = '';
      botaoLimpar?.setAttribute('hidden', '');
      return;
    }

    const somenteNumeros = valor.replace(/\D/g, '');
    let termoParaFiltrar = valor;

    if (somenteNumeros.length === 8) {
      status.textContent = 'Buscando cidade pelo CEP...';
      const cidade = await buscarCidadePorCep(somenteNumeros);
      if (!cidade) {
        status.textContent = 'CEP não encontrado. Tente digitar o nome do local ou da cidade.';
        return;
      }
      termoParaFiltrar = cidade;
    }

    const encontrados = aplicarFiltros(termoParaFiltrar);
    status.textContent = encontrados > 0
      ? `${encontrados} local(is) encontrado(s) para "${termoParaFiltrar}".`
      : `Nenhum local encontrado para "${termoParaFiltrar}" ainda.`;
    botaoLimpar?.removeAttribute('hidden');
  }

  botaoBuscar?.addEventListener('click', executarBusca);
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') executarBusca();
  });
  botaoLimpar?.addEventListener('click', () => {
    if (input) input.value = '';
    aplicarFiltros('');
    if (status) status.textContent = '';
    botaoLimpar?.setAttribute('hidden', '');
  });
  filtroTipo?.addEventListener('change', () => aplicarFiltros(input?.value || ''));
  filtroEstado?.addEventListener('change', () => aplicarFiltros(input?.value || ''));

  // ---- Botão de compartilhar (Web Share API, com fallback pra copiar o link) ----
  document.querySelectorAll('.botao-compartilhar').forEach((botao) => {
    botao.addEventListener('click', async () => {
      const caminho = botao.dataset.url;
      if (!caminho) return;
      const url = `${window.location.origin}${caminho}`;
      const nome = botao.dataset.nome || 'Climbeiros';
      try {
        if (navigator.share) {
          await navigator.share({ title: nome, text: `Confira ${nome} no Climbeiros`, url });
        } else {
          await navigator.clipboard.writeText(url);
          const original = botao.textContent;
          botao.textContent = '✓';
          setTimeout(() => { botao.textContent = original; }, 1500);
        }
      } catch {
        // Usuário cancelou o compartilhamento nativo, ou o navegador bloqueou — sem problema.
      }
    });
  });

  if (locais.length > 0) {
    import('leaflet').then((mod) => {
      L = mod;

      // Corrige um bug conhecido do Leaflet dentro de bundlers (Vite/Astro):
      // os ícones padrão do pin não são encontrados automaticamente.
      const iconePin = L.icon({
        iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
        iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
        shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41],
      });

      mapa = L.map('mapa').setView([locais[0].latitude, locais[0].longitude], 6);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap',
      }).addTo(mapa);

      const bounds = [];
      locais.forEach((l) => {
        const marker = L.marker([l.latitude, l.longitude], { icon: iconePin }).addTo(mapa);
        marker.bindPopup(`<strong>${l.nome}</strong><br/><a href="#local-${l.id}">Ver detalhes</a>`);
        marcadores[l.id] = marker;
        bounds.push([l.latitude, l.longitude]);
      });
      if (bounds.length > 1) mapa.fitBounds(bounds, { padding: [30, 30] });
    });
  }
</script>

<style is:global>
  @import 'leaflet/dist/leaflet.css';
</style>

<style>
  .busca-local {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 20px 0 12px;
  }
  .busca-local input {
    flex: 1;
    min-width: 220px;
    font-family: var(--fonte-corpo);
    font-size: 1rem;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid rgba(42,31,22,0.25);
    color: var(--marrom);
  }
  .filtros {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  .filtro-campo {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--fonte-display);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--verde-escuro);
  }
  .filtro-campo select {
    font-family: var(--fonte-corpo);
    font-size: 0.9rem;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px solid rgba(42,31,22,0.25);
    color: var(--marrom);
    background: var(--branco);
    min-width: 160px;
  }
  .busca-status {
    font-size: 0.9rem;
    opacity: 0.8;
    margin-bottom: 8px;
    min-height: 1.2em;
  }
  .mapa {
    height: 380px;
    border-radius: var(--raio);
    margin: 12px 0 40px;
    box-shadow: var(--sombra);
  }
  .lista-setores {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .setor-card {
    background: var(--branco);
    border: 1px solid rgba(42,31,22,0.08);
    border-radius: var(--raio);
    box-shadow: var(--sombra);
    overflow: hidden;
  }
  .setor-card__capa {
    display: block;
    width: 100%;
    height: 160px;
    object-fit: cover;
  }
  .setor-card__capa--vazia {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
    background: linear-gradient(150deg, var(--verde-escuro), var(--marrom));
  }
  .setor-card__corpo { padding: 24px; }
  .setor-card__cabecalho {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .setor-card__local { opacity: 0.7; font-size: 0.9rem; margin-top: -8px; }
  .setor-card__link { color: inherit; text-decoration: none; }
  .setor-card__link:hover { text-decoration: underline; }
  .setor-card__tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 4px; }
  .tag-tipo {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-weight: 600;
    background: var(--creme-claro);
    color: var(--verde-escuro);
    border: 1px solid rgba(42,31,22,0.12);
    padding: 3px 9px;
    border-radius: 30px;
  }
  .setor-card__setores { margin-top: 8px; display: flex; flex-direction: column; gap: 4px; }
  .setor-card__lado { font-size: 0.9rem; opacity: 0.85; }
  .setor-card__detalhes { display: inline-block; margin-top: 14px; }
  .botao-compartilhar {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(42,31,22,0.15);
    background: var(--creme-claro);
    color: var(--verde-escuro);
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.15s;
  }
  .botao-compartilhar:hover { transform: translateY(-2px); }
</style>
