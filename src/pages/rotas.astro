---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import type { Setor, Croqui } from '../lib/supabase';

const { data: setores } = await supabase
  .from('setores')
  .select('*')
  .order('estado')
  .order('cidade')
  .order('nome') as { data: Setor[] | null };

const { data: croquis } = await supabase.from('croquis').select('*') as { data: Croqui[] | null };

const setoresComCoordenadas = (setores ?? []).filter((s) => s.latitude && s.longitude);

function croquisDoSetor(setorId: string) {
  return (croquis ?? []).filter((c) => c.setor_id === setorId);
}

const rotuloCroqui: Record<string, string> = {
  link: 'Ver croqui (site)',
  pdf: 'Abrir croqui (PDF)',
  foto: 'Ver croqui (foto)',
};
---
<Layout titulo="Rotas & Setores" descricao="Setores e vias de escalada catalogados pela comunidade Climbeiros.">
  <section class="secao">
    <div class="container">
      <p class="eyebrow">Onde escalar</p>
      <h1>Rotas & Setores</h1>
      <p>Explore os locais de escalada catalogados pela comunidade, com a orientação de croqui de cada um. Clique num pin do mapa ou busque por cidade/CEP pra filtrar.</p>

      {setores && setores.length > 0 && (
        <>
          <div class="busca-local">
            <input
              type="text"
              id="busca-cidade"
              placeholder="Buscar por cidade ou CEP..."
              aria-label="Buscar setores por cidade ou CEP"
            />
            <button type="button" id="busca-botao" class="botao">Buscar</button>
            <button type="button" id="busca-limpar" class="botao botao--secundario" hidden>Limpar</button>
          </div>
          <p id="busca-status" class="busca-status" role="status"></p>
        </>
      )}
    </div>

    {setoresComCoordenadas.length > 0 && (
      <div class="container">
        <div id="mapa" class="mapa"></div>
      </div>
    )}

    <div class="container">
      {(!setores || setores.length === 0) && (
        <p>Ainda estamos catalogando os primeiros setores. Volte em breve!</p>
      )}

      <div class="lista-setores" id="lista-setores">
        {setores?.map((setor) => (
          <article class="setor-card" id={`setor-${setor.id}`} data-cidade={(setor.cidade || '').toLowerCase()}>
            <div class="setor-card__cabecalho">
              <div>
                <h2>{setor.nome}</h2>
                <p class="setor-card__local">{[setor.regiao, setor.cidade, setor.estado].filter(Boolean).join(' · ')}</p>
              </div>
            </div>
            {setor.descricao && <p>{setor.descricao}</p>}

            {croquisDoSetor(setor.id).length > 0 && (
              <div class="setor-card__croquis">
                {croquisDoSetor(setor.id).map((c) => (
                  c.tipo === 'referencia' ? (
                    <p class="setor-card__croqui-ref">📍 Croqui: {c.texto}</p>
                  ) : (
                    <a href={c.url ?? '#'} target="_blank" rel="noopener" class="botao botao--secundario setor-card__croqui-link">
                      {rotuloCroqui[c.tipo] || 'Ver croqui'}
                    </a>
                  )
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script type="application/json" id="dados-setores" set:html={JSON.stringify(setoresComCoordenadas)}></script>

<script>
  const setores = JSON.parse(document.getElementById('dados-setores')?.textContent || '[]');
  let mapa;
  let L;
  const marcadores = {}; // setor id -> Leaflet marker

  function normalizar(texto) {
    return texto
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();
  }

  async function buscarCidadePorCep(cep) {
    const resposta = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
    const dados = await resposta.json();
    if (dados.erro) return null;
    return dados.localidade;
  }

  function filtrar(cidade) {
    const termo = normalizar(cidade);
    let visiveis = 0;
    const idsVisiveis = new Set();

    document.querySelectorAll('#lista-setores .setor-card').forEach((card) => {
      const cidadeCard = normalizar(card.dataset.cidade || '');
      const bate = !termo || cidadeCard.includes(termo);
      card.hidden = !bate;
      if (bate) {
        visiveis++;
        idsVisiveis.add(card.id.replace('setor-', ''));
      }
    });

    // Atualiza os pins do mapa junto com os cards
    if (mapa) {
      const bounds = [];
      Object.entries(marcadores).forEach(([id, marker]) => {
        if (idsVisiveis.has(id)) {
          if (!mapa.hasLayer(marker)) marker.addTo(mapa);
          bounds.push(marker.getLatLng());
        } else {
          mapa.removeLayer(marker);
        }
      });
      if (bounds.length === 1) {
        mapa.setView(bounds[0], 11);
      } else if (bounds.length > 1) {
        mapa.fitBounds(bounds, { padding: [30, 30] });
      }
    }

    return visiveis;
  }

  const input = document.getElementById('busca-cidade');
  const botaoBuscar = document.getElementById('busca-botao');
  const botaoLimpar = document.getElementById('busca-limpar');
  const status = document.getElementById('busca-status');

  async function executarBusca() {
    if (!input || !status) return;
    const valor = input.value.trim();
    if (!valor) {
      filtrar('');
      status.textContent = '';
      botaoLimpar?.setAttribute('hidden', '');
      return;
    }

    const somenteNumeros = valor.replace(/\D/g, '');
    let cidadeParaFiltrar = valor;

    if (somenteNumeros.length === 8) {
      status.textContent = 'Buscando cidade pelo CEP...';
      const cidade = await buscarCidadePorCep(somenteNumeros);
      if (!cidade) {
        status.textContent = 'CEP não encontrado. Tente digitar o nome da cidade.';
        return;
      }
      cidadeParaFiltrar = cidade;
    }

    const encontrados = filtrar(cidadeParaFiltrar);
    status.textContent = encontrados > 0
      ? `${encontrados} setor(es) encontrado(s) em ${cidadeParaFiltrar}.`
      : `Nenhum setor encontrado em ${cidadeParaFiltrar} ainda.`;
    botaoLimpar?.removeAttribute('hidden');
  }

  botaoBuscar?.addEventListener('click', executarBusca);
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') executarBusca();
  });
  botaoLimpar?.addEventListener('click', () => {
    if (input) input.value = '';
    filtrar('');
    if (status) status.textContent = '';
    botaoLimpar?.setAttribute('hidden', '');
  });

  if (setores.length > 0) {
    import('leaflet').then((mod) => {
      L = mod;

      // Corrige um bug conhecido do Leaflet dentro de bundlers (Vite/Astro):
      // os ícones padrão do pin não são encontrados automaticamente.
      const iconePin = L.icon({
        iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
        iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
        shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41],
      });

      mapa = L.map('mapa').setView([setores[0].latitude, setores[0].longitude], 6);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap',
      }).addTo(mapa);

      const bounds = [];
      setores.forEach((s) => {
        const marker = L.marker([s.latitude, s.longitude], { icon: iconePin }).addTo(mapa);
        marker.bindPopup(`<strong>${s.nome}</strong><br/><a href="#setor-${s.id}">Ver detalhes</a>`);
        marcadores[s.id] = marker;
        bounds.push([s.latitude, s.longitude]);
      });
      if (bounds.length > 1) mapa.fitBounds(bounds, { padding: [30, 30] });
    });
  }
</script>

<style is:global>
  @import 'leaflet/dist/leaflet.css';
</style>

<style>
  .busca-local {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 20px 0 8px;
  }
  .busca-local input {
    flex: 1;
    min-width: 220px;
    font-family: var(--fonte-corpo);
    font-size: 1rem;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid rgba(42,31,22,0.25);
    color: var(--marrom);
  }
  .busca-status {
    font-size: 0.9rem;
    opacity: 0.8;
    margin-bottom: 8px;
    min-height: 1.2em;
  }
  .mapa {
    height: 380px;
    border-radius: var(--raio);
    margin: 12px 0 40px;
    box-shadow: var(--sombra);
  }
  .lista-setores {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .setor-card {
    background: var(--branco);
    border: 1px solid rgba(42,31,22,0.08);
    border-radius: var(--raio);
    box-shadow: var(--sombra);
    padding: 24px;
  }
  .setor-card__cabecalho {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .setor-card__local { opacity: 0.7; font-size: 0.9rem; margin-top: -8px; }
  .setor-card__croqui-ref { font-size: 0.9rem; opacity: 0.8; font-style: italic; }
  .setor-card__croquis { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .setor-card__croqui-link { margin-top: 0; }
</style>
