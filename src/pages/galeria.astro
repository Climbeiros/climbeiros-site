---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;

const { data: fotos } = await supabase
  .from('fotos_galeria')
  .select('nome, instagram, local, imagem_url, enviado_em')
  .eq('aprovado', true)
  .order('enviado_em', { ascending: false });

const listaFotos = fotos ?? [];

// Quantas fotos aparecem de cada vez no mural (o botão "Trocar fotos" sorteia
// outras dentre todas as aprovadas, quando existem mais do que essa quantidade).
const QUANTIDADE_MURAL = 8;

function legendaFoto(foto: { nome: string; instagram?: string | null; local?: string | null }) {
  return [foto.nome, foto.instagram, foto.local].filter(Boolean).join(' · ');
}

// A esteira só faz sentido "rodando" com uma quantidade razoável de fotos —
// com poucas, ela fica parada (sem loop infinito) pra não parecer quebrada.
const esteiraGira = listaFotos.length > 5;

// Manda a lista completa de fotos aprovadas pro script do cliente, que usa
// isso pra sortear quais aparecem no mural a cada clique em "Trocar fotos".
const dadosFotosJSON = JSON.stringify(listaFotos).replace(/</g, '\\u003c');
---
<Layout titulo="Galeria" descricao="Fotos de escalada mandadas pela própria comunidade Climbeiros.">
  <section class="secao">
    <div class="container">
      <p class="eyebrow">Feito por quem escala</p>
      <h1>Galeria</h1>
      <p>
        Fotos de escalada mandadas por gente de verdade! Dos boulders de
        academia até os setores mais escondidos do Brasil. Manda a sua foto
        aí embaixo!
      </p>
    </div>
  </section>

  {listaFotos.length === 0 && (
    <section class="secao">
      <div class="container">
        <p class="crux-nota">
          Ainda não temos fotos aprovadas por aqui — seja a primeira pessoa a
          mandar a sua!
        </p>
      </div>
    </section>
  )}

  {listaFotos.length > 0 && (
    <>
      <section class="secao-esteira">
        <div class="esteira-viewport">
          <div class="esteira-trilho" id="esteira-trilho" data-gira={esteiraGira ? 'true' : 'false'}>
            {listaFotos.map((foto) => (
              <div class="esteira-item">
                <button
                  type="button"
                  class="foto-abrir"
                  aria-label={`Ver foto de ${foto.nome} em tamanho maior`}
                  data-legenda={legendaFoto(foto)}
                >
                  <img src={foto.imagem_url} alt={`Foto de escalada enviada por ${foto.nome}`} loading="lazy" />
                </button>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="secao secao--creme">
        <div class="container">
          <div class="mural-cabecalho">
            <h2 class="titulo-secao titulo-secao--mural">Mural da galera</h2>
            {listaFotos.length > QUANTIDADE_MURAL && (
              <button type="button" class="botao-reshuffle" id="btn-reshuffle">🔀 Trocar fotos</button>
            )}
            {listaFotos.length > 1 && listaFotos.length <= QUANTIDADE_MURAL && (
              <button type="button" class="botao-reshuffle" id="btn-reshuffle">🔀 Misturar de novo</button>
            )}
          </div>
          <div class="mural" id="mural"></div>
          {listaFotos.length > QUANTIDADE_MURAL && (
            <p class="aviso-fotos-restantes">
              Mostrando {QUANTIDADE_MURAL} de {listaFotos.length} fotos aprovadas — clica em "Trocar fotos" pra ver outras.
            </p>
          )}
        </div>
      </section>
    </>
  )}

  <section class="secao">
    <div class="container">
      <h2 class="titulo-secao">Manda sua foto</h2>
      <form
        id="form-foto"
        class="form-foto"
        data-supabase-url={supabaseUrl}
        data-supabase-key={supabaseKey}
      >
        <label>
          Nome
          <input type="text" name="nome" required />
        </label>
        <label>
          Instagram (opcional)
          <input type="text" name="instagram" placeholder="@seuusuario" />
        </label>
        <label>
          Local da foto (opcional)
          <input type="text" name="local" placeholder="Ex.: Academia Vertical, Setor Pedra Grande" />
        </label>
        <label>
          Foto (até 5 MB)
          <input type="file" name="foto" accept="image/png, image/jpeg, image/webp" required />
        </label>
        <button type="submit" class="botao">Enviar foto</button>
        <p id="form-foto-status" class="form-status" role="status"></p>
        <p class="form-foto-aviso">
          Sua foto passa por uma revisão da equipe do Climbeiros antes de
          aparecer aqui na galeria.
        </p>
      </form>
    </div>
  </section>

  <div id="lightbox" class="lightbox" hidden>
    <button type="button" class="lightbox__fechar" id="lightbox-fechar" aria-label="Fechar foto">×</button>
    <div class="lightbox__conteudo">
      <img id="lightbox-img" src="" alt="" />
      <p id="lightbox-legenda" class="lightbox__legenda"></p>
    </div>
  </div>

  <script type="application/json" id="dados-fotos" set:html={dadosFotosJSON}></script>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';

  // ---------------------------------------------------------------------
  // Formulário de envio de foto (igual a antes — nenhuma mudança aqui)
  // ---------------------------------------------------------------------
  const form = document.getElementById('form-foto') as HTMLFormElement | null;
  const status = document.getElementById('form-foto-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    const dados = new FormData(form);
    const arquivo = dados.get('foto') as File | null;
    const botao = form.querySelector('button') as HTMLButtonElement | null;
    if (!botao) return;

    if (!arquivo || arquivo.size === 0) {
      status.textContent = 'Escolha uma foto antes de enviar.';
      return;
    }
    if (arquivo.size > 5 * 1024 * 1024) {
      status.textContent = 'A foto precisa ter no máximo 5 MB.';
      return;
    }

    botao.disabled = true;
    status.textContent = 'Enviando...';

    try {
      const supabase = createClient(form.dataset.supabaseUrl!, form.dataset.supabaseKey!);

      const extensao = arquivo.name.split('.').pop();
      const nomeArquivo = `${Date.now()}-${Math.random().toString(36).slice(2)}.${extensao}`;

      const { error: erroUpload } = await supabase.storage
        .from('fotos-comunidade')
        .upload(nomeArquivo, arquivo);

      if (erroUpload) {
        status.textContent = 'Erro ao enviar a foto: ' + erroUpload.message;
        botao.disabled = false;
        return;
      }

      const { data: urlPublica } = supabase.storage
        .from('fotos-comunidade')
        .getPublicUrl(nomeArquivo);

      const { error: erroInsert } = await supabase.from('fotos_galeria').insert({
        nome: dados.get('nome'),
        instagram: dados.get('instagram') || null,
        local: dados.get('local') || null,
        imagem_url: urlPublica.publicUrl,
      });

      if (erroInsert) {
        status.textContent = 'Erro ao registrar a foto: ' + erroInsert.message;
      } else {
        status.textContent = 'Foto enviada! Ela aparece aqui assim que for aprovada pela equipe do Climbeiros.';
        form.reset();
      }
    } catch (err) {
      status.textContent = 'Erro inesperado: ' + (err instanceof Error ? err.message : String(err));
    }

    botao.disabled = false;
  });

  // ---------------------------------------------------------------------
  // Lightbox — agora aberto por delegação de evento (funciona tanto pras
  // fotos da esteira quanto pras do mural, mesmo essas sendo recriadas a
  // cada "Trocar fotos", sem precisar reconectar o clique toda vez).
  // ---------------------------------------------------------------------
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxLegenda = document.getElementById('lightbox-legenda');
  const lightboxFechar = document.getElementById('lightbox-fechar');

  function abrirLightbox(src: string, legenda: string) {
    if (!lightbox || !lightboxImg || !lightboxLegenda) return;
    lightboxImg.src = src;
    lightboxImg.alt = legenda;
    lightboxLegenda.textContent = legenda;
    lightbox.hidden = false;
  }

  function fecharLightbox() {
    if (!lightbox || !lightboxImg) return;
    lightbox.hidden = true;
    lightboxImg.src = '';
  }

  document.addEventListener('click', (e) => {
    const alvo = (e.target as HTMLElement).closest('.foto-abrir') as HTMLElement | null;
    if (!alvo) return;
    const img = alvo.querySelector('img');
    if (img) abrirLightbox(img.src, alvo.dataset.legenda || '');
  });

  lightboxFechar?.addEventListener('click', fecharLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) fecharLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.hidden) fecharLightbox();
  });

  // ---------------------------------------------------------------------
  // Esteira sem fim — duplica as fotos uma vez pra criar o loop contínuo.
  // ---------------------------------------------------------------------
  const esteiraTrilho = document.getElementById('esteira-trilho');
  if (esteiraTrilho && esteiraTrilho.dataset.gira === 'true') {
    esteiraTrilho.insertAdjacentHTML('beforeend', esteiraTrilho.innerHTML);
  }

  // ---------------------------------------------------------------------
  // Mural inclinado com "Trocar fotos" — sorteia um novo grupo dentre
  // todas as fotos aprovadas (ou só re-embaralha, se tiver poucas fotos).
  // ---------------------------------------------------------------------
  type Foto = { nome: string; instagram?: string | null; local?: string | null; imagem_url: string };

  const dadosFotosEl = document.getElementById('dados-fotos');
  const todasAsFotos: Foto[] = dadosFotosEl ? JSON.parse(dadosFotosEl.textContent || '[]') : [];
  const mural = document.getElementById('mural');
  const botaoReshuffle = document.getElementById('btn-reshuffle');
  const QUANTIDADE_MURAL = 8;

  function escapeHtml(texto: string) {
    return texto.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  }

  function legenda(foto: Foto) {
    return [foto.nome, foto.instagram, foto.local].filter(Boolean).join(' · ');
  }

  function sortearFotos(): Foto[] {
    const embaralhado = [...todasAsFotos].sort(() => Math.random() - 0.5);
    return embaralhado.slice(0, Math.min(QUANTIDADE_MURAL, embaralhado.length));
  }

  function renderMural() {
    if (!mural) return;
    const escolhidas = sortearFotos();

    mural.innerHTML = escolhidas.map((foto) => {
      const rot = (Math.random() * 16 - 8).toFixed(1);
      const leg = escapeHtml(legenda(foto));
      const nomeSeguro = escapeHtml(foto.nome);
      return `
        <figure class="polaroid" style="--rot: ${rot}deg">
          <div class="fita"></div>
          <button type="button" class="foto-abrir" aria-label="Ver foto de ${nomeSeguro} em tamanho maior" data-legenda="${leg}">
            <img src="${foto.imagem_url}" alt="Foto de escalada enviada por ${nomeSeguro}" loading="lazy" />
          </button>
          <figcaption>${nomeSeguro}</figcaption>
        </figure>`;
    }).join('');

    requestAnimationFrame(() => {
      mural?.querySelectorAll<HTMLElement>('.polaroid').forEach((card, i) => {
        setTimeout(() => card.classList.add('mostrar'), i * 60);
      });
    });
  }

  if (mural && todasAsFotos.length > 0) {
    renderMural();
    botaoReshuffle?.addEventListener('click', () => {
      mural.querySelectorAll('.polaroid').forEach((card) => card.classList.remove('mostrar'));
      setTimeout(renderMural, 200);
    });
  }
</script>

<style>
  .titulo-secao {
    font-family: var(--fonte-display);
    text-transform: uppercase;
    color: var(--verde-escuro);
    font-size: 1.4rem;
    margin: 0 0 1.25rem;
    text-align: center;
  }

  .crux-nota {
    max-width: 820px;
    margin: 0 auto;
    opacity: 0.75;
    text-align: center;
  }

  /* ===================== Esteira sem fim ===================== */
  .secao-esteira {
    background: var(--verde-escuro);
    padding: 34px 0;
  }
  .esteira-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 90px, #000 calc(100% - 90px), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 90px, #000 calc(100% - 90px), transparent 100%);
  }
  .esteira-trilho {
    display: flex;
    gap: 26px;
    width: max-content;
    padding: 0 18px;
  }
  .esteira-trilho[data-gira="true"] {
    animation: rodar-esteira 32s linear infinite;
  }
  .esteira-viewport:hover .esteira-trilho[data-gira="true"] {
    animation-play-state: paused;
  }
  @keyframes rodar-esteira {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .esteira-item {
    flex: 0 0 auto;
    width: 220px;
    height: 276px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 12px 28px rgba(0,0,0,0.35);
    border: 4px solid rgba(255,255,255,0.15);
  }
  @media (max-width: 640px) {
    .esteira-item {
      width: 170px;
      height: 213px;
    }
  }
  .esteira-item:nth-child(odd) { transform: rotate(-4deg); }
  .esteira-item:nth-child(even) { transform: rotate(3deg); }
  .esteira-item .foto-abrir {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }
  .esteira-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ===================== Mural inclinado + reshuffle ===================== */
  .mural-cabecalho {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 6px;
  }
  .titulo-secao--mural { margin-bottom: 0; }
  .botao-reshuffle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--laranja);
    color: #fff;
    border: none;
    font-family: var(--fonte-display);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .botao-reshuffle:hover { background: var(--amarelo); transform: translateY(-2px); }
  .botao-reshuffle:active { transform: translateY(0); }

  .mural {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 56px 44px;
    padding: 30px 10px 20px;
    min-height: 240px;
  }
  .aviso-fotos-restantes {
    text-align: center;
    font-size: 0.82rem;
    color: var(--marrom);
    opacity: 0.65;
    font-style: italic;
    margin: 0;
  }

  /* ===================== Formulário "Manda sua foto" ===================== */
  .form-foto {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 460px;
    margin: 0 auto;
    background: var(--branco);
    padding: 28px;
    border-radius: var(--raio);
    box-shadow: var(--sombra);
  }
  .form-foto label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--fonte-display);
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--verde-escuro);
    letter-spacing: 0.03em;
  }
  .form-foto input {
    font-family: var(--fonte-corpo);
    font-size: 1rem;
    padding: 10px 12px;
    border-radius: 6px;
    border: 1px solid rgba(42,31,22,0.2);
    color: var(--marrom);
  }
  .form-foto button { align-self: flex-start; }
  .form-status { font-size: 0.9rem; min-height: 1.2em; margin: 0; }
  .form-foto-aviso {
    font-size: 0.8rem;
    opacity: 0.7;
    margin: 0;
  }

  /* ===================== Lightbox (igual a antes) ===================== */
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(20, 15, 10, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    z-index: 999;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox__conteudo {
    max-width: min(900px, 92vw);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .lightbox__conteudo img {
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: var(--raio);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }
  .lightbox__legenda {
    color: var(--creme-claro);
    text-align: center;
    font-size: 0.9rem;
    margin: 0;
  }
  .lightbox__fechar {
    position: fixed;
    top: 24px;
    right: 28px;
    background: none;
    border: none;
    color: var(--creme-claro);
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
    z-index: 1000;
  }
  .lightbox__fechar:hover {
    color: var(--amarelo);
  }
</style>

<!--
  Este bloco usa is:global de propósito: as fotos do "Mural da galera" são
  criadas pelo JavaScript no navegador (função renderMural, no <script> acima),
  não escritas direto aqui no .astro. O CSS "scoped" normal do Astro só
  funciona em elementos que ele mesmo gera durante o build — em elementos
  criados depois, pelo JS, ele não é aplicado. Por isso o efeito de foto
  quadrada + fita de durex do mural precisa ficar num bloco global.
-->
<style is:global>
  .polaroid {
    width: 330px;
    margin: 0;
    background: var(--branco);
    padding: 20px 20px 68px;
    box-shadow: var(--sombra);
    border-radius: 5px;
    cursor: default;
    position: relative;
    opacity: 0;
    transform: scale(0.6) rotate(0deg);
    transition: transform 0.45s cubic-bezier(.2,.9,.3,1.3), box-shadow 0.3s ease, opacity 0.35s ease;
  }
  @media (max-width: 640px) {
    .polaroid {
      width: 260px;
      padding: 16px 16px 54px;
    }
  }
  .polaroid.mostrar {
    opacity: 1;
    transform: scale(1) rotate(var(--rot, 0deg));
  }
  .polaroid:hover {
    transform: scale(1.14) rotate(0deg) translateY(-8px) !important;
    box-shadow: 0 22px 44px rgba(42,31,22,0.32);
    z-index: 10;
  }
  .polaroid .foto-abrir {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }
  .polaroid img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    border-radius: 1px;
  }
  .polaroid figcaption {
    position: absolute;
    bottom: 16px;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--fonte-display);
    font-size: 1rem;
    color: var(--marrom);
    opacity: 0.75;
  }
  .polaroid .fita {
    position: absolute;
    top: -22px;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
    width: 100px;
    height: 38px;
    background: rgba(224, 147, 28, 0.55);
    border: 1px solid rgba(224, 147, 28, 0.7);
  }
</style>
