---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;

const { data: fotos } = await supabase
  .from('fotos_comunidade')
  .select('nome, instagram, local, imagem_url, enviado_em')
  .eq('aprovado', true)
  .order('enviado_em', { ascending: false });
---
<Layout titulo="Comunidade" descricao="Fotos de escalada mandadas pela própria comunidade Climbeiros.">
  <section class="pagina-hero">
    <div class="pagina-hero__contorno" aria-hidden="true"></div>
    <div class="container pagina-hero__conteudo">
      <span class="eyebrow">Feito por quem escala</span>
      <h1>Comunidade</h1>
      <p class="lead">
        Fotos de escalada mandadas por gente de verdade — dos boulders de
        academia até os setores mais escondidos do Brasil. Manda a sua foto
        aí embaixo!
      </p>
    </div>
  </section>

  <section class="secao secao--creme">
    <div class="container">
      <h2 class="titulo-secao">Manda sua foto</h2>

      <form
        id="form-foto"
        class="form-foto"
        data-supabase-url={supabaseUrl}
        data-supabase-key={supabaseKey}
      >
        <label>
          Nome
          <input type="text" name="nome" required />
        </label>
        <label>
          Instagram (opcional)
          <input type="text" name="instagram" placeholder="@seuusuario" />
        </label>
        <label>
          Local da foto (opcional)
          <input type="text" name="local" placeholder="Ex.: Academia Vertical, Setor Pedra Grande" />
        </label>
        <label>
          Foto (até 5 MB)
          <input type="file" name="foto" accept="image/png, image/jpeg, image/webp" required />
        </label>
        <button type="submit" class="botao">Enviar foto</button>
        <p id="form-foto-status" class="form-status" role="status"></p>
        <p class="form-foto-aviso">
          Sua foto passa por uma revisão da equipe do Climbeiros antes de
          aparecer aqui na galeria.
        </p>
      </form>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <h2 class="titulo-secao">Galeria da comunidade</h2>

      {fotos && fotos.length > 0 ? (
        <div class="galeria-fotos">
          {fotos.map((foto) => (
            <figure class="galeria-item">
              <img src={foto.imagem_url} alt={`Foto de escalada enviada por ${foto.nome}`} loading="lazy" />
              <figcaption>
                <strong>{foto.nome}</strong>
                {foto.instagram && <span class="galeria-item__insta"> · {foto.instagram}</span>}
                {foto.local && <span class="galeria-item__local">{foto.local}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <p class="crux-nota">
          Ainda não temos fotos aprovadas por aqui — seja a primeira pessoa a
          mandar a sua!
        </p>
      )}
    </div>
  </section>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const form = document.getElementById('form-foto');
  const status = document.getElementById('form-foto-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const dados = new FormData(form);
    const arquivo = dados.get('foto');
    const botao = form.querySelector('button');

    if (!arquivo || arquivo.size === 0) {
      status.textContent = 'Escolha uma foto antes de enviar.';
      return;
    }
    if (arquivo.size > 5 * 1024 * 1024) {
      status.textContent = 'A foto precisa ter no máximo 5 MB.';
      return;
    }

    botao.disabled = true;
    status.textContent = 'Enviando...';

    try {
      const supabase = createClient(form.dataset.supabaseUrl, form.dataset.supabaseKey);

      const extensao = arquivo.name.split('.').pop();
      const nomeArquivo = `${Date.now()}-${Math.random().toString(36).slice(2)}.${extensao}`;

      const { error: erroUpload } = await supabase.storage
        .from('fotos-comunidade')
        .upload(nomeArquivo, arquivo);

      if (erroUpload) {
        status.textContent = 'Erro ao enviar a foto: ' + erroUpload.message;
        botao.disabled = false;
        return;
      }

      const { data: urlPublica } = supabase.storage
        .from('fotos-comunidade')
        .getPublicUrl(nomeArquivo);

      const { error: erroInsert } = await supabase.from('fotos_comunidade').insert({
        nome: dados.get('nome'),
        instagram: dados.get('instagram') || null,
        local: dados.get('local') || null,
        imagem_url: urlPublica.publicUrl,
      });

      if (erroInsert) {
        status.textContent = 'Erro ao registrar a foto: ' + erroInsert.message;
      } else {
        status.textContent = 'Foto enviada! Ela aparece aqui assim que for aprovada pela equipe do Climbeiros.';
        form.reset();
      }
    } catch (err) {
      status.textContent = 'Erro inesperado: ' + (err && err.message ? err.message : String(err));
    }

    botao.disabled = false;
  });
</script>

<style>
  .titulo-secao {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    color: var(--verde-escuro);
    font-size: 1.4rem;
    margin: 0 0 1.25rem;
    text-align: center;
  }

  .form-foto {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 520px;
    margin: 0 auto;
    background: var(--branco);
    padding: 28px;
    border-radius: var(--raio);
  }
  .form-foto label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--fonte-display);
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--verde-escuro);
    letter-spacing: 0.03em;
  }
  .form-foto input {
    font-family: var(--fonte-corpo);
    font-size: 1rem;
    padding: 10px 12px;
    border-radius: 6px;
    border: 1px solid rgba(42,31,22,0.2);
    color: var(--marrom);
  }
  .form-foto button { align-self: flex-start; }
  .form-status { font-size: 0.9rem; min-height: 1.2em; margin: 0; }
  .form-foto-aviso {
    font-size: 0.8rem;
    opacity: 0.7;
    margin: 0;
  }

  .galeria-fotos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }
  .galeria-item {
    margin: 0;
    border-radius: var(--raio);
    overflow: hidden;
    background: var(--creme-claro);
    box-shadow: var(--sombra);
  }
  .galeria-item img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }
  .galeria-item figcaption {
    padding: 12px 14px;
    font-size: 0.85rem;
    color: var(--marrom);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .galeria-item__insta {
    opacity: 0.8;
  }
  .galeria-item__local {
    opacity: 0.65;
    font-size: 0.8rem;
  }

  .crux-nota {
    max-width: 820px;
    margin: 0 auto;
    opacity: 0.75;
    text-align: center;
  }
</style>
