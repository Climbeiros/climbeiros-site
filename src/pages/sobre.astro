---
import Layout from '../layouts/Layout.astro';
import { getSiteConfig } from '../lib/supabase';
const config = await getSiteConfig();
const texto = config.sobre_texto ||
  'Os Climbeiros nasceu da vontade de um grupo de amigos de reunir, num só lugar, tudo que a comunidade de escalada no Brasil precisa: onde treinar, onde aprender, quais vias vale a pena pegar e quem são as marcas que realmente apoiam quem escala.';

// Fotos da página ficam no Supabase Storage, bucket "fotos", com nomes começando por "sobre-"
// (versões menores das fotos da galeria). Pra trocar uma foto, suba outra com o mesmo nome
// no bucket (substituindo a antiga) ou troque o nome aqui.
const FOTOS = 'https://ctbetvnlojkpiwrruvie.supabase.co/storage/v1/object/public/fotos/sobre-';
const colagem = [
  { src: FOTOS + 'colagem-goat.jpg', alt: 'A galera escalando junto na Goat', classe: 'colagem__a' },
  { src: FOTOS + 'colagem-poses.jpg', alt: 'Testando poses na Casa de Pedra', classe: 'colagem__b' },
  { src: FOTOS + 'colagem-perdizes.jpg', alt: 'Gui, Bia, Rods e Thi na Casa de Pedra Perdizes', classe: 'colagem__c' },
  { src: FOTOS + 'colagem-moema.jpg', alt: 'Gui, Emi, Marcos e Ric na Casa de Pedra Moema', classe: 'colagem__d' },
];

const mosaico = [
  { src: FOTOS + 'grupo-goat.jpg', alt: 'Climbeiros na Goat', grande: true },
  { src: FOTOS + 'de-boa-na-pedra.jpg', alt: 'De boa na pedra' },
  { src: FOTOS + 'climbeiras-rochelas.jpg', alt: 'Climbeiras em Rochelas, Serra do Cipó' },
  { src: FOTOS + 'geo-e-dea.jpg', alt: 'Geo e Dea na Pedreira do Garcia' },
  { src: FOTOS + 'treelab.jpg', alt: 'A galera na TreeLab' },
  { src: FOTOS + 'pose-climbeiras.jpg', alt: 'Pose das Climbeiras' },
];

const bastidores = [
  { src: FOTOS + 'geovanna.jpg', alt: 'Geovanna', posicao: '50% 50%' },
  { src: FOTOS + 'emilie.jpg', alt: 'Emilie', posicao: '70% 60%' },
  { src: FOTOS + 'larissa.jpg', alt: 'Larissa', posicao: '50% 40%' },
];

const valores = [
  {
    titulo: 'Amizade primeiro',
    texto: 'A cordada começa na confiança entre quem sobe junto. Antes de ser conteúdo, os Climbeiros são um grupo de amigos, e é assim que a gente trata cada pessoa que chega.',
    cor: 'verde',
  },
  {
    titulo: 'Segurança sempre',
    texto: 'Check de equipamento e de parceiro antes de cada via. Levar a montanha a sério é o que permite se divertir nela por muitos anos.',
    cor: 'laranja',
  },
  {
    titulo: 'Leveza',
    texto: 'Vida ativa sem cobrança, do yoga de domingo ao cume. A escalada é desafio, mas também é prazer; a gente celebra cada progresso no ritmo de cada um.',
    cor: 'amarelo',
  },
  {
    titulo: 'Verdade acima de tudo',
    texto: 'Só recomendamos o que usamos e confiamos: rotas, equipamentos e marcas. Nada de propaganda genérica: se está aqui, é porque passou pela nossa experiência real.',
    cor: 'creme',
  },
];
---
<Layout titulo="Sobre" descricao="Conheça a história e o time por trás dos Climbeiros, uma comunidade de amigos que escalam juntos e criaram um hub de escalada para o Brasil." imagem={FOTOS + 'colagem-goat.jpg'}>
  <section class="secao">
    <div class="container sobre">
      <div class="sobre__texto">
        <p class="eyebrow">Quem somos</p>
        <h1>A escalada é melhor em grupo</h1>
        <p>{texto}</p>
        <a href="/contato" class="botao">Fale com a gente</a>
      </div>
      <div class="colagem">
        {colagem.map((f) => (
          <img src={f.src} alt={f.alt} class={f.classe} loading="eager" />
        ))}
      </div>
    </div>
  </section>

  <!-- MISSÃO -->
  <section class="secao">
    <div class="container missao">
      <p class="eyebrow">Nossa missão</p>
      <h2>Ninguém precisa subir sozinho</h2>
      <p>
        Aproximar quem ama a vertical. Reunimos num só lugar tudo que a comunidade
        de escalada no Brasil precisa: onde treinar, onde aprender, quais vias vale
        a pena pegar e quais marcas realmente apoiam quem escala, para que mais
        gente escale com segurança, informação e boa companhia.
      </p>
    </div>
  </section>

  <!-- COMO A GENTE SE JUNTOU -->
  <section class="secao secao--creme">
    <div class="container">
      <div class="historia">
        <div class="historia__texto">
          <p class="eyebrow">Como a gente se juntou</p>
          <h2>De amigo em amigo</h2>
          <p>Os Climbeiros não começaram como projeto. Começaram na escalada, com cada um chamando alguém que conhecia pra ir junto.</p>
          <ul class="corda" aria-label="Como o grupo cresceu">
            <li>Alguém levou um amigo pra escalar.</li>
            <li>Esse amigo puxou outro, que puxou mais um.</li>
            <li>A galera foi se conhecendo na parede, a vibe bateu, e virou um grupo só.</li>
          </ul>
          <p>É por isso que a gente acredita que a escalada é melhor em grupo: foi ela que juntou a gente.</p>
        </div>
        <div class="mosaico">
          {mosaico.map((f) => (
            <img src={f.src} alt={f.alt} class={f.grande ? 'mosaico__grande' : undefined} loading="lazy" />
          ))}
        </div>
      </div>

      <div class="bastidores">
        <div class="bastidores__rostos">
          {bastidores.map((p) => (
            <img src={p.src} alt={p.alt} style={`object-position: ${p.posicao}`} loading="lazy" />
          ))}
        </div>
        <p>
          Nos bastidores, quem cuida do site são a Geovanna, a Emilie e a Larissa.
          Quer falar com a gente? <a href="/contato">Manda uma mensagem →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- VALORES -->
  <section class="secao">
    <div class="container">
      <p class="eyebrow">No que a gente acredita</p>
      <h2>Nossos valores</h2>
      <div class="valores valores--grade">
        {valores.map((v) => (
          <article class={`valor valor--${v.cor}`}>
            <div class="valor__corpo">
              <h3>{v.titulo}</h3>
              <p>{v.texto}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
<style>
  .sobre {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }
  .sobre__texto { min-width: 0; }

  /* Colagem do topo: 4 fotos de grupo */
  .colagem {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 150px 150px 170px;
    grid-template-areas: "a b" "a c" "d d";
    gap: 8px;
    min-width: 0;
  }
  .colagem img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--raio);
    box-shadow: var(--sombra);
  }
  .colagem__a { grid-area: a; }
  .colagem__b { grid-area: b; }
  .colagem__c { grid-area: c; object-position: 50% 35%; }
  .colagem__d { grid-area: d; object-position: 50% 60%; }

  @media (max-width: 760px) {
    .sobre { grid-template-columns: 1fr; }
    .colagem { order: -1; grid-template-rows: 120px 120px 140px; }
  }

  /* Missão */
  .missao h2 { color: var(--verde-escuro); margin-bottom: 16px; }
  .missao p:not(.eyebrow) { font-size: 1.15rem; color: var(--marrom); opacity: 0.9; margin: 0; max-width: 760px; }

  /* Como a gente se juntou */
  .historia {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 44px;
    align-items: center;
  }
  .historia__texto { min-width: 0; max-width: 34rem; }
  .historia__texto h2 { color: var(--verde-escuro); margin-bottom: 14px; }
  .historia__texto p:not(.eyebrow) { font-size: 1.05rem; }
  .corda { list-style: none; margin: 6px 0 18px; padding: 0; }
  .corda li {
    position: relative;
    padding: 0 0 14px 34px;
  }
  .corda li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 6px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--laranja);
  }
  .corda li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 10px;
    top: 22px;
    bottom: 0;
    border-left: 2px dashed var(--verde);
  }
  .mosaico {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 150px;
    gap: 8px;
    min-width: 0;
  }
  .mosaico img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--raio);
  }
  .mosaico__grande { grid-column: span 2; grid-row: span 2; }

  .bastidores {
    margin-top: 44px;
    padding-top: 22px;
    border-top: 1px solid rgba(61, 84, 57, 0.25);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
  }
  .bastidores__rostos { display: flex; }
  .bastidores__rostos img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--creme-claro);
    margin-left: -12px;
  }
  .bastidores__rostos img:first-child { margin-left: 0; }
  .bastidores p { margin: 0; flex: 1 1 280px; min-width: 0; }
  .bastidores a { color: var(--laranja); font-weight: 600; text-decoration: none; }
  .bastidores a:hover { text-decoration: underline; }

  @media (max-width: 760px) {
    .historia { grid-template-columns: 1fr; }
    .mosaico { grid-auto-rows: 110px; }
  }

  /* Valores — blocos de cor cheia, colados, formando um quadrado 2x2 */
  .valores--grade {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-radius: var(--raio);
    overflow: hidden;
    box-shadow: var(--sombra);
  }
  .valor {
    padding: 40px 38px;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  /* Cores cheias da paleta, texto claro por cima */
  .valor--verde   { background: var(--verde); }
  .valor--laranja { background: var(--laranja); }
  .valor--amarelo { background: var(--amarelo); }
  .valor--creme   { background: var(--verde-escuro); }

  .valor__corpo h3 { color: var(--creme); margin-bottom: 10px; }
  .valor__corpo p { margin: 0; font-size: 0.98rem; color: var(--creme-claro); opacity: 0.95; }
  /* No bloco amarelo, texto escuro garante melhor contraste */
  .valor--amarelo .valor__corpo h3 { color: var(--marrom); }
  .valor--amarelo .valor__corpo p { color: var(--marrom); opacity: 0.85; }

  @media (max-width: 760px) {
    .valores--grade { grid-template-columns: 1fr; }
    .valor { min-height: 0; padding: 32px 30px; }
  }
</style>
