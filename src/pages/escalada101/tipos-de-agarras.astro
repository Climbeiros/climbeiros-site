---
// src/pages/escalada101/tipos-de-agarras.astro
//
// Página interativa com os tipos de agarra e os tipos de inclinação de
// parede da escalada. Assim como a página de equipamentos e a de
// vocabulário, o conteúdo aqui é fixo no código (não vem do Supabase) —
// pra adicionar, editar ou trocar a foto/vídeo de um tipo, mexa direto
// nos arrays TIPOS_AGARRA e TIPOS_PAREDE lá no final do arquivo, dentro
// do bloco de script.
//
// Fotos e vídeos ficam em:
//   public/images/agarras/   (fotos)
//   public/videos/agarras/   (vídeos)

import Layout from '../../layouts/Layout.astro';
---

<Layout title="Tipos de Agarras | Climbeiros">
<section class="pagina-hero">
  <div class="pagina-hero__contorno" aria-hidden="true"></div>
  <div class="container pagina-hero__conteudo">
    <span class="eyebrow">Escalada 101</span>
    <h1>Tipos de Agarras</h1>
    <p class="lead">
      Uma parede de escalada tem vários formatos de agarra diferentes, e cada
      um se usa de um jeito. Clique em qualquer agarra da parede (ou na lista
      ao lado) pra ver o nome e a dica de como usar aquele tipo.
    </p>
  </div>
</section>

<div class="container">
  <h2 class="titulo-secao">A parede</h2>

  <div class="parede-layout">
    <div>
      <div class="parede" id="parede"></div>
      <p class="parede-nota">
        Aqui as cores são só pra enfeitar a parede. Em academia de verdade
        isso varia: em algumas, como a Casa de Pedra, cada via tem sua
        própria cor de agarra; em outras, a cor não indica nada e quem marca
        a via é a fita ou etiqueta ao lado. O que não muda de um lugar pro
        outro é o formato — é ele que diz o tipo da agarra, não a cor dela.
      </p>
    </div>
    <div class="legenda" id="legenda"></div>
  </div>

  <h2 class="titulo-secao" style="margin-top:3rem;">Tipos de inclinação da parede</h2>
  <div class="parede-tipos-grade" id="parede-tipos"></div>
</div>
</Layout>

<div class="modal-overlay" id="modal-overlay" hidden>
  <div class="modal-caixa" role="dialog" aria-modal="true">
    <button class="modal-fechar" id="modal-fechar" aria-label="Fechar">✕</button>
    <div class="modal-icone-area" id="modal-icone"></div>
    <h3 id="modal-titulo"></h3>
    <p class="descricao" id="modal-descricao"></p>
    <p class="como-usar"><strong>Como usar</strong><span id="modal-como-usar"></span></p>
    <div id="modal-foto-area"></div>
  </div>
</div>

<svg width="0" height="0" style="position:absolute">
  <defs>
    <symbol id="f-barra-fina" viewBox="0 0 100 100">
      <rect x="8" y="40" width="84" height="20" rx="8" fill="currentColor" />
    </symbol>

    <symbol id="f-bola" viewBox="0 0 100 100">
      <ellipse cx="50" cy="55" rx="40" ry="32" fill="currentColor" />
      <ellipse cx="36" cy="42" rx="14" ry="8" fill="rgba(255,255,255,0.3)" />
    </symbol>

    <mask id="m-concha">
      <rect width="100" height="100" fill="white" />
      <circle cx="66" cy="38" r="30" fill="black" />
    </mask>
    <symbol id="f-concha" viewBox="0 0 100 100">
      <circle cx="48" cy="55" r="36" fill="currentColor" mask="url(#m-concha)" />
    </symbol>

    <symbol id="f-invertida" viewBox="0 0 100 100">
      <g transform="translate(0,100) scale(1,-1)">
        <circle cx="48" cy="55" r="36" fill="currentColor" mask="url(#m-concha)" />
      </g>
    </symbol>

    <symbol id="f-pinca" viewBox="0 0 100 100">
      <rect x="34" y="8" width="32" height="84" rx="15" fill="currentColor" />
    </symbol>

    <symbol id="f-furo" viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="28" fill="currentColor" />
      <circle cx="50" cy="50" r="15" fill="rgba(0,0,0,0.4)" />
    </symbol>

    <symbol id="f-lateral" viewBox="0 0 100 100">
      <path d="M18,18 Q16,50 18,82 Q65,68 78,50 Q65,32 18,18 Z" fill="currentColor" />
    </symbol>

    <symbol id="f-gaston" viewBox="0 0 100 100">
      <path d="M82,18 Q84,50 82,82 Q35,68 22,50 Q35,32 82,18 Z" fill="currentColor" />
    </symbol>

    <symbol id="f-volume" viewBox="0 0 100 100">
      <polygon points="50,6 93,36 79,92 21,92 7,36" fill="currentColor" />
    </symbol>

    <symbol id="seta" viewBox="0 0 100 100">
      <line x1="50" y1="15" x2="50" y2="70" stroke="currentColor" stroke-width="10" stroke-linecap="round" />
      <polygon points="50,95 30,60 70,60" fill="currentColor" />
    </symbol>
  </defs>
</svg>

<style is:global>
  h2.titulo-secao {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    color: var(--verde-escuro);
    font-size: 1.4rem;
    margin: 0 0 1.25rem;
  }

  /* ---------- Parede interativa ---------- */

  .parede-layout {
    display: grid;
    grid-template-columns: minmax(260px, 420px) 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: 1rem;
  }

  @media (max-width: 720px) {
    .parede-layout { grid-template-columns: 1fr; }
  }

  .parede {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 18px;
    overflow: hidden;
    background:
      repeating-linear-gradient(115deg, rgba(0,0,0,0.05) 0 2px, transparent 2px 90px),
      repeating-linear-gradient(25deg, rgba(0,0,0,0.04) 0 2px, transparent 2px 70px),
      linear-gradient(160deg, #cfc3a3, #b9ac86 55%, #a89873);
      box-shadow: inset 0 0 40px rgba(0,0,0,0.25), 0 6px 16px rgba(42,31,22,0.2);
  }

  .agarra-btn {
    position: absolute;
    transform: translate(-50%, -50%);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    filter: drop-shadow(0 3px 3px rgba(0,0,0,0.35));
    transition: transform 0.15s ease;
  }

  .agarra-btn:hover,
  .agarra-btn:focus-visible {
    transform: translate(-50%, -50%) scale(1.15);
  }

  .agarra-btn svg { display: block; width: 100%; height: 100%; }

  .parede-nota {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0.75rem 0 0;
    line-height: 1.4;
  }

  .legenda {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .legenda-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--creme-claro);
    border: none;
    border-radius: 10px;
    padding: 0.6rem 0.8rem;
    cursor: pointer;
    text-align: left;
    font-family: 'Work Sans', sans-serif;
    font-size: 0.95rem;
    color: var(--marrom);
  }

  .legenda-item:hover { background: var(--creme); }

  .legenda-icone {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .legenda-nome { font-weight: 600; }

  /* ---------- Tipos de parede (inclinação) ---------- */

  .parede-tipos-grade {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin: 2.5rem 0 3rem;
  }

  .parede-tipo-card {
    background: var(--creme-claro);
    border: none;
    border-radius: 14px;
    padding: 1.25rem;
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-family: 'Work Sans', sans-serif;
    color: var(--marrom);
  }

  .parede-tipo-card:hover { background: var(--creme); }

  .parede-tipo-card svg { width: 100%; height: 90px; }

  .parede-tipo-card .nome {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    color: var(--verde-escuro);
    font-size: 1.1rem;
  }

  .parede-tipo-card p { margin: 0; font-size: 0.9rem; opacity: 0.85; line-height: 1.4; }

  /* ---------- Modal ---------- */

  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(42, 31, 22, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    z-index: 50;
  }

  .modal-overlay[hidden] { display: none; }

  .modal-caixa {
    background: white;
    border-radius: 16px;
    max-width: 480px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 1.75rem;
    position: relative;
    box-shadow: 0 12px 30px rgba(0,0,0,0.3);
  }

  .modal-fechar {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--creme-claro);
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    font-size: 1.1rem;
    cursor: pointer;
    color: var(--marrom);
  }

  .modal-icone-area {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .modal-icone-area svg { width: 140px; height: 140px; }

  .modal-caixa h3 {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    color: var(--verde-escuro);
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
    text-align: center;
  }

  .modal-caixa .descricao { margin: 0 0 1rem; line-height: 1.5; }

  .modal-caixa .como-usar {
    background: var(--creme-claro);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    margin: 0;
    line-height: 1.5;
  }

  .modal-caixa .como-usar strong {
    display: block;
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--laranja);
    margin-bottom: 0.35rem;
    letter-spacing: 0.03em;
  }

  .modal-foto-legenda {
    display: block;
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--verde-escuro);
    letter-spacing: 0.03em;
    margin: 1rem 0 0.4rem;
  }

  .modal-foto-real {
    width: 100%;
    max-height: 55vh;
    object-fit: contain;
    background: var(--creme-claro);
    border-radius: 10px;
    display: block;
  }

  .modal-video-real {
    width: 100%;
    max-height: 320px;
    border-radius: 10px;
    display: block;
    background: #000;
  }
</style>

<script>
  const TIPOS_AGARRA = [
    {
      id: 'regua', nome: 'Régua (edge)', formato: 'barra-fina', forca: 'baixo', cor: '#b5476b', tamanho: 62,
      foto: '/images/agarras/regua.jpg',
      descricao: 'Uma borda comprida e reta na parede, meio como uma prateleira. Diferente da réglete (que é bem fininha), a régua é mais larga e dá pra apoiar boa parte da mão, não só a ponta dos dedos.',
      comoUsar: 'Distribua a mão ao longo da borda, com os dedos dobrados por cima e o polegar ajudando a travar. Quanto mais reta e comprida, mais fácil de segurar — mas se ela inclinar pra fora, vira quase uma abaulada.',
    },
    {
      id: 'reglete', nome: 'Réglete', formato: 'barra-fina', forca: 'baixo', cor: '#da7326',
      video: '/videos/agarras/reglete.mp4',
      tamanho: 46,
      descricao: 'Uma borda fina e reta na parede. Só dá pra encostar a ponta dos dedos — não fecha a mão inteira nela.',
      comoUsar: 'Mantenha os dedos retos ou levemente dobrados e os cotovelos altos. Quanto mais fina a réglete, mais força vai pra ponta dos dedos — por isso ela cansa rápido.',
    },
    {
      id: 'abaulada', nome: 'Abaulada (sloper)', formato: 'bola', forca: 'baixo', cor: '#c9a24a',
      foto: '/images/agarras/abaulada.jpg', tamanho: 58,
      descricao: 'Uma bola ou curva lisa, sem nenhuma borda pra segurar — não existe "encaixe", você fica em cima dela só com atrito.',
      comoUsar: 'Abra a palma da mão inteira sobre a agarra e mantenha o corpo baixo e próximo da parede. Quanto mais peso for pra trás, mais fácil ela escorrega.',
    },
    {
      id: 'concha', nome: 'Concha (bom pegador)', formato: 'concha', forca: 'baixo', cor: '#668062',
      foto: '/images/agarras/concha.jpg', tamanho: 56,
      descricao: 'Uma agarra grande e funda, com um "buraco" onde a mão inteira entra e se apoia com conforto.',
      comoUsar: 'Feche a mão inteira por dentro da concha, como se estivesse segurando uma alça. É a agarra mais fácil de usar — ótima pra descansar no meio da via.',
    },
    {
      id: 'pinca', nome: 'Pinça', formato: 'pinca', forca: 'squeeze', cor: '#e0931c', tamanho: 46,
      foto: '/images/agarras/pinca.jpg',
      descricao: 'Uma agarra estreita que se aperta dos dois lados, com o polegar de um lado e os outros dedos do outro.',
      comoUsar: 'Aperte como numa pinça de roupa — a força vem do polegar espremendo contra os outros dedos, não de puxar pra baixo.',
    },
    {
      id: 'furo', nome: 'Furo (monodedo/bidedo)', formato: 'furo', forca: 'baixo', cor: '#5b4632', tamanho: 34,
      video: '/videos/agarras/furo.mp4',
      descricao: 'Um buraco pequeno na parede onde só cabe um ou dois dedos.',
      comoUsar: 'Encaixe só a ponta de um ou dois dedos, sem forçar o dedo esticado — e vá com calma: furos machucam tendão fácil se usados sem aquecer.',
    },
    {
      id: 'invertida', nome: 'Invertida', formato: 'invertida', forca: 'cima', cor: '#b5476b', tamanho: 50,
      descricao: 'Uma agarra virada de cabeça pra baixo — a abertura dela aponta pro chão, não pra cima.',
      comoUsar: 'Puxe de baixo pra cima, com a palma virada pro teto. Geralmente vem com um bom apoio de pé logo abaixo, porque o corpo tende a abrir pra fora.',
    },
    {
      id: 'lateral', nome: 'Lateral (side pull)', formato: 'lateral', forca: 'lateral-esquerda', cor: '#3b6e8f',
      foto: '/images/agarras/lateral.jpg', tamanho: 50,
      descricao: 'Uma agarra virada de lado, com a borda apontando pra direita ou esquerda em vez de pra cima.',
      comoUsar: 'Puxe na horizontal, na direção do seu corpo, girando o quadril pra parede em vez de ficar de frente. Puxar pra baixo nela quase não segura.',
    },
    {
      id: 'gaston', nome: 'Gastão', formato: 'gaston', forca: 'lateral-direita', cor: '#6b4a8a', tamanho: 50,
      descricao: 'Parecida com a lateral, só que ao contrário: você empurra a agarra pra longe do corpo em vez de puxar pra perto.',
      comoUsar: 'Cotovelo pra fora, tipo abrindo uma porta pesada. É um dos movimentos mais cansativos de segurar por muito tempo.',
    },
    {
      id: 'volume', nome: 'Volume', formato: 'volume', forca: 'baixo', cor: '#a9855a',
      foto: '/images/agarras/volume.jpg', tamanho: 74,
      descricao: 'Uma peça grande, geralmente lisa e sem pontos definidos — às vezes tem outras agarras menores parafusadas em cima dela.',
      comoUsar: 'Usa-se mais com o corpo inteiro do que com força de mão: apoie a palma ou o pé na superfície larga e jogue o peso a favor, em vez de tentar "agarrar" ela.',
    },
  ];

  const TIPOS_PAREDE = [
    { id: 'slab', nome: 'Slab', angulo: -18,
      foto: '/images/agarras/parede-slab.jpg',
      descricao: 'A parede é mais deitada que vertical — você fica meio "debruçado" sobre ela em vez de subir reto pra cima.',
      comoUsar: 'O equilíbrio e o atrito dos pés valem mais que a força de braço. Mantenha o peso sobre os pés e o corpo ereto, sem se agarrar com força nas mãos.' },
    { id: 'vertical', nome: 'Vertical', angulo: 0,
      foto: '/images/agarras/parede-vertical.jpg',
      descricao: 'A parede sobe reta, a 90 graus — é o ângulo mais comum nas vias de academia.',
      comoUsar: 'Equilíbrio entre força de braço e técnica de pé. Mantenha os braços esticados sempre que possível pra economizar energia.' },
    { id: 'teto', nome: 'Teto (overhang)', angulo: 22,
      video: '/videos/agarras/parede-teto.mp4',
      descricao: 'A parede se inclina na sua direção, deixando você praticamente pendurado em alguns trechos.',
      comoUsar: 'Aqui é força de braço e core (abdômen) que seguram o corpo — os pés servem mais pra empurrar do que pra apoiar peso.' },
  ];

  // posições em % (x,y) pra espalhar as agarras pela parede
  const POSICOES = [
    [12,10],[34,6],[58,12],[80,8],[22,24],[46,26],[68,22],[88,28],
    [10,40],[30,42],[52,40],[74,44],[90,50],[16,58],[38,58],[60,60],
    [82,62],[24,74],[46,76],[68,74],[86,80],[14,88],[36,90],[58,88],
    [78,90],[50,52],[62,32],
  ];

  const CORES_PAREDE = ['#da7326', '#e0931c', '#668062', '#c9a24a', '#b5476b', '#3b6e8f', '#6b4a8a', '#a9855a', '#5b4632'];

  function anguloForca(forca) {
    switch (forca) {
      case 'cima': return 0;
      case 'baixo': return 180;
      case 'lateral-esquerda': return 270;
      case 'lateral-direita': return 90;
      default: return 180;
    }
  }

  function montarParede() {
    const parede = document.getElementById('parede');
    POSICOES.forEach(([x, y], i) => {
      const tipo = TIPOS_AGARRA[i % TIPOS_AGARRA.length];
      const cor = CORES_PAREDE[(i * 5) % CORES_PAREDE.length];
      const btn = document.createElement('button');
      btn.className = 'agarra-btn';
      btn.style.left = x + '%';
      btn.style.top = y + '%';
      btn.style.width = tipo.tamanho + 'px';
      btn.style.height = tipo.tamanho + 'px';
      btn.style.color = cor;
      btn.setAttribute('aria-label', tipo.nome);
      btn.innerHTML = `<svg viewBox="0 0 100 100"><use href="#f-${tipo.formato}"></use></svg>`;
      btn.addEventListener('click', () => abrirModalAgarra(tipo));
      parede.appendChild(btn);
    });
  }

  function montarLegenda() {
    const legenda = document.getElementById('legenda');
    const emOrdem = [...TIPOS_AGARRA].sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
    emOrdem.forEach((tipo) => {
      const item = document.createElement('button');
      item.className = 'legenda-item';
      item.innerHTML = `
        <svg class="legenda-icone" viewBox="0 0 100 100" style="color:${tipo.cor}">
          <use href="#f-${tipo.formato}"></use>
        </svg>
        <span class="legenda-nome">${tipo.nome}</span>
      `;
      item.addEventListener('click', () => abrirModalAgarra(tipo));
      legenda.appendChild(item);
    });
  }

  function montarTiposParede() {
    const wrap = document.getElementById('parede-tipos');
    TIPOS_PAREDE.forEach((tipo) => {
      const card = document.createElement('button');
      card.className = 'parede-tipo-card';
      card.innerHTML = `
        <svg viewBox="0 0 100 60">
          <line x1="10" y1="55" x2="90" y2="55" stroke="#2a1f16" stroke-width="3" opacity="0.3" />
          <g transform="rotate(${tipo.angulo}, 30, 55)">
            <line x1="30" y1="55" x2="30" y2="5" stroke="#3d5439" stroke-width="6" stroke-linecap="round" />
            <circle cx="30" cy="5" r="6" fill="#da7326" />
          </g>
        </svg>
        <span class="nome">${tipo.nome}</span>
        <p>${tipo.descricao}</p>
      `;
      card.addEventListener('click', () => abrirModalParede(tipo));
      wrap.appendChild(card);
    });
  }

  function iconeComForca(tipo) {
    if (tipo.forca === 'squeeze') {
      return `
        <svg viewBox="0 0 160 100">
          <g transform="translate(30,50)"><use href="#f-${tipo.formato}" width="40" height="40" x="-20" y="-40" style="color:${tipo.cor}"></use></g>
          <g transform="translate(10,10) rotate(90)"><use href="#seta" width="30" height="30" style="color:#3d5439"></use></g>
          <g transform="translate(115,60) rotate(270)"><use href="#seta" width="30" height="30" style="color:#3d5439"></use></g>
        </svg>`;
    }
    const rot = anguloForca(tipo.forca);
    return `
      <svg viewBox="0 0 100 100">
        <use href="#f-${tipo.formato}" style="color:${tipo.cor}"></use>
      </svg>
      <svg viewBox="0 0 100 100" style="position:absolute;">
        <g transform="rotate(${rot},50,50)"><use href="#seta" width="34" height="34" x="33" y="33" style="color:#3d543999"></use></g>
      </svg>`;
  }

  function abrirModalAgarra(tipo) {
    document.getElementById('modal-icone').innerHTML = `<div style="position:relative;width:140px;height:140px;">${iconeComForca(tipo)}</div>`;
    document.getElementById('modal-titulo').textContent = tipo.nome;
    document.getElementById('modal-descricao').textContent = tipo.descricao;
    document.getElementById('modal-como-usar').textContent = tipo.comoUsar;

    const fotoArea = document.getElementById('modal-foto-area');
    if (tipo.video) {
      fotoArea.innerHTML = `
        <span class="modal-foto-legenda">Vídeo real usando essa agarra</span>
        <video class="modal-video-real" src="${tipo.video}" controls playsinline muted loop></video>
      `;
    } else if (tipo.foto) {
      fotoArea.innerHTML = `
        <span class="modal-foto-legenda">Exemplo real desse tipo de agarra</span>
        <img class="modal-foto-real" src="${tipo.foto}" alt="Foto de uma agarra real do tipo ${tipo.nome}">
      `;
    } else {
      fotoArea.innerHTML = `<span class="modal-foto-legenda">Ainda sem foto real desse tipo — manda uma que eu adiciono</span>`;
    }

    document.getElementById('modal-overlay').hidden = false;
  }

  function abrirModalParede(tipo) {
    document.getElementById('modal-icone').innerHTML = `
      <svg viewBox="0 0 100 60" style="width:180px;height:110px;">
        <line x1="10" y1="55" x2="90" y2="55" stroke="#2a1f16" stroke-width="3" opacity="0.3" />
        <g transform="rotate(${tipo.angulo}, 30, 55)">
          <line x1="30" y1="55" x2="30" y2="5" stroke="#3d5439" stroke-width="6" stroke-linecap="round" />
          <circle cx="30" cy="5" r="6" fill="#da7326" />
        </g>
      </svg>`;
    document.getElementById('modal-titulo').textContent = tipo.nome;
    document.getElementById('modal-descricao').textContent = tipo.descricao;
    document.getElementById('modal-como-usar').textContent = tipo.comoUsar;

    const fotoArea = document.getElementById('modal-foto-area');
    if (tipo.video) {
      fotoArea.innerHTML = `
        <span class="modal-foto-legenda">Vídeo real desse tipo de parede</span>
        <video class="modal-video-real" src="${tipo.video}" controls playsinline muted loop></video>
      `;
    } else if (tipo.foto) {
      fotoArea.innerHTML = `
        <span class="modal-foto-legenda">Exemplo real desse tipo de parede</span>
        <img class="modal-foto-real" src="${tipo.foto}" alt="Foto de uma parede real do tipo ${tipo.nome}">
      `;
    } else {
      fotoArea.innerHTML = `<span class="modal-foto-legenda">Ainda sem foto ou vídeo real desse tipo — manda um que eu adiciono</span>`;
    }

    document.getElementById('modal-overlay').hidden = false;
  }

  document.getElementById('modal-fechar').addEventListener('click', () => {
    document.getElementById('modal-overlay').hidden = true;
  });
  document.getElementById('modal-overlay').addEventListener('click', (e) => {
    if (e.target.id === 'modal-overlay') document.getElementById('modal-overlay').hidden = true;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.getElementById('modal-overlay').hidden = true;
  });

  montarParede();
  montarLegenda();
  montarTiposParede();
</script>
