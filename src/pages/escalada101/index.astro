---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import type { Artigo } from '../../lib/supabase';
const { data: artigos } = await supabase
  .from('artigos')
  .select('*')
  .eq('categoria', 'escalada101')
  .order('publicado_em', { ascending: true }) as { data: Artigo[] | null };
// A página de equipamentos, a de vocabulário e a de tipos de agarras são
// interativas (código próprio), então não vêm do banco — são sempre
// incluídas manualmente no fim da lista.
const itemVocabulario = {
  titulo: 'Vocabulário de Escalada',
  resumo: 'Gírias, termos e expressões que todo escalador ouve na parede — do "flash" ao "vacou".',
  href: '/escalada101/vocabulario',
};
const itemAgarras = {
  titulo: 'Tipos de Agarras',
  resumo: 'Réglete, pinça, concha, gastão e mais — descubra o formato de cada agarra e como usar cada uma.',
  href: '/escalada101/tipos-de-agarras',
};
const itemEquipamentos = {
  titulo: 'Equipamentos para Cada Modalidade',
  resumo: 'O que é essencial, o que dá pra alugar e o que só faz sentido comprar depois — boulder, esportiva, trad e mais.',
  href: '/escalada101/equipamentos',
};
const itensExtras = [itemVocabulario, itemAgarras, itemEquipamentos];

// Junta os artigos vindos do Supabase com os itens fixos (vocabulário,
// agarras, equipamentos) numa lista só, pra numerar e desenhar tudo de uma vez.
const listaArtigos = (artigos ?? []).map((artigo) => ({
  titulo: artigo.titulo,
  resumo: artigo.resumo,
  href: `/escalada101/${artigo.slug}`,
}));
const todosItens = [...listaArtigos, ...itensExtras];

// Escolhe qual ilustração animada mostrar pra cada item, com base no título.
// Se um dia entrar um artigo novo no Supabase que não bate com nenhuma
// palavra-chave, ele cai no ícone "padrao" (uma bandeirinha) em vez de
// quebrar a página.
function getIconeChave(titulo: string) {
  const t = titulo.toLowerCase();
  if (t.includes('tipos de escalada')) return 'montanha';
  if (t.includes('gradua')) return 'grau';
  if (t.includes('vocabul')) return 'vocab';
  if (t.includes('agarra')) return 'volume';
  if (t.includes('equipamento')) return 'capacete';
  return 'padrao';
}
---
<Layout titulo="Escalada 101" descricao="O básico que todo escalador precisa saber: tipos de escalada, graduação de vias e equipamentos, num só lugar.">
  <section class="pagina-hero">
    <div class="pagina-hero__contorno" aria-hidden="true"></div>
    <div class="container pagina-hero__conteudo">
      <span class="eyebrow">Comece por aqui</span>
      <h1>Escalada 101</h1>
      <p class="lead">O básico que todo escalador precisa saber, sem enrolação. Reunimos aqui os fundamentos — de modalidades a equipamento — pra quem tá chegando agora.</p>
    </div>
  </section>
  <section class="secao">
    <div class="container">
      <div class="lista-artigos">
        {todosItens.map((item, i) => {
          const chave = getIconeChave(item.titulo);
          return (
            <a class="artigo-item" href={item.href}>
              <span class="artigo-item__numero">{String(i + 1).padStart(2, '0')}</span>
              <span class="artigo-item__icone">
                {chave === 'montanha' && (
                  <svg class="icone-montanha" viewBox="0 0 40 40">
                    <polygon points="4,32 16,12 24,24 30,16 37,32" fill="#668062" />
                    <circle class="ponto-escalador" cx="20" cy="20" r="3" fill="#da7326" />
                  </svg>
                )}
                {chave === 'grau' && (
                  <svg class="icone-grau" viewBox="0 0 40 40">
                    <rect x="8" y="18" width="6" height="16" rx="1.5" fill="#e0931c" />
                    <rect x="17" y="10" width="6" height="24" rx="1.5" fill="#668062" />
                    <rect x="26" y="22" width="6" height="12" rx="1.5" fill="#da7326" />
                  </svg>
                )}
                {chave === 'vocab' && (
                  <svg class="icone-vocab" viewBox="0 0 40 40">
                    <path d="M6 10 h28 a3 3 0 0 1 3 3 v11 a3 3 0 0 1 -3 3 h-16 l-7 6 v-6 h-5 a3 3 0 0 1 -3 -3 v-11 a3 3 0 0 1 3 -3 z" fill="#3d5439" />
                    <circle cx="15" cy="19" r="2" fill="#f0e2b2" />
                    <circle cx="20" cy="19" r="2" fill="#f0e2b2" />
                    <circle cx="25" cy="19" r="2" fill="#f0e2b2" />
                  </svg>
                )}
                {chave === 'volume' && (
                  <svg class="icone-volume" viewBox="0 0 40 40">
                    <defs>
                      <clipPath id={`frenteVolume-${i}`}>
                        <polygon points="20,8 8,32 26,32" />
                      </clipPath>
                    </defs>
                    <polygon points="20,8 28,12 34,28 26,32" fill="#a85a1c" />
                    <polygon points="20,8 8,32 26,32" fill="#e0931c" />
                    <circle cx="20" cy="26" r="1.4" fill="#3d5439" />
                    <rect class="brilho-volume" x="4" y="6" width="9" height="30" fill="#ffffff" opacity="0.4" clip-path={`url(#frenteVolume-${i})`} />
                  </svg>
                )}
                {chave === 'capacete' && (
                  <svg class="icone-capacete" viewBox="0 0 40 40">
                    <path d="M6 27 C6 15, 34 15, 34 27 Z" fill="#e0931c" />
                    <path d="M4 27 C4 25, 36 25, 36 27 L34 29 C24 31, 16 31, 6 29 Z" fill="#3d5439" />
                    <rect x="13" y="16" width="3" height="6" rx="1.2" fill="#c9752c" />
                    <rect x="24" y="16" width="3" height="6" rx="1.2" fill="#c9752c" />
                    <path d="M10 27 C9 30, 9 33, 11 34" fill="none" stroke="#2a1f16" stroke-width="1.6" stroke-linecap="round" />
                    <path d="M30 27 C31 30, 31 33, 29 34" fill="none" stroke="#2a1f16" stroke-width="1.6" stroke-linecap="round" />
                  </svg>
                )}
                {chave === 'padrao' && (
                  <svg class="icone-padrao" viewBox="0 0 40 40">
                    <line x1="14" y1="8" x2="14" y2="32" stroke="#5c4a30" stroke-width="2.5" stroke-linecap="round" />
                    <polygon class="bandeira-padrao" points="14,9 30,14 14,19" fill="#668062" />
                  </svg>
                )}
              </span>
              <span class="artigo-item__corpo">
                <h3>{item.titulo}</h3>
                <p>{item.resumo}</p>
              </span>
              <span class="etiqueta">Disponível</span>
              <span class="artigo-item__seta">→</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<style>
  .artigo-item__icone {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--creme-claro);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 1rem;
  }

  .artigo-item__icone svg {
    width: 32px;
    height: 32px;
    overflow: visible;
  }

  /* ---- Tipos de Escalada: montanha com climbeiro subindo ---- */
  .icone-montanha .ponto-escalador {
    animation: subir-montanha 3s ease-in-out infinite;
  }
  @keyframes subir-montanha {
    0%   { transform: translate(-9px, 7px); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(6px, -9px); opacity: 0; }
  }

  /* ---- Graduação: barrinhas crescendo ---- */
  .icone-grau rect {
    transform-box: fill-box;
    transform-origin: bottom center;
    animation: crescer 1.8s ease-in-out infinite;
  }
  .icone-grau rect:nth-child(1) { animation-delay: 0s; }
  .icone-grau rect:nth-child(2) { animation-delay: 0.2s; }
  .icone-grau rect:nth-child(3) { animation-delay: 0.4s; }
  @keyframes crescer {
    0%, 100% { transform: scaleY(0.55); }
    50% { transform: scaleY(1); }
  }

  /* ---- Vocabulário: balão de fala com "..." piscando ---- */
  .icone-vocab circle {
    animation: piscar-ponto 1.4s ease-in-out infinite;
  }
  .icone-vocab circle:nth-child(2) { animation-delay: 0.2s; }
  .icone-vocab circle:nth-child(3) { animation-delay: 0.4s; }
  @keyframes piscar-ponto {
    0%, 100% { opacity: 0.25; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-2px); }
  }

  /* ---- Tipos de Agarras: volume triangular com brilho na face da frente ---- */
  .icone-volume .brilho-volume {
    animation: brilho-varrer 2.6s ease-in-out infinite;
  }
  @keyframes brilho-varrer {
    0% { transform: translateX(-4px); opacity: 0; }
    15% { opacity: 0.55; }
    50% { transform: translateX(20px); opacity: 0.55; }
    70% { opacity: 0; }
    100% { transform: translateX(20px); opacity: 0; }
  }

  /* ---- Equipamentos: capacete balançando ---- */
  .icone-capacete {
    animation: balancar-capacete 2.4s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: bottom center;
  }
  @keyframes balancar-capacete {
    0%, 100% { transform: rotate(-5deg); }
    50% { transform: rotate(5deg); }
  }

  /* ---- Ícone padrão (pra artigos novos que não batem com nenhuma palavra-chave) ---- */
  .icone-padrao .bandeira-padrao {
    transform-box: fill-box;
    transform-origin: 0px 0px;
    animation: bandeira-padrao-ondular 2.2s ease-in-out infinite;
  }
  @keyframes bandeira-padrao-ondular {
    0%, 100% { transform: skewY(0deg); }
    50% { transform: skewY(6deg); }
  }
</style>
