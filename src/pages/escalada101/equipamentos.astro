// ---------------------------------------------------------------
// Modalidades: quais peças aparecem em cada uma
// ---------------------------------------------------------------
const MODALIDADES = {
  boulder: {
    label: "Boulder",
    blurb: "Sem corda, sem cadeirinha. O kit mais simples de todos — quase dá pra escalar só de sapatilha.",
    itens: ["roupa", "sapatilha", "magnesio"],
  },
  academia: {
    label: "Academia (top rope)",
    blurb: "O primeiro contato com a corda, num ambiente controlado. Ideal pra aprender o sistema de segurança.",
    itens: ["sapatilha", "cadeirinha", "corda", "freio", "magnesio"],
  },
  esportiva: {
    label: "Esportiva",
    blurb: "O kit completo da escalada guiada ao ar livre — as proteções já estão fixadas na rocha, você só clipa a corda.",
    itens: ["capacete", "cadeirinha", "corda", "freio", "costuras", "fitaSolteira", "sapatilha", "magnesio"],
  },
  trad: {
    label: "Tradicional",
    blurb: "Tudo da esportiva, mais o material que você mesmo posiciona (e depois retira) da rocha.",
    itens: ["capacete", "cadeirinha", "corda", "freio", "nuts", "fitaDupla", "sapatilha", "magnesio", "walkie"],
  },
  viaferrata: {
    label: "Via Ferrata",
    blurb: "Kit enxuto: você já anda praticamente seguro pelo cabo de aço o tempo todo.",
    itens: ["capacete", "cadeirinha", "longe", "luvas"],
  },
  alpinismo: {
    label: "Alpinismo",
    blurb: "Mais logística e autonomia. O equipamento de segurança soma-se ao de sobrevivência na montanha.",
    itens: ["capacete", "cadeirinha", "corda", "mochila", "piolet", "luvas"],
  },
};

const svgNS = "http://www.w3.org/2000/svg";
const gearLayer = document.getElementById("gear-layer");
const infoPainel = document.getElementById("info-painel");
const tabsEl = document.getElementById("tabs");
const blurbEl = document.getElementById("blurb");
const checklistEl = document.getElementById("checklist");
const camisaGrupo = document.getElementById("camisa-grupo");
const camisaPulso = document.getElementById("camisa-pulso");
camisaGrupo.dataset.gear = "roupa";

function mostrarInfo(gearId){
  const g = GEAR[gearId];
  const foto = g.img ? `<img class="info-painel__foto" src="${g.img}" alt="Foto real: ${g.nome}" loading="lazy">` : "";
  infoPainel.innerHTML = `<div class="info-painel__corpo">${foto}<div class="info-painel__texto"><h3 class="info-painel__nome">${g.nome}</h3><p class="info-painel__desc">${g.desc}</p></div></div>`;
  document.querySelectorAll(".gear-item").forEach(el => el.classList.toggle("ativo", el.dataset.gear === gearId));
}

camisaGrupo.addEventListener("click", () => { if (camisaGrupo.classList.contains("gear-item")) mostrarInfo("roupa"); });
camisaGrupo.addEventListener("keydown", (e) => {
  if ((e.key === "Enter" || e.key === " ") && camisaGrupo.classList.contains("gear-item")) { e.preventDefault(); mostrarInfo("roupa"); }
});

function renderModalidade(key){
  const mod = MODALIDADES[key];

  // tabs
  tabsEl.querySelectorAll(".modalidade-tab").forEach(btn => {
    btn.classList.toggle("ativa", btn.dataset.mod === key);
    btn.setAttribute("aria-selected", btn.dataset.mod === key ? "true" : "false");
  });

  blurbEl.textContent = mod.blurb;

  // reset painel
  infoPainel.innerHTML = `<p class="info-painel__prompt">Clique em qualquer item do equipamento pra saber o que é.</p>`;

  // camiseta clicável (só quando "roupa" faz parte do kit da modalidade)
  const roupaAtiva = mod.itens.includes("roupa");
  camisaGrupo.classList.toggle("gear-item", roupaAtiva);
  camisaGrupo.classList.remove("ativo");
  camisaGrupo.setAttribute("tabindex", roupaAtiva ? "0" : "-1");
  camisaGrupo.setAttribute("role", roupaAtiva ? "button" : "presentation");
  camisaPulso.style.display = roupaAtiva ? "" : "none";

  // gear no boneco
  gearLayer.innerHTML = "";
  mod.itens.forEach(id => {
    if (id === "roupa") return;
    const item = GEAR[id];
    const posicoes = item.pos || [{x: item.x, y: item.y}];

    posicoes.forEach(p => {
      const g = document.createElementNS(svgNS, "g");
      g.setAttribute("class", "gear-item");
      g.setAttribute("tabindex", "0");
      g.setAttribute("role", "button");
      g.setAttribute("aria-label", item.nome);
      g.dataset.gear = id;

      const pulso = document.createElementNS(svgNS, "circle");
      pulso.setAttribute("class", "gear-pulso");
      pulso.setAttribute("cx", p.x);
      pulso.setAttribute("cy", p.y);
      pulso.setAttribute("r", "16");
      g.appendChild(pulso);

      const posWrap = document.createElementNS(svgNS, "g");
      posWrap.setAttribute("transform", `translate(${p.x},${p.y})`);
      const grupo = document.createElementNS(svgNS, "g");
      grupo.setAttribute("class", "gear-grupo");
      grupo.innerHTML = FORMAS[id];
      posWrap.appendChild(grupo);
      g.appendChild(posWrap);

      const alvo = document.createElementNS(svgNS, "circle");
      alvo.setAttribute("class", "gear-alvo");
      alvo.setAttribute("cx", p.x);
      alvo.setAttribute("cy", p.y);
      alvo.setAttribute("r", "26");
      g.appendChild(alvo);

      g.addEventListener("click", () => mostrarInfo(id));
      g.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); mostrarInfo(id); } });

      gearLayer.appendChild(g);
    });
  });

  // checklist
  checklistEl.innerHTML = mod.itens.map(id => {
    const item = GEAR[id];
    return `<li><strong>${item.nome}</strong>${item.desc}</li>`;
  }).join("");
}

// monta as abas
Object.keys(MODALIDADES).forEach((key, i) => {
  const btn = document.createElement("button");
  btn.type = "button";
  btn.className = "modalidade-tab";
  btn.textContent = MODALIDADES[key].label;
  btn.dataset.mod = key;
  btn.setAttribute("role", "tab");
  btn.addEventListener("click", () => renderModalidade(key));
  tabsEl.appendChild(btn);
});

renderModalidade("boulder");

</script>
