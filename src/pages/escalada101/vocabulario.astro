---
// src/pages/escalada101/vocabulario.astro
//
// Página de flashcards com gírias e termos de escalada.
// Assim como a página de equipamentos, o conteúdo aqui é fixo no código
// (não vem do Supabase) — pra adicionar, editar ou remover uma palavra,
// mexa na lista "termos" logo abaixo. Cada item é um objeto com:
//   termo      -> a palavra ou expressão (frente do card)
//   definicao  -> a explicação (verso do card)
//   categoria  -> 'estilo' | 'seguranca' | 'giria'  (só muda a cor da etiqueta)
//
// Pra adicionar uma palavra nova, copie um bloco { ... } inteiro,
// cole antes do "];" e preencha os campos. Não precisa mexer em mais nada.

import Layout from '../../layouts/Layout.astro';

const termos = [
  {
    termo: 'Flash',
    definicao:
      'Subir a via inteira, limpo, na primeira tentativa — mas depois de já ter recebido alguma dica (beta) sobre os movimentos antes de tentar.',
    categoria: 'estilo',
  },
  {
    termo: 'À vista',
    definicao:
      'Subir a via inteira, limpo, na primeira tentativa e sem nenhuma informação prévia: sem beta, sem ver ninguém escalando antes.',
    categoria: 'estilo',
  },
  {
    termo: 'Cadena',
    definicao:
      'Subir a via do início ao fim sem cair e sem descansar pendurado na corda — não importa se foi de primeira ou depois de várias tentativas treinando os movimentos.',
    categoria: 'estilo',
  },
  {
    termo: 'Mandar uma via',
    definicao:
      'Completar a via com sucesso, escalando limpo do começo ao fim. Pode ser à vista, de flash ou de cadena — mandou é mandou.',
    categoria: 'estilo',
  },
  {
    termo: 'Projeto',
    definicao:
      'Via que você está tentando repetidas vezes, treinando os movimentos, até finalmente conseguir mandar ela de cadena. Enquanto isso, ela é "seu projeto".',
    categoria: 'estilo',
  },
  {
    termo: 'Malhar a via',
    definicao:
      'Tentar a mesma via várias vezes seguidas, repetindo e treinando cada lance até dominar os movimentos — geralmente é isso que se faz com um projeto antes de conseguir mandar ele de uma vez só.',
    categoria: 'estilo',
  },
  {
    termo: 'Dar corda',
    definicao:
      'Soltar corda pro escalador ter folga suficiente pra se mover ou clipar o próximo grampo, sem deixar sobrar corda demais.',
    categoria: 'seguranca',
  },
  {
    termo: 'Retesar',
    definicao:
      'O oposto de dar corda: puxar e recolher a sobra, deixando a corda mais firme. Quem está assegurando retesa quando o escalador para de subir, descansa ou pode cair.',
    categoria: 'seguranca',
  },
  {
    termo: 'Zela',
    definicao:
      'Pedido pra quem está assegurando prestar atenção total, sem folgar nem por um segundo — geralmente nos trechos mais perigosos da via ("zela aqui, o próximo grampo tá longe!").',
    categoria: 'seguranca',
  },
  {
    termo: 'Pega!',
    definicao:
      'Comando gritado quando o escalador quer parar e descansar pendurado na corda: o segurador retesa e sustenta o peso dele. No top rope pode ser usado a qualquer momento; na guiada, só depois de clipar a última costura.',
    categoria: 'seguranca',
  },
  {
    termo: 'Vacou',
    definicao:
      'Caiu da via. Vem de "tomar uma vaca" — quando o escalador perde o agarrão e despenca.',
    categoria: 'giria',
  },
  {
    termo: 'Veneno',
    definicao:
      'Trecho ou movimento muito difícil, doloroso ou traiçoeiro da via — geralmente o que decide se você manda ou vacou.',
    categoria: 'giria',
  },
  {
    termo: 'Crux',
    definicao:
      'O trecho mais difícil da via, que geralmente decide se você manda ou vacou — o termo técnico (do inglês) pra o que os climbeiros também chamam de "veneno".',
    categoria: 'giria',
  },
  {
    termo: 'Adrenante',
    definicao:
      'Aquele momento (ou via inteira) que faz o coração disparar de tão emocionante, geralmente por causa da exposição ou da dificuldade.',
    categoria: 'giria',
  },
  {
    termo: 'Beta',
    definicao:
      'Informação sobre como fazer os movimentos de uma via: onde estão os agarradores bons, a sequência certa, se tem algum truque. "Pedir beta" é perguntar antes de tentar; "dar beta" é ensinar pra quem vai tentar.',
    categoria: 'giria',
  },
  {
    termo: 'Kmon',
    definicao:
      'Gíria de incentivo (do inglês "come on") gritada pra quem está escalando, tipo "vai, você consegue!" — geralmente solta nos momentos mais difíceis da via.',
    categoria: 'giria',
  },
];

const corPorCategoria = {
  estilo: 'var(--laranja)',
  seguranca: 'var(--verde)',
  giria: 'var(--amarelo)',
};

const nomeCategoria = {
  estilo: 'Estilo de escalada',
  seguranca: 'Segurança',
  giria: 'Gíria',
};
---

<Layout title="Vocabulário de Escalada | Climbeiros">
  <section class="pagina-hero">
    <div class="pagina-hero__contorno" aria-hidden="true"></div>
    <div class="container pagina-hero__conteudo">
      <span class="eyebrow">Escalada 101</span>
      <h1>Vocabulário de Escalada</h1>
      <p class="lead">
        Flash, à vista, cadena, vacou... se você já ficou perdido ouvindo os
        climbeiros mais experientes falando essas palavras, essa página é pra
        você. Clique em cada card pra virar e ver a explicação.
      </p>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <div class="vocab-toolbar">
        <button type="button" id="btn-embaralhar" class="botao botao--secundario">
          Embaralhar
        </button>
        <p id="vocab-contador" class="vocab-contador"></p>
      </div>

      <div class="vocab-grade" id="vocab-grade">
        {termos.map((item, i) => (
          <button
            type="button"
            class="flashcard"
            data-index={i}
            aria-label={`Card: ${item.termo}. Clique para ver a definição.`}
          >
            <div class="flashcard-interno">
              <div class="flashcard-frente">
                <span
                  class="etiqueta"
                  style={`background:${corPorCategoria[item.categoria]}; color:#ffffff; font-weight:600;`}
                >
                  {nomeCategoria[item.categoria]}
                </span>
                <p class="flashcard-termo">{item.termo}</p>
                <p class="flashcard-dica">clique pra virar</p>
              </div>
              <div class="flashcard-verso">
                <p class="flashcard-definicao">{item.definicao}</p>
              </div>
            </div>
          </button>
        ))}
      </div>

      <p class="vocab-rodape-texto">
        Tem uma gíria da sua academia ou do seu grupo que não tá aqui? Manda
        pra gente que a gente adiciona.
      </p>

      <a href="/escalada101" class="botao">Voltar pra Escalada 101</a>
    </div>
  </section>

  <section class="secao secao--creme">
    <div class="container">
      <h2 class="titulo-secao">Teste seu conhecimento</h2>

      <div id="quiz-inicio" class="quiz-inicio">
        <p>
          Quer ver se você manda no vocabulário de escalada? Responda um quiz
          rápido de múltipla escolha pra descobrir.
        </p>
        <button type="button" id="btn-iniciar-quiz" class="botao">Começar quiz</button>
      </div>

      <div id="quiz-jogo" class="quiz-caixa" hidden>
        <p class="quiz-progresso" id="quiz-progresso"></p>
        <p class="quiz-pergunta" id="quiz-pergunta"></p>
        <div class="quiz-opcoes" id="quiz-opcoes"></div>
        <button type="button" id="btn-proxima" class="botao botao--secundario" hidden>Próxima</button>
      </div>

      <div id="quiz-resultado" class="quiz-resultado" hidden>
        <div class="cena-wrap" id="cena-comemoracao" hidden>
          <svg viewBox="0 0 300 210" preserveAspectRatio="xMidYMid slice">
            <defs>
              <linearGradient id="ceu" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#f7e3ad" />
                <stop offset="55%" stop-color="#f0e2b2" />
                <stop offset="100%" stop-color="#e7d18e" />
              </linearGradient>
              <linearGradient id="parede" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#dcc588" />
                <stop offset="100%" stop-color="#c9ae6c" />
              </linearGradient>
            </defs>

            <rect x="0" y="0" width="300" height="210" fill="url(#ceu)" />

            <g class="raio" opacity="0.5">
              <g stroke="#e0931c" stroke-width="2" stroke-linecap="round">
                <line x1="150" y1="8" x2="150" y2="0" />
                <line x1="150" y1="60" x2="150" y2="52" />
                <line x1="124" y1="30" x2="118" y2="30" />
                <line x1="182" y1="30" x2="176" y2="30" />
                <line x1="132" y1="12" x2="128" y2="8" />
                <line x1="168" y1="12" x2="172" y2="8" />
                <line x1="132" y1="48" x2="128" y2="52" />
                <line x1="168" y1="48" x2="172" y2="52" />
              </g>
            </g>
            <circle cx="150" cy="30" r="14" fill="#e0931c" opacity="0.85" />

            <g class="nuvem" opacity="0.75">
              <ellipse cx="40" cy="26" rx="16" ry="7" fill="#ffffff" />
              <ellipse cx="52" cy="22" rx="12" ry="6" fill="#ffffff" />
            </g>
            <g class="nuvem n2" opacity="0.6">
              <ellipse cx="10" cy="48" rx="13" ry="6" fill="#ffffff" />
              <ellipse cx="20" cy="45" rx="9" ry="5" fill="#ffffff" />
            </g>

            <polygon points="0,95 60,45 110,95" fill="#8fa383" opacity="0.55" />
            <polygon points="70,95 140,35 210,95" fill="#7c9271" opacity="0.6" />
            <polygon points="170,95 240,50 300,95" fill="#8fa383" opacity="0.5" />

            <path d="M 0 210 L 0 130 C 60 150, 90 90, 150 100 C 200 108, 230 60, 300 70 L 300 210 Z" fill="url(#parede)" />
            <path d="M 0 210 L 0 130 C 60 150, 90 90, 150 100 C 200 108, 230 60, 300 70 L 300 210 Z" fill="none" stroke="#b99c5c" stroke-width="1" opacity="0.4" />

            <g fill="#b99c5c" opacity="0.25">
              <circle cx="30" cy="180" r="2" /><circle cx="90" cy="165" r="1.6" />
              <circle cx="140" cy="150" r="2" /><circle cx="200" cy="120" r="1.6" />
              <circle cx="250" cy="100" r="2" /><circle cx="60" cy="140" r="1.4" />
              <circle cx="170" cy="130" r="1.8" /><circle cx="230" cy="90" r="1.6" />
            </g>

            <g>
              <ellipse cx="44" cy="196" rx="9" ry="6" fill="#da7326" transform="rotate(-15 44 196)" />
              <ellipse cx="74" cy="154" rx="8" ry="5.5" fill="#e0931c" transform="rotate(20 74 154)" />
              <ellipse cx="62" cy="108" rx="8" ry="5.5" fill="#668062" transform="rotate(-10 62 108)" />
              <ellipse cx="108" cy="88" rx="8.5" ry="5.5" fill="#e7d18e" transform="rotate(12 108 88)" />
              <ellipse cx="150" cy="58" rx="8" ry="5.5" fill="#da7326" transform="rotate(-18 150 58)" />
              <ellipse cx="196" cy="34" rx="8.5" ry="5.5" fill="#e0931c" transform="rotate(8 196 34)" />
            </g>

            <circle id="poof1" class="poof" cx="44" cy="196" r="10" fill="#ffffff" />
            <circle id="poof2" class="poof" cx="74" cy="154" r="10" fill="#ffffff" />
            <circle id="poof3" class="poof" cx="62" cy="108" r="10" fill="#ffffff" />
            <circle id="poof4" class="poof" cx="108" cy="88" r="10" fill="#ffffff" />
            <circle id="poof5" class="poof" cx="150" cy="58" r="10" fill="#ffffff" />
            <circle id="poof6" class="poof" cx="196" cy="34" r="10" fill="#ffffff" />

            <g transform="translate(225,18)">
              <rect x="0" y="0" width="2" height="26" fill="#5c4a30" />
              <polygon class="bandeira" id="bandeira" points="2,2 20,7 2,12" fill="#3d5439" />
            </g>

            <g id="climber">
              <g id="climber-figura">
                <circle cx="0" cy="-14" r="4.2" fill="#2a1f16" />
                <line x1="0" y1="-10" x2="0" y2="-1" stroke="#3d5439" stroke-width="3" stroke-linecap="round" />
                <line x1="0" y1="-8" x2="-6" y2="-15" stroke="#3d5439" stroke-width="2.6" stroke-linecap="round" />
                <line x1="0" y1="-8" x2="6" y2="-16" stroke="#3d5439" stroke-width="2.6" stroke-linecap="round" />
                <line x1="0" y1="-1" x2="-5" y2="6" stroke="#2a1f16" stroke-width="2.8" stroke-linecap="round" />
                <line x1="0" y1="-1" x2="5" y2="6" stroke="#2a1f16" stroke-width="2.8" stroke-linecap="round" />
              </g>
            </g>
          </svg>
        </div>
        <span class="selo-topou" id="selo-topou" hidden>Mandou tudo de cadena! 🧗</span>
        <p class="quiz-resultado-numero" id="quiz-resultado-numero"></p>
        <p id="quiz-resultado-texto"></p>
        <button type="button" id="btn-jogar-de-novo" class="botao">Jogar de novo</button>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .vocab-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .vocab-contador {
    font-family: 'Work Sans', sans-serif;
    color: var(--marrom);
    opacity: 0.7;
  }

  .vocab-grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .flashcard {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    perspective: 1200px;
    height: 220px;
    font-family: inherit;
    text-align: left;
  }

  .flashcard-interno {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.5s;
    transform-style: preserve-3d;
  }

  .flashcard.virada .flashcard-interno {
    transform: rotateY(180deg);
  }

  .flashcard-frente,
  .flashcard-verso {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 10px rgba(42, 31, 22, 0.15);
  }

  .flashcard-frente {
    background: var(--creme-claro);
    justify-content: space-between;
  }

  .flashcard-verso {
    background: var(--verde-escuro);
    color: white;
    transform: rotateY(180deg);
    justify-content: center;
  }

  .flashcard-termo {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    font-size: 1.4rem;
    color: var(--marrom);
    margin: 0.75rem 0 0;
  }

  .flashcard-dica {
    font-size: 0.8rem;
    opacity: 0.6;
    margin: 0;
  }

  .flashcard-definicao {
    margin: 0;
    line-height: 1.4;
  }

  .vocab-rodape-texto {
    margin-bottom: 1.5rem;
    opacity: 0.8;
  }

  /* ---------- Quiz ---------- */

  .titulo-secao {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    color: var(--verde-escuro);
    font-size: 1.4rem;
    margin: 0 0 1.25rem;
    text-align: center;
  }

  .quiz-inicio {
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
  }

  .quiz-resultado {
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
    background: white;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 10px rgba(42, 31, 22, 0.1);
    position: relative;
    overflow: hidden;
  }

  .quiz-inicio p,
  .quiz-resultado p {
    margin: 0 0 1.25rem;
  }

  .quiz-caixa {
    max-width: 560px;
    margin: 0 auto;
    background: white;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 10px rgba(42, 31, 22, 0.1);
  }

  .quiz-progresso {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--verde-escuro);
    opacity: 0.8;
    margin: 0 0 0.5rem;
  }

  .quiz-pergunta {
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    font-size: 1.5rem;
    color: var(--marrom);
    margin: 0 0 1.5rem;
  }

  .quiz-opcoes {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .quiz-opcao {
    background: var(--creme-claro);
    border: 2px solid transparent;
    border-radius: 10px;
    padding: 0.9rem 1.1rem;
    text-align: left;
    cursor: pointer;
    font-family: 'Work Sans', sans-serif;
    font-size: 0.95rem;
    color: var(--marrom);
    line-height: 1.4;
    transition: background 0.15s ease, border-color 0.15s ease,
      transform 0.15s ease, box-shadow 0.15s ease;
  }

  .quiz-opcao:hover:not(:disabled) {
    background: var(--creme);
    border-color: var(--laranja);
    color: var(--marrom);
    font-weight: 600;
    transform: translateY(-3px) scale(1.015);
    box-shadow: 0 6px 14px rgba(42, 31, 22, 0.25);
  }

  .quiz-opcao:disabled {
    cursor: default;
  }

  .quiz-opcao--correta {
    background: var(--verde);
    color: white;
  }

  .quiz-opcao--errada {
    background: #b5476b;
    color: white;
  }

  .quiz-opcao--selecionada {
    border-color: var(--marrom);
    box-shadow: 0 0 0 3px rgba(42, 31, 22, 0.2);
    transform: translateY(-2px);
  }

  .quiz-resultado-numero {
    font-family: 'Oswald', sans-serif;
    font-size: 2.5rem;
    color: var(--verde-escuro);
    margin: 0 0 0.5rem;
  }

  /* ---------- Comemoração (quando acerta todas as perguntas) ---------- */

  .cena-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 300 / 210;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 1.5rem;
    box-shadow: inset 0 0 0 1px rgba(42, 31, 22, 0.06);
  }

  .cena-wrap svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .selo-topou {
    display: inline-block;
    font-family: 'Oswald', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.95rem;
    color: white;
    background: var(--laranja);
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
    opacity: 0;
    transform: scale(0.4);
  }

  .selo-topou.mostrar {
    animation: pop-selo 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes pop-selo {
    0% { opacity: 0; transform: scale(0.4) rotate(-8deg); }
    60% { opacity: 1; transform: scale(1.15) rotate(3deg); }
    100% { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  .nuvem {
    animation: flutuar 26s linear infinite;
  }
  .nuvem.n2 {
    animation-duration: 34s;
    animation-delay: -10s;
  }
  @keyframes flutuar {
    from { transform: translateX(-40px); }
    to { transform: translateX(340px); }
  }

  .bandeira {
    transform-origin: 2px 2px;
    animation: bandeira-ondular 2.2s ease-in-out infinite;
  }
  @keyframes bandeira-ondular {
    0%, 100% { transform: skewY(0deg); }
    50% { transform: skewY(6deg); }
  }
  .bandeira.festejando {
    animation: bandeira-festa 0.5s ease-in-out 4;
  }
  @keyframes bandeira-festa {
    0%, 100% { transform: skewY(0deg) scale(1); }
    50% { transform: skewY(14deg) scale(1.06); }
  }

  #climber {
    offset-path: path("M 44 196 C 40 172, 78 176, 74 154 C 70 128, 56 122, 62 108 C 68 92, 104 104, 108 88 C 112 70, 146 76, 150 58 C 154 42, 190 50, 196 34");
    offset-distance: 0%;
    offset-rotate: 0deg;
  }

  #climber.subindo {
    animation: subir-trilha 3.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) forwards;
  }

  @keyframes subir-trilha {
    0% { offset-distance: 0%; }
    100% { offset-distance: 100%; }
  }

  #climber-figura {
    animation: balancar 0.5s ease-in-out infinite alternate;
  }
  @keyframes balancar {
    from { transform: rotate(-6deg); }
    to { transform: rotate(6deg); }
  }

  #climber.subindo #climber-figura {
    animation: escalar-membros 0.35s ease-in-out infinite alternate;
  }
  @keyframes escalar-membros {
    from { transform: rotate(-11deg) scale(1); }
    to { transform: rotate(9deg) scale(1.04); }
  }

  .poof {
    opacity: 0;
  }
  .poof.disparar {
    animation: poof-pop 0.55s ease-out forwards;
  }
  @keyframes poof-pop {
    0% { opacity: 0.9; transform: scale(0.2); }
    100% { opacity: 0; transform: scale(2.6); }
  }

  .confete {
    position: absolute;
    top: -10px;
    width: 7px;
    height: 12px;
    opacity: 0;
    border-radius: 2px;
    z-index: 3;
  }
  @keyframes cair {
    0% { transform: translateY(0) rotate(0deg); opacity: 1; }
    100% { transform: translateY(300px) rotate(560deg); opacity: 0; }
  }

  .raio {
    transform-origin: 150px 30px;
    animation: girar 40s linear infinite;
  }
  @keyframes girar {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

<script>
  const grade = document.getElementById('vocab-grade');
  const cards = Array.from(document.querySelectorAll('.flashcard'));
  const contador = document.getElementById('vocab-contador');
  const btnEmbaralhar = document.getElementById('btn-embaralhar');

  function atualizarContador() {
    const viradas = document.querySelectorAll('.flashcard.virada').length;
    if (contador) {
      contador.textContent = `${viradas} de ${cards.length} vistos`;
    }
  }

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      card.classList.toggle('virada');
      atualizarContador();
    });
  });

  btnEmbaralhar?.addEventListener('click', () => {
    if (!grade) return;
    const embaralhados = [...cards].sort(() => Math.random() - 0.5);
    embaralhados.forEach((card) => {
      card.classList.remove('virada');
      grade.appendChild(card);
    });
    atualizarContador();
  });

  atualizarContador();

  // ---------- Quiz ----------
  const TERMOS_QUIZ = cards.map((card) => ({
    termo: card.querySelector('.flashcard-termo')?.textContent.trim() ?? '',
    definicao: card.querySelector('.flashcard-definicao')?.textContent.trim() ?? '',
  }));

  const quizInicio = document.getElementById('quiz-inicio');
  const quizJogo = document.getElementById('quiz-jogo');
  const quizResultado = document.getElementById('quiz-resultado');
  const quizProgresso = document.getElementById('quiz-progresso');
  const quizPerguntaEl = document.getElementById('quiz-pergunta');
  const quizOpcoesEl = document.getElementById('quiz-opcoes');
  const btnIniciarQuiz = document.getElementById('btn-iniciar-quiz');
  const btnProxima = document.getElementById('btn-proxima');
  const btnJogarDeNovo = document.getElementById('btn-jogar-de-novo');
  const quizResultadoNumero = document.getElementById('quiz-resultado-numero');
  const quizResultadoTexto = document.getElementById('quiz-resultado-texto');
  const cenaComemoracao = document.getElementById('cena-comemoracao');
  const seloTopou = document.getElementById('selo-topou');
  const climberEl = document.getElementById('climber');
  const bandeiraEl = document.getElementById('bandeira');

  const TOTAL_PERGUNTAS_QUIZ = Math.min(5, TERMOS_QUIZ.length);

  let quizPerguntas = [];
  let quizIndiceAtual = 0;
  let quizAcertos = 0;

  function embaralharArray(lista) {
    return [...lista].sort(() => Math.random() - 0.5);
  }

  function montarOpcoes(perguntaAtual) {
    const distratores = embaralharArray(
      TERMOS_QUIZ.filter((t) => t.termo !== perguntaAtual.termo)
    ).slice(0, 3);
    return embaralharArray([perguntaAtual, ...distratores]);
  }

  function mostrarPergunta() {
    const perguntaAtual = quizPerguntas[quizIndiceAtual];
    const opcoes = montarOpcoes(perguntaAtual);

    quizProgresso.textContent = `Pergunta ${quizIndiceAtual + 1} de ${quizPerguntas.length}`;
    quizPerguntaEl.textContent = `O que significa "${perguntaAtual.termo}"?`;
    quizOpcoesEl.innerHTML = '';
    btnProxima.hidden = true;

    opcoes.forEach((opcao) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'quiz-opcao';
      btn.textContent = opcao.definicao;
      btn.dataset.termo = opcao.termo;
      btn.addEventListener('click', () => {
        const acertou = opcao.termo === perguntaAtual.termo;
        if (acertou) quizAcertos++;
        btn.classList.add('quiz-opcao--selecionada');
        Array.from(quizOpcoesEl.children).forEach((el) => {
          el.disabled = true;
          if (el.dataset.termo === perguntaAtual.termo) {
            el.classList.add('quiz-opcao--correta');
          } else if (el === btn) {
            el.classList.add('quiz-opcao--errada');
          }
        });
        btnProxima.hidden = false;
      });
      quizOpcoesEl.appendChild(btn);
    });
  }

  // ---------- Comemoração (quando acerta todas as perguntas) ----------
  const CORES_CONFETE = ['#668062', '#da7326', '#e0931c', '#e7d18e', '#3d5439'];
  const DURACAO_ESCALADA_MS = 3200;
  const PONTOS_GIZ = [1, 2, 3, 4, 5, 6];

  function resetarComemoracao() {
    if (!cenaComemoracao) return;
    cenaComemoracao.hidden = true;
    seloTopou.hidden = true;
    seloTopou.classList.remove('mostrar');
    climberEl.classList.remove('subindo');
    bandeiraEl.classList.remove('festejando');
    PONTOS_GIZ.forEach((ponto) => {
      const el = document.getElementById('poof' + ponto);
      if (el) el.classList.remove('disparar');
    });
    quizResultado.querySelectorAll('.confete').forEach((c) => c.remove());
  }

  function dispararGiz(indice) {
    const el = document.getElementById('poof' + indice);
    if (!el) return;
    el.classList.remove('disparar');
    void el.getBBox();
    el.classList.add('disparar');
  }

  function confettiComemoracao() {
    for (let i = 0; i < 46; i++) {
      const c = document.createElement('div');
      c.className = 'confete';
      c.style.left = Math.random() * 100 + '%';
      c.style.background = CORES_CONFETE[Math.floor(Math.random() * CORES_CONFETE.length)];
      c.style.animation = `cair ${0.9 + Math.random() * 0.8}s ease-in forwards`;
      c.style.animationDelay = (Math.random() * 0.3) + 's';
      quizResultado.appendChild(c);
      setTimeout(() => c.remove(), 2000);
    }
  }

  function tocarAnimacaoComemoracao() {
    cenaComemoracao.hidden = false;
    seloTopou.hidden = false;
    void climberEl.getBBox();
    climberEl.classList.add('subindo');

    PONTOS_GIZ.forEach((ponto, i) => {
      const atraso = (DURACAO_ESCALADA_MS / PONTOS_GIZ.length) * (i + 1) - 150;
      setTimeout(() => dispararGiz(ponto), atraso);
    });

    setTimeout(() => {
      bandeiraEl.classList.add('festejando');
      seloTopou.classList.add('mostrar');
      confettiComemoracao();
    }, DURACAO_ESCALADA_MS - 150);
  }

  function mostrarResultado() {
    quizJogo.hidden = true;
    quizResultado.hidden = false;
    quizResultadoNumero.textContent = `${quizAcertos} de ${quizPerguntas.length}`;
    const proporcao = quizAcertos / quizPerguntas.length;
    let mensagem;
    resetarComemoracao();
    if (proporcao === 1) {
      mensagem = 'Mandou tudo de cadena! 🧗';
      tocarAnimacaoComemoracao();
    } else if (proporcao >= 0.7) {
      mensagem = 'Você já manda bem no vocabulário!';
    } else if (proporcao >= 0.4) {
      mensagem = 'Bom começo — vale revisar os cards aí em cima de novo.';
    } else {
      mensagem = 'Bora treinar mais um pouco com os cards aí em cima!';
    }
    quizResultadoTexto.textContent = mensagem;
  }

  function proximaPerguntaQuiz() {
    quizIndiceAtual++;
    if (quizIndiceAtual < quizPerguntas.length) {
      mostrarPergunta();
    } else {
      mostrarResultado();
    }
  }

  function iniciarQuiz() {
    quizIndiceAtual = 0;
    quizAcertos = 0;
    quizPerguntas = embaralharArray(TERMOS_QUIZ).slice(0, TOTAL_PERGUNTAS_QUIZ);
    quizInicio.hidden = true;
    quizResultado.hidden = true;
    quizJogo.hidden = false;
    mostrarPergunta();
  }

  if (TERMOS_QUIZ.length < 4) {
    quizInicio.hidden = true;
  } else {
    btnIniciarQuiz?.addEventListener('click', iniciarQuiz);
    btnProxima?.addEventListener('click', proximaPerguntaQuiz);
    btnJogarDeNovo?.addEventListener('click', iniciarQuiz);
  }
</script>
