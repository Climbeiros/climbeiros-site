---
// src/pages/rotas/[localSlug]/[setorSlug].astro
// Página individual de um setor de escalada, aninhada dentro do seu Local:
// croqui e como chegar específicos deste setor. Hospedagens, guias e
// avaliações da comunidade agora ficam na página do Local (vale pro lugar
// como um todo, não só para este setor/lado) — ver
// src/pages/rotas/[localSlug]/index.astro.
import Layout from '../../../layouts/Layout.astro';
import { supabase } from '../../../lib/supabase';
import type { Local, Setor, Croqui } from '../../../lib/supabase';
import AvisoConstrucao from '../../../components/AvisoConstrucao.astro';
import BotaoFeedback from '../../../components/BotaoFeedback.astro';

export async function getStaticPaths() {
  const { data: setores } = await supabase
    .from('setores')
    .select('slug, locais(slug)')
    .not('slug', 'is', null)
    .not('local_id', 'is', null) as { data: { slug: string; locais: { slug: string | null } | null }[] | null };

  return (setores ?? [])
    .filter((s) => s.locais?.slug)
    .map((s) => ({ params: { localSlug: s.locais!.slug, setorSlug: s.slug } }));
}

const { localSlug, setorSlug } = Astro.params;

const { data: local } = await supabase
  .from('locais')
  .select('*')
  .eq('slug', localSlug)
  .single() as { data: Local | null };

const { data: setor } = await supabase
  .from('setores')
  .select('*')
  .eq('slug', setorSlug)
  .single() as { data: Setor | null };

const { data: croquis } = setor
  ? await supabase.from('croquis').select('*').eq('setor_id', setor.id) as { data: Croqui[] | null }
  : { data: null };

const rotuloCroqui: Record<string, string> = {
  link: 'Ver croqui (site)',
  pdf: 'Abrir croqui (PDF)',
  foto: 'Ver croqui (foto)',
};

const encontrado = Boolean(local && setor && setor.local_id === local.id);
---
<Layout titulo={setor?.nome || 'Setor'} descricao={setor?.descricao || undefined}>
  {encontrado && local && setor ? (
    <section class="secao">
      <div class="container setor-detalhe">
        <a href={`/rotas/${local.slug}`} class="voltar">← {local.nome}</a>

        <h1>{setor.nome}</h1>
        <p class="setor-detalhe__local">
          {setor.lado && <span class="setor-detalhe__lado">Lado {setor.lado} · </span>}
          {[setor.regiao, setor.cidade, setor.estado].filter(Boolean).join(' · ')}
        </p>

        <AvisoConstrucao />

        {setor.descricao && <p class="setor-detalhe__descricao">{setor.descricao}</p>}

        {setor.como_chegar && (
          <div class="bloco">
            <h2>Como chegar</h2>
            <p>{setor.como_chegar}</p>
          </div>
        )}

        {croquis && croquis.length > 0 && (
          <div class="bloco">
            <h2>Croqui</h2>
            <div class="setor-detalhe__croquis">
              {croquis.map((c) => (
                c.tipo === 'referencia' ? (
                  <p class="setor-card__croqui-ref">📍 {c.texto}</p>
                ) : (
                  <a href={c.url ?? '#'} target="_blank" rel="noopener" class="botao botao--secundario">
                    {rotuloCroqui[c.tipo] || 'Ver croqui'}
                  </a>
                )
              ))}
            </div>
          </div>
        )}

        <p class="setor-detalhe__cta-local">
          Hospedagens, guias e avaliações desse lugar ficam na página do local:
          {' '}<a href={`/rotas/${local.slug}`}>ver {local.nome} →</a>
        </p>
      </div>
    </section>
  ) : (
    <div class="container secao">
      <h1>Setor não encontrado</h1>
      <a href="/rotas">Voltar para Rotas & Setores</a>
    </div>
  )}
  {encontrado && setor && <BotaoFeedback pagina={`Setor: ${setor.nome}`} />}
</Layout>

<style>
  .voltar { display: inline-block; margin-bottom: 20px; font-family: var(--fonte-display); text-transform: uppercase; font-size: 0.85rem; }
  .setor-detalhe { max-width: 760px; }
  .setor-detalhe__local { opacity: 0.7; font-size: 0.95rem; margin-top: -8px; }
  .setor-detalhe__lado { color: var(--laranja); font-weight: 600; opacity: 1; }
  .setor-detalhe__descricao { margin-top: 12px; }

  .bloco { margin-top: 32px; padding-top: 20px; border-top: 1px solid rgba(42, 31, 22, 0.12); }
  .bloco h2 { font-family: var(--fonte-display); text-transform: uppercase; font-size: 1.2rem; color: var(--verde-escuro); margin-bottom: 10px; }

  .setor-detalhe__croquis { display: flex; flex-wrap: wrap; gap: 10px; }

  .setor-detalhe__cta-local { margin-top: 32px; padding-top: 20px; border-top: 1px solid rgba(42, 31, 22, 0.12); font-size: 0.92rem; opacity: 0.85; }
</style>
