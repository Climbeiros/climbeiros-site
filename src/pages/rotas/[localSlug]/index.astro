    cursor: pointer;
    transition: transform 0.15s;
    white-space: nowrap;
  }
  .botao-compartilhar:hover { transform: translateY(-2px); }

  /* :global() é necessário aqui porque esses elementos são criados por
     JavaScript (innerHTML) depois que a página carrega — o Astro só aplica
     o escopo do <style> em elementos presentes no HTML original do
     componente, então sem :global() essas regras nunca bateriam com nada. */
  :global(.previsao__carregando), :global(.previsao__erro) { opacity: 0.65; font-style: italic; font-size: 0.9rem; }
  :global(.previsao__dias) {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding: 2px 2px 8px;
    margin: 0 -2px;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--laranja) transparent;
    -webkit-overflow-scrolling: touch;
  }
  :global(.previsao__dias)::-webkit-scrollbar { height: 4px; }
  :global(.previsao__dias)::-webkit-scrollbar-track { background: transparent; }
  :global(.previsao__dias)::-webkit-scrollbar-thumb { background: var(--laranja); border-radius: 10px; opacity: 0.6; }
  :global(.previsao__dia) {
    scroll-snap-align: start;
    flex: 1 1 0;
    min-width: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    background: var(--creme-claro);
    border-radius: 8px;
    padding: 6px 4px;
    font-size: 0.85rem;
  }
  :global(.previsao__dia-topo) { display: flex; align-items: center; gap: 4px; }
  :global(.previsao__dia-nome) { font-family: var(--fonte-display); text-transform: uppercase; font-size: 0.6rem; letter-spacing: 0.02em; color: var(--verde-escuro); }
  :global(.previsao__dia-icone) { font-size: 0.95rem; line-height: 1; }
  :global(.previsao__dia-temp) { font-size: 0.78rem; font-weight: 600; color: var(--marrom); }
  :global(.previsao__dia-min) { font-weight: 400; opacity: 0.6; }
  :global(.previsao__dia-chuva) { font-size: 0.6rem; opacity: 0.75; color: var(--verde-escuro); }
  :global(.previsao__dia-chuva--vazia) { opacity: 0.35; }
  .previsao__fonte { font-size: 0.72rem; opacity: 0.6; margin-top: 8px; }

  .bloco { margin-top: 32px; padding-top: 20px; border-top: 1px solid rgba(42, 31, 22, 0.12); }
  .bloco h2 { font-family: var(--fonte-display); text-transform: uppercase; font-size: 1.2rem; color: var(--verde-escuro); margin-bottom: 10px; }
  .bloco--recolhivel > .bloco__titulo {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    cursor: pointer; list-style: none;
  }
  .bloco--recolhivel > .bloco__titulo::-webkit-details-marker { display: none; }
  .bloco--recolhivel > .bloco__titulo h2 { margin: 0; }
