---
// src/pages/rotas/[localSlug]/index.astro
// Página de um Local (ex: "Pedra da Divisa"): como chegar em geral, a lista de
// setores (agrupados por lado quando houver), e os blocos que valem para o
// lugar como um todo: hospedagens próximas, guias que atuam ali, e avaliações
// da comunidade (nota + comentário + fotos + link de vídeo). Hospedagens e
// guias vêm direto de "inscricoes_hospedagens"/"inscricoes_guias" — não existe
// mais tabela curada separada; aprovar no painel de pendências já deixa a
// linha visível aqui (RLS filtra processado=true e rejeitado=false). Site
// estático: depois de aprovar, é preciso um novo deploy na Vercel pra aparecer
// aqui (o painel já dispara isso sozinho).
import { linkInstagram, linkWhatsApp, linkWhatsAppComMensagem, mensagemGuia } from "../../../lib/contatos";
import Layout from '../../../layouts/Layout.astro';
import { supabase, mesAno } from '../../../lib/supabase';
import type {
  Local,
  Setor,
  Hospedagem,
  Guia,
  AvaliacaoLocalPublica,
  FotoAvaliacaoLocalPublica,
} from '../../../lib/supabase';
import AvisoConstrucao from '../../../components/AvisoConstrucao.astro';
import { resumoVias, linksNavegacao } from '../../../lib/graus';
import { nomeSetorCurto } from '../../../lib/nomes';
import BotaoFeedback from '../../../components/BotaoFeedback.astro';
import FormHospedagem from '../../../components/FormHospedagem.astro';

export async function getStaticPaths() {
  const { data: locais } = await supabase
    .from('locais')
    .select('slug')
    .not('slug', 'is', null) as { data: { slug: string }[] | null };
  return (locais ?? []).map((l) => ({ params: { localSlug: l.slug } }));
}

const { localSlug } = Astro.params;

const { data: local } = await supabase
  .from('locais')
  .select('*')
  .eq('slug', localSlug)
  .single() as { data: Local | null };

const { data: setores } = local
  ? await supabase
      .from('setores')
      .select('*')
      .eq('local_id', local.id)
      .order('lado')
      .order('nome') as { data: Setor[] | null }
  : { data: null };
// Ordem natural ("Setor 2" antes de "Setor 10"), dentro de cada lado.
const ordemNatural = (x: string | null | undefined, y: string | null | undefined) =>
  (x ?? '').localeCompare(y ?? '', 'pt-BR', { numeric: true, sensitivity: 'base' });
setores?.sort((a, b) => ordemNatural(a.lado, b.lado) || ordemNatural(a.nome, b.nome));

// Croqui em PDF do local (pro botão no topo da página, ao lado de "Salvar offline").
// Vem dos croquis em PDF dos setores ou das referências do próprio local.
const { data: croquisPdf } = (setores ?? []).length
  ? await supabase.from('croquis').select('url').eq('tipo', 'pdf')
      .in('setor_id', (setores ?? []).map((s) => s.id)) as { data: { url: string | null }[] | null }
  : { data: null };
const pdfLocal = [
  ...(croquisPdf ?? []).map((c) => c.url),
  ...(local?.croqui_referencias ?? []).map((c) => c.url).filter((u) => /\.pdf($|[?#])/i.test(u) || /drive\.google\.com\/file\//i.test(u)),
].find(Boolean) ?? null;

// Mapa dos setores (imagem aérea com cada setor clicável), quando o local tiver.
const nomeCurto = (nome: string) => nomeSetorCurto(nome, local?.nome);
const mapaSetores = local?.mapa_setores
  ? {
      ...local.mapa_setores,
      alturaVB: Math.round((1000 * local.mapa_setores.altura) / local.mapa_setores.largura),
      areas: local.mapa_setores.areas
        .map((a) => ({ ...a, setor: (setores ?? []).find((s) => s.slug === a.slug) }))
        .filter((a) => a.setor && a.pontos.length > 2)
        .map((a) => ({ ...a, nome: nomeCurto(a.setor!.nome), d: a.pontos.map((p) => p.join(',')).join(' ') })),
    }
  : null;

// Com o mapa, a lista de setores fica recolhida (o mapa já leva a cada setor).
const temMapaSetores = !!(mapaSetores && mapaSetores.areas.length > 0);
const ListaEnvelope = temMapaSetores ? 'details' : 'div';

const semLado = (setores ?? []).filter((s) => !s.lado);
const nomesLados = [...new Set((setores ?? []).filter((s) => s.lado).map((s) => s.lado as string))];
const lados = nomesLados.map((lado) => ({
  lado,
  setores: (setores ?? []).filter((s) => s.lado === lado),
}));

// Vias/boulders dos setores deste local (só grau e tipo), pra mostrar
// ao lado de cada setor um resumo tipo "12 vias · 4º a 7º B".
const idsSetores = (setores ?? []).map((s) => s.id);
const rotasDoLocal: { setor_id: string | null; grau: string | null; tipo: string | null }[] = [];
if (idsSetores.length) {
  for (let inicio = 0; ; inicio += 1000) {
    const { data } = await supabase.from('rotas').select('setor_id, grau, tipo')
      .in('setor_id', idsSetores).range(inicio, inicio + 999);
    rotasDoLocal.push(...(data ?? []));
    if (!data || data.length < 1000) break;
  }
}
function resumoDoSetor(setorId: string) {
  return resumoVias(rotasDoLocal.filter((r) => r.setor_id === setorId));
}
const resumoLocal = resumoVias(rotasDoLocal);
const navegacao = local ? linksNavegacao(local.latitude, local.longitude) : null;

// Hospedagens, guias e avaliações são vinculados ao Local (não mais ao setor
// específico), já que uma hospedagem/guia costuma atender o lugar inteiro.
const { data: hospedagens } = local
  ? await supabase.from('inscricoes_hospedagens').select('id, nome, contato_reserva, link_reserva, distancia, locais_ids, tem_desconto, desconto_desc, ordem').order('ordem') as { data: Hospedagem[] | null }
  : { data: null };
const hospedagensDoLocal = (hospedagens ?? []).filter((h) => (h.locais_ids ?? []).includes(local?.id ?? ''));

const { data: guias } = local
  ? await supabase.from('inscricoes_guias').select('id, nome, email, telefone, instagram, cidade, uf, especialidades_lista, certificacao, foto_url, bio, cursos_oferecidos, locais_ids, locais_interesse, cupom_codigo, cupom_desc, climbeiros_indica, ordem, criado_em').order('ordem') as { data: Guia[] | null }
  : { data: null };
const guiasDoLocal = (guias ?? []).filter((g) => (g.locais_ids ?? []).includes(local?.id ?? ''));

// Lista completa de locais, pra oferecer no dropdown do formulário de
// cadastro de hospedagem (já vem pré-selecionado o local desta página).
const { data: todosLocais } = await supabase
  .from('locais')
  .select('id, nome')
  .order('nome') as { data: { id: string; nome: string }[] | null };

const { data: avaliacoes } = local
  ? await supabase
      .from('avaliacoes_locais_publicas')
      .select('*')
      .eq('local_id', local.id)
      .order('enviado_em', { ascending: false }) as { data: AvaliacaoLocalPublica[] | null }
  : { data: null };

const { data: fotosAvaliacoes } = local
  ? await supabase.from('avaliacoes_locais_fotos_publicas').select('*') as { data: FotoAvaliacaoLocalPublica[] | null }
  : { data: null };

function fotosDaAvaliacao(avaliacaoId: string) {
  return (fotosAvaliacoes ?? []).filter((f) => f.avaliacao_id === avaliacaoId);
}

const resumoAvaliacoes = (avaliacoes ?? []).length > 0
  ? {
      media: ((avaliacoes ?? []).reduce((soma, a) => soma + a.nota, 0) / (avaliacoes ?? []).length).toFixed(1),
      total: (avaliacoes ?? []).length,
    }
  : null;

// --- Informações pro Google, prévia de link e IAs (ver Layout.astro) ---
const lugarTexto = [local?.cidade, local?.estado].filter(Boolean).join('/');
const tiposTexto = (local?.tipos ?? []).join(', ').toLowerCase();
const descricaoSeo = local
  ? (local.descricao?.trim() ||
      `Escalada em ${local.nome}${lugarTexto ? ` (${lugarTexto})` : ''}` +
      `${tiposTexto ? `, ${tiposTexto}` : ''}: setores, croquis, como chegar, previsão do tempo, onde ficar e guias que atuam no local.`)
  : undefined;
const urlLocal = local ? new URL(`/rotas/${local.slug}/`, Astro.site).href : '';
const jsonLdLocal = local
  ? [
      {
        '@context': 'https://schema.org',
        '@type': ['TouristAttraction', 'SportsActivityLocation'],
        name: local.nome,
        description: descricaoSeo,
        url: urlLocal,
        ...(local.imagem_capa_url ? { image: local.imagem_capa_url } : {}),
        ...(local.tipos?.length ? { keywords: ['escalada', ...local.tipos].join(', ') } : {}),
        address: {
          '@type': 'PostalAddress',
          ...(local.cidade ? { addressLocality: local.cidade } : {}),
          ...(local.estado ? { addressRegion: local.estado } : {}),
          addressCountry: 'BR',
        },
        ...(local.latitude != null && local.longitude != null
          ? { geo: { '@type': 'GeoCoordinates', latitude: local.latitude, longitude: local.longitude } }
          : {}),
        ...((setores ?? []).some((s) => s.slug)
          ? {
              containsPlace: (setores ?? [])
                .filter((s) => s.slug)
                .map((s) => ({
                  '@type': 'Place',
                  name: s.nome,
                  url: new URL(`/rotas/${local.slug}/${s.slug}/`, Astro.site).href,
                })),
            }
          : {}),
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Rotas & Setores', item: new URL('/rotas/', Astro.site).href },
          { '@type': 'ListItem', position: 2, name: local.nome, item: urlLocal },
        ],
      },
    ]
  : undefined;
---
<Layout
  titulo={local ? `${local.nome} · Escalada${local.cidade ? ` em ${local.cidade}` : ''}` : 'Local'}
  descricao={descricaoSeo}
  imagem={local?.imagem_capa_url || undefined}
  jsonLd={jsonLdLocal}
>
  {local ? (
    <section class="secao">
      {local.imagem_capa_url && (
        <div class="container">
          <img class="local-detalhe__capa" src={local.imagem_capa_url} alt={local.nome} />
        </div>
      )}
      <div class="container local-detalhe">
        <a href="/rotas" class="voltar" data-voltar>← Rotas & Setores</a>

        <div class="local-detalhe__titulo">
          <h1>{local.nome}</h1>
          <div class="local-detalhe__acoes">
          <button
            type="button"
            class="botao-compartilhar"
            data-url={`/rotas/${local.slug}`}
            data-nome={local.nome}
            title="Compartilhar"
            aria-label={`Compartilhar ${local.nome}`}
          >↗ Compartilhar</button>
          <button
            type="button"
            class="botao-compartilhar botao-offline"
            data-local={`/rotas/${local.slug}`}
            data-capa={local.imagem_capa_url || ''}
            title="Guardar este local e os setores no celular, pra abrir sem internet"
            hidden
          >⤓ Salvar offline</button>
          {pdfLocal && (
            <a href={pdfLocal} target="_blank" rel="noopener" class="botao-compartilhar botao-pdf" title="Abrir o croqui completo em PDF">📄 Croqui em PDF</a>
          )}
          </div>
        </div>
        <p class="local-detalhe__local">{[...new Set([local.regiao, local.cidade, local.estado].filter(Boolean))].join(' · ')}</p>

        {!local.croqui_so_externo && !local.pagina_completa && <AvisoConstrucao />}

        {local.tipos && local.tipos.length > 0 && (
          <div class="local-detalhe__tags">
            {local.tipos.map((t) => <span class="tag-tipo">{t}</span>)}
          </div>
        )}

        {local.descricao && <p class="local-detalhe__descricao">{local.descricao}</p>}

        {local.croqui_so_externo && (
          <div class="bloco">
            <h2>Vias e croqui</h2>
            {local.guia_recomendado && <p class="guia-recomendado">📖 {local.guia_recomendado}</p>}
            {local.croqui_referencias && local.croqui_referencias.length > 0 && (
              <ul class="croqui-referencias">
                {local.croqui_referencias.map((c) => (
                  <li>
                    <a href={c.url} target="_blank" rel="noopener">{c.label} ↗</a>
                  </li>
                ))}
              </ul>
            )}
            <p class="croqui-referencias__aviso">Os croquis são de quem os produziu: quando o arquivo está hospedado no Climbeiros, é porque os autores autorizaram; os demais links levam pra fonte original (redirecionamos, não copiamos o conteúdo). Sempre confira a versão mais recente antes de ir.</p>
          </div>
        )}

        {!local.croqui_so_externo && (
        <div class="bloco">
          <h2>Setores</h2>
          {resumoLocal && idsSetores.length > 1 && <p class="setores-resumo">{resumoLocal} no total</p>}

          {mapaSetores && mapaSetores.areas.length > 0 && (
            <figure class="mapa-setores">
              <div class="mapa-setores__quadro">
                <img src={mapaSetores.imagem_url} alt={`Vista aérea de ${local.nome} com a localização de cada setor`} width={mapaSetores.largura} height={mapaSetores.altura} loading="lazy" />
                <svg viewBox={`0 0 1000 ${mapaSetores.alturaVB}`} preserveAspectRatio="none">
                  {mapaSetores.areas.map((a) => (
                    <a href={`/rotas/${local.slug}/${a.slug}`} aria-label={`Abrir o setor ${a.nome}`}>
                      <title>{a.nome}</title>
                      <polygon points={a.d} class="mapa-setores__area"></polygon>
                    </a>
                  ))}
                </svg>
              </div>
              <figcaption>
                <strong>Toque num setor no mapa</strong> pra ver o croqui com as vias e todos os detalhes.
                {mapaSetores.credito && <span class="mapa-setores__credito"> Imagem: {mapaSetores.credito}</span>}
              </figcaption>
            </figure>
          )}

          {(!setores || setores.length === 0) && (
            <p class="vazio">Ainda não temos setores cadastrados aqui. Tem o croqui? <a href="/contato?motivo=croqui">Envie pra gente</a> que a gente cadastra as vias.</p>
          )}

          {temMapaSetores && (
            <nav class="setores-pilulas" aria-label="Setores deste local">
              {(setores ?? []).map((s) => (
                <a href={`/rotas/${local.slug}/${s.slug}`}>{nomeSetorCurto(s.nome, local.nome)}</a>
              ))}
            </nav>
          )}

          <ListaEnvelope class:list={[{ "setores-em-lista": temMapaSetores }]}>
            {temMapaSetores && <summary>Ver os setores em lista</summary>}
            {lados.length > 0 ? (
              <>
                {lados.map((l) => (
                  <div class="lado-grupo">
                    <h3>Lado {l.lado}</h3>
                    <ul class="setores-lista">
                      {l.setores.map((s) => (
                        <li>
                          <a href={`/rotas/${local.slug}/${s.slug}`} class="setores-lista__link">{nomeSetorCurto(s.nome, local.nome)}</a>
                          {resumoDoSetor(s.id) && <span class="setores-lista__resumo">{resumoDoSetor(s.id)}</span>}
                          {s.descricao && <p class="setores-lista__desc">{s.descricao}</p>}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
                {semLado.length > 0 && (
                  <div class="lado-grupo">
                    <ul class="setores-lista">
                      {semLado.map((s) => (
                        <li>
                          <a href={`/rotas/${local.slug}/${s.slug}`} class="setores-lista__link">{nomeSetorCurto(s.nome, local.nome)}</a>
                          {resumoDoSetor(s.id) && <span class="setores-lista__resumo">{resumoDoSetor(s.id)}</span>}
                          {s.descricao && <p class="setores-lista__desc">{s.descricao}</p>}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </>
            ) : (
              <ul class="setores-lista">
                {semLado.map((s) => (
                  <li>
                    <a href={`/rotas/${local.slug}/${s.slug}`} class="setores-lista__link">{nomeSetorCurto(s.nome, local.nome)}</a>
                    {resumoDoSetor(s.id) && <span class="setores-lista__resumo">{resumoDoSetor(s.id)}</span>}
                    {s.descricao && <p class="setores-lista__desc">{s.descricao}</p>}
                  </li>
                ))}
              </ul>
            )}
          </ListaEnvelope>
        </div>
        )}

        {local.videos && local.videos.length > 0 && (
          <div class="bloco">
            <h2>Dica de quem já foi</h2>
            <ul class="videos-lista">
              {local.videos.map((v) => (
                <li>
                  <a href={v.url} target="_blank" rel="noopener" class="videos-lista__link">▶ {v.label}</a>
                  {v.autor && <span class="videos-lista__autor">por {v.autor}</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        {(local.como_chegar || navegacao) && (
          <div class="bloco">
            <h2>Como chegar</h2>
            {local.como_chegar && <p>{local.como_chegar}</p>}
            {navegacao && (
              <div class="navegacao">
                <a href={navegacao.google} target="_blank" rel="noopener" class="botao botao--pequeno">📍 Abrir no Google Maps</a>
                <a href={navegacao.waze} target="_blank" rel="noopener" class="botao botao--pequeno botao--secundario">🚗 Abrir no Waze</a>
              </div>
            )}
          </div>
        )}

        {local.latitude && local.longitude && (
          <div class="bloco">
            <h2>Previsão do tempo</h2>
            <div id="previsao-tempo" class="previsao" data-lat={local.latitude} data-lon={local.longitude}>
              <p class="previsao__carregando">Carregando previsão...</p>
            </div>
            <p class="previsao__fonte">Dados: <a href="https://open-meteo.com" target="_blank" rel="noopener">Open-Meteo</a>. Na seca (a melhor época pra maioria dos setores) chove menos, mas vale sempre conferir antes de ir.</p>
          </div>
        )}

        {local.boas_praticas && local.boas_praticas.itens.length > 0 && (
          <details class="bloco bloco--recolhivel">
            <summary class="bloco__titulo"><h2>Antes de escalar</h2><span class="bloco__contagem">regras do local</span></summary>
            <ul class="boas-praticas">
              {local.boas_praticas.itens.map((item) => <li>{item}</li>)}
            </ul>
            {local.boas_praticas.fonte && <p class="boas-praticas__fonte">Fonte: {local.boas_praticas.fonte}</p>}
          </details>
        )}

        <details class="bloco bloco--recolhivel">
          <summary class="bloco__titulo"><h2>Onde ficar</h2><span class="bloco__contagem">{hospedagensDoLocal.length > 0 ? `${hospedagensDoLocal.length} ${hospedagensDoLocal.length === 1 ? 'opção' : 'opções'}` : 'nenhuma ainda'}</span></summary>
          {hospedagensDoLocal.length > 0 ? (
            <ul class="hospedagens-lista">
              {hospedagensDoLocal.map((h) => (
                <li class="hospedagem-item">
                  <strong>{h.nome}</strong>
                  {h.distancia && <span class="hospedagem-item__distancia"> · {h.distancia}</span>}
                  {h.tem_desconto === 'Sim' && (
                    <span class="hospedagem-item__desconto">🎟️ Desconto Climbeiros{h.desconto_desc ? `: ${h.desconto_desc}` : ''}</span>
                  )}
                  <div class="hospedagem-item__contato">
                    {h.contato_reserva && <span>{h.contato_reserva}</span>}
                    {h.link_reserva && <a href={h.link_reserva} target="_blank" rel="noopener">Reservar</a>}
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="vazio">Ainda não temos hospedagens cadastradas perto daqui.</p>
          )}

          <details class="cadastro-detalhes">
            <summary>Tem uma hospedagem por aqui? Cadastre-se</summary>
            <FormHospedagem localId={local.id} />
          </details>
        </details>

        <details class="bloco bloco--recolhivel">
          <summary class="bloco__titulo"><h2>Guias que atuam aqui</h2><span class="bloco__contagem">{guiasDoLocal.length > 0 ? `${guiasDoLocal.length} ${guiasDoLocal.length === 1 ? 'guia' : 'guias'}` : 'nenhum ainda'}</span></summary>
          {guiasDoLocal.length > 0 ? (
            <ul class="guias-lista">
              {guiasDoLocal.map((g) => (
                <li class="guia-item">
                  <strong>{g.nome}</strong>
                  {g.especialidades_lista && g.especialidades_lista.length > 0 && (
                    <span class="guia-item__espec"> · {g.especialidades_lista.join(', ')}</span>
                  )}
                  <div class="guia-item__contato">
                    {linkWhatsApp(g.telefone) && <a href={linkWhatsAppComMensagem(g.telefone, mensagemGuia(g))} target="_blank" rel="noopener">WhatsApp</a>}
                    {linkInstagram(g.instagram) && <a href={linkInstagram(g.instagram)} target="_blank" rel="noopener">Instagram</a>}
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="vazio">Ainda não temos guias indicados para este local.</p>
          )}
          <p class="cta-guia">
            Você é guia e atua aqui? <a href="/cursos#seja-guia">Cadastre-se na nossa rede de guias →</a>
          </p>
        </details>

        {!local.croqui_so_externo && (local.guia_recomendado || (local.croqui_referencias && local.croqui_referencias.length > 0)) && (
          <div class="bloco">
            <h2>Croqui e guia</h2>
            {local.guia_recomendado && <p class="guia-recomendado">📖 {local.guia_recomendado}</p>}
            {local.croqui_referencias && local.croqui_referencias.length > 0 && (
              <ul class="croqui-referencias">
                {local.croqui_referencias.map((c) => (
                  <li>
                    <a href={c.url} target="_blank" rel="noopener">{c.label} ↗</a>
                  </li>
                ))}
              </ul>
            )}
            <p class="croqui-referencias__aviso">Os croquis são de quem os produziu: quando o arquivo está hospedado no Climbeiros, é porque os autores autorizaram; os demais links levam pra fonte original (redirecionamos, não copiamos o conteúdo). Sempre confira a versão mais recente antes de ir.</p>
          </div>
        )}

        <details class="bloco bloco--recolhivel">
          <summary class="bloco__titulo"><h2>Avaliações da comunidade</h2><span class="bloco__contagem">{resumoAvaliacoes ? `★ ${resumoAvaliacoes.media} · ${resumoAvaliacoes.total}` : 'nenhuma ainda'}</span></summary>
          {resumoAvaliacoes ? (
            <p class="avaliacao-resumo">
              <span class="avaliacao-resumo__estrelas" aria-hidden="true">★</span>
              <strong>{resumoAvaliacoes.media}</strong> · {resumoAvaliacoes.total} avaliaç{resumoAvaliacoes.total === 1 ? 'ão' : 'ões'}
            </p>
          ) : (
            <p class="avaliacao-resumo avaliacao-resumo--vazia">Ainda sem avaliações</p>
          )}

          {avaliacoes && avaliacoes.length > 0 && (
            <ul class="avaliacao-lista">
              {avaliacoes.map((a) => (
                <li class="avaliacao-item">
                  <div class="avaliacao-item__topo">
                    <span class="avaliacao-item__estrelas" aria-hidden="true">{'★'.repeat(a.nota)}{'☆'.repeat(5 - a.nota)}</span>
                    <strong>{a.nome}</strong>
{mesAno(a.enviado_em) && <span class="avaliacao-item__data">{mesAno(a.enviado_em)}</span>}
                  </div>
                  {a.comentario && <p class="avaliacao-item__comentario">{a.comentario}</p>}
                  {a.link_video && (
                    <p class="avaliacao-item__video">
                      <a href={a.link_video} target="_blank" rel="noopener">Ver vídeo →</a>
                    </p>
                  )}
                  {fotosDaAvaliacao(a.id).length > 0 && (
                    <div class="avaliacao-item__fotos">
                      {fotosDaAvaliacao(a.id).map((f) => (
                        <img src={f.imagem_url} alt={`Foto enviada por ${a.nome}`} loading="lazy" />
                      ))}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          )}

          <details class="cadastro-detalhes">
            <summary>Já escalou aqui? Deixe sua avaliação</summary>
            <form
              class="form-avaliacao"
              id="form-avaliacao-local"
              data-local-id={local.id}
            >
              <fieldset class="estrelas-input">
                <legend>Sua nota</legend>
                {[5, 4, 3, 2, 1].map((n) => (
                  <>
                    <input type="radio" name="nota" id={`av-nota-${n}`} value={n} required />
                    <label for={`av-nota-${n}`} title={`${n} estrela${n > 1 ? 's' : ''}`}>★</label>
                  </>
                ))}
              </fieldset>
              <label>
                Comentário (opcional)
                <textarea name="comentario" rows="3" placeholder="Dicas pra quem for escalar aqui: acesso, condição das vias, etc."></textarea>
              </label>
              <label>
                Link de vídeo (opcional)
                <input type="url" name="link_video" placeholder="Link do YouTube, Instagram ou TikTok" />
              </label>
              <label>
                Fotos (opcional)
                <input type="file" name="fotos" accept="image/png, image/jpeg, image/webp" multiple />
              </label>
              <label>
                Seu nome
                <input type="text" name="nome" required />
              </label>
              <label>
                Seu e-mail
                <input type="email" name="email" required />
                <small>Não é exibido publicamente, usamos só pra contato, se precisar.</small>
              </label>
              <input type="text" name="site" class="campo-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <button type="submit" class="botao botao--pequeno">Enviar avaliação</button>
              <p class="form-status" role="status"></p>
              <p class="form-aviso">Sua avaliação (e fotos) passam por uma checagem da equipe do Climbeiros antes de aparecer aqui.</p>
            </form>
          </details>
        </details>
        {!local.croqui_so_externo && (
          <p class="link-editor"><a href="/editor">É responsável por este croqui? Entre no editor</a></p>
        )}
      </div>
    </section>
  ) : (
    <div class="container secao">
      <h1>Local não encontrado</h1>
      <a href="/rotas">Voltar para Rotas & Setores</a>
    </div>
  )}
  {local && <BotaoFeedback pagina={`Local: ${local.nome}`} />}
</Layout>

<script>
  import { supabase } from '../../../lib/supabase';
  import { reduzirFoto } from '../../../lib/desapego';

  // ---- Botão de compartilhar (Web Share API, com fallback pra copiar o link) ----
  document.querySelectorAll('.botao-compartilhar').forEach((botao) => {
    botao.addEventListener('click', async () => {
      const caminho = botao.dataset.url;
      if (!caminho) return;
      const url = `${window.location.origin}${caminho}`;
      const nome = botao.dataset.nome || 'Climbeiros';
      try {
        if (navigator.share) {
          await navigator.share({ title: nome, text: `Confira ${nome} no Climbeiros`, url });
        } else {
          await navigator.clipboard.writeText(url);
          const original = botao.textContent;
          botao.textContent = '✓ Link copiado';
          setTimeout(() => { botao.textContent = original; }, 1800);
        }
      } catch {
        // Usuário cancelou o compartilhamento nativo, ou o navegador bloqueou — sem problema.
      }
    });
  });

  // ---- Salvar offline (PWA) ----
  // Guarda a página do Local, a de cada setor e os arquivos que elas usam no
  // cache "climbeiros-salvos", que o service worker (/sw.js) consulta quando
  // não tem sinal. A chave é o endereço sem a barra final, igual ao sw.js.
  const CACHE_SALVOS = 'climbeiros-salvos';
  const chavePagina = (caminho: string) =>
    window.location.origin + (caminho !== '/' ? caminho.replace(/\/+$/, '') : '/');

  async function salvarUrl(cache: Cache, caminho: string, ehPagina: boolean) {
    const res = await fetch(caminho, { credentials: 'same-origin' });
    if (!res.ok) throw new Error(`${caminho}: ${res.status}`);
    const corpo = await res.blob();
    const limpa = new Response(corpo, { status: 200, headers: res.headers });
    await cache.put(ehPagina ? chavePagina(new URL(caminho, window.location.origin).pathname) : caminho, limpa);
    return ehPagina ? await corpo.text() : '';
  }

  const botaoOffline = document.querySelector<HTMLButtonElement>('.botao-offline');
  if (botaoOffline && 'caches' in window && 'serviceWorker' in navigator) {
    const local = botaoOffline.dataset.local || '';
    const marcarSalvo = () => { botaoOffline.textContent = '✓ Salvo offline'; };
    botaoOffline.hidden = false;
    caches.open(CACHE_SALVOS).then((c) => c.match(chavePagina(local))).then((r) => { if (r) marcarSalvo(); });

    botaoOffline.addEventListener('click', async () => {
      botaoOffline.disabled = true;
      botaoOffline.textContent = 'Salvando...';
      try {
        const cache = await caches.open(CACHE_SALVOS);
        const setores = Array.from(document.querySelectorAll<HTMLAnchorElement>('.setores-lista__link'))
          .map((a) => new URL(a.href).pathname);
        const paginas = [local, ...new Set(setores)];
        const arquivos = new Set<string>();
        for (const p of paginas) {
          const html = await salvarUrl(cache, p, true);
          // CSS, scripts e imagens do próprio site usados pela página.
          for (const m of html.matchAll(/(?:src|href)="(\/(?:_astro|images|icons)\/[^"]+)"/g)) arquivos.add(m[1]);
        }
        await Promise.all([...arquivos].map((a) => salvarUrl(cache, a, false).catch(() => {})));
        const capa = botaoOffline.dataset.capa;
        if (capa) {
          try { const r = await fetch(capa); if (r.ok) await cache.put(capa, r); } catch { /* capa é opcional */ }
        }
        // Pede ao navegador pra não apagar esse conteúdo quando faltar espaço.
        try { await navigator.storage?.persist?.(); } catch { /* opcional */ }
        marcarSalvo();
      } catch (e) {
        console.error('Salvar offline falhou:', e);
        botaoOffline.textContent = 'Não deu, tente com sinal';
      } finally {
        botaoOffline.disabled = false;
      }
    });
  }

  // ---- Previsão do tempo (Open-Meteo, API pública e gratuita, sem chave) ----
  // Emoji na apresentação colorida padrão do sistema (sem variation selector
  // U+FE0E): a versão monocromática desses símbolos não tem suporte
  // confiável em todo navegador/SO (no Windows renderizava tudo errado).
  const painelPrevisao = document.getElementById('previsao-tempo');
  if (painelPrevisao) {
    const lat = painelPrevisao.dataset.lat;
    const lon = painelPrevisao.dataset.lon;
    const diasSemana = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
    const iconePorCodigo = (codigo) => {
      if ([0, 1].includes(codigo)) return '☀️'; // sol
      if ([2, 3].includes(codigo)) return '☁️'; // nublado
      if ([45, 48].includes(codigo)) return '🌫️'; // neblina
      if ([51, 53, 55, 56, 57, 61, 63, 65, 80, 81, 82].includes(codigo)) return '🌧️'; // chuva
      if ([71, 73, 75, 77, 85, 86].includes(codigo)) return '❄️'; // neve
      if ([95, 96, 99].includes(codigo)) return '⛈️'; // tempestade
      return '☀️';
    };

    const controle = new AbortController();
    const tempoLimite = setTimeout(() => controle.abort(), 10000);

    fetch(
      `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&daily=weathercode,weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=America%2FSao_Paulo&forecast_days=7`,
      { signal: controle.signal }
    )
      .then((r) => {
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return r.json();
      })
      .then((dados) => {
        const dias = dados?.daily?.time ?? [];
        const codigos = dados?.daily?.weather_code ?? dados?.daily?.weathercode ?? [];
        if (dias.length === 0) throw new Error('sem dados');
        painelPrevisao.innerHTML = `
          <div class="previsao__dias">
            ${dias.map((data, i) => {
              const dataObj = new Date(data + 'T12:00:00');
              const nomeDia = i === 0 ? 'Hoje' : diasSemana[dataObj.getDay()];
              const max = Math.round(dados.daily.temperature_2m_max[i]);
              const min = Math.round(dados.daily.temperature_2m_min[i]);
              const chuva = dados.daily.precipitation_probability_max[i];
              const icone = iconePorCodigo(codigos[i]);
              return `
                <div class="previsao__dia">
                  <span class="previsao__dia-topo">
                    <span class="previsao__dia-nome">${nomeDia}</span>
                    <span class="previsao__dia-icone" aria-hidden="true">${icone}</span>
                  </span>
                  <span class="previsao__dia-temp">${max}°<span class="previsao__dia-min">/${min}°</span></span>
                  <span class="previsao__dia-chuva${chuva > 0 ? '' : ' previsao__dia-chuva--vazia'}">${chuva > 0 ? `💧${chuva}%` : '–'}</span>
                </div>
              `;
            }).join('')}
          </div>
        `;
      })
      .catch((err) => {
        console.error('Previsão do tempo (Open-Meteo):', err);
        painelPrevisao.innerHTML = navigator.onLine === false
          ? '<p class="previsao__erro">Sem internet agora. A previsão aparece quando o sinal voltar.</p>'
          : '<p class="previsao__erro">Não foi possível carregar a previsão agora. Tente de novo mais tarde.</p>';
      })
      .finally(() => clearTimeout(tempoLimite));
  }

  // ---- Formulário de avaliação (nota + comentário + fotos + vídeo) ----
  const formAv = document.getElementById('form-avaliacao-local') as HTMLFormElement | null;
  const statusAv = formAv?.querySelector('.form-status') as HTMLElement | null;

  formAv?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusAv || !formAv) return;
    const dados = new FormData(formAv);

    if (dados.get('site')) {
      statusAv.textContent = 'Avaliação enviada!';
      formAv.reset();
      return;
    }

    const nota = dados.get('nota');
    if (!nota) {
      statusAv.textContent = 'Escolha uma nota de 1 a 5 estrelas.';
      return;
    }

    const botao = formAv.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const CONTATO = 'Tente de novo ou escreva pra contato@climbeiros.com.br';
    botao?.setAttribute('disabled', '');

    try {
      // 1) Fotos primeiro (diminuídas, igual ao Desapego). Se alguma não subir,
      //    para tudo e avisa: antes a foto era pulada sem aviso (bug de 14/11/2026).
      const arquivos = Array.from((formAv.querySelector('input[name="fotos"]') as HTMLInputElement | null)?.files ?? []);
      const urlsFotos: string[] = [];
      for (const [i, arquivo] of arquivos.entries()) {
        statusAv.textContent = `Preparando a foto ${i + 1} de ${arquivos.length}...`;
        const blob = await reduzirFoto(arquivo);
        if (blob.size > 5 * 1024 * 1024) {
          statusAv.textContent = `A foto "${arquivo.name}" é grande demais e não consegui diminuir. Tire ela e escolha outra (ou um print dela).`;
          botao?.removeAttribute('disabled');
          return;
        }
        const ext = blob.type === 'image/jpeg' ? 'jpg' : (arquivo.name.split('.').pop() || 'jpg').toLowerCase();
        const nomeArquivo = `${Date.now()}-${Math.random().toString(36).slice(2)}.${ext}`;
        const { error: erroUpload } = await supabase.storage
          .from('fotos-avaliacoes-setores')
          .upload(nomeArquivo, blob, { contentType: blob.type || arquivo.type });
        if (erroUpload) {
          statusAv.textContent = `Não consegui enviar a foto "${arquivo.name}". Tente outra foto (JPG) ou envie sem fotos. Sua avaliação ainda não foi enviada.`;
          botao?.removeAttribute('disabled');
          return;
        }
        urlsFotos.push(supabase.storage.from('fotos-avaliacoes-setores').getPublicUrl(nomeArquivo).data.publicUrl);
      }

      // 2) A avaliação. O id é criado aqui (como no Divulgar evento): pedir o id de
      //    volta pro banco falhava, porque o público não pode ler avaliações pendentes.
      statusAv.textContent = 'Enviando...';
      const avaliacaoId = crypto.randomUUID();
      const { error: erroAvaliacao } = await supabase.from('avaliacoes_locais').insert({
        id: avaliacaoId,
        local_id: formAv.dataset.localId,
        nome: dados.get('nome'),
        email: dados.get('email'),
        nota: Number(nota),
        comentario: dados.get('comentario') || null,
        link_video: dados.get('link_video') || null,
      });
      if (erroAvaliacao) {
        console.error('Avaliação de local:', erroAvaliacao);
        statusAv.textContent = 'Ops, não consegui enviar sua avaliação. ' + CONTATO;
        botao?.removeAttribute('disabled');
        return;
      }

      // 3) Liga as fotos à avaliação
      let fotosFalharam = 0;
      for (const url of urlsFotos) {
        const { error: erroFoto } = await supabase.from('avaliacoes_locais_fotos').insert({ avaliacao_id: avaliacaoId, imagem_url: url });
        if (erroFoto) { console.error('Foto da avaliação:', erroFoto); fotosFalharam++; }
      }

      formAv.reset();
      statusAv.textContent = fotosFalharam
        ? `Recebemos sua avaliação, mas ${fotosFalharam === 1 ? 'uma foto não foi junto' : fotosFalharam + ' fotos não foram junto'}. Se quiser, mande pra contato@climbeiros.com.br.`
        : 'Obrigado! Sua avaliação passa por uma checagem antes de aparecer no site.';
    } catch (err) {
      console.error('Avaliação de local:', err);
      statusAv.textContent = 'Ops, algo deu errado (pode ser a internet). ' + CONTATO;
    }

    botao?.removeAttribute('disabled');
  });
</script>

