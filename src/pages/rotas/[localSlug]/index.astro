  .local-detalhe__descricao { margin-top: 12px; }
  .botao-compartilhar.botao-pdf { background: var(--laranja); border-color: var(--laranja); color: var(--branco); text-decoration: none; display: inline-flex; align-items: center; }
  .botao-compartilhar.botao-pdf:hover { color: var(--branco); }
  .botao-compartilhar {
    flex: 0 0 auto;
    border-radius: 30px;
    border: 1px solid rgba(42,31,22,0.15);
    background: var(--creme-claro);
    color: var(--verde-escuro);
    font-family: var(--fonte-display);
    text-transform: uppercase;
