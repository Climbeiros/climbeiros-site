---
// src/pages/rotas/[localSlug]/index.astro
// Página de um Local (ex: "Pedra da Divisa"): como chegar em geral, a lista de
// setores (agrupados por lado quando houver), e os blocos que valem para o
// lugar como um todo: hospedagens próximas, guias que atuam ali, e avaliações
// da comunidade (nota + comentário + fotos + link de vídeo). Site estático:
// depois de aprovar hospedagem/guia/avaliação no Supabase, é preciso rodar um
// novo deploy na Vercel pra aparecer aqui.
import Layout from '../../../layouts/Layout.astro';
import { supabase } from '../../../lib/supabase';
import type {
  Local,
  Setor,
  Hospedagem,
  Guia,
  AvaliacaoLocalPublica,
  FotoAvaliacaoLocalPublica,
} from '../../../lib/supabase';

export async function getStaticPaths() {
  const { data: locais } = await supabase
    .from('locais')
    .select('slug')
    .not('slug', 'is', null) as { data: { slug: string }[] | null };
  return (locais ?? []).map((l) => ({ params: { localSlug: l.slug } }));
}

const { localSlug } = Astro.params;

const { data: local } = await supabase
  .from('locais')
  .select('*')
  .eq('slug', localSlug)
  .single() as { data: Local | null };

const { data: setores } = local
  ? await supabase
      .from('setores')
      .select('*')
      .eq('local_id', local.id)
      .order('lado')
      .order('nome') as { data: Setor[] | null }
  : { data: null };

const semLado = (setores ?? []).filter((s) => !s.lado);
const nomesLados = [...new Set((setores ?? []).filter((s) => s.lado).map((s) => s.lado as string))];
const lados = nomesLados.map((lado) => ({
  lado,
  setores: (setores ?? []).filter((s) => s.lado === lado),
}));

// Hospedagens, guias e avaliações são vinculados ao Local (não mais ao setor
// específico), já que uma hospedagem/guia costuma atender o lugar inteiro.
const { data: hospedagens } = local
  ? await supabase.from('hospedagens').select('*').eq('publicado', true).order('ordem') as { data: Hospedagem[] | null }
  : { data: null };
const hospedagensDoLocal = (hospedagens ?? []).filter((h) => (h.locais_ids ?? []).includes(local?.id ?? ''));

const { data: guias } = local
  ? await supabase.from('guias').select('*').eq('publicado', true).order('ordem') as { data: Guia[] | null }
  : { data: null };
const guiasDoLocal = (guias ?? []).filter((g) => (g.locais_ids ?? []).includes(local?.id ?? ''));

const { data: avaliacoes } = local
  ? await supabase
      .from('avaliacoes_locais_publicas')
      .select('*')
      .eq('local_id', local.id)
      .order('enviado_em', { ascending: false }) as { data: AvaliacaoLocalPublica[] | null }
  : { data: null };

const { data: fotosAvaliacoes } = local
  ? await supabase.from('avaliacoes_locais_fotos_publicas').select('*') as { data: FotoAvaliacaoLocalPublica[] | null }
  : { data: null };

function fotosDaAvaliacao(avaliacaoId: string) {
  return (fotosAvaliacoes ?? []).filter((f) => f.avaliacao_id === avaliacaoId);
}

const resumoAvaliacoes = (avaliacoes ?? []).length > 0
  ? {
      media: ((avaliacoes ?? []).reduce((soma, a) => soma + a.nota, 0) / (avaliacoes ?? []).length).toFixed(1),
      total: (avaliacoes ?? []).length,
    }
  : null;
---
<Layout titulo={local?.nome || 'Local'} descricao={local?.descricao || undefined}>
  {local ? (
    <section class="secao">
      <div class="container local-detalhe">
        <a href="/rotas" class="voltar">← Rotas & Setores</a>

        <h1>{local.nome}</h1>
        <p class="local-detalhe__local">{[local.regiao, local.cidade, local.estado].filter(Boolean).join(' · ')}</p>

        {local.descricao && <p class="local-detalhe__descricao">{local.descricao}</p>}

        {local.como_chegar && (
          <div class="bloco">
            <h2>Como chegar</h2>
            <p>{local.como_chegar}</p>
          </div>
        )}

        <div class="bloco">
          <h2>Setores</h2>

          {(!setores || setores.length === 0) && (
            <p class="vazio">Ainda não temos setores cadastrados aqui.</p>
          )}

          {lados.length > 0 ? (
            <>
              {lados.map((l) => (
                <div class="lado-grupo">
                  <h3>Lado {l.lado}</h3>
                  <ul class="setores-lista">
                    {l.setores.map((s) => (
                      <li>
                        <a href={`/rotas/${local.slug}/${s.slug}`} class="setores-lista__link">{s.nome}</a>
                        {s.descricao && <p class="setores-lista__desc">{s.descricao}</p>}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              {semLado.length > 0 && (
                <div class="lado-grupo">
                  <ul class="setores-lista">
                    {semLado.map((s) => (
                      <li>
                        <a href={`/rotas/${local.slug}/${s.slug}`} class="setores-lista__link">{s.nome}</a>
                        {s.descricao && <p class="setores-lista__desc">{s.descricao}</p>}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </>
          ) : (
            <ul class="setores-lista">
              {semLado.map((s) => (
                <li>
                  <a href={`/rotas/${local.slug}/${s.slug}`} class="setores-lista__link">{s.nome}</a>
                  {s.descricao && <p class="setores-lista__desc">{s.descricao}</p>}
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="bloco">
          <h2>Onde ficar</h2>
          {hospedagensDoLocal.length > 0 ? (
            <ul class="hospedagens-lista">
              {hospedagensDoLocal.map((h) => (
                <li class="hospedagem-item">
                  <strong>{h.nome}</strong>
                  {h.distancia && <span class="hospedagem-item__distancia"> · {h.distancia}</span>}
                  {h.tem_desconto && (
                    <span class="hospedagem-item__desconto">🎟️ Desconto Climbeiros{h.desconto_desc ? `: ${h.desconto_desc}` : ''}</span>
                  )}
                  <div class="hospedagem-item__contato">
                    {h.contato_reserva && <span>{h.contato_reserva}</span>}
                    {h.link_reserva && <a href={h.link_reserva} target="_blank" rel="noopener">Reservar</a>}
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="vazio">Ainda não temos hospedagens cadastradas perto daqui.</p>
          )}

          <details class="cadastro-detalhes">
            <summary>Tem uma hospedagem por aqui? Cadastre-se</summary>
            <form
              class="form-hospedagem"
              id="form-hospedagem"
            >
              <div class="linha">
                <label>
                  Nome da hospedagem *
                  <input type="text" name="nome" required />
                </label>
                <label>
                  Distância até aqui
                  <input type="text" name="distancia" placeholder="Ex.: a 5 min a pé, 10 km de carro" />
                </label>
              </div>
              <div class="linha">
                <label>
                  Contato para reserva *
                  <input type="text" name="contato_reserva" placeholder="Telefone, WhatsApp ou e-mail" required />
                </label>
                <label>
                  Link de reserva (opcional)
                  <input type="url" name="link_reserva" placeholder="Booking, site próprio, Instagram..." />
                </label>
              </div>
              <label>
                Locais que atende
                <input type="text" name="locais_interesse" value={local.nome} />
                <small>Se atender mais de um local, pode listar todos aqui, separados por vírgula.</small>
              </label>
              <label class="cupom-toggle">
                <input type="checkbox" name="tem_desconto" id="hp-tem-desconto" />
                Quero oferecer desconto para quem vier do Climbeiros
              </label>
              <div class="cupom-campos" id="hp-desconto-campos" hidden>
                <label>
                  Código do desconto
                  <input type="text" name="desconto_codigo" placeholder="Ex.: CLIMBEIROS10" />
                </label>
                <label>
                  Como funciona o desconto?
                  <textarea name="desconto_desc" rows="2" placeholder="Ex.: 10% na diária pra quem mencionar o Climbeiros"></textarea>
                </label>
              </div>
              <label>
                Mensagem (opcional)
                <textarea name="mensagem" rows="3"></textarea>
              </label>
              <input type="text" name="site" class="campo-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <button type="submit" class="botao botao--pequeno">Enviar cadastro</button>
              <p class="form-status" role="status"></p>
              <p class="form-aviso">Seu cadastro passa por uma checagem da equipe do Climbeiros antes de aparecer aqui.</p>
            </form>
          </details>
        </div>

        <div class="bloco">
          <h2>Guias que atuam aqui</h2>
          {guiasDoLocal.length > 0 ? (
            <ul class="guias-lista">
              {guiasDoLocal.map((g) => (
                <li class="guia-item">
                  <strong>{g.nome}</strong>
                  {g.especialidades && g.especialidades.length > 0 && (
                    <span class="guia-item__espec"> · {g.especialidades.join(', ')}</span>
                  )}
                  <div class="guia-item__contato">
                    {g.whatsapp && <a href={`https://wa.me/${g.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>}
                    {g.instagram && <a href={`https://instagram.com/${g.instagram}`} target="_blank" rel="noopener">Instagram</a>}
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="vazio">Ainda não temos guias indicados para este local.</p>
          )}
          <p class="cta-guia">
            Você é guia e atua aqui? <a href="/cursos#seja-guia">Cadastre-se na nossa rede de guias →</a>
          </p>
        </div>

        <div class="bloco">
          <h2>Avaliações da comunidade</h2>
          {resumoAvaliacoes ? (
            <p class="avaliacao-resumo">
              <span class="avaliacao-resumo__estrelas" aria-hidden="true">★</span>
              <strong>{resumoAvaliacoes.media}</strong> · {resumoAvaliacoes.total} avaliaç{resumoAvaliacoes.total === 1 ? 'ão' : 'ões'}
            </p>
          ) : (
            <p class="avaliacao-resumo avaliacao-resumo--vazia">Ainda sem avaliações</p>
          )}

          {avaliacoes && avaliacoes.length > 0 && (
            <ul class="avaliacao-lista">
              {avaliacoes.map((a) => (
                <li class="avaliacao-item">
                  <div class="avaliacao-item__topo">
                    <span class="avaliacao-item__estrelas" aria-hidden="true">{'★'.repeat(a.nota)}{'☆'.repeat(5 - a.nota)}</span>
                    <strong>{a.nome}</strong>
                  </div>
                  {a.comentario && <p class="avaliacao-item__comentario">{a.comentario}</p>}
                  {a.link_video && (
                    <p class="avaliacao-item__video">
                      <a href={a.link_video} target="_blank" rel="noopener">Ver vídeo →</a>
                    </p>
                  )}
                  {fotosDaAvaliacao(a.id).length > 0 && (
                    <div class="avaliacao-item__fotos">
                      {fotosDaAvaliacao(a.id).map((f) => (
                        <img src={f.imagem_url} alt={`Foto enviada por ${a.nome}`} loading="lazy" />
                      ))}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          )}

          <details class="cadastro-detalhes">
            <summary>Já escalou aqui? Deixe sua avaliação</summary>
            <form
              class="form-avaliacao"
              id="form-avaliacao-local"
              data-local-id={local.id}
            >
              <fieldset class="estrelas-input">
                <legend>Sua nota</legend>
                {[5, 4, 3, 2, 1].map((n) => (
                  <>
                    <input type="radio" name="nota" id={`av-nota-${n}`} value={n} required />
                    <label for={`av-nota-${n}`} title={`${n} estrela${n > 1 ? 's' : ''}`}>★</label>
                  </>
                ))}
              </fieldset>
              <label>
                Comentário (opcional)
                <textarea name="comentario" rows="3" placeholder="Dicas pra quem for escalar aqui: acesso, condição das vias, etc."></textarea>
              </label>
              <label>
                Link de vídeo (opcional)
                <input type="url" name="link_video" placeholder="Link do YouTube, Instagram ou TikTok" />
              </label>
              <label>
                Fotos (opcional, até 5 MB cada)
                <input type="file" name="fotos" accept="image/png, image/jpeg, image/webp" multiple />
              </label>
              <label>
                Seu nome
                <input type="text" name="nome" required />
              </label>
              <label>
                Seu e-mail
                <input type="email" name="email" required />
                <small>Não é exibido publicamente, usamos só pra contato, se precisar.</small>
              </label>
              <input type="text" name="site" class="campo-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <button type="submit" class="botao botao--pequeno">Enviar avaliação</button>
              <p class="form-status" role="status"></p>
              <p class="form-aviso">Sua avaliação (e fotos) passam por uma checagem da equipe do Climbeiros antes de aparecer aqui.</p>
            </form>
          </details>
        </div>
      </div>
    </section>
  ) : (
    <div class="container secao">
      <h1>Local não encontrado</h1>
      <a href="/rotas">Voltar para Rotas & Setores</a>
    </div>
  )}
</Layout>

<script>
  import { supabase } from '../../../lib/supabase';

  // ---- Formulário de cadastro de hospedagem ----
  const formHosp = document.getElementById('form-hospedagem') as HTMLFormElement | null;
  const statusHosp = formHosp?.querySelector('.form-status') as HTMLElement | null;
  const toggleDesconto = document.getElementById('hp-tem-desconto') as HTMLInputElement | null;
  const camposDesconto = document.getElementById('hp-desconto-campos');

  toggleDesconto?.addEventListener('change', () => {
    if (camposDesconto) camposDesconto.hidden = !toggleDesconto.checked;
  });

  formHosp?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusHosp) return;
    const dados = new FormData(formHosp);

    if (dados.get('site')) {
      statusHosp.textContent = 'Cadastro enviado!';
      formHosp.reset();
      return;
    }

    const botao = formHosp.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    botao?.setAttribute('disabled', '');
    statusHosp.textContent = 'Enviando...';

    const temDesconto = (dados.get('tem_desconto') as string) === 'on';

    const { error } = await supabase.from('inscricoes_hospedagens').insert([{
      nome: dados.get('nome'),
      contato_reserva: dados.get('contato_reserva'),
      link_reserva: dados.get('link_reserva') || null,
      distancia: dados.get('distancia') || null,
      locais_interesse: dados.get('locais_interesse') || null,
      tem_desconto: temDesconto ? 'Sim' : 'Não',
      desconto_codigo: temDesconto ? (dados.get('desconto_codigo') || null) : null,
      desconto_desc: temDesconto ? (dados.get('desconto_desc') || null) : null,
      mensagem: dados.get('mensagem') || null,
    }]);

    if (error) {
      statusHosp.textContent = 'Ops, algo deu errado: ' + error.message;
    } else {
      statusHosp.textContent = 'Recebemos seu cadastro! Ele passa por uma checagem antes de aparecer no site.';
      formHosp.reset();
    }
    botao?.removeAttribute('disabled');
  });

  // ---- Formulário de avaliação (nota + comentário + fotos + vídeo) ----
  const formAv = document.getElementById('form-avaliacao-local') as HTMLFormElement | null;
  const statusAv = formAv?.querySelector('.form-status') as HTMLElement | null;

  formAv?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusAv || !formAv) return;
    const dados = new FormData(formAv);

    if (dados.get('site')) {
      statusAv.textContent = 'Avaliação enviada!';
      formAv.reset();
      return;
    }

    const nota = dados.get('nota');
    if (!nota) {
      statusAv.textContent = 'Escolha uma nota de 1 a 5 estrelas.';
      return;
    }

    const botao = formAv.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    botao?.setAttribute('disabled', '');
    statusAv.textContent = 'Enviando...';

    try {
      const { data: avaliacaoInserida, error: erroAvaliacao } = await supabase
        .from('avaliacoes_locais')
        .insert({
          local_id: formAv.dataset.localId,
          nome: dados.get('nome'),
          email: dados.get('email'),
          nota: Number(nota),
          comentario: dados.get('comentario') || null,
          link_video: dados.get('link_video') || null,
        })
        .select('id')
        .single();

      if (erroAvaliacao || !avaliacaoInserida) {
        statusAv.textContent = 'Erro ao enviar: ' + (erroAvaliacao?.message ?? 'tente novamente.');
        botao?.removeAttribute('disabled');
        return;
      }

      const arquivos = (formAv.querySelector('input[name="fotos"]') as HTMLInputElement | null)?.files;
      if (arquivos && arquivos.length > 0) {
        for (const arquivo of Array.from(arquivos)) {
          if (arquivo.size > 5 * 1024 * 1024) continue; // pula fotos maiores que 5 MB
          const extensao = arquivo.name.split('.').pop();
          const nomeArquivo = `${Date.now()}-${Math.random().toString(36).slice(2)}.${extensao}`;

          const { error: erroUpload } = await supabase.storage
            .from('fotos-avaliacoes-setores')
            .upload(nomeArquivo, arquivo);
          if (erroUpload) continue;

          const { data: urlPublica } = supabase.storage
            .from('fotos-avaliacoes-setores')
            .getPublicUrl(nomeArquivo);

          await supabase.from('avaliacoes_locais_fotos').insert({
            avaliacao_id: avaliacaoInserida.id,
            imagem_url: urlPublica.publicUrl,
          });
        }
      }

      statusAv.textContent = 'Obrigado! Sua avaliação passa por uma checagem antes de aparecer no site.';
      formAv.reset();
    } catch (err) {
      statusAv.textContent = 'Erro inesperado: ' + (err instanceof Error ? err.message : String(err));
    }

    botao?.removeAttribute('disabled');
  });
</script>

<style>
  .voltar { display: inline-block; margin-bottom: 20px; font-family: var(--fonte-display); text-transform: uppercase; font-size: 0.85rem; }
  .local-detalhe { max-width: 760px; }
  .local-detalhe__local { opacity: 0.7; font-size: 0.95rem; margin-top: -8px; }
  .local-detalhe__descricao { margin-top: 12px; }

  .bloco { margin-top: 32px; padding-top: 20px; border-top: 1px solid rgba(42, 31, 22, 0.12); }
  .bloco h2 { font-family: var(--fonte-display); text-transform: uppercase; font-size: 1.2rem; color: var(--verde-escuro); margin-bottom: 10px; }

  .vazio { opacity: 0.65; font-style: italic; }

  .lado-grupo { margin-top: 18px; }
  .lado-grupo:first-child { margin-top: 0; }
  .lado-grupo h3 {
    font-family: var(--fonte-display);
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    color: var(--laranja);
    margin-bottom: 8px;
  }
  .setores-lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .setores-lista li { background: var(--creme-claro); border-radius: 8px; padding: 12px 14px; }
  .setores-lista__link { font-family: var(--fonte-display); text-transform: uppercase; font-size: 0.95rem; color: var(--verde-escuro); text-decoration: none; }
  .setores-lista__link:hover { text-decoration: underline; }
  .setores-lista__desc { margin: 6px 0 0; font-size: 0.88rem; opacity: 0.85; }

  .hospedagens-lista, .guias-lista, .avaliacao-lista { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .hospedagem-item, .guia-item { background: var(--creme-claro); border-radius: 8px; padding: 10px 12px; font-size: 0.92rem; }
  .hospedagem-item__distancia, .guia-item__espec { opacity: 0.75; }
  .hospedagem-item__desconto { display: block; margin-top: 4px; color: var(--laranja); font-weight: 600; font-size: 0.85rem; }
  .hospedagem-item__contato, .guia-item__contato { display: flex; gap: 12px; margin-top: 6px; flex-wrap: wrap; font-size: 0.85rem; }

  .cta-guia { font-size: 0.9rem; margin-top: 10px; }

  .avaliacao-resumo { display: flex; align-items: center; gap: 6px; margin: 0 0 12px; font-size: 0.95rem; }
  .avaliacao-resumo__estrelas { color: var(--amarelo); }
  .avaliacao-resumo--vazia { opacity: 0.6; font-style: italic; }
  .avaliacao-item__topo { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
  .avaliacao-item__estrelas { color: var(--amarelo); letter-spacing: 1px; }
  .avaliacao-item__comentario { margin: 4px 0 0; font-size: 0.9rem; opacity: 0.9; }
  .avaliacao-item__video { margin: 6px 0 0; font-size: 0.85rem; }
  .avaliacao-item__fotos { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .avaliacao-item__fotos img { width: 84px; height: 84px; object-fit: cover; border-radius: 6px; }

  .cadastro-detalhes summary {
    cursor: pointer;
    font-family: var(--fonte-display);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--laranja);
    margin-top: 10px;
  }
  .cadastro-detalhes[open] summary { margin-bottom: 12px; }

  .form-hospedagem, .form-avaliacao {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--branco);
    border: 1px solid rgba(42, 31, 22, 0.15);
    border-radius: 8px;
    padding: 14px;
  }
  .form-hospedagem .linha, .form-avaliacao .linha { display: flex; gap: 12px; flex-wrap: wrap; }
  .form-hospedagem .linha > *, .form-avaliacao .linha > * { flex: 1; min-width: 200px; }
  .form-hospedagem label, .form-avaliacao label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--fonte-display);
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--verde-escuro);
