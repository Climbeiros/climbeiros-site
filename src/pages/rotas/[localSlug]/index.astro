    content: '+'; flex: 0 0 auto; width: 28px; height: 28px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--creme-claro); color: var(--verde-escuro); font-weight: 700; font-size: 1.1rem;
  }
  .bloco--recolhivel[open] > .bloco__titulo::after { content: '−'; }
  .bloco--recolhivel[open] > .bloco__titulo { margin-bottom: 10px; }
  .bloco__contagem { margin-left: auto; font-size: 0.85rem; opacity: 0.7; white-space: nowrap; }

  .vazio { opacity: 0.65; font-style: italic; }

  .lado-grupo { margin-top: 18px; }
  .lado-grupo:first-child { margin-top: 0; }
  .lado-grupo h3 {
    font-family: var(--fonte-display);
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    color: var(--laranja);
    margin-bottom: 8px;
  }
  .setores-lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .setores-lista li { background: var(--creme-claro); border-radius: 8px; padding: 12px 14px; }
  .setores-lista__link { font-family: var(--fonte-display); text-transform: uppercase; font-size: 0.95rem; color: var(--verde-escuro); text-decoration: none; }
  .setores-lista__link:hover { text-decoration: underline; }
  .videos-lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .videos-lista li { background: var(--creme-claro); border-radius: 8px; padding: 12px 14px; }
