---
// src/pages/crux/como-ler-croqui.astro
//
// Como ler um croqui: um croqui de exemplo, desenhado em SVG, em que cada
// símbolo é clicável e mostra o que significa. Conteúdo fixo no código
// (não vem do Supabase). Os textos de cada símbolo ficam no array SIMBOLOS.
import Layout from '../../layouts/Layout.astro';

const SIMBOLOS = [
  {
    id: 'numero',
    nome: 'Número da via',
    texto: 'Liga o desenho à lista de vias que vem junto do croqui, com nome, grau e tamanho. A numeração costuma seguir a ordem da parede.',
  },
  {
    id: 'linha',
    nome: 'Linha da via',
    texto: 'Mostra por onde a via sobe. Siga a linha, não a agarra mais bonita: vias vizinhas podem passar bem pertinho uma da outra.',
  },
  {
    id: 'chapeleta',
    nome: 'Chapeleta',
    texto: 'Cada X é uma proteção fixa na rocha. Conte quantas a via tem: é o número de costuras que você leva, mais duas de folga.',
  },
  {
    id: 'parada',
    nome: 'Parada',
    texto: 'O fim da via ou da enfiada. Normalmente são duas proteções juntas, onde você se prende, monta a descida ou faz a segurança do parceiro.',
  },
  {
    id: 'enfiada',
    nome: 'Enfiada',
    texto: 'Vias longas são divididas em enfiadas, trechos que terminam numa parada. Aqui a via 2 tem duas: a 1ª vai até a parada logo acima do teto e a 2ª até o topo. Cada enfiada pode ter o próprio grau.',
  },
  {
    id: 'grau',
    nome: 'Grau',
    texto: 'A dificuldade da via. Nos croquis brasileiros aparece o grau geral (5º, 6º, 7a…) e às vezes o grau do crux. Também pode vir a exposição, de E1 (bem protegida) a E5 (muito perigosa em caso de queda). A explicação completa está em Graduação, no Escalada 101.',
  },
  {
    id: 'altura',
    nome: 'Altura',
    texto: 'O tamanho da via em metros. Serve pra escolher a corda: pra baixar alguém do topo até o chão, ela precisa ter pelo menos o dobro da altura da via.',
  },
  {
    id: 'teto',
    nome: 'Teto',
    texto: 'Trecho em que a rocha fica quase na horizontal, por cima da sua cabeça: é o negativo levado ao extremo. Costuma exigir bastante força.',
  },
  {
    id: 'movel',
    nome: 'Fenda e linha tracejada',
    texto: 'Neste croqui, a linha tracejada é um trecho sem chapeleta: quem escala coloca a própria proteção (móvel) na fenda. Cada croqui tem sua legenda, então confira a dele. Mais sobre isso logo abaixo, em Exposição e proteção.',
  },
  {
    id: 'arvore',
    nome: 'Pontos de referência',
    texto: 'Árvores, blocos e plantas desenhados no croqui ajudam a achar o começo e o caminho da via quando você está na base.',
  },
  {
    id: 'descida',
    nome: 'Descida',
    texto: 'Mostra como sair do topo: de rapel, baixando pela própria via ou por uma trilha. Descubra a descida antes de subir.',
  },
  {
    id: 'acesso',
    nome: 'Trilha de acesso',
    texto: 'O caminho até a base. O croqui completo costuma dizer também onde estacionar e quanto tempo de caminhada leva.',
  },
];

const FICHA = [
  { rotulo: 'Número', titulo: '2', texto: 'É o número desenhado na base da via no croqui.' },
  { rotulo: 'Nome', titulo: 'Teto Imaginário', texto: 'Quem abre a via escolhe o nome. É assim que a galera vai falar dela.' },
  { rotulo: 'Grau', titulo: '7a', texto: 'Grau geral da via, na escala brasileira. Na rocha, comece abaixo do que você faz na academia.' },
  { rotulo: 'Exposição', titulo: 'E2', texto: 'Via com proteção regular. Pela escala brasileira, E1 é bem protegida e, a partir do E3, aparecem trechos perigosos em caso de queda.' },
  { rotulo: 'Tamanho', titulo: '40 m · 2 enfiadas', texto: 'A via tem duas paradas. Confira se a corda dá pra descer de cada uma.' },
  { rotulo: 'Proteção', titulo: '7 chapeletas', texto: 'São 4 na 1ª enfiada e 3 na 2ª. Leve costuras pra maior enfiada, mais duas: 6. Numa via mista, aqui viria também a proteção móvel, tipo "friends médios".' },
  { rotulo: 'Conquista', titulo: 'Ana e Beto, 2019', texto: 'Quem abriu a via e quando. Qualquer mudança na via se conversa com eles ou com a associação local.' },
];

const BOULDER = [
  { rotulo: 'Foto', titulo: 'Muitas vezes é uma foto do bloco', texto: 'Em vez de desenho, muitos croquis de boulder usam uma foto com as linhas marcadas por cima.' },
  { rotulo: 'Grau', titulo: 'Escala V', texto: 'No Brasil, o mais comum é a escala americana: V0, V1, V2… Ela não se compara direto com o grau das vias com corda.' },
  { rotulo: 'Saída', titulo: 'SD ou "sentado"', texto: 'Quando o problema começa com você sentado no chão, o croqui marca SD (sit start).' },
  { rotulo: 'Topo', titulo: 'Por onde descer', texto: 'Olhe o caminho de descida do bloco antes de subir. Às vezes é pelo lado de trás.' },
];

const DICAS = [
  'Leia a legenda antes de tudo. Cada autor desenha de um jeito, e o mesmo símbolo pode mudar de um croqui pro outro.',
  'Na base, ache a via pelos pontos de referência e confirme contando as primeiras chapeletas.',
  'Confira altura e número de chapeletas antes de subir: são eles que dizem que corda e quantas costuras levar.',
  'O croqui pode estar desatualizado, com chapeleta trocada ou via fechada. Pergunte pra quem escala ali.',
  'Salve o croqui no celular antes de sair, porque o sinal na rocha costuma ser fraco.',
  'Nó na ponta da corda, sempre, mesmo quando o croqui diz que a corda dá.',
];
---
<Layout titulo="Como ler um croqui" descricao="Croqui interativo: clique em cada símbolo pra entender chapeleta, parada, enfiada, grau, altura e descida, e saiba ler a ficha de uma via.">
  <section class="pagina-hero">
    <div class="pagina-hero__contorno" aria-hidden="true"></div>
    <div class="container pagina-hero__conteudo">
      <span class="eyebrow">Crux</span>
      <h1>Como ler um croqui</h1>
      <p class="lead">O croqui é o mapa da parede: mostra onde cada via começa, por onde sobe, quanta proteção tem e como descer. Aprenda a ler o desenho antes de chegar na base.</p>
      <nav class="sumario" aria-label="Nesta página">
        <a href="#croqui">O croqui</a>
        <a href="#avisos">Exposição e proteção</a>
        <a href="#ficha">A ficha da via</a>
        <a href="#boulder">Croqui de boulder</a>
        <a href="#dicas">Dicas</a>
      </nav>
    </div>
  </section>

  <section class="secao" id="croqui">
    <div class="container">
      <div class="grupo-cabecalho">
        <span class="numero">01</span>
        <h2>Clique nos símbolos</h2>
      </div>
      <p class="croqui-intro">Um croqui de exemplo, de um setor imaginário com três vias. Toque em qualquer parte do desenho, ou nos nomes da legenda, pra ver o que significa.</p>

      <div class="croqui-layout">
        <figure class="croqui-figura">
          <svg class="croqui-svg" viewBox="0 0 420 530" role="img" aria-label="Croqui de exemplo com três vias">
            <!-- chão e rocha -->
            <rect x="0" y="488" width="420" height="42" fill="#cfd8bf" />
            <path d="M30,490 L40,120 Q60,60 140,50 L280,40 Q370,45 392,110 L396,490 Z" fill="#ece5d2" stroke="#b9ad8f" stroke-width="2" />

            <!-- trilha de acesso -->
            <g class="simbolo" data-s="acesso" tabindex="0" role="button" aria-label="Trilha de acesso">
              <path class="toque" d="M0,512 C120,500 260,516 420,504" />
              <path class="traco" d="M0,512 C120,500 260,516 420,504" fill="none" stroke="#8a7a5a" stroke-width="2.5" stroke-dasharray="6 6" />
            </g>

            <!-- fenda -->
            <g class="simbolo" data-s="movel" tabindex="0" role="button" aria-label="Fenda e trecho de proteção móvel">
              <path class="toque" d="M326,470 C334,420 318,390 324,340 C330,290 314,250 318,200 C321,175 312,160 311,150" />
              <path class="traco" d="M326,470 C334,420 318,390 324,340 C330,290 314,250 318,200 C321,175 312,160 311,150" fill="none" stroke="#6b5f48" stroke-width="3" />
              <path class="traco" d="M314,478 C322,420 306,390 312,340 C318,290 302,250 306,200 C309,175 302,160 302,146" fill="none" stroke="#3d5439" stroke-width="3" stroke-dasharray="7 6" />
            </g>

            <!-- linhas das vias 1 e 2 -->
            <g class="simbolo" data-s="linha" tabindex="0" role="button" aria-label="Linha da via">
              <path class="toque" d="M110,478 C112,400 105,330 112,260 C118,190 112,150 118,108" />
              <path class="toque" d="M215,478 C214,420 222,370 226,322 C228,300 232,292 236,280 C240,230 234,170 240,94" />
              <path class="traco" d="M110,478 C112,400 105,330 112,260 C118,190 112,150 118,108" fill="none" stroke="#3d5439" stroke-width="3" />
              <path class="traco" d="M215,478 C214,420 222,370 226,322 C228,300 232,292 236,280 C240,230 234,170 240,94" fill="none" stroke="#3d5439" stroke-width="3" />
            </g>

            <!-- teto -->
            <g class="simbolo" data-s="teto" tabindex="0" role="button" aria-label="Teto">
              <path class="forma" d="M178,300 L272,288 L276,304 L182,318 Z" fill="#8f8268" />
            </g>

            <!-- chapeletas -->
            <g class="simbolo" data-s="chapeleta" tabindex="0" role="button" aria-label="Chapeletas">
              {[[110,432],[108,378],[108,322],[113,266],[115,212],[116,160],[214,440],[218,398],[223,355],[228,312],[237,252],[236,200],[237,150]].map(([x, y]) => (
                <g transform={`translate(${x},${y})`}>
                  <circle class="toque-ponto" r="11" />
                  <path class="marca" d="M-5,-5 L5,5 M5,-5 L-5,5" stroke="#da7326" stroke-width="3" stroke-linecap="round" />
                </g>
              ))}
            </g>

            <!-- paradas -->
            <g class="simbolo" data-s="parada" tabindex="0" role="button" aria-label="Paradas">
              {[[118,96],[238,266],[240,82],[302,134]].map(([x, y]) => (
                <g transform={`translate(${x},${y})`}>
                  <circle class="toque-ponto" r="13" />
                  <circle cx="-5" cy="0" r="4.5" fill="#fffdf7" stroke="#2a1f16" stroke-width="2.2" />
                  <circle cx="5" cy="0" r="4.5" fill="#fffdf7" stroke="#2a1f16" stroke-width="2.2" />
                </g>
              ))}
            </g>

            <!-- enfiadas -->
            <g class="simbolo" data-s="enfiada" tabindex="0" role="button" aria-label="Enfiadas">
              <rect class="toque-ponto" x="248" y="376" width="34" height="24" rx="6" />
              <rect class="toque-ponto" x="252" y="166" width="34" height="24" rx="6" />
              <text x="265" y="393" class="rotulo-svg">1ª</text>
              <text x="269" y="183" class="rotulo-svg">2ª</text>
            </g>

            <!-- graus -->
            <g class="simbolo" data-s="grau" tabindex="0" role="button" aria-label="Graus">
              <rect class="toque-ponto" x="122" y="452" width="34" height="24" rx="6" />
              <rect class="toque-ponto" x="180" y="452" width="30" height="24" rx="6" />
              <rect class="toque-ponto" x="334" y="446" width="34" height="24" rx="6" />
              <text x="139" y="469" class="rotulo-svg rotulo-grau">5º</text>
              <text x="195" y="469" class="rotulo-svg rotulo-grau">7a</text>
              <text x="351" y="463" class="rotulo-svg rotulo-grau">6º</text>
            </g>

            <!-- altura -->
            <g class="simbolo" data-s="altura" tabindex="0" role="button" aria-label="Altura da via">
              <rect class="toque-ponto" x="56" y="262" width="44" height="60" rx="6" />
              <path class="traco" d="M78,112 L78,474" stroke="#6b5f48" stroke-width="1.5" stroke-dasharray="3 4" />
              <path d="M72,112 L84,112 M72,474 L84,474" stroke="#6b5f48" stroke-width="1.5" />
              <rect x="60" y="280" width="36" height="22" rx="4" fill="#ece5d2" />
              <text x="78" y="296" class="rotulo-svg rotulo-pequeno">25 m</text>
            </g>

            <!-- árvore -->
            <g class="simbolo" data-s="arvore" tabindex="0" role="button" aria-label="Ponto de referência">
              <circle class="toque-ponto" cx="356" cy="84" r="22" />
              <rect x="352" y="88" width="7" height="22" fill="#6b5f48" />
              <circle class="forma" cx="356" cy="80" r="15" fill="#668062" />
            </g>

            <!-- descida -->
            <g class="simbolo" data-s="descida" tabindex="0" role="button" aria-label="Descida">
              <path class="toque" d="M104,92 C76,98 58,130 58,190" />
              <path class="traco traco-descida" d="M104,92 C76,98 58,130 58,186" fill="none" stroke="#e0931c" stroke-width="2.5" stroke-dasharray="5 5" />
              <path class="traco traco-descida" d="M51,180 L58,194 L65,180" fill="none" stroke="#e0931c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <text x="58" y="214" class="rotulo-svg rotulo-pequeno rotulo-descida">rapel</text>
            </g>

            <!-- números -->
            <g class="simbolo" data-s="numero" tabindex="0" role="button" aria-label="Números das vias">
              {[[110,'1'],[215,'2'],[314,'3']].map(([x, n]) => (
                <g transform={`translate(${x},492)`}>
                  <circle class="forma" r="11" fill="#3d5439" />
                  <text y="5" class="rotulo-numero">{n}</text>
                </g>
              ))}
            </g>
          </svg>
          <figcaption>Setor imaginário, só pra aprender. Os croquis reais de cada local estão em Rotas & Setores.</figcaption>
        </figure>

        <div class="croqui-lado">
          <div class="croqui-info" aria-live="polite">
            <span class="croqui-info__rotulo">Toque num símbolo</span>
            <h3 id="croqui-info-titulo">O que é isso?</h3>
            <p id="croqui-info-texto">Escolha qualquer parte do desenho ou um item da legenda abaixo.</p>
          </div>
          <ul class="croqui-legenda">
            {SIMBOLOS.map((s) => (
              <li><button type="button" class="legenda-botao" data-s={s.id}>{s.nome}</button></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="secao secao--creme" id="avisos">
    <div class="container">
      <div class="grupo-cabecalho">
        <span class="numero">02</span>
        <h2>O que o croqui está te avisando</h2>
      </div>
      <p class="grupo-intro">Duas informações do croqui dizem se uma via é pra você hoje, mais até do que o grau: a exposição e o tipo de proteção.</p>

      <h3 class="aviso-titulo">Exposição: o tamanho da encrenca se você cair</h3>
      <p class="aviso-texto">Duas vias com o mesmo grau podem ser bem diferentes. No sistema brasileiro de graduação, a exposição vai de E1 a E5:</p>
      <ul class="escala-e">
        <li><strong>E1</strong> vias bem protegidas</li>
        <li><strong>E2</strong> proteção regular</li>
        <li><strong>E3</strong> proteção regular, com trechos perigosos</li>
        <li><strong>E4</strong> vias perigosas em caso de queda</li>
        <li><strong>E5</strong> vias muito perigosas em caso de queda</li>
      </ul>
      <p class="fonte-nota">Fonte: Sistema Brasileiro de Graduação de Vias, aprovado pela CBME em 2007.</p>
      <p class="aviso-texto">Por que a distância entre as proteções pesa tanto: quem cai acima da última proteção despenca mais ou menos o dobro dessa distância, somando ainda a folga e a elasticidade da corda.</p>
      <div class="comparacao comparacao--2">
        <figure class="mini-croqui">
          <svg viewBox="0 0 200 300" role="img" aria-label="Via com chapeletas próximas: queda curta">
            <rect x="20" y="10" width="160" height="262" rx="8" fill="#ece5d2" />
            <rect x="0" y="272" width="200" height="28" fill="#cfd8bf" />
            <path d="M100,272 L100,20" stroke="#3d5439" stroke-width="3" />
            <g stroke="#da7326" stroke-width="3" stroke-linecap="round">
              {[230, 190, 150, 110, 70].map((y) => <path d={`M95,${y - 5} L105,${y + 5} M105,${y - 5} L95,${y + 5}`} />)}
            </g>
            <circle cx="100" cy="52" r="7" fill="#2a1f16" />
            <path d="M118,52 L118,94" stroke="#da7326" stroke-width="2.5" stroke-dasharray="4 4" />
            <path d="M112,88 L118,98 L124,88" fill="none" stroke="#da7326" stroke-width="2.5" stroke-linecap="round" />
            <text x="128" y="76" class="mini-rotulo">queda</text>
            <text x="128" y="94" class="mini-rotulo">curta</text>
          </svg>
          <figcaption><strong>E1</strong> Chapeletas próximas. Se cair, a queda é curta e livre.</figcaption>
        </figure>
        <figure class="mini-croqui">
          <svg viewBox="0 0 200 300" role="img" aria-label="Via com chapeletas espaçadas e platô: queda longa">
            <rect x="20" y="10" width="160" height="262" rx="8" fill="#ece5d2" />
            <rect x="0" y="272" width="200" height="28" fill="#cfd8bf" />
            <path d="M40,150 L150,150 L150,162 L40,162 Z" fill="#8f8268" />
            <text x="30" y="184" class="mini-rotulo mini-rotulo--perigo">bate no</text>
            <text x="30" y="202" class="mini-rotulo mini-rotulo--perigo">platô</text>
            <path d="M100,272 L100,20" stroke="#3d5439" stroke-width="3" />
            <g stroke="#da7326" stroke-width="3" stroke-linecap="round">
              {[235, 130].map((y) => <path d={`M95,${y - 5} L105,${y + 5} M105,${y - 5} L95,${y + 5}`} />)}
            </g>
            <circle cx="100" cy="40" r="7" fill="#2a1f16" />
            <path d="M126,40 L126,140" stroke="#a8540f" stroke-width="2.5" stroke-dasharray="4 4" />
            <path d="M120,134 L126,144 L132,134" fill="none" stroke="#a8540f" stroke-width="2.5" stroke-linecap="round" />
            <path d="M116,146 L120,140 M126,146 L126,138 M136,146 L132,140" stroke="#a8540f" stroke-width="2" stroke-linecap="round" />
            <text x="134" y="80" class="mini-rotulo mini-rotulo--perigo">queda</text>
            <text x="134" y="98" class="mini-rotulo mini-rotulo--perigo">longa</text>
          </svg>
          <figcaption><strong>E3, E4…</strong> Chapeletas espaçadas e um platô no caminho. A mesma queda pode virar acidente.</figcaption>
        </figure>
      </div>

      <h3 class="aviso-titulo">Proteção: fixa, móvel ou as duas</h3>
      <p class="aviso-texto">O croqui também diz o que você vai precisar pendurar na cadeirinha.</p>
      <div class="comparacao comparacao--3">
        <figure class="mini-croqui">
          <svg viewBox="0 0 140 240" role="img" aria-label="Via esportiva, só com chapeletas">
            <rect x="15" y="10" width="110" height="210" rx="8" fill="#ece5d2" />
            <path d="M70,220 L70,22" stroke="#3d5439" stroke-width="3" />
            <g stroke="#da7326" stroke-width="3" stroke-linecap="round">
              {[190, 150, 110, 70, 35].map((y) => <path d={`M65,${y - 5} L75,${y + 5} M75,${y - 5} L65,${y + 5}`} />)}
            </g>
          </svg>
          <figcaption><strong>Esportiva</strong> Só chapeletas. Leve costuras.</figcaption>
        </figure>
        <figure class="mini-croqui">
          <svg viewBox="0 0 140 240" role="img" aria-label="Via tradicional, só com proteção móvel na fenda">
            <rect x="15" y="10" width="110" height="210" rx="8" fill="#ece5d2" />
            <path d="M78,220 C86,180 70,150 78,110 C84,80 72,50 76,22" fill="none" stroke="#6b5f48" stroke-width="3" />
            <path d="M66,220 C74,180 58,150 66,110 C72,80 60,50 64,22" fill="none" stroke="#3d5439" stroke-width="3" stroke-dasharray="7 6" />
            <g fill="#668062">
              {[[79, 180], [75, 128], [76, 76]].map(([x, y]) => <path d={`M${x - 5},${y - 6} L${x + 5},${y - 6} L${x},${y + 6} Z`} />)}
            </g>
          </svg>
          <figcaption><strong>Móvel (trad)</strong> Nada fixo no caminho. Leve nuts, friends e fitas.</figcaption>
        </figure>
        <figure class="mini-croqui">
          <svg viewBox="0 0 140 240" role="img" aria-label="Via mista, com chapeletas e um trecho de fenda">
            <rect x="15" y="10" width="110" height="210" rx="8" fill="#ece5d2" />
            <path d="M70,220 L70,150" stroke="#3d5439" stroke-width="3" />
            <path d="M82,150 C88,130 76,110 82,90" fill="none" stroke="#6b5f48" stroke-width="3" />
            <path d="M70,150 C76,130 64,110 70,90" fill="none" stroke="#3d5439" stroke-width="3" stroke-dasharray="7 6" />
            <path d="M70,90 L70,22" stroke="#3d5439" stroke-width="3" />
            <g stroke="#da7326" stroke-width="3" stroke-linecap="round">
              {[195, 160, 70, 35].map((y) => <path d={`M65,${y - 5} L75,${y + 5} M75,${y - 5} L65,${y + 5}`} />)}
            </g>
            <path d="M78,114 L88,114 L83,126 Z" fill="#668062" />
          </svg>
          <figcaption><strong>Mista</strong> Chapeletas e trechos de fenda. Leve costuras e as peças móveis que o croqui indicar.</figcaption>
        </figure>
      </div>

      <div class="caixa-atencao aviso-caixa">
        <h3>Ainda não coloca proteção móvel?</h3>
        <p>Então vias trad e mistas ainda não são pra você, mesmo que o grau pareça fácil. Colocar e tirar proteção é técnica que se aprende no chão, com quem sabe. <a href="/cursos/">Ache um guia que ensina escalada tradicional →</a></p>
      </div>
    </div>
  </section>

  <section class="secao" id="ficha">
    <div class="container">
      <div class="grupo-cabecalho">
        <span class="numero">03</span>
        <h2>A ficha da via</h2>
      </div>
