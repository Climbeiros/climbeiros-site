<script define:vars={{ SIMBOLOS }}>
  // Ao tocar num símbolo do desenho ou num item da legenda, destaca todas as
  // partes com o mesmo símbolo e mostra a explicação ao lado.
  const porId = Object.fromEntries(SIMBOLOS.map((s) => [s.id, s]));
  const titulo = document.getElementById('croqui-info-titulo');
  const texto = document.getElementById('croqui-info-texto');
  const info = document.querySelector('.croqui-info');

  function escolher(id) {
    const s = porId[id];
    if (!s) return;
    document.querySelectorAll('[data-s]').forEach((el) => {
      el.classList.toggle('ativo', el.getAttribute('data-s') === id);
    });
    titulo.textContent = s.nome;
    texto.textContent = s.texto;
    info.classList.add('preenchido');
  }

  document.querySelectorAll('.simbolo, .legenda-botao').forEach((el) => {
    const id = el.getAttribute('data-s');
    el.addEventListener('click', () => {
      escolher(id);
      // No celular a explicação fica embaixo do desenho: rola até ela se não estiver à vista.
      if (el.classList.contains('simbolo')) {
        const r = info.getBoundingClientRect();
        if (r.top < 0 || r.bottom > window.innerHeight) info.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        escolher(id);
      }
    });
  });
</script>

