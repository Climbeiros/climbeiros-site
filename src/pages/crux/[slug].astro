---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import type { Artigo } from '../../lib/supabase';

export async function getStaticPaths() {
  const { data: artigos } = await supabase
    .from('artigos')
    .select('slug')
    .eq('categoria', 'crux') as { data: { slug: string }[] | null };
  return (artigos ?? []).map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const { data: artigo } = await supabase
  .from('artigos')
  .select('*')
  .eq('slug', slug)
  .eq('categoria', 'crux')
  .single() as { data: Artigo | null };
// --- Dados estruturados do artigo pro Google e IAs (ver Layout.astro) ---
const jsonLdArtigo = artigo
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: artigo.titulo,
        ...(artigo.resumo ? { description: artigo.resumo } : {}),
        ...(artigo.imagem_capa_url ? { image: artigo.imagem_capa_url } : {}),
        ...(artigo.publicado_em ? { datePublished: artigo.publicado_em } : {}),
        inLanguage: 'pt-BR',
        author: artigo.autor
          ? { '@type': 'Person', name: artigo.autor }
          : { '@type': 'Organization', name: 'Climbeiros', url: 'https://www.climbeiros.com.br/' },
        publisher: {
          '@type': 'Organization',
          name: 'Climbeiros',
          logo: { '@type': 'ImageObject', url: 'https://www.climbeiros.com.br/logo.png' },
        },
        mainEntityOfPage: new URL(`/crux/${artigo.slug}/`, Astro.site).href,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Crux', item: new URL('/crux/', Astro.site).href },
          { '@type': 'ListItem', position: 2, name: artigo.titulo, item: new URL(`/crux/${artigo.slug}/`, Astro.site).href },
        ],
      },
    ]
  : undefined;
---
<Layout titulo={artigo?.titulo || 'Artigo'} descricao={artigo?.resumo || undefined} imagem={artigo?.imagem_capa_url || undefined} tipo="article" jsonLd={jsonLdArtigo}>
  {artigo ? (
    <article class="secao">
      <div class="container artigo">
        <a href="/crux" class="voltar">← Crux</a>
        <h1>{artigo.titulo}</h1>
        {artigo.autor && <p class="artigo__meta">Por {artigo.autor}</p>}
        {artigo.imagem_capa_url && <img src={artigo.imagem_capa_url} alt={artigo.titulo} class="artigo__capa" />}
        <div class="artigo__conteudo" set:html={artigo.conteudo} />
      </div>
    </article>
  ) : (
    <div class="container secao">
      <h1>Artigo não encontrado</h1>
      <a href="/crux">Voltar para Crux</a>
    </div>
  )}
</Layout>

<style>
  .artigo { max-width: 760px; }
  .voltar { display: inline-block; margin-bottom: 20px; font-family: var(--fonte-display); text-transform: uppercase; font-size: 0.85rem; }
  .artigo__meta { opacity: 0.7; margin-top: -8px; }
  .artigo__capa { border-radius: var(--raio); margin: 20px 0; box-shadow: var(--sombra); }
  .artigo__conteudo { font-size: 1.05rem; }
  .artigo__conteudo :global(h2) { margin-top: 1.4em; }
</style>
