---
// src/pages/tecnicas.astro
//
// Página com os nomes das técnicas/posições de escalada em português e
// inglês, com uma ilustração simples de cada uma. Conteúdo fixo no
// código (não vem do Supabase) — pra adicionar, editar ou remover uma
// técnica, mexa direto no array TECNICAS aqui embaixo.
import Layout from '../../layouts/Layout.astro';
const TECNICAS = [
  {
    nome: 'Bandeira',
    ingles: 'Flag / Flagging',
    icone: 'bandeira',
    descricao:
      'A perna livre estica pro lado, sem tocar em nada, só pra fazer contrapeso. Evita que o corpo gire e "abra a porta" (barn door) pra longe da parede.',
    video: '/videos/tecnicas_flag.mov',
    videoThumb: '/images/tecnicas/bandeira.jpg',
  },
  {
    nome: 'Gancho de Calcanhar',
    ingles: 'Heel Hook',
    icone: 'gancho-calcanhar',
    descricao:
      'O calcanhar se apoia numa agarra ou saliência e puxa o corpo, funcionando quase como uma terceira mão. Muito usado em tetos e agarras altas.',
    video: '',
  },
  {
    nome: 'Gancho de Peito do Pé',
    ingles: 'Toe Hook',
    icone: 'gancho-peito-pe',
    descricao:
      'A parte de cima do pé engancha numa agarra ou embaixo de um teto, puxando o corpo pra dentro da parede, o oposto do gancho de calcanhar.',
    video: '',
  },
  {
    nome: 'Joelho Caído',
    ingles: 'Drop Knee (Egyptian)',
    icone: 'joelho-caido',
    descricao:
      'O quadril gira e o joelho cai pra dentro e pra baixo, aproximando o corpo da parede. Ganha alcance pro braço oposto sem precisar de tanta força.',
    video: '/videos/tecnicas_knee_drop.mov',
    videoThumb: '/images/tecnicas/joelho-caido.jpg',
  },
  {
    nome: 'Mantle (Apoio Alto)',
    ingles: 'Mantling',
    icone: 'mantle',
    descricao:
      'As mãos empurram uma borda ou ressalto pra baixo até o corpo ficar em pé sobre ela, tipo o movimento de sair da borda de uma piscina.',
    video: '/videos/tecnicas_balconar.mov',
    videoThumb: '/images/tecnicas/balconar.jpg',
  },
  {
    nome: 'Balconar',
    ingles: 'Mantle',
    icone: 'balcao',
    descricao:
      'É como muita gente por aqui chama o mantle: subir numa borda ou ressalto como se estivesse se apoiando pra subir num balcão. Mesmo movimento do card acima, nome mais popular na gíria brasileira.',
    video: '/videos/tecnicas_balconar.mov',
    videoThumb: '/images/tecnicas/balconar.jpg',
  },
  {
    nome: 'Grampo',
    ingles: 'Stemming',
    icone: 'grampo',
    descricao:
      'Mãos e pés empurram duas superfícies opostas, comum em diedros e chaminés, usando a força das pernas abertas pra segurar o corpo no lugar.',
    video: '',
  },
  {
    nome: 'Aderência',
    ingles: 'Smearing',
    icone: 'aderencia',
    descricao:
      'Sem agarra de pé definida: a sola da sapatilha encosta numa parte lisa da parede e o atrito sozinho segura o peso.',
    video: '',
  },
  {
    nome: 'Dinâmico',
    ingles: 'Dyno',
    icone: 'dinamico',
    descricao:
      'Um movimento explosivo: o escalador solta todos os apoios por um instante pra "voar" até uma agarra que estaria fora de alcance num movimento estático.',
    video: '',
  },
  {
    nome: 'Backstep',
    ingles: 'Backstep',
    icone: 'backstep',
    descricao:
      'A lateral externa do pé encosta na agarra e o quadril vira de lado pra parede, esticando o corpo e ganhando alcance com o braço de cima.',
    video: '',
  },
  {
    nome: 'Cruzada',
    ingles: 'Cross-Through',
    icone: 'cruzada',
    descricao:
      'Um braço cruza por cima do outro pra alcançar uma agarra do lado oposto, em vez de trocar de mão na mesma agarra.',
    video: '',
  },
  {
    nome: 'Pedalada',
    ingles: 'Foot Walking / Smearing Up',
    icone: 'pedalada',
    descricao:
      'Com as duas mãos numa agarra só, os pés "andam" subindo pela parede lisa, sem nenhuma agarra de pé, só o atrito da sapatilha segurando o peso a cada passo.',
    video: '',
  },
  {
    nome: 'Troca de Pé',
    ingles: 'Foot Swap',
    icone: 'troca-pe',
    descricao:
      'Troca rápida de pé em cima da mesma agarra de apoio — tira um pé e já encaixa o outro no lugar, sem perder o equilíbrio, pra ficar numa posição melhor pro próximo movimento.',
    video: '',
  },
];
---
<Layout titulo="Técnicas & Posições" descricao="Os nomes das técnicas e posições de escalada em português e inglês, com uma ilustração simples de cada uma.">
  <section class="pagina-hero">
    <div class="pagina-hero__contorno" aria-hidden="true"></div>
    <div class="container pagina-hero__conteudo">
      <span class="eyebrow">Crux</span>
      <h1>Técnicas & Posições</h1>
      <p class="lead">Os nomes que você vai ouvir na academia ou lendo sobre escalada lá fora, em português e em inglês, com uma ilustração simples pra entender a posição do corpo.</p>
    </div>
  </section>
  <section class="secao">
    <div class="container">
      <div class="grade grade--3 tecnicas-grade">
        {TECNICAS.map((tecnica) => (
          <div
            class={`card tecnica-card ${tecnica.video ? 'tecnica-card--comvideo' : ''}`}
