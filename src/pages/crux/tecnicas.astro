    <div class="video-lightbox__conteudo">
      <video id="video-lightbox-player" controls playsinline></video>
      <p id="video-lightbox-legenda" class="video-lightbox__legenda"></p>
    </div>
  </div>
</Layout>
<script>
  // Abre um vídeo em destaque quando a pessoa clica num card de técnica
  // que tem vídeo cadastrado (campo "video" no array TECNICAS lá em cima).
  const lightbox = document.getElementById('video-lightbox');
  const player = document.getElementById('video-lightbox-player');
  const legenda = document.getElementById('video-lightbox-legenda');
  const fechar = document.getElementById('video-lightbox-fechar');
  function abrirVideo(src, nome) {
    if (!lightbox || !player) return;
    player.src = src;
    if (legenda) legenda.textContent = nome || '';
    lightbox.hidden = false;
    player.play().catch(() => {});
  }
  function fecharVideo() {
    if (!lightbox || !player) return;
    lightbox.hidden = true;
    player.pause();
    player.src = '';
  }
  document.querySelectorAll('.tecnica-card--comvideo').forEach((card) => {
    card.addEventListener('click', () => {
      const src = card.getAttribute('data-video');
      if (src) abrirVideo(src, card.getAttribute('data-nome'));
    });
  });
  fechar?.addEventListener('click', fecharVideo);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) fecharVideo();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.hidden) fecharVideo();
  });
</script>
<style>
  .tecnicas-grade { align-items: stretch; }
  .tecnica-card {
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tecnica-card__topo {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .tecnica-card__icone {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--creme-claro);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .tecnica-card__icone svg {
    width: 38px;
    height: 38px;
    overflow: visible;
  }
  .tecnica-card__titulos h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .tecnica-card__ingles {
    display: block;
    font-family: var(--fonte-display);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--laranja);
    margin-top: 2px;
  }
  .tecnica-card p {
    margin: 0;
    font-size: 0.92rem;
    opacity: 0.88;
    line-height: 1.45;
  }
  .tecnica-card--comvideo {
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.2s ease;
  }
  .tecnica-card--comvideo:hover {
    transform: translateY(-3px);
    box-shadow: var(--sombra);
  }
  .tecnica-card__thumb {
    position: relative;
    margin-top: 4px;
    border-radius: 8px;
    overflow: hidden;
    line-height: 0;
  }
  .tecnica-card__thumb img {
    width: 100%;
    height: 130px;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease;
  }
  .tecnica-card--comvideo:hover .tecnica-card__thumb img {
    transform: scale(1.05);
  }
