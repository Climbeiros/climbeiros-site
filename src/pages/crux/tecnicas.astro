---
// src/pages/tecnicas.astro
//
// Página com os nomes das técnicas/posições de escalada em português e
// inglês, com uma ilustração simples de cada uma. Conteúdo fixo no
// código (não vem do Supabase) — pra adicionar, editar ou remover uma
// técnica, mexa direto no array TECNICAS aqui embaixo.

import Layout from '../../layouts/Layout.astro';

const TECNICAS = [
  {
    nome: 'Bandeira',
    ingles: 'Flag / Flagging',
    icone: 'bandeira',
    descricao:
      'A perna livre estica pro lado, sem tocar em nada, só pra fazer contrapeso. Evita que o corpo gire e "abra a porta" (barn door) pra longe da parede.',
  },
  {
    nome: 'Gancho de Calcanhar',
    ingles: 'Heel Hook',
    icone: 'gancho-calcanhar',
    descricao:
      'O calcanhar se apoia numa agarra ou saliência e puxa o corpo, funcionando quase como uma terceira mão — muito usado em tetos e agarras altas.',
  },
  {
    nome: 'Gancho de Peito do Pé',
    ingles: 'Toe Hook',
    icone: 'gancho-peito-pe',
    descricao:
      'A parte de cima do pé engancha numa agarra ou embaixo de um teto, puxando o corpo pra dentro da parede — o oposto do gancho de calcanhar.',
  },
  {
    nome: 'Joelho Caído',
    ingles: 'Drop Knee (Egyptian)',
    icone: 'joelho-caido',
    descricao:
      'O quadril gira e o joelho cai pra dentro e pra baixo, aproximando o corpo da parede — ganha alcance pro braço oposto sem precisar de tanta força.',
  },
  {
    nome: 'Mantle (Apoio Alto)',
    ingles: 'Mantling',
    icone: 'mantle',
    descricao:
      'As mãos empurram uma borda ou ressalto pra baixo até o corpo ficar em pé sobre ela — tipo o movimento de sair da borda de uma piscina.',
  },
  {
    nome: 'Balconar',
    ingles: 'Mantle',
    icone: 'balcao',
    descricao:
      'É como muita gente por aqui chama o mantle: subir numa borda ou ressalto como se estivesse se apoiando pra subir num balcão. Mesmo movimento do card acima, nome mais popular na gíria brasileira.',
  },
  {
    nome: 'Grampo',
    ingles: 'Stemming',
    icone: 'grampo',
    descricao:
      'Mãos e pés empurram duas superfícies opostas — comum em diedros e chaminés — usando a força das pernas abertas pra segurar o corpo no lugar.',
  },
  {
    nome: 'Aderência',
    ingles: 'Smearing',
    icone: 'aderencia',
    descricao:
      'Sem agarra de pé definida: a sola da sapatilha encosta numa parte lisa da parede e o atrito sozinho segura o peso.',
  },
  {
    nome: 'Dinâmico',
    ingles: 'Dyno',
    icone: 'dinamico',
    descricao:
      'Um movimento explosivo: o escalador solta todos os apoios por um instante pra "voar" até uma agarra que estaria fora de alcance num movimento estático.',
  },
  {
    nome: 'Backstep',
    ingles: 'Backstep',
    icone: 'backstep',
    descricao:
      'A lateral externa do pé encosta na agarra e o quadril vira de lado pra parede, esticando o corpo e ganhando alcance com o braço de cima.',
  },
  {
    nome: 'Cruzada',
    ingles: 'Cross-Through',
    icone: 'cruzada',
    descricao:
      'Um braço cruza por cima do outro pra alcançar uma agarra do lado oposto, em vez de trocar de mão na mesma agarra.',
  },
  {
    nome: 'Pedalada',
    ingles: 'Foot Walking / Smearing Up',
    icone: 'pedalada',
    descricao:
      'Com as duas mãos numa agarra só, os pés "andam" subindo pela parede lisa, sem nenhuma agarra de pé — só o atrito da sapatilha segurando o peso a cada passo.',
  },
  {
    nome: 'Troca de Pé',
    ingles: 'Foot Swap',
    icone: 'troca-pe',
    descricao:
      'Troca rápida de pé em cima da mesma agarra de apoio — tira um pé e já encaixa o outro no lugar, sem perder o equilíbrio, pra ficar numa posição melhor pro próximo movimento.',
  },
];
---
<Layout titulo="Técnicas & Posições" descricao="Os nomes das técnicas e posições de escalada em português e inglês, com uma ilustração simples de cada uma.">
  <section class="pagina-hero">
    <div class="pagina-hero__contorno" aria-hidden="true"></div>
    <div class="container pagina-hero__conteudo">
      <span class="eyebrow">Crux</span>
      <h1>Técnicas & Posições</h1>
      <p class="lead">Os nomes que você vai ouvir na academia ou lendo sobre escalada lá fora — em português e em inglês, com uma ilustração simples pra entender a posição do corpo.</p>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <div class="grade grade--3 tecnicas-grade">
        {TECNICAS.map((tecnica) => (
          <div class="card tecnica-card">
            <div class="tecnica-card__topo">
              <span class="tecnica-card__icone">
                {tecnica.icone === 'bandeira' && (
                  <svg viewBox="0 0 100 100">
                    <circle cx="34" cy="14" r="5" fill="#da7326" />
                    <circle cx="66" cy="14" r="5" fill="#da7326" />
                    <circle cx="42" cy="82" r="5" fill="#da7326" />
                    <path d="M50,40 L34,16" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,40 L66,16" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,40 L42,80" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,40 L80,64" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <circle cx="50" cy="30" r="7" fill="#3d5439" />
                  </svg>
                )}
                {tecnica.icone === 'gancho-calcanhar' && (
                  <svg viewBox="0 0 100 100">
                    <circle cx="26" cy="16" r="5" fill="#da7326" />
                    <circle cx="36" cy="82" r="5" fill="#da7326" />
                    <circle cx="80" cy="38" r="5" fill="#e0931c" />
                    <path d="M42,40 L26,18" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M42,40 L36,80" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M42,40 L64,44 L80,38" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="42" cy="30" r="7" fill="#3d5439" />
                  </svg>
                )}
                {tecnica.icone === 'gancho-peito-pe' && (
                  <svg viewBox="0 0 100 100">
                    <circle cx="32" cy="14" r="5" fill="#da7326" />
                    <circle cx="68" cy="14" r="5" fill="#da7326" />
                    <circle cx="58" cy="82" r="5" fill="#da7326" />
                    <circle cx="26" cy="52" r="5" fill="#e0931c" />
                    <path d="M50,38 L32,16" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,38 L68,16" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,58 L58,80" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,58 L34,54 L26,52" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="50" cy="28" r="7" fill="#3d5439" />
                  </svg>
                )}
                {tecnica.icone === 'joelho-caido' && (
                  <svg viewBox="0 0 100 100">
                    <circle cx="78" cy="14" r="5" fill="#da7326" />
                    <circle cx="22" cy="30" r="5" fill="#da7326" />
                    <circle cx="46" cy="82" r="5" fill="#da7326" />
                    <circle cx="70" cy="80" r="5" fill="#da7326" />
                    <path d="M50,36 L78,16" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,36 L22,30" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,55 L40,68 L46,80" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M50,55 L66,72 L70,80" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="46" cy="26" r="7" fill="#3d5439" />
                  </svg>
                )}
                {tecnica.icone === 'mantle' && (
                  <svg viewBox="0 0 100 100">
                    <line x1="15" y1="55" x2="85" y2="55" stroke="#2a1f16" stroke-width="4" opacity="0.3" />
                    <path d="M50,32 L30,55" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,32 L70,55" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,50 L42,68 L38,78" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M50,50 L58,68 L62,78" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="50" cy="22" r="7" fill="#3d5439" />
                  </svg>
                )}
                {tecnica.icone === 'balcao' && (
                  <svg viewBox="0 0 100 100">
                    <line x1="15" y1="52" x2="85" y2="52" stroke="#2a1f16" stroke-width="4" opacity="0.3" />
                    <path d="M48,30 L30,50" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M48,30 L66,48" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M48,45 L58,55 L62,58" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M48,45 L40,65 L36,78" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M50,20 Q58,10 66,16" stroke="#e0931c" stroke-width="3" fill="none" stroke-linecap="round" stroke-dasharray="2 4" />
                    <circle cx="54" cy="18" r="7" fill="#3d5439" />
                  </svg>
                )}
                {tecnica.icone === 'grampo' && (
                  <svg viewBox="0 0 100 100">
                    <path d="M20,10 L45,92" stroke="#2a1f16" stroke-width="3" opacity="0.25" />
                    <path d="M80,10 L55,92" stroke="#2a1f16" stroke-width="3" opacity="0.25" />
                    <path d="M50,40 L28,25" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,40 L72,25" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,55 L32,80" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,55 L68,80" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <circle cx="50" cy="30" r="7" fill="#3d5439" />
                  </svg>
                )}
                {tecnica.icone === 'aderencia' && (
                  <svg viewBox="0 0 100 100">
                    <circle cx="70" cy="18" r="5" fill="#da7326" />
                    <circle cx="34" cy="30" r="5" fill="#da7326" />
                    <ellipse cx="42" cy="81" rx="9" ry="4" fill="#2a1f16" opacity="0.2" />
                    <path d="M54,35 L70,18" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M54,35 L34,30" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M46,55 L40,78" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M46,55 L60,68 L66,74" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="54" cy="24" r="7" fill="#3d5439" />
                  </svg>
                )}
                {tecnica.icone === 'dinamico' && (
                  <svg viewBox="0 0 100 100">
                    <circle cx="50" cy="8" r="5" fill="#e0931c" />
                    <circle cx="30" cy="90" r="4" fill="#3d5439" opacity="0.25" />
                    <circle cx="70" cy="90" r="4" fill="#3d5439" opacity="0.25" />
                    <line x1="18" y1="30" x2="26" y2="24" stroke="#2a1f16" stroke-width="3" opacity="0.3" stroke-linecap="round" />
                    <line x1="74" y1="24" x2="82" y2="30" stroke="#2a1f16" stroke-width="3" opacity="0.3" stroke-linecap="round" />
                    <path d="M50,26 L40,10" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,26 L60,10" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,48 L35,62" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,48 L65,62" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <circle cx="50" cy="18" r="7" fill="#3d5439" />
                  </svg>
                )}
                {tecnica.icone === 'backstep' && (
                  <svg viewBox="0 0 100 100">
                    <circle cx="72" cy="12" r="5" fill="#da7326" />
                    <circle cx="26" cy="40" r="5" fill="#da7326" />
                    <circle cx="62" cy="80" r="5" fill="#e0931c" />
                    <path d="M46,33 L72,12" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M46,33 L26,40" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M46,55 L56,75 L62,80" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M46,55 L34,64 L30,58" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <line x1="58" y1="78" x2="68" y2="82" stroke="#3d5439" stroke-width="4" stroke-linecap="round" />
                    <circle cx="52" cy="22" r="7" fill="#3d5439" />
                  </svg>
                )}
                {tecnica.icone === 'cruzada' && (
                  <svg viewBox="0 0 100 100">
                    <circle cx="74" cy="16" r="5" fill="#da7326" />
                    <circle cx="82" cy="42" r="5" fill="#e0931c" />
                    <circle cx="40" cy="82" r="5" fill="#da7326" />
                    <path d="M50,33 L74,16" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,33 L62,26 L82,42" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M50,55 L40,80" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,55 L62,78" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <circle cx="50" cy="23" r="7" fill="#3d5439" />
                  </svg>
                )}
                {tecnica.icone === 'pedalada' && (
                  <svg viewBox="0 0 100 100">
                    <circle cx="50" cy="12" r="5" fill="#da7326" />
                    <ellipse cx="38" cy="76" rx="7" ry="3.5" fill="#2a1f16" opacity="0.2" />
                    <ellipse cx="64" cy="82" rx="7" ry="3.5" fill="#2a1f16" opacity="0.2" />
                    <path d="M74,68 L74,42" stroke="#e0931c" stroke-width="3" fill="none" stroke-dasharray="3 3" stroke-linecap="round" />
                    <polygon points="74,35 68,46 80,46" fill="#e0931c" />
                    <path d="M50,34 L42,14" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,34 L58,14" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,53 L42,66 L38,74" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M50,53 L60,70 L64,80" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="50" cy="26" r="7" fill="#3d5439" />
                  </svg>
                )}
                {tecnica.icone === 'troca-pe' && (
                  <svg viewBox="0 0 100 100">
                    <circle cx="26" cy="22" r="5" fill="#da7326" />
                    <circle cx="74" cy="22" r="5" fill="#da7326" />
                    <circle cx="50" cy="80" r="5" fill="#da7326" />
                    <circle cx="40" cy="72" r="4" fill="#3d5439" opacity="0.3" />
                    <circle cx="58" cy="74" r="4" fill="#3d5439" />
                    <path d="M40,72 Q49,60 58,74" stroke="#e0931c" stroke-width="3" fill="none" stroke-dasharray="3 3" stroke-linecap="round" />
                    <path d="M50,35 L26,24" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,35 L74,24" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,52 L58,74" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" />
                    <path d="M50,52 L40,68 L40,72" stroke="#3d5439" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="50" cy="27" r="7" fill="#3d5439" />
                  </svg>
                )}
              </span>
              <div class="tecnica-card__titulos">
                <h3>{tecnica.nome}</h3>
                <span class="tecnica-card__ingles">{tecnica.ingles}</span>
              </div>
            </div>
            <p>{tecnica.descricao}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .tecnicas-grade { align-items: stretch; }

  .tecnica-card {
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tecnica-card__topo {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .tecnica-card__icone {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--creme-claro);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tecnica-card__icone svg {
    width: 38px;
    height: 38px;
    overflow: visible;
  }

  .tecnica-card__titulos h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .tecnica-card__ingles {
    display: block;
    font-family: var(--fonte-display);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--laranja);
    margin-top: 2px;
  }

  .tecnica-card p {
    margin: 0;
    font-size: 0.92rem;
    opacity: 0.88;
    line-height: 1.45;
  }
</style>
