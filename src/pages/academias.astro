---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import type { Academia, AvaliacaoPublica } from '../lib/supabase';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;

const { data: academias } = await supabase
  .from('academias')
  .select('*')
  .order('nome') as { data: Academia[] | null };

const { data: avaliacoes } = await supabase
  .from('avaliacoes_publicas')
  .select('*')
  .order('enviado_em', { ascending: false }) as { data: AvaliacaoPublica[] | null };

// Agrupa as avaliações (já aprovadas — a view só devolve essas) por academia.
const avaliacoesPorAcademia = new Map<string, AvaliacaoPublica[]>();
(avaliacoes ?? []).forEach((av) => {
  const lista = avaliacoesPorAcademia.get(av.academia_id) ?? [];
  lista.push(av);
  avaliacoesPorAcademia.set(av.academia_id, lista);
});

function resumo(academiaId: string) {
  const lista = avaliacoesPorAcademia.get(academiaId) ?? [];
  if (lista.length === 0) return null;
  const media = lista.reduce((soma, a) => soma + a.nota, 0) / lista.length;
  return { media: media.toFixed(1), total: lista.length };
}

const temSeloIndica = (academias ?? []).some((a) => a.climbeiros_indica);
const textoSeloIndica = 'O selo "Climbeiros indica" identifica as academias que a gente conhece de perto, visitou e recomenda com confiança.';
---
<Layout titulo="Academias" descricao="Academias de escalada recomendadas pela comunidade Climbeiros.">
  <section class="secao">
    <div class="container">
      <p class="eyebrow">Onde treinar</p>
      <h1>Academias de escalada</h1>

      {temSeloIndica && (
        <p class="selo-disclaimer">
          <img class="selo-disclaimer__icone" src="/selo-climbeiros-indica.png" alt="" aria-hidden="true" />
          {textoSeloIndica}
        </p>
      )}

      {(!academias || academias.length === 0) && (
        <p>Ainda estamos cadastrando as primeiras academias. Volte em breve!</p>
      )}

      {academias && academias.length > 0 && (
        <>
          <div class="busca-local" data-busca-grupo="academias">
            <input
              type="text"
              class="busca-input"
              placeholder="Buscar por cidade ou CEP..."
              aria-label="Buscar academias por cidade ou CEP"
            />
            <button type="button" class="botao busca-botao">Buscar</button>
            <button type="button" class="botao botao--secundario busca-limpar" hidden>Limpar</button>
          </div>
          <p class="busca-status" role="status"></p>
        </>
      )}

      <div class="grade grade--3" data-busca-lista="academias">
        {academias?.map((a) => {
          const res = resumo(a.id);
          const comentarios = avaliacoesPorAcademia.get(a.id) ?? [];
          return (
            <article class="card" data-cidade={(a.cidade || '').toLowerCase()}>
              <div class="card__imagem-wrap">
                <img class="card__imagem" src={a.imagem_url || '/logo.png'} alt={a.nome} />
                {a.climbeiros_indica && (
                  <img
                    class="card__selo"
                    src="/selo-climbeiros-indica.png"
                    alt="Selo Climbeiros indica"
                    title={textoSeloIndica}
                    loading="lazy"
                  />
                )}
              </div>
              <div class="card__corpo">
                <h3>{a.nome}</h3>
                <p class="card__local">{a.cidade}{a.estado ? `, ${a.estado}` : ''}</p>
                {a.endereco && <p class="card__endereco">{a.endereco}</p>}
                {a.Modalidades && <p class="card__modalidades"><strong>Modalidades:</strong> {a.Modalidades}</p>}
                {a.descricao && <p>{a.descricao}</p>}
                <div class="card__links">
                  {a.website && <a href={a.website} target="_blank" rel="noopener">Site</a>}
                  {a.whatsapp && <a href={`https://wa.me/${a.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>}
                  {a.instagram && <a href={a.instagram} target="_blank" rel="noopener">Instagram</a>}
                </div>

                <div class="card__avaliacoes">
                  {res ? (
                    <p class="avaliacao-resumo">
                      <span class="avaliacao-resumo__estrelas" aria-hidden="true">★</span>
                      <strong>{res.media}</strong> · {res.total} avaliaç{res.total === 1 ? 'ão' : 'ões'}
                    </p>
                  ) : (
                    <p class="avaliacao-resumo avaliacao-resumo--vazia">Ainda sem avaliações</p>
                  )}

                  <details class="avaliacao-detalhes">
                    <summary>Ver e deixar uma avaliação</summary>

                    {comentarios.length > 0 && (
                      <ul class="avaliacao-lista">
                        {comentarios.map((c) => (
                          <li class="avaliacao-item">
                            <div class="avaliacao-item__topo">
                              <span class="avaliacao-item__estrelas" aria-hidden="true">{'★'.repeat(c.nota)}{'☆'.repeat(5 - c.nota)}</span>
                              <strong>{c.nome}</strong>
                            </div>
                            {c.comentario && <p class="avaliacao-item__comentario">{c.comentario}</p>}
                          </li>
                        ))}
                      </ul>
                    )}

                    <form
                      class="form-avaliacao"
                      data-academia-id={a.id}
                      data-supabase-url={supabaseUrl}
                      data-supabase-key={supabaseKey}
                    >
                      <fieldset class="estrelas-input">
                        <legend>Sua nota</legend>
                        {[5, 4, 3, 2, 1].map((n) => (
                          <>
                            <input type="radio" name="nota" id={`nota-${a.id}-${n}`} value={n} required />
                            <label for={`nota-${a.id}-${n}`} title={`${n} estrela${n > 1 ? 's' : ''}`}>★</label>
                          </>
                        ))}
                      </fieldset>
                      <label>
                        Comentário (opcional)
                        <textarea name="comentario" rows="3" placeholder="Como foi sua experiência nessa academia?"></textarea>
                      </label>
                      <label>
                        Seu nome
                        <input type="text" name="nome" required />
                      </label>
                      <label>
                        Seu e-mail
                        <input type="email" name="email" required />
                        <small>Não é exibido publicamente, usamos só pra contato, se precisar.</small>
                      </label>
                      {/* honeypot: campo escondido para visitantes reais, bots costumam preencher */}
                      <input type="text" name="site" class="campo-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
                      <button type="submit" class="botao botao--pequeno">Enviar avaliação</button>
                      <p class="form-status" role="status"></p>
                      <p class="form-avaliacao-aviso">
                        Sua avaliação passa por uma checagem da equipe do Climbeiros antes de aparecer aqui.
                      </p>
                    </form>
                  </details>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<script>
  function normalizar(texto: string) {
    return texto
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();
  }

  async function buscarCidadePorCep(cep: string) {
    const resposta = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
    const dados = await resposta.json();
    if (dados.erro) return null;
    return dados.localidade as string;
  }

  document.querySelectorAll<HTMLElement>('[data-busca-grupo]').forEach((grupo) => {
    const nomeGrupo = grupo.dataset.buscaGrupo;
    const lista = document.querySelector<HTMLElement>(`[data-busca-lista="${nomeGrupo}"]`);
    const input = grupo.querySelector<HTMLInputElement>('.busca-input');
    const botaoBuscar = grupo.querySelector('.busca-botao');
    const botaoLimpar = grupo.querySelector('.busca-limpar');
    const status = grupo.nextElementSibling?.classList.contains('busca-status')
      ? (grupo.nextElementSibling as HTMLElement)
      : null;

    if (!lista || !input) return;

    function filtrar(cidade: string) {
      const termo = normalizar(cidade);
      let visiveis = 0;
      lista?.querySelectorAll<HTMLElement>('.card').forEach((card) => {
        const cidadeCard = normalizar(card.dataset.cidade || '');
        const semCidade = !card.dataset.cidade;
        const bate = !termo || semCidade || cidadeCard.includes(termo);
        card.hidden = !bate;
        if (bate) visiveis++;
      });
      return visiveis;
    }

    async function executarBusca() {
      const valor = input.value.trim();
      if (!valor) {
        filtrar('');
        if (status) status.textContent = '';
        botaoLimpar?.setAttribute('hidden', '');
        return;
      }

      const somenteNumeros = valor.replace(/\D/g, '');
      let cidadeParaFiltrar = valor;

      if (somenteNumeros.length === 8) {
        if (status) status.textContent = 'Buscando cidade pelo CEP...';
        const cidade = await buscarCidadePorCep(somenteNumeros);
        if (!cidade) {
          if (status) status.textContent = 'CEP não encontrado. Tente digitar o nome da cidade.';
          return;
        }
        cidadeParaFiltrar = cidade;
      }

      const encontrados = filtrar(cidadeParaFiltrar);
      if (status) {
        status.textContent = encontrados > 0
          ? `${encontrados} resultado(s) para ${cidadeParaFiltrar}.`
          : `Nada encontrado em ${cidadeParaFiltrar} ainda.`;
      }
      botaoLimpar?.removeAttribute('hidden');
    }

    botaoBuscar?.addEventListener('click', executarBusca);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') executarBusca();
    });
    botaoLimpar?.addEventListener('click', () => {
      input.value = '';
      filtrar('');
      if (status) status.textContent = '';
      botaoLimpar.setAttribute('hidden', '');
    });
  });
</script>

<script>
  import { createClient } from '@supabase/supabase-js';

  document.querySelectorAll<HTMLFormElement>('.form-avaliacao').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form-status');
    const botao = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status || !botao) return;

      const dados = new FormData(form);

      // Honeypot: campo escondido via CSS que só um bot preencheria.
      if (dados.get('site')) {
        status.textContent = 'Avaliação enviada!';
        form.reset();
        return;
      }

      const nota = dados.get('nota');
      if (!nota) {
        status.textContent = 'Escolha uma nota de 1 a 5 estrelas.';
        return;
      }

      botao.disabled = true;
      status.textContent = 'Enviando...';

      try {
        const supabase = createClient(form.dataset.supabaseUrl!, form.dataset.supabaseKey!);

        const { error } = await supabase.from('avaliacoes_academias').insert({
          academia_id: form.dataset.academiaId,
          nome: dados.get('nome'),
          email: dados.get('email'),
          nota: Number(nota),
          comentario: dados.get('comentario') || null,
        });

        if (error) {
          status.textContent = 'Erro ao enviar: ' + error.message;
        } else {
          status.textContent = 'Obrigado! Sua avaliação passará por uma checagem antes de aparecer no site.';
          form.reset();
        }
      } catch (err) {
        status.textContent = 'Erro inesperado: ' + (err instanceof Error ? err.message : String(err));
      }

      botao.disabled = false;
    });
  });
</script>

<style>
  .selo-disclaimer {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 720px;
    font-size: 0.85rem;
    opacity: 0.75;
    margin: 12px 0 0;
  }
  .selo-disclaimer__icone {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }

  .card__imagem-wrap { position: relative; }
  .card__imagem {
    object-position: top;
  }
  .card__selo {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 52px;
    height: 52px;
    /* halo claro ao redor do selo, pra ele não sumir em fotos com fundo escuro */
    filter:
      drop-shadow(0 0 3px rgba(255,255,255,0.9))
      drop-shadow(0 0 3px rgba(255,255,255,0.9))
      drop-shadow(0 3px 6px rgba(0,0,0,0.35));
  }

  .card__local { font-size: 0.85rem; color: var(--laranja); font-weight: 600; margin-bottom: 8px; }
  .card__endereco { font-size: 0.85rem; opacity: 0.65; margin-top: -8px; margin-bottom: 8px; font-style: italic; }
  .card__modalidades { font-size: 0.85rem; margin-bottom: 8px; }
  .card__links { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 10px; }

  .busca-local {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 20px 0 8px;
  }
  .busca-local input {
    flex: 1;
    min-width: 220px;
    font-family: var(--fonte-corpo);
    font-size: 1rem;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid rgba(42,31,22,0.25);
    color: var(--marrom);
  }
  .busca-status {
    font-size: 0.9rem;
    opacity: 0.8;
    margin-bottom: 24px;
    min-height: 1.2em;
  }

  .card__avaliacoes {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(42, 31, 22, 0.12);
  }

  .avaliacao-resumo {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 8px;
    font-size: 0.9rem;
  }
  .avaliacao-resumo__estrelas { color: var(--amarelo); }
  .avaliacao-resumo--vazia { opacity: 0.6; font-style: italic; }

  .avaliacao-detalhes summary {
    cursor: pointer;
    font-family: var(--fonte-display);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--laranja);
  }
  .avaliacao-detalhes[open] summary { margin-bottom: 12px; }

  .avaliacao-lista {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 220px;
    overflow-y: auto;
  }
  .avaliacao-item {
    background: var(--creme-claro);
    border-radius: 8px;
    padding: 10px 12px;
  }
  .avaliacao-item__topo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
  }
  .avaliacao-item__estrelas { color: var(--amarelo); letter-spacing: 1px; }
  .avaliacao-item__comentario {
    margin: 4px 0 0;
    font-size: 0.85rem;
    opacity: 0.85;
  }

  .form-avaliacao {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--branco);
    border: 1px solid rgba(42, 31, 22, 0.15);
    border-radius: 8px;
    padding: 14px;
  }
  .form-avaliacao label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--fonte-display);
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--verde-escuro);
    letter-spacing: 0.03em;
  }
  .form-avaliacao input,
  .form-avaliacao textarea {
    font-family: var(--fonte-corpo);
    font-size: 0.9rem;
    padding: 8px 10px;
    border-radius: 6px;
    border: 1px solid rgba(42, 31, 22, 0.2);
    color: var(--marrom);
    resize: vertical;
  }
  .form-avaliacao small { text-transform: none; letter-spacing: normal; opacity: 0.65; font-size: 0.72rem; }
  .botao--pequeno { align-self: flex-start; padding: 8px 16px; font-size: 0.85rem; }
  .form-avaliacao-aviso { font-size: 0.72rem; opacity: 0.65; margin: 0; }

  .campo-honeypot {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* Fieldset de estrelas: radios na ordem 5→1 no HTML + row-reverse deixa a UI 1→5,
     e o seletor ~ pinta a estrela clicada e todas as anteriores (visualmente, à esquerda). */
  .estrelas-input {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 2px;
    border: none;
    padding: 0;
    margin: 0;
  }
  .estrelas-input legend {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
  }
  .estrelas-input input {
    position: absolute;
    opacity: 0;
    width: 1px; height: 1px;
  }
  .estrelas-input label {
    cursor: pointer;
    font-size: 1.6rem;
    line-height: 1;
    color: rgba(42, 31, 22, 0.25);
    padding: 2px;
  }
  .estrelas-input input:checked ~ label,
  .estrelas-input label:hover,
  .estrelas-input label:hover ~ label {
    color: var(--amarelo);
  }
</style>
