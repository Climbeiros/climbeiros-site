---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import type { Academia, Curso } from '../lib/supabase';

const { data: academias } = await supabase
  .from('academias')
  .select('*')
  .order('nome') as { data: Academia[] | null };

const { data: cursos } = await supabase
  .from('cursos')
  .select('*')
  .order('nome') as { data: Curso[] | null };
---
<Layout titulo="Academias & Cursos" descricao="Academias de escalada e cursos recomendados pela comunidade Climbeiros.">
  <section class="secao">
    <div class="container">
      <p class="eyebrow">Onde treinar</p>
      <h1>Academias de escalada</h1>

      {(!academias || academias.length === 0) && (
        <p>Ainda estamos cadastrando as primeiras academias. Volte em breve!</p>
      )}

      {academias && academias.length > 0 && (
        <>
          <div class="busca-local" data-busca-grupo="academias">
            <input
              type="text"
              class="busca-input"
              placeholder="Buscar por cidade ou CEP..."
              aria-label="Buscar academias por cidade ou CEP"
            />
            <button type="button" class="botao busca-botao">Buscar</button>
            <button type="button" class="botao botao--secundario busca-limpar" hidden>Limpar</button>
          </div>
          <p class="busca-status" role="status"></p>
        </>
      )}

      <div class="grade grade--3" data-busca-lista="academias">
        {academias?.map((a) => (
          <article class="card" data-cidade={(a.cidade || '').toLowerCase()}>
            <div class="card__corpo">
              <h3>{a.nome}</h3>
              <p class="card__local">{a.cidade}{a.estado ? `, ${a.estado}` : ''}</p>
              {a.endereco && <p class="card__endereco">{a.endereco}</p>}
              {a.Modalidades && <p class="card__modalidades"><strong>Modalidades:</strong> {a.Modalidades}</p>}
              {a.descricao && <p>{a.descricao}</p>}
              <div class="card__links">
                {a.website && <a href={a.website} target="_blank" rel="noopener">Site</a>}
                {a.whatsapp && <a href={`https://wa.me/${a.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>}
                {a.instagram && <a href={a.instagram} target="_blank" rel="noopener">Instagram</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="secao secao--creme">
    <div class="container">
      <p class="eyebrow">Onde aprender</p>
      <h1>Cursos de escalada</h1>

      {(!cursos || cursos.length === 0) && (
        <p>Ainda estamos cadastrando os primeiros cursos. Volte em breve!</p>
      )}

      {cursos && cursos.length > 0 && (
        <>
          <div class="busca-local" data-busca-grupo="cursos">
            <input
              type="text"
              class="busca-input"
              placeholder="Buscar por cidade ou CEP..."
              aria-label="Buscar cursos por cidade ou CEP"
            />
            <button type="button" class="botao busca-botao">Buscar</button>
            <button type="button" class="botao botao--secundario busca-limpar" hidden>Limpar</button>
          </div>
          <p class="busca-status" role="status"></p>
        </>
      )}

      <div class="grade grade--3" data-busca-lista="cursos">
        {cursos?.map((c) => (
          <article class="card" data-cidade={(c.cidade || '').toLowerCase()}>
            <div class="card__corpo">
              {c.nivel && <span class="etiqueta">{c.nivel}</span>}
              <h3>{c.nome}</h3>
              {c.instituicao && <p class="card__local">{c.instituicao} {c.cidade ? `· ${c.cidade}` : ''}</p>}
              {c.descricao && <p>{c.descricao}</p>}
              <div class="card__rodape">
                {c.preco && <span class="card__preco">{c.preco}</span>}
                {c.link_inscricao && <a href={c.link_inscricao} target="_blank" rel="noopener" class="botao botao--secundario">Inscrever-se</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="busca-obs">Cursos online aparecem sempre, independente da cidade buscada.</p>
    </div>
  </section>
</Layout>

<script>
  function normalizar(texto: string) {
    return texto
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();
  }

  async function buscarCidadePorCep(cep: string) {
    const resposta = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
    const dados = await resposta.json();
    if (dados.erro) return null;
    return dados.localidade as string;
  }

  // Configura a busca de forma independente para cada grupo (academias e cursos),
  // já que as duas seções da página têm sua própria barra de busca e sua própria lista.
  document.querySelectorAll<HTMLElement>('[data-busca-grupo]').forEach((grupo) => {
    const nomeGrupo = grupo.dataset.buscaGrupo;
    const lista = document.querySelector<HTMLElement>(`[data-busca-lista="${nomeGrupo}"]`);
    const input = grupo.querySelector<HTMLInputElement>('.busca-input');
    const botaoBuscar = grupo.querySelector('.busca-botao');
    const botaoLimpar = grupo.querySelector('.busca-limpar');
    const status = grupo.nextElementSibling?.classList.contains('busca-status')
      ? (grupo.nextElementSibling as HTMLElement)
      : null;

    if (!lista || !input) return;

    function filtrar(cidade: string) {
      const termo = normalizar(cidade);
      let visiveis = 0;
      lista?.querySelectorAll<HTMLElement>('.card').forEach((card) => {
        const cidadeCard = normalizar(card.dataset.cidade || '');
        const semCidade = !card.dataset.cidade;
        // Itens sem cidade (ex: cursos online) continuam sempre visíveis.
        const bate = !termo || semCidade || cidadeCard.includes(termo);
        card.hidden = !bate;
        if (bate) visiveis++;
      });
      return visiveis;
    }

    async function executarBusca() {
      const valor = input.value.trim();
      if (!valor) {
        filtrar('');
        if (status) status.textContent = '';
        botaoLimpar?.setAttribute('hidden', '');
        return;
      }

      const somenteNumeros = valor.replace(/\D/g, '');
      let cidadeParaFiltrar = valor;

      if (somenteNumeros.length === 8) {
        if (status) status.textContent = 'Buscando cidade pelo CEP...';
        const cidade = await buscarCidadePorCep(somenteNumeros);
        if (!cidade) {
          if (status) status.textContent = 'CEP não encontrado. Tente digitar o nome da cidade.';
          return;
        }
        cidadeParaFiltrar = cidade;
      }

      const encontrados = filtrar(cidadeParaFiltrar);
      if (status) {
        status.textContent = encontrados > 0
          ? `${encontrados} resultado(s) para ${cidadeParaFiltrar}.`
          : `Nada encontrado em ${cidadeParaFiltrar} ainda.`;
      }
      botaoLimpar?.removeAttribute('hidden');
    }

    botaoBuscar?.addEventListener('click', executarBusca);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') executarBusca();
    });
    botaoLimpar?.addEventListener('click', () => {
      input.value = '';
      filtrar('');
      if (status) status.textContent = '';
      botaoLimpar.setAttribute('hidden', '');
    });
  });
</script>

<style>
  .card__local { font-size: 0.85rem; opacity: 0.7; margin-bottom: 8px; }
  .card__endereco { font-size: 0.85rem; opacity: 0.65; margin-top: -8px; margin-bottom: 8px; font-style: italic; }
  .card__modalidades { font-size: 0.85rem; margin-bottom: 8px; }
  .card__links { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 10px; }
  .card__rodape { display: flex; align-items: center; justify-content: space-between; margin-top: 14px; }
  .card__preco { font-family: var(--fonte-display); color: var(--verde-escuro); }

  .busca-local {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 20px 0 8px;
  }
  .busca-local input {
    flex: 1;
    min-width: 220px;
    font-family: var(--fonte-corpo);
    font-size: 1rem;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid rgba(42,31,22,0.25);
    color: var(--marrom);
  }
  .busca-status {
    font-size: 0.9rem;
    opacity: 0.8;
    margin-bottom: 24px;
    min-height: 1.2em;
  }
  .busca-obs {
    font-size: 0.85rem;
    opacity: 0.65;
    margin-top: 20px;
  }
</style>
