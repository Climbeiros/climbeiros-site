---
// src/components/FormGuia.astro
// Formulário "É guia/instrutor e quer aparecer aqui?". Grava em
// "inscricoes_guias" (entra pendente no painel). Usado em Guias & Cursos e
// na página de Contato. Use só uma vez por página (os ids são fixos).
//
// Modo edição (08/11/2026): quando o guia entra em "Editar meu perfil" (Guias &
// Cursos), a página dispara o evento "guia:editar" com os dados dele. O formulário
// vem preenchido e, ao enviar, chama guia_enviar_edicao (a edição espera aprovação
// na tabela edicoes_guias). O WhatsApp fica travado, porque é o login.
//
// Novo visual (13/11/2026):
// - 4 blocos que abrem e fecham (Quem é você / Sua atuação / Seu card no site /
//   Só pra equipe), cada um mostrando no título o que falta.
// - Rascunho salvo sozinho no navegador (localStorage). Senha e foto não entram no
//   rascunho. Ao voltar, o formulário pergunta se quer continuar de onde parou.
//   Cadastro novo e edição têm rascunhos separados (a edição, um por WhatsApp).
// - "Visualizar meu perfil" nos blocos 1 a 3 mostra o card como vai ficar no site.
// - "Revisar e enviar" mostra o card completo + "Quero fazer ajustes" / "Está certo,
//   pode enviar".
// - Locais em caixinhas com busca (antes era lista com Ctrl/Cmd).
// - Saiu o campo "Melhor contato para divulgarmos" (a equipe decide). A coluna
//   contato_pref continua no banco; o formulário só não manda mais nada pra ela.
// O card da prévia copia o visual do card de Guias & Cursos (src/pages/cursos.astro).
// Mudou o card lá? Ajuste também as classes "fgc-" aqui embaixo.
import { supabase } from '../lib/supabase';
import '../styles/formularios.css';

const { data: locais } = await supabase
  .from('locais')
  .select('id, nome, estado')
  .order('estado', { ascending: true })
  .order('nome', { ascending: true }) as { data: { id: string; nome: string; estado: string | null }[] | null };

const locaisPorEstado = new Map<string, { id: string; nome: string }[]>();
for (const l of locais ?? []) {
  const estado = l.estado || 'Outros';
  if (!locaisPorEstado.has(estado)) locaisPorEstado.set(estado, []);
  locaisPorEstado.get(estado)!.push(l);
}

const UFS = ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'];
const ESPECIALIDADES = ['Escalada esportiva','Escalada tradicional','Boulder','Escalada indoor','Montanhismo','Alpinismo','Escalada em gelo','Trekking','Canionismo','Escalada móvel','Escalada em fendas','Escalada artificial','Bigwall','Curso de autoresgate'];

const iconeOlho = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>';
---
<form class="fc" id="form-guia" novalidate>
  <div class="fg-editando" id="fg-editando" hidden>
    <p><strong>Editando o perfil de <span id="fg-editando-nome"></span></strong></p>
    <p>Mude o que quiser e clique em "Revisar e enviar". A equipe confere antes de aparecer no site; até lá, seu perfil atual continua no ar.</p>
    <p id="fg-editando-pendente" hidden>Você já tem uma alteração esperando aprovação. Se enviar de novo, esta nova substitui a anterior.</p>
    <button type="button" class="fg-link" id="fg-cancelar-edicao">Cancelar edição</button>
  </div>

  <div class="fg-retomar" id="fg-retomar" hidden>
    <p><strong>Você tem um rascunho salvo</strong> (<span id="fg-retomar-quando"></span>). Quer continuar de onde parou?</p>
    <button type="button" class="botao" id="fg-retomar-sim">Continuar</button>
    <button type="button" class="botao botao--secundario" id="fg-retomar-nao">Começar do zero</button>
  </div>

  <!-- BLOCO 1 -->
  <details class="fg-bloco" data-bloco="1" open>
    <summary>
      <span class="fg-bloco-num">1</span>
      <span class="fg-bloco-tit"><strong>Quem é você</strong><small>Seus contatos e o acesso pra editar o perfil depois</small></span>
      <span class="fg-bloco-status"></span><span class="fg-bloco-seta" aria-hidden="true"></span>
    </summary>
    <div class="fg-bloco-corpo">
      <div class="fc-linha">
        <div class="fc-campo">
          <label for="fg-nome">Nome <span class="req req--sim">Obrigatório</span></label>
          <input type="text" id="fg-nome" name="nome" required data-conta />
        </div>
        <div class="fc-campo">
          <label for="fg-email">E-mail <span class="req req--sim">Obrigatório</span></label>
          <input type="email" id="fg-email" name="email" required data-conta />
        </div>
      </div>
      <div class="fc-linha">
        <div class="fc-campo">
          <label for="fg-telefone">WhatsApp <span class="req req--sim">Obrigatório</span></label>
          <input type="tel" id="fg-telefone" name="telefone" placeholder="(11)991721313" maxlength="13" inputmode="numeric" required data-conta />
          <small class="fc-ajuda" id="fg-telefone-ajuda">É com ele (e a senha abaixo) que você entra depois pra editar seu perfil.</small>
        </div>
        <div class="fc-campo">
          <label for="fg-instagram">Instagram</label>
          <input type="text" id="fg-instagram" name="instagram" placeholder="@seu.perfil" data-conta />
        </div>
      </div>
      <div class="fc-campo" id="fg-senha-campo">
        <label for="fg-senha">Crie uma senha de 6 números <span class="req req--sim">Obrigatório</span></label>
        <input type="password" id="fg-senha" name="senha" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" autocomplete="new-password" placeholder="••••••" required data-conta data-nao-salvar />
        <div class="fg-senha-info">
          <p class="fg-senha-tit">Pra que serve a senha?</p>
          <ul>
            <li><strong>Pra você editar seu perfil sozinho</strong> depois que ele entrar no ar: trocar foto, atualizar cursos, mudar o cupom… É só entrar com seu WhatsApp + esta senha em "Edite o seu perfil".</li>
            <li><strong>Toda alteração passa por revisão da equipe Climbeiros</strong> antes de aparecer no site. Até lá, seu perfil atual continua no ar.</li>
            <li>Ninguém vê essa senha, nem a gente. Por segurança, ela não fica salva no rascunho.</li>
          </ul>
        </div>
      </div>
      <div class="fc-linha">
        <div class="fc-campo">
          <label for="fg-cidade">Cidade</label>
          <input type="text" id="fg-cidade" name="cidade" placeholder="Ex.: São Paulo" data-conta />
        </div>
        <div class="fc-campo">
          <label for="fg-uf">UF</label>
          <select id="fg-uf" name="uf" data-conta>
            <option value="">Selecione</option>
            {UFS.map((uf) => <option value={uf}>{uf}</option>)}
          </select>
        </div>
      </div>
      <div class="fg-bloco-rodape">
        <button type="button" class="fg-ver" data-ver-perfil><Fragment set:html={iconeOlho} />Visualizar meu perfil</button>
        <button type="button" class="fg-link" data-proximo>Próximo bloco →</button>
      </div>
    </div>
  </details>

  <!-- BLOCO 2 -->
  <details class="fg-bloco" data-bloco="2">
    <summary>
      <span class="fg-bloco-num">2</span>
      <span class="fg-bloco-tit"><strong>Sua atuação</strong><small>O que você ensina e onde</small></span>
      <span class="fg-bloco-status"></span><span class="fg-bloco-seta" aria-hidden="true"></span>
    </summary>
    <div class="fg-bloco-corpo">
      <div class="fc-campo" data-conta-grupo>
        <span class="fc-label">Especialidades</span>
        <div class="fc-opcoes">
          {ESPECIALIDADES.map((esp) => (
            <label class="fc-check"><input type="checkbox" name="especialidade" value={esp} /> {esp}</label>
          ))}
        </div>
        <input type="text" id="fg-espec-outra" name="especialidade_outra" placeholder="Outra especialidade (opcional)" />
      </div>
      <div class="fc-campo">
        <label for="fg-certificacao">Certificação</label>
        <input type="text" id="fg-certificacao" name="certificacao" placeholder="Ex.: Guia CANMOD, AGB, instrutor de ginásio..." data-conta />
      </div>
      <div class="fc-campo" data-conta-grupo>
        <label for="fg-locais-busca">Em quais locais você atua?</label>
        <input type="search" id="fg-locais-busca" placeholder="Busque pelo nome do local" autocomplete="off" />
        <div class="fg-locais-lista" id="fg-locais-lista">
          {Array.from(locaisPorEstado.entries()).map(([estado, lista]) => (
            <div class="fg-locais-uf">
              <p class="fg-locais-uf-tit">{estado}</p>
              {lista.map((l) => (
                <label class="fc-check"><input type="checkbox" name="locais_ids" value={l.id} data-nome={l.nome} /> {l.nome}</label>
              ))}
            </div>
          ))}
          <p class="fg-locais-nada" id="fg-locais-nada" hidden>Nenhum local com esse nome. Escreva no campo abaixo que a gente cadastra.</p>
        </div>
        <div class="fg-chips" id="fg-locais-chips"></div>
        <small class="fc-ajuda">Marque quantos quiser. Usamos isso pra te mostrar na página de cada local.</small>
      </div>
      <div class="fc-campo">
        <label for="fg-locais-outro">Atua em algum local que não está na lista?</label>
        <textarea id="fg-locais-outro" name="locais_outro" rows="2" placeholder="Escreva aqui o nome do local, cidade e estado. Ainda estamos cadastrando as rotas do site, então é normal seu local não aparecer ainda."></textarea>
        <small class="fc-ajuda">Não achar seu local na lista não trava sua inscrição. A gente usa essa informação pra saber quais locais cadastrar em seguida.</small>
      </div>
      <div class="fg-bloco-rodape">
        <button type="button" class="fg-ver" data-ver-perfil><Fragment set:html={iconeOlho} />Visualizar meu perfil</button>
        <button type="button" class="fg-link" data-proximo>Próximo bloco →</button>
      </div>
    </div>
  </details>

  <!-- BLOCO 3 -->
  <details class="fg-bloco" data-bloco="3">
    <summary>
      <span class="fg-bloco-num">3</span>
      <span class="fg-bloco-tit"><strong>Seu card no site</strong><small>Foto, apresentação, cursos e cupom</small></span>
      <span class="fg-bloco-status"></span><span class="fg-bloco-seta" aria-hidden="true"></span>
    </summary>
    <div class="fg-bloco-corpo">
      <div class="fc-campo">
        <label for="fg-foto">Foto</label>
        <p class="fg-foto-atual" id="fg-foto-atual" hidden><img id="fg-foto-atual-img" alt="" /> <span>Sua foto atual. Escolha outra só se quiser trocar.</span></p>
        <input type="file" id="fg-foto" name="foto" accept="image/png, image/jpeg, image/webp" data-conta data-nao-salvar />
        <small class="fc-ajuda">Até 5 MB. A foto não fica no rascunho: se sair da página, escolha de novo.</small>
      </div>
      <div class="fc-campo">
        <label for="fg-bio">Sobre você</label>
        <textarea id="fg-bio" name="bio" rows="3" placeholder="Conte um pouco sobre sua experiência" data-conta></textarea>
      </div>
      <div class="fc-campo">
        <label for="fg-cursos">Cursos oferecidos</label>
        <textarea id="fg-cursos" name="cursos_oferecidos" rows="4" placeholder="Conte quais cursos você oferece: o nível, onde acontece, próximas datas, valor e o link ou contato pra inscrição." data-conta></textarea>
        <small class="fc-ajuda">Um curso por linha ou parágrafo. Não oferece cursos? Pode deixar em branco.</small>
      </div>
      <label class="fc-check">
        <input type="checkbox" name="tem_cupom" id="fg-tem-cupom" data-conta />
        Quero oferecer um cupom de desconto para a comunidade Climbeiros
      </label>
      <div class="fc-destaque" id="fg-cupom-campos" hidden>
        <div class="fc-campo">
          <label for="fg-cupom">Código do cupom <span class="req req--sim">Obrigatório</span></label>
          <input type="text" id="fg-cupom" name="cupom_codigo" placeholder="Ex.: GUIA10" />
        </div>
        <div class="fc-campo">
          <label for="fg-cupomdesc">Qual é o benefício? <span class="req req--sim">Obrigatório</span></label>
          <textarea id="fg-cupomdesc" name="cupom_desc" rows="3" placeholder="Ex.: 10% de desconto na primeira aula avulsa, ou 1 dia grátis no curso de 2 dias"></textarea>
          <small class="fc-ajuda">Aparece embaixo do código no seu card, pra pessoa saber o que ganha usando o cupom.</small>
        </div>
      </div>
      <div class="fg-bloco-rodape">
        <button type="button" class="fg-ver" data-ver-perfil><Fragment set:html={iconeOlho} />Visualizar meu perfil</button>
        <button type="button" class="fg-link" data-proximo>Próximo bloco →</button>
      </div>
    </div>
  </details>

  <!-- BLOCO 4 -->
  <details class="fg-bloco" data-bloco="4">
    <summary>
      <span class="fg-bloco-num">4</span>
      <span class="fg-bloco-tit"><strong>Só pra equipe</strong><small>Não aparece no site · opcional</small></span>
      <span class="fg-bloco-status"></span><span class="fg-bloco-seta" aria-hidden="true"></span>
    </summary>
    <div class="fg-bloco-corpo">
      <div class="fc-campo">
        <label for="fg-msg">Mensagem pra equipe Climbeiros</label>
        <textarea id="fg-msg" name="mensagem" rows="3" placeholder="Algo que só a gente precise saber" data-conta></textarea>
      </div>
    </div>
  </details>

  <div class="fg-rascunho" id="fg-rascunho" hidden>
    <span class="fg-rascunho-ponto"></span><span id="fg-rascunho-txt">Rascunho salvo</span>
    <button type="button" class="fg-link" id="fg-rascunho-apagar">Apagar rascunho</button>
  </div>
  <button type="submit" class="botao" id="fg-enviar">Revisar e enviar</button>
  <p class="fc-status" id="fg-status" role="status"></p>
</form>

<!-- "Visualizar meu perfil": o card como vai ficar em Guias & Cursos -->
<dialog class="fg-janela fg-janela--ver" id="fg-ver" aria-labelledby="fg-ver-titulo">
  <div class="fg-ver-topo">
    <p id="fg-ver-titulo">É assim que seu card aparece em <strong>Guias &amp; Cursos</strong></p>
    <button type="button" class="fg-fechar" id="fg-ver-fechar" aria-label="Fechar">×</button>
  </div>
  <div id="fg-ver-card"></div>
  <p class="fg-ver-dica">Campos em branco não aparecem no card. Quanto mais completo, melhor.</p>
</dialog>

<!-- Revisão antes de enviar: card completo + confirmação -->
<dialog class="fg-janela fg-janela--rev" id="fg-revisao" aria-labelledby="fg-rev-titulo">
  <h2 id="fg-rev-titulo">Confere antes de enviar?</h2>
  <p class="fg-rev-intro" id="fg-rev-intro"></p>
  <div id="fg-rev-card"></div>
  <div id="fg-rev-extra"></div>
  <form method="dialog" class="fg-rev-botoes">
    <button type="submit" value="corrigir" class="botao botao--secundario">Quero fazer ajustes</button>
    <button type="submit" value="enviar" class="botao">Está certo, pode enviar</button>
  </form>
</dialog>

<script>
  import { supabase } from '../lib/supabase';
  import { usuarioInstagram } from '../lib/contatos';
  import { mascaraTelefone, telefoneValido } from '../lib/formularios';

  const form = document.getElementById('form-guia') as HTMLFormElement | null;
  const status = document.getElementById('fg-status');
  const btn = document.getElementById('fg-enviar');
  const campoTelefone = document.getElementById('fg-telefone') as HTMLInputElement | null;
  const campoSenha = document.getElementById('fg-senha') as HTMLInputElement | null;
  const campoFoto = document.getElementById('fg-foto') as HTMLInputElement | null;
  const blocos = form ? Array.from(form.querySelectorAll<HTMLDetailsElement>('.fg-bloco')) : [];
  mascaraTelefone(campoTelefone);
  campoSenha?.addEventListener('input', () => { campoSenha.value = campoSenha.value.replace(/\D/g, '').slice(0, 6); });

  function campo<T extends HTMLElement>(id: string) { return document.getElementById(id) as T | null; }
  function valor(nome: string): string {
    const el = form?.elements.namedItem(nome) as HTMLInputElement | null;
    return el && 'value' in el ? String(el.value || '').trim() : '';
  }
  function marcados(nome: string): HTMLInputElement[] {
    return form ? Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${nome}"]:checked`)) : [];
  }

  // ---------- Cupom ----------
  const chkCupom = campo<HTMLInputElement>('fg-tem-cupom');
  const camposCupom = campo('fg-cupom-campos');
  const campoCupom = campo<HTMLInputElement>('fg-cupom');
  const campoCupomDesc = campo<HTMLTextAreaElement>('fg-cupomdesc');
  function atualizarCupom() {
    if (!chkCupom) return;
    if (camposCupom) camposCupom.hidden = !chkCupom.checked;
    // Com cupom marcado, código e benefício passam a ser obrigatórios
    if (campoCupom) campoCupom.required = chkCupom.checked;
    if (campoCupomDesc) campoCupomDesc.required = chkCupom.checked;
  }
  chkCupom?.addEventListener('change', atualizarCupom);

  // ---------- Blocos: o que falta em cada um ----------
  function preenchido(el: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement): boolean {
    if (el instanceof HTMLInputElement && el.type === 'checkbox') return el.checked;
    if (el instanceof HTMLInputElement && el.type === 'file') return !!(el.files && el.files.length) || (!!edicao && !!original.foto_url);
    return String(el.value || '').trim() !== '';
  }
  function obrigatoriosVazios(raiz: ParentNode) {
    return Array.from(raiz.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]'))
      .filter((el) => !el.closest('[hidden]') && !preenchido(el));
  }
  function atualizarBlocos() {
    for (const b of blocos) {
      const campos = Array.from(b.querySelectorAll<HTMLInputElement>('[data-conta]')).filter((el) => !el.closest('[hidden]'));
      const grupos = Array.from(b.querySelectorAll('[data-conta-grupo]'));
      const total = campos.length + grupos.length;
      let feitos = campos.filter(preenchido).length;
      grupos.forEach((g) => {
        const temMarcado = !!g.querySelector('input[type="checkbox"]:checked');
        const temTexto = Array.from(g.querySelectorAll<HTMLInputElement>('input[type="text"]')).some((i) => i.value.trim());
        if (temMarcado || temTexto) feitos++;
      });
      const falta = obrigatoriosVazios(b).length;
      const st = b.querySelector('.fg-bloco-status');
      if (st) {
        if (falta) st.textContent = falta === 1 ? 'Falta 1 obrigatório' : `Faltam ${falta} obrigatórios`;
        else st.textContent = feitos === total ? '✓ Completo' : `${feitos} de ${total}`;
      }
      b.classList.toggle('fg-bloco--completo', !falta && feitos === total);
    }
  }
  function abrirBloco(b: HTMLDetailsElement | null | undefined, rolar = true) {
    if (!b) return;
    blocos.forEach((x) => { if (x !== b) x.open = false; });
    b.open = true;
    if (rolar) b.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  form?.querySelectorAll<HTMLButtonElement>('[data-proximo]').forEach((bt) => bt.addEventListener('click', () => {
    const atual = bt.closest<HTMLDetailsElement>('.fg-bloco');
    abrirBloco(blocos[blocos.indexOf(atual!) + 1]);
  }));

  // ---------- Locais: busca + etiquetas ----------
  const buscaLocais = campo<HTMLInputElement>('fg-locais-busca');
  const listaLocais = campo('fg-locais-lista');
  const semLocais = campo('fg-locais-nada');
  const sem = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  buscaLocais?.addEventListener('input', () => {
    const t = sem(buscaLocais.value.trim());
    let algum = false;
    listaLocais?.querySelectorAll<HTMLElement>('.fg-locais-uf').forEach((grupo) => {
      let visiveis = 0;
      grupo.querySelectorAll<HTMLElement>('.fc-check').forEach((l) => {
        const mostra = !t || sem(l.textContent || '').includes(t);
        l.hidden = !mostra;
        if (mostra) visiveis++;
      });
      grupo.hidden = !visiveis;
      if (visiveis) algum = true;
    });
    if (semLocais) semLocais.hidden = algum;
  });
  // A busca não é dado do formulário: não deixa o Enter enviar nem o rascunho guardar
  buscaLocais?.addEventListener('keydown', (e) => { if (e.key === 'Enter') e.preventDefault(); });
  function locaisEscolhidos() {
    return marcados('locais_ids').map((i) => ({ id: i.value, nome: i.dataset.nome || '' }));
  }
  function atualizarChips() {
    const chips = campo('fg-locais-chips');
    chips?.replaceChildren(...locaisEscolhidos().map((l) => {
      const s = document.createElement('span');
      s.textContent = l.nome;
      return s;
    }));
  }

  // ---------- Modo edição (variáveis usadas pelo rascunho e pela revisão) ----------
  type DadosGuia = Record<string, any>;
  let edicao: { whatsapp: string; senha: string } | null = null;
  let original: DadosGuia = {};   // perfil como está no ar (pra revisão saber o que mudou)

  // ---------- Rascunho automático ----------
  const CHAVE_NOVO = 'climbeiros:rascunho:guia';
  const chaveRascunho = () => edicao ? `climbeiros:rascunho:guia-edicao:${edicao.whatsapp.replace(/\D/g, '')}` : CHAVE_NOVO;
  const rascunho = {
    ler(chave: string): { quando: number; dados: Record<string, any> } | null {
      try { return JSON.parse(localStorage.getItem(chave) || 'null'); } catch { return null; }
    },
    gravar(chave: string, v: unknown) {
      try { localStorage.setItem(chave, JSON.stringify(v)); return true; } catch { return false; }
    },
    apagar(chave: string) { try { localStorage.removeItem(chave); } catch { /* sem localStorage */ } },
  };
  const barraRascunho = campo('fg-rascunho');
  const textoRascunho = campo('fg-rascunho-txt');
  const caixaRetomar = campo('fg-retomar');
  const hora = (ts: number) => new Date(ts).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });

  function coletarRascunho() {
    const dados: Record<string, any> = {};
    form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select').forEach((el) => {
      if (!el.name || el.hasAttribute('data-nao-salvar') || el.type === 'search' || el.type === 'file') return;
      if (el instanceof HTMLInputElement && el.type === 'checkbox') {
        if (!dados[el.name]) dados[el.name] = [];
        if (el.checked) dados[el.name].push(el.value);
      } else if (!(el instanceof HTMLInputElement && el.readOnly)) {
        dados[el.name] = el.value;
      }
    });
    return dados;
  }
  function aplicarRascunho(dados: Record<string, any>) {
    form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select').forEach((el) => {
      if (!el.name || !(el.name in dados) || el.hasAttribute('data-nao-salvar')) return;
      if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = (dados[el.name] || []).includes(el.value);
      else if (!(el instanceof HTMLInputElement && el.readOnly)) el.value = dados[el.name] ?? '';
    });
    atualizarTudo();
  }
  let timerRascunho: ReturnType<typeof setTimeout> | undefined;
  function salvarRascunhoDepois() {
    if (!barraRascunho || !textoRascunho) return;
    barraRascunho.hidden = false;
    barraRascunho.classList.add('fg-rascunho--salvando');
    textoRascunho.textContent = 'Salvando rascunho...';
    clearTimeout(timerRascunho);
    timerRascunho = setTimeout(() => {
      const agora = Date.now();
      const ok = rascunho.gravar(chaveRascunho(), { quando: agora, dados: coletarRascunho() });
      barraRascunho.classList.remove('fg-rascunho--salvando');
      textoRascunho.textContent = ok ? `Rascunho salvo às ${hora(agora)} neste aparelho` : 'Este navegador não deixa salvar rascunho';
    }, 700);
  }
  function esconderRascunho() {
    clearTimeout(timerRascunho);
    if (barraRascunho) barraRascunho.hidden = true;
    if (caixaRetomar) caixaRetomar.hidden = true;
  }
  // Mostra "Quer continuar de onde parou?" se houver rascunho pra esta chave
  function oferecerRascunho() {
    if (!caixaRetomar) return;
    const salvo = rascunho.ler(chaveRascunho());
    caixaRetomar.hidden = !(salvo && salvo.dados);
    if (salvo && salvo.dados) {
      const d = new Date(salvo.quando);
      const quando = campo('fg-retomar-quando');
      if (quando) quando.textContent = `${d.toLocaleDateString('pt-BR')} às ${hora(salvo.quando)}`;
    }
  }
  campo('fg-retomar-sim')?.addEventListener('click', () => {
    const salvo = rascunho.ler(chaveRascunho());
    if (salvo?.dados) aplicarRascunho(salvo.dados);
    if (caixaRetomar) caixaRetomar.hidden = true;
    if (barraRascunho && textoRascunho && salvo) {
      barraRascunho.hidden = false;
      textoRascunho.textContent = `Rascunho salvo às ${hora(salvo.quando)} neste aparelho`;
    }
    if (status) status.textContent = edicao
      ? 'Rascunho recuperado. Se tinha escolhido uma foto nova, escolha de novo.'
      : 'Rascunho recuperado. A senha e a foto precisam ser preenchidas de novo.';
  });
  campo('fg-retomar-nao')?.addEventListener('click', () => {
    rascunho.apagar(chaveRascunho());
    if (caixaRetomar) caixaRetomar.hidden = true;
  });
  campo('fg-rascunho-apagar')?.addEventListener('click', () => {
    rascunho.apagar(chaveRascunho());
    if (edicao) {
      // Volta pro perfil como está no ar
      entrarNaEdicao({ whatsapp: edicao.whatsapp, senha: edicao.senha, guia: original, edicaoPendente: !campo('fg-editando-pendente')?.hidden }, false);
    } else {
      form?.reset();
      atualizarTudo();
    }
    esconderRascunho();
    if (status) status.textContent = 'Rascunho apagado.';
  });

  function atualizarTudo() { atualizarCupom(); atualizarChips(); atualizarBlocos(); }
  form?.addEventListener('input', (e) => {
    if ((e.target as HTMLElement).id === 'fg-locais-busca') return;
    atualizarChips(); atualizarBlocos(); salvarRascunhoDepois();
  });
  form?.addEventListener('change', (e) => {
    if ((e.target as HTMLElement).id === 'fg-locais-busca') return;
    atualizarChips(); atualizarBlocos(); salvarRascunhoDepois();
  });

  // ---------- Entrar / sair do modo edição ----------
  const caixaEditando = campo('fg-editando');
  const campoSenhaBloco = campo('fg-senha-campo');
  const ajudaTelefone = campo('fg-telefone-ajuda');
  const fotoAtual = campo('fg-foto-atual');
  const fotoAtualImg = campo<HTMLImageElement>('fg-foto-atual-img');

  function preencher(id: string, v: unknown) {
    const el = campo<HTMLInputElement>(id);
    if (el) el.value = v == null ? '' : String(v);
  }

  function entrarNaEdicao(det: { whatsapp: string; senha: string; guia: DadosGuia; edicaoPendente?: boolean }, perguntarRascunho = true) {
    if (!form) return;
    form.reset();
    esconderRascunho();
    edicao = { whatsapp: det.whatsapp, senha: det.senha };
    const g = det.guia || {};
    original = g;

    preencher('fg-nome', g.nome);
    preencher('fg-email', g.email);
    preencher('fg-instagram', g.instagram ? '@' + String(g.instagram).replace(/^@/, '') : '');
    preencher('fg-cidade', g.cidade);
    preencher('fg-uf', g.uf);
    preencher('fg-certificacao', g.certificacao);
    preencher('fg-locais-outro', g.locais_interesse);
    preencher('fg-bio', g.bio);
    preencher('fg-cursos', g.cursos_oferecidos);
    if (campoTelefone) { campoTelefone.value = g.telefone || det.whatsapp; campoTelefone.readOnly = true; }

    const espec: string[] = Array.isArray(g.especialidades_lista) ? g.especialidades_lista : [];
    const caixas = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="especialidade"]'));
    caixas.forEach((el) => { el.checked = espec.includes(el.value); });
    const conhecidas = new Set(caixas.map((el) => el.value));
    preencher('fg-espec-outra', espec.filter((e) => !conhecidas.has(e)).join(', '));

    const locais = new Set((Array.isArray(g.locais_ids) ? g.locais_ids : []).map(String));
    form.querySelectorAll<HTMLInputElement>('input[name="locais_ids"]').forEach((el) => { el.checked = locais.has(el.value); });

    if (chkCupom) chkCupom.checked = !!(g.cupom_codigo && String(g.cupom_codigo).trim());
    preencher('fg-cupom', g.cupom_codigo);
    preencher('fg-cupomdesc', g.cupom_desc);

    if (fotoAtual && fotoAtualImg) {
      fotoAtual.hidden = !g.foto_url;
      if (g.foto_url) fotoAtualImg.src = g.foto_url;
    }

    if (campoSenhaBloco) campoSenhaBloco.hidden = true;
    if (campoSenha) campoSenha.required = false;
    if (ajudaTelefone) ajudaTelefone.textContent = 'O WhatsApp é o seu login e não muda por aqui. Precisa trocar? Fale com a gente pelo Contato.';
    if (caixaEditando) caixaEditando.hidden = false;
    const nomeEl = campo('fg-editando-nome');
    if (nomeEl) nomeEl.textContent = g.nome || '';
    const pendente = campo('fg-editando-pendente');
    if (pendente) pendente.hidden = !det.edicaoPendente;
    if (status) status.textContent = '';
    atualizarTudo();
    if (perguntarRascunho) {
      oferecerRascunho();
      abrirBloco(blocos[0], false);
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function sairDaEdicao() {
    edicao = null;
    original = {};
    form?.reset();
    esconderRascunho();
    if (campoTelefone) campoTelefone.readOnly = false;
    if (campoSenhaBloco) campoSenhaBloco.hidden = false;
    if (campoSenha) campoSenha.required = true;
    if (ajudaTelefone) ajudaTelefone.textContent = 'É com ele (e a senha abaixo) que você entra depois pra editar seu perfil.';
    if (caixaEditando) caixaEditando.hidden = true;
    if (fotoAtual) fotoAtual.hidden = true;
    atualizarTudo();
    abrirBloco(blocos[0], false);
    oferecerRascunho();
  }

  window.addEventListener('guia:editar', (ev) => entrarNaEdicao((ev as CustomEvent).detail));
  campo('fg-cancelar-edicao')?.addEventListener('click', () => {
    sairDaEdicao();
    if (status) status.textContent = '';
  });

  // ---------- Card (mesmo visual de Guias & Cursos) ----------
  let fotoTemp = '';
  function el(tag: string, cls?: string, texto?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (texto != null) e.textContent = texto;
    return e;
  }
  function secao(rotulo: string, ...filhos: Node[]) {
    const d = el('div');
    d.append(el('div', 'fgc-lbl', rotulo), ...filhos);
    return d;
  }
  function especialidadesEscolhidas(): string[] {
    const lista = marcados('especialidade').map((i) => i.value);
    valor('especialidade_outra').split(',').map((x) => x.trim()).filter(Boolean)
      .forEach((x) => { if (!lista.includes(x)) lista.push(x); });
    return lista;
  }
  function montarCard(): HTMLElement {
    const art = el('article', 'fgc');
    const head = el('div', 'fgc-head');
    const nome = valor('nome') || 'Seu nome';
    if (fotoTemp) { URL.revokeObjectURL(fotoTemp); fotoTemp = ''; }
    const arquivo = campoFoto?.files?.[0];
    const fotoUrl = arquivo ? (fotoTemp = URL.createObjectURL(arquivo)) : (edicao ? original.foto_url : '');
    if (fotoUrl) {
      const img = el('img', 'fgc-foto') as HTMLImageElement;
      img.src = fotoUrl; img.alt = nome;
      head.append(img);
    } else {
      head.append(el('div', 'fgc-foto fgc-foto--iniciais', nome.split(/\s+/).filter(Boolean).slice(0, 2).map((p) => p[0].toUpperCase()).join('')));
    }
    const info = el('div', 'fgc-info');
    info.append(el('h3', '', nome));
    const base = [valor('cidade'), valor('uf')].filter(Boolean).join(' · ');
    if (base) info.append(el('div', 'fgc-base', '📍 ' + base));
    head.append(info);
    art.append(head);

    const corpo = el('div', 'fgc-corpo');
    let algum = false;
    if (valor('bio')) { corpo.append(secao('Sobre', el('p', 'fgc-texto', valor('bio')))); algum = true; }
    const espec = especialidadesEscolhidas();
    if (espec.length) {
      const chips = el('div', 'fgc-chips');
      espec.forEach((x) => chips.append(el('span', 'fgc-chip', x)));
      corpo.append(secao('Especialidades', chips)); algum = true;
    }
    const locs = locaisEscolhidos().map((l) => l.nome);
    if (locs.length || valor('locais_outro')) {
      const filhos: Node[] = [];
      if (locs.length) filhos.push(el('p', 'fgc-locais', locs.join(' · ')));
      if (valor('locais_outro')) {
        const p = el('p', 'fgc-locais fgc-locais--outros');
        if (locs.length) p.append(el('strong', '', 'Também: '));
        p.append(valor('locais_outro'));
        filhos.push(p);
      }
      corpo.append(secao('Atua em', ...filhos)); algum = true;
    }
    if (valor('cursos_oferecidos')) { corpo.append(secao('Cursos oferecidos', el('p', 'fgc-texto', valor('cursos_oferecidos')))); algum = true; }
    if (valor('certificacao')) {
      const p = el('p', 'fgc-cert');
      p.append(el('strong', '', 'Certificações: '), valor('certificacao'));
      corpo.append(p); algum = true;
    }
    if (chkCupom?.checked && valor('cupom_codigo')) {
      const c = el('div', 'fgc-cupom');
      const topo = el('div', 'fgc-cupom-topo');
      topo.append(el('span', 'fgc-cupom-lbl', 'Cupom Climbeiros'), el('span', 'fgc-cupom-codigo', valor('cupom_codigo')));
      c.append(topo);
      if (valor('cupom_desc')) c.append(el('p', 'fgc-cupom-desc', valor('cupom_desc')));
      corpo.append(c); algum = true;
    }
    if (!algum) corpo.append(el('p', 'fgc-vazio', 'Preencha os blocos 2 e 3 pra o seu card ganhar conteúdo.'));

    const contato = el('div', 'fgc-contato');
    if (campoTelefone?.value) {
      const a = el('span', 'fgc-btn fgc-btn--ic fgc-wa'); a.title = 'WhatsApp';
      a.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg>';
      contato.append(a);
    }
    const ig = usuarioInstagram(valor('instagram'));
    if (ig) {
      const a = el('span', 'fgc-btn fgc-ig');
      a.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></svg>';
      a.append(el('span', '', '@' + ig));
      contato.append(a);
    }
    if (valor('email')) {
      const a = el('span', 'fgc-btn fgc-btn--ic fgc-em'); a.title = 'E-mail';
      a.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>';
      contato.append(a);
    }
    if (contato.children.length) corpo.append(contato);
    art.append(corpo);
    return art;
  }

  // ---------- Visualizar meu perfil ----------
  const janelaVer = campo<HTMLDialogElement>('fg-ver');
  form?.querySelectorAll('[data-ver-perfil]').forEach((b) => b.addEventListener('click', () => {
    if (!janelaVer || typeof janelaVer.showModal !== 'function') return;
    campo('fg-ver-card')?.replaceChildren(montarCard());
    janelaVer.showModal();
    janelaVer.scrollTop = 0;
  }));
  campo('fg-ver-fechar')?.addEventListener('click', () => janelaVer?.close());
  janelaVer?.addEventListener('click', (e) => { if (e.target === janelaVer) janelaVer.close(); });

  // ---------- Revisão antes de enviar ----------
  const janelaRev = campo<HTMLDialogElement>('fg-revisao');
  function txt(v: unknown): string {
    if (Array.isArray(v)) return v.map((x) => String(x).trim()).filter(Boolean).join(', ');
    return v == null ? '' : String(v).trim();
  }
  function iguais(a: unknown, b: unknown): boolean {
    if (Array.isArray(a) || Array.isArray(b)) {
      const lista = (x: unknown) => (Array.isArray(x) ? x : []).map((y) => String(y).trim()).filter(Boolean).sort().join('|');
      return lista(a) === lista(b);
    }
    return txt(a) === txt(b);
  }
  function caixaConfira(titulo: string, linhas: [string, string][]): HTMLElement {
    const s = el('section', 'fg-rev-bloco');
    s.append(el('h3', '', titulo));
    const dl = el('dl');
    for (const [rot, v] of linhas) {
      const dd = el('dd', v ? '' : 'fg-rev-vazio', v || 'Em branco');
      dl.append(el('dt', '', rot), dd);
    }
    s.append(dl);
    return s;
  }

  function revisar(perfil: Record<string, any>, extra: { telefone: string; mensagem: string; fotoNova: boolean }): Promise<boolean> {
    // Navegador muito antigo sem <dialog>: envia como antes
    if (!janelaRev || typeof janelaRev.showModal !== 'function') return Promise.resolve(true);
    const intro = campo('fg-rev-intro');
    const linhas: [string, string][] = [['WhatsApp (seu login)', extra.telefone], ['E-mail', txt(perfil.email)]];
    if (extra.mensagem) linhas.push(['Mensagem pra equipe', extra.mensagem]);

    if (edicao) {
      const nomes: [string, boolean][] = [
        ['Nome', !iguais(perfil.nome, original.nome)],
        ['E-mail', !iguais(perfil.email, original.email)],
        ['Instagram', !iguais(perfil.instagram, String(original.instagram || '').replace(/^@/, ''))],
        ['Cidade', !iguais(perfil.cidade, original.cidade) || !iguais(perfil.uf, original.uf)],
        ['Especialidades', !iguais(perfil.especialidades_lista, original.especialidades_lista)],
        ['Certificação', !iguais(perfil.certificacao, original.certificacao)],
        ['Foto', extra.fotoNova],
        ['Locais', !iguais(perfil.locais_ids, original.locais_ids) || !iguais(perfil.locais_interesse, original.locais_interesse)],
        ['Sobre você', !iguais(perfil.bio, original.bio)],
        ['Cursos', !iguais(perfil.cursos_oferecidos, original.cursos_oferecidos)],
        ['Cupom', !iguais(perfil.cupom_codigo, original.cupom_codigo) || !iguais(perfil.cupom_desc, original.cupom_desc)],
      ];
      const mudou = nomes.filter(([, m]) => m).map(([n]) => n);
      // Nada mudou (nem mensagem): deixa o banco responder "nada mudou", como antes
      if (!mudou.length && !extra.mensagem) return Promise.resolve(true);
      linhas.unshift(['O que você mudou', mudou.join(', ') || 'Só a mensagem pra equipe']);
      if (intro) intro.textContent = 'É assim que seu card vai ficar depois que a equipe aprovar. Dá uma lida com calma: erro de digitação aparece no site do jeitinho que foi escrito.';
    } else if (intro) {
      intro.textContent = 'É assim que seu card vai aparecer em Guias & Cursos. Dá uma lida com calma, principalmente em "Sobre você" e nos cursos: erro de digitação aparece no site do jeitinho que foi escrito.';
    }

    campo('fg-rev-card')?.replaceChildren(montarCard());
    campo('fg-rev-extra')?.replaceChildren(caixaConfira('Confira também', linhas));
    janelaRev.returnValue = '';
    janelaRev.showModal();
    janelaRev.scrollTop = 0;
    return new Promise((resolve) => {
      janelaRev.addEventListener('close', () => resolve(janelaRev.returnValue === 'enviar'), { once: true });
    });
  }

  // ---------- Envio ----------
  function avisar(texto: string, alvo?: HTMLElement | null) {
    if (status) status.textContent = texto;
    if (alvo) {
      abrirBloco(alvo.closest<HTMLDetailsElement>('.fg-bloco'), false);
      alvo.focus();
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !btn || !form) return;

    // Primeiro obrigatório vazio: abre o bloco certo e põe o cursor no campo
    const faltando = obrigatoriosVazios(form)[0] as HTMLElement | undefined;
    if (faltando) {
      const rotulo = faltando.closest('.fc-campo')?.querySelector('label')?.childNodes[0]?.textContent?.trim() || 'um campo obrigatório';
      const bloco = faltando.closest('.fg-bloco')?.querySelector('strong')?.textContent || '';
      avisar(`Falta preencher "${rotulo}"${bloco ? ` no bloco "${bloco}"` : ''}.`, faltando);
      return;
    }
    const telefone = campoTelefone?.value || '';
    if (!edicao) {
      if (!telefoneValido(telefone)) {
        avisar('Preencha o WhatsApp no formato (11)991721313, com DDD e 9 números. Ele é o seu login pra editar o perfil depois.', campoTelefone);
        return;
      }
      if (!/^\d{6}$/.test(campoSenha?.value || '')) {
        avisar('Crie uma senha com 6 números. Com ela você edita seu perfil depois.', campoSenha);
        return;
      }
    }
    const emailEl = campo<HTMLInputElement>('fg-email');
    if (emailEl && !emailEl.checkValidity()) {
      avisar('Confira o e-mail: parece que falta alguma coisa (ex.: nome@email.com).', emailEl);
      return;
    }
    const arquivoFoto = campoFoto?.files?.[0];
    if (arquivoFoto && arquivoFoto.size > 5 * 1024 * 1024) {
      avisar('A foto passou de 5 MB. Escolha uma menor ou deixe o campo em branco.', campoFoto);
      return;
    }
    status.textContent = '';

    const temCupom = !!chkCupom?.checked;
    const perfil: Record<string, any> = {
      nome: valor('nome'),
      email: valor('email'),
      instagram: usuarioInstagram(valor('instagram')),
      cidade: valor('cidade') || null,
      uf: valor('uf') || null,
      especialidades_lista: especialidadesEscolhidas(),
      certificacao: valor('certificacao') || null,
      bio: valor('bio') || null,
      cursos_oferecidos: valor('cursos_oferecidos') || null,
      locais_ids: locaisEscolhidos().map((l) => l.id),
      locais_interesse: valor('locais_outro') || null,
      tem_cupom: temCupom ? 'Sim' : 'Não',
      cupom_codigo: temCupom ? (valor('cupom_codigo') || null) : null,
      cupom_desc: temCupom ? (valor('cupom_desc') || null) : null,
    };
    const mensagem = valor('mensagem');

    // ----- Revisão antes de enviar -----
    const confirmou = await revisar(perfil, { telefone, mensagem, fotoNova: !!arquivoFoto });
    if (!confirmou) {
      status.textContent = 'Sem pressa: ajuste o que precisar e clique em "Revisar e enviar" de novo.';
      return;
    }

    btn.setAttribute('disabled', '');
    status.textContent = 'Enviando...';

    // Foto (opcional): sobe pro bucket público "fotos-guias" antes de gravar
    let fotoUrl: string | null = null;
    if (arquivoFoto) {
      const extensao = arquivoFoto.name.split('.').pop();
      const nomeArquivo = `${Date.now()}-${Math.random().toString(36).slice(2)}.${extensao}`;
      const { error: erroUpload } = await supabase.storage.from('fotos-guias').upload(nomeArquivo, arquivoFoto);
      if (!erroUpload) {
        fotoUrl = supabase.storage.from('fotos-guias').getPublicUrl(nomeArquivo).data.publicUrl;
      }
    }

    // ----- Editando um perfil que já existe -----
    if (edicao) {
      if (fotoUrl) perfil.foto_url = fotoUrl;   // sem foto nova, a atual continua
      const chaveEdicao = chaveRascunho();
      const { data: r, error } = await supabase.rpc('guia_enviar_edicao', {
        p_whatsapp: edicao.whatsapp, p_senha: edicao.senha, p_dados: perfil, p_mensagem: mensagem || null,
      });
      btn.removeAttribute('disabled');
      if (error || !r) {
        status.textContent = 'Ops, algo deu errado. Seu rascunho continua salvo: tente novamente ou escreva para contato@climbeiros.com.br';
        return;
      }
      if (!r.ok) {
        status.textContent = r.motivo === 'nada_mudou'
          ? 'Nada mudou em relação ao seu perfil atual. Mude algum campo antes de enviar.'
          : r.motivo === 'travado'
            ? 'Muitas tentativas erradas: o acesso foi travado por segurança. Fale com a gente pelo Contato que a gente destrava.'
            : 'Não consegui conferir seu acesso. Feche e entre de novo em "Editar meu perfil".';
        return;
      }
      rascunho.apagar(chaveEdicao);
      sairDaEdicao();
      status.textContent = 'Recebemos suas alterações! Assim que a equipe aprovar, elas aparecem no site. 🧗';
      return;
    }

    // ----- Inscrição nova -----
    const { error } = await supabase.from('inscricoes_guias').insert([{
      ...perfil,
      telefone,
      foto_url: fotoUrl,
      mensagem: mensagem || null,
      senha_hash: campoSenha?.value,   // chega com os 6 números; o banco embaralha antes de gravar
    }]);
    btn.removeAttribute('disabled');
    if (error) {
      status.textContent = 'Ops, algo deu errado. Seu rascunho continua salvo: tente novamente ou escreva para contato@climbeiros.com.br';
      return;
    }
    rascunho.apagar(CHAVE_NOVO);
    form.reset();
    esconderRascunho();
    atualizarTudo();
    abrirBloco(blocos[0], false);
    status.textContent = 'Recebemos sua inscrição! Em breve a gente entra em contato. 🧗';
  });

  atualizarTudo();
  oferecerRascunho();
</script>

