---
// src/components/FormGuia.astro
// Formulário "É guia/instrutor e quer aparecer aqui?". Grava em
// "inscricoes_guias" (entra pendente no painel). Usado em Guias & Cursos e
// na página de Contato. Use só uma vez por página (os ids são fixos).
//
// Modo edição (08/11/2026): quando o guia entra em "Editar meu perfil" (Guias &
// Cursos), a página dispara o evento "guia:editar" com os dados dele. O formulário
// vem preenchido e, ao enviar, chama guia_enviar_edicao (a edição espera aprovação
// na tabela edicoes_guias). O WhatsApp fica travado, porque é o login.
import { supabase } from '../lib/supabase';
import '../styles/formularios.css';

const { data: locais } = await supabase
  .from('locais')
  .select('id, nome, estado')
  .order('estado', { ascending: true })
  .order('nome', { ascending: true }) as { data: { id: string; nome: string; estado: string | null }[] | null };

const locaisPorEstado = new Map<string, { id: string; nome: string }[]>();
for (const l of locais ?? []) {
  const estado = l.estado || 'Outros';
  if (!locaisPorEstado.has(estado)) locaisPorEstado.set(estado, []);
  locaisPorEstado.get(estado)!.push(l);
}

const UFS = ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'];
const ESPECIALIDADES = ['Escalada esportiva','Escalada tradicional','Boulder','Escalada indoor','Montanhismo','Alpinismo','Escalada em gelo','Trekking','Canionismo','Escalada móvel','Escalada em fendas','Escalada artificial','Bigwall','Curso de autoresgate'];
---
<form class="fc" id="form-guia">
  <div class="fg-editando" id="fg-editando" hidden>
    <p><strong>Editando o perfil de <span id="fg-editando-nome"></span></strong></p>
    <p>Mude o que quiser e clique em "Enviar alterações". A equipe confere antes de aparecer no site; até lá, seu perfil atual continua no ar.</p>
    <p id="fg-editando-pendente" hidden>Você já tem uma alteração esperando aprovação. Se enviar de novo, esta nova substitui a anterior.</p>
    <button type="button" class="fg-cancelar" id="fg-cancelar-edicao">Cancelar edição</button>
  </div>
  <p class="fc-legenda" id="fg-legenda">Só <strong>nome</strong>, <strong>e-mail</strong>, <strong>WhatsApp</strong> e <strong>senha</strong> são obrigatórios; o resto é opcional, mas quanto mais completo, melhor fica o seu card. Fique de olho também nas etiquetas: <span class="selo selo--site">No site</span> aparece pra todo mundo, <span class="selo selo--equipe">Só a equipe vê</span> fica só com a gente.</p>
  <div class="fc-linha">
    <div class="fc-campo">
      <label for="fg-nome">Nome <span class="req req--sim">Obrigatório</span> <span class="selo selo--site">No site</span></label>
      <input type="text" id="fg-nome" name="nome" required />
    </div>
    <div class="fc-campo">
      <label for="fg-email">E-mail <span class="req req--sim">Obrigatório</span> <span class="selo selo--site">No site</span></label>
      <input type="email" id="fg-email" name="email" required />
    </div>
  </div>
  <div class="fc-linha">
    <div class="fc-campo">
      <label for="fg-telefone">WhatsApp <span class="req req--sim">Obrigatório</span> <span class="selo selo--site">No site</span></label>
      <input type="tel" id="fg-telefone" name="telefone" placeholder="(11)991721313" maxlength="13" inputmode="numeric" required />
      <small class="fc-ajuda" id="fg-telefone-ajuda">É com ele (e a senha abaixo) que você entra depois pra editar seu perfil.</small>
    </div>
    <div class="fc-campo">
      <label for="fg-instagram">Instagram <span class="req req--nao">Opcional</span> <span class="selo selo--site">No site</span></label>
      <input type="text" id="fg-instagram" name="instagram" placeholder="@seu.perfil" />
    </div>
  </div>
  <div class="fc-campo" id="fg-senha-campo">
    <label for="fg-senha">Crie uma senha de 6 números <span class="req req--sim">Obrigatório</span></label>
    <input type="password" id="fg-senha" name="senha" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" autocomplete="new-password" placeholder="••••••" required />
    <small class="fc-ajuda">Pra você mesmo atualizar seu perfil quando quiser (foto, cursos, cupom...). Ninguém vê essa senha, nem a gente.</small>
  </div>
  <div class="fc-linha">
    <div class="fc-campo">
      <label for="fg-cidade">Cidade <span class="req req--nao">Opcional</span> <span class="selo selo--site">No site</span></label>
      <input type="text" id="fg-cidade" name="cidade" placeholder="Ex.: São Paulo" />
    </div>
    <div class="fc-campo">
      <label for="fg-uf">UF <span class="req req--nao">Opcional</span> <span class="selo selo--site">No site</span></label>
      <select id="fg-uf" name="uf">
        <option value="">Selecione</option>
        {UFS.map((uf) => <option value={uf}>{uf}</option>)}
      </select>
    </div>
  </div>
  <div class="fc-campo">
    <span class="fc-label">Melhor contato para divulgarmos <span class="req req--nao">Opcional</span> <span class="selo selo--equipe">Só a equipe vê</span></span>
    <div class="fc-opcoes">
      <label class="fc-check"><input type="checkbox" name="pref" value="WhatsApp" /> WhatsApp</label>
      <label class="fc-check"><input type="checkbox" name="pref" value="Instagram" /> Instagram</label>
    </div>
  </div>
  <div class="fc-campo">
    <span class="fc-label">Especialidades <span class="req req--nao">Opcional</span> <span class="selo selo--site">No site</span></span>
    <div class="fc-opcoes">
      {ESPECIALIDADES.map((esp) => (
        <label class="fc-check"><input type="checkbox" name="especialidade" value={esp} /> {esp}</label>
      ))}
    </div>
    <input type="text" id="fg-espec-outra" name="especialidade_outra" placeholder="Outra especialidade (opcional)" />
  </div>
  <div class="fc-campo">
    <label for="fg-certificacao">Certificação <span class="req req--nao">Opcional</span> <span class="selo selo--site">No site</span></label>
    <input type="text" id="fg-certificacao" name="certificacao" placeholder="Ex.: Guia CANMOD, AGB, instrutor de ginásio..." />
  </div>
  <div class="fc-campo">
    <label for="fg-foto">Foto <span class="req req--nao">Opcional</span> <span class="selo selo--site">No site</span></label>
    <p class="fg-foto-atual" id="fg-foto-atual" hidden><img id="fg-foto-atual-img" alt="" /> <span>Sua foto atual. Escolha outra só se quiser trocar.</span></p>
    <input type="file" id="fg-foto" name="foto" accept="image/png, image/jpeg, image/webp" />
    <small class="fc-ajuda">Até 5 MB.</small>
  </div>
  <div class="fc-campo">
    <label for="fg-locais">Em quais locais você atua? <span class="req req--nao">Opcional</span> <span class="selo selo--site">No site</span></label>
    <select id="fg-locais" name="locais_ids" multiple size="6">
      {Array.from(locaisPorEstado.entries()).map(([estado, lista]) => (
        <optgroup label={estado}>
          {lista.map((l) => <option value={l.id}>{l.nome}</option>)}
        </optgroup>
      ))}
    </select>
    <small class="fc-ajuda">Segure Ctrl (ou Cmd no Mac) pra selecionar mais de um local. Usamos isso pra te mostrar na página de cada local.</small>
  </div>
  <div class="fc-campo">
    <label for="fg-locais-outro">Atua em algum local que não está na lista? <span class="req req--nao">Opcional</span> <span class="selo selo--site">No site</span></label>
    <textarea id="fg-locais-outro" name="locais_outro" rows="2" placeholder="Escreva aqui o nome do local, cidade e estado. Ainda estamos cadastrando as rotas do site, então é normal seu local não aparecer ainda."></textarea>
    <small class="fc-ajuda">Não precisa se preocupar em não achar seu local na lista acima, isso não trava sua inscrição. A gente usa essa informação pra saber quais locais cadastrar em seguida.</small>
  </div>
  <div class="fc-campo">
    <label for="fg-bio">Sobre você <span class="req req--nao">Opcional</span> <span class="selo selo--site">No site</span></label>
    <textarea id="fg-bio" name="bio" rows="3" placeholder="Conte um pouco sobre sua experiência"></textarea>
  </div>
  <div class="fc-campo">
    <label for="fg-cursos">Cursos oferecidos <span class="req req--nao">Opcional</span> <span class="selo selo--site">No site</span></label>
    <textarea id="fg-cursos" name="cursos_oferecidos" rows="4" placeholder="Conte quais cursos você oferece: o nível, onde acontece, próximas datas, valor e o link ou contato pra inscrição."></textarea>
    <small class="fc-ajuda">Um curso por linha ou parágrafo. Não oferece cursos? Pode deixar em branco.</small>
  </div>
  <div class="fc-campo">
    <label for="fg-msg">Mensagem pra equipe Climbeiros <span class="req req--nao">Opcional</span> <span class="selo selo--equipe">Só a equipe vê</span></label>
    <textarea id="fg-msg" name="mensagem" rows="3" placeholder="Algo que só a gente precise saber"></textarea>
  </div>
  <label class="fc-check">
    <input type="checkbox" name="tem_cupom" id="fg-tem-cupom" />
    Quero oferecer um cupom de desconto para a comunidade Climbeiros
  </label>
  <div class="fc-destaque" id="fg-cupom-campos" hidden>
    <div class="fc-campo">
      <label for="fg-cupom">Código do cupom <span class="req req--sim">Obrigatório</span> <span class="selo selo--site">No site</span></label>
      <input type="text" id="fg-cupom" name="cupom_codigo" placeholder="Ex.: GUIA10" />
    </div>
    <div class="fc-campo">
      <label for="fg-cupomdesc">Qual é o benefício? <span class="req req--sim">Obrigatório</span> <span class="selo selo--site">No site</span></label>
      <textarea id="fg-cupomdesc" name="cupom_desc" rows="3" placeholder="Ex.: 10% de desconto na primeira aula avulsa, ou 1 dia grátis no curso de 2 dias"></textarea>
      <small class="fc-ajuda">Aparece embaixo do código no seu card, pra pessoa saber o que ganha usando o cupom.</small>
    </div>
  </div>
  <button type="submit" class="botao" id="fg-enviar">Enviar inscrição</button>
  <p class="fc-status" id="fg-status" role="status"></p>
</form>

<script>
  import { supabase } from '../lib/supabase';
  import { usuarioInstagram } from '../lib/contatos';
  import { mascaraTelefone, telefoneValido } from '../lib/formularios';

  const form = document.getElementById('form-guia') as HTMLFormElement | null;
  const status = document.getElementById('fg-status');
  const btn = document.getElementById('fg-enviar');
  const campoTelefone = document.getElementById('fg-telefone') as HTMLInputElement | null;
  const campoSenha = document.getElementById('fg-senha') as HTMLInputElement | null;
  mascaraTelefone(campoTelefone);
  campoSenha?.addEventListener('input', () => { campoSenha.value = campoSenha.value.replace(/\D/g, '').slice(0, 6); });

  const chkCupom = document.getElementById('fg-tem-cupom') as HTMLInputElement | null;
  const camposCupom = document.getElementById('fg-cupom-campos');
  const campoCupom = document.getElementById('fg-cupom') as HTMLInputElement | null;
  const campoCupomDesc = document.getElementById('fg-cupomdesc') as HTMLTextAreaElement | null;
  function atualizarCupom() {
    if (!chkCupom) return;
    if (camposCupom) camposCupom.hidden = !chkCupom.checked;
    // Com cupom marcado, código e benefício passam a ser obrigatórios
    if (campoCupom) campoCupom.required = chkCupom.checked;
    if (campoCupomDesc) campoCupomDesc.required = chkCupom.checked;
  }
  chkCupom?.addEventListener('change', atualizarCupom);

  // ---------- Modo edição ----------
  type DadosGuia = Record<string, any>;
  let edicao: { whatsapp: string; senha: string } | null = null;
  const caixaEditando = document.getElementById('fg-editando');
  const legenda = document.getElementById('fg-legenda');
  const campoSenhaBloco = document.getElementById('fg-senha-campo');
  const ajudaTelefone = document.getElementById('fg-telefone-ajuda');
  const fotoAtual = document.getElementById('fg-foto-atual');
  const fotoAtualImg = document.getElementById('fg-foto-atual-img') as HTMLImageElement | null;

  function campo<T extends HTMLElement>(id: string) { return document.getElementById(id) as T | null; }
  function preencher(id: string, valor: unknown) {
    const el = campo<HTMLInputElement>(id);
    if (el) el.value = valor == null ? '' : String(valor);
  }

  function entrarNaEdicao(det: { whatsapp: string; senha: string; guia: DadosGuia; edicaoPendente?: boolean }) {
    if (!form) return;
    form.reset();
    edicao = { whatsapp: det.whatsapp, senha: det.senha };
    const g = det.guia || {};

    preencher('fg-nome', g.nome);
    preencher('fg-email', g.email);
    preencher('fg-instagram', g.instagram ? '@' + String(g.instagram).replace(/^@/, '') : '');
    preencher('fg-cidade', g.cidade);
    preencher('fg-uf', g.uf);
    preencher('fg-certificacao', g.certificacao);
    preencher('fg-locais-outro', g.locais_interesse);
    preencher('fg-bio', g.bio);
    preencher('fg-cursos', g.cursos_oferecidos);
    if (campoTelefone) { campoTelefone.value = g.telefone || det.whatsapp; campoTelefone.readOnly = true; }

    const prefs = String(g.contato_pref || '').split(',').map((p) => p.trim());
    form.querySelectorAll<HTMLInputElement>('input[name="pref"]').forEach((el) => { el.checked = prefs.includes(el.value); });

    const espec: string[] = Array.isArray(g.especialidades_lista) ? g.especialidades_lista : [];
    const caixas = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="especialidade"]'));
    caixas.forEach((el) => { el.checked = espec.includes(el.value); });
    const conhecidas = new Set(caixas.map((el) => el.value));
    preencher('fg-espec-outra', espec.filter((e) => !conhecidas.has(e)).join(', '));

    const locais = new Set((Array.isArray(g.locais_ids) ? g.locais_ids : []).map(String));
    const sel = campo<HTMLSelectElement>('fg-locais');
    if (sel) Array.from(sel.options).forEach((o) => { o.selected = locais.has(o.value); });

    if (chkCupom) chkCupom.checked = !!(g.cupom_codigo && String(g.cupom_codigo).trim());
    preencher('fg-cupom', g.cupom_codigo);
    preencher('fg-cupomdesc', g.cupom_desc);
    atualizarCupom();

    if (fotoAtual && fotoAtualImg) {
      fotoAtual.hidden = !g.foto_url;
      if (g.foto_url) fotoAtualImg.src = g.foto_url;
    }

    if (campoSenhaBloco) campoSenhaBloco.hidden = true;
    if (campoSenha) campoSenha.required = false;
    if (ajudaTelefone) ajudaTelefone.textContent = 'O WhatsApp é o seu login e não muda por aqui. Precisa trocar? Fale com a gente pelo Contato.';
    if (legenda) legenda.hidden = true;
    if (caixaEditando) caixaEditando.hidden = false;
    const nomeEl = campo('fg-editando-nome');
    if (nomeEl) nomeEl.textContent = g.nome || '';
    const pendente = campo('fg-editando-pendente');
    if (pendente) pendente.hidden = !det.edicaoPendente;
    if (btn) btn.textContent = 'Enviar alterações';
    if (status) status.textContent = '';
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function sairDaEdicao() {
    edicao = null;
    form?.reset();
    atualizarCupom();
    if (campoTelefone) campoTelefone.readOnly = false;
    if (campoSenhaBloco) campoSenhaBloco.hidden = false;
    if (campoSenha) campoSenha.required = true;
    if (ajudaTelefone) ajudaTelefone.textContent = 'É com ele (e a senha abaixo) que você entra depois pra editar seu perfil.';
    if (legenda) legenda.hidden = false;
    if (caixaEditando) caixaEditando.hidden = true;
    if (fotoAtual) fotoAtual.hidden = true;
    if (btn) btn.textContent = 'Enviar inscrição';
  }

  window.addEventListener('guia:editar', (ev) => entrarNaEdicao((ev as CustomEvent).detail));
  document.getElementById('fg-cancelar-edicao')?.addEventListener('click', () => {
    sairDaEdicao();
    if (status) status.textContent = '';
  });

  // ---------- Envio ----------
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !btn || !form) return;
    const dados = Object.fromEntries(new FormData(form).entries()) as Record<string, any>;
    if (!dados.nome || !dados.email) {
      status.textContent = 'Por favor, preencha ao menos nome e e-mail.';
      return;
    }
    const telefone = campoTelefone?.value || '';
    if (!edicao) {
      if (!telefone || !telefoneValido(telefone)) {
        status.textContent = 'Preencha o WhatsApp no formato (11)991721313, com DDD e 9 números. Ele é o seu login pra editar o perfil depois.';
        campoTelefone?.focus();
        return;
      }
      if (!/^\d{6}$/.test(campoSenha?.value || '')) {
        status.textContent = 'Crie uma senha com 6 números. Com ela você edita seu perfil depois.';
        campoSenha?.focus();
        return;
      }
    }
    const temCupom = !!chkCupom?.checked;
    if (temCupom && (!String(dados.cupom_codigo || '').trim() || !String(dados.cupom_desc || '').trim())) {
      status.textContent = 'Você marcou que quer oferecer um cupom: preencha o código e qual é o benefício (ou desmarque a opção).';
      (String(dados.cupom_codigo || '').trim() ? campoCupomDesc : campoCupom)?.focus();
      return;
    }
    const prefContato = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="pref"]:checked'))
      .map((el) => el.value).join(', ');
    const especialidades = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="especialidade"]:checked'))
      .map((el) => el.value);
    String(dados.especialidade_outra || '').split(',').map((x) => x.trim()).filter(Boolean)
      .forEach((x) => { if (!especialidades.includes(x)) especialidades.push(x); });
    const locaisSelect = form.querySelector<HTMLSelectElement>('#fg-locais');
    const locaisIds = locaisSelect ? Array.from(locaisSelect.selectedOptions).map((o) => o.value) : [];

    btn.setAttribute('disabled', '');
    status.textContent = 'Enviando...';

    // Foto (opcional): sobe pro bucket público "fotos-guias" antes de gravar
    let fotoUrl: string | null = null;
    const arquivoFoto = form.querySelector<HTMLInputElement>('#fg-foto')?.files?.[0];
    if (arquivoFoto) {
      if (arquivoFoto.size > 5 * 1024 * 1024) {
        status.textContent = 'A foto passou de 5 MB. Escolha uma menor ou deixe o campo em branco.';
        btn.removeAttribute('disabled');
        return;
      }
      const extensao = arquivoFoto.name.split('.').pop();
      const nomeArquivo = `${Date.now()}-${Math.random().toString(36).slice(2)}.${extensao}`;
      const { error: erroUpload } = await supabase.storage.from('fotos-guias').upload(nomeArquivo, arquivoFoto);
      if (!erroUpload) {
        fotoUrl = supabase.storage.from('fotos-guias').getPublicUrl(nomeArquivo).data.publicUrl;
      }
    }

    const perfil: Record<string, any> = {
      nome: dados.nome,
      email: dados.email,
      instagram: usuarioInstagram(dados.instagram),
      contato_pref: prefContato || null,
      cidade: dados.cidade || null,
      uf: dados.uf || null,
      especialidades_lista: especialidades,
      certificacao: dados.certificacao || null,
      bio: dados.bio || null,
      cursos_oferecidos: String(dados.cursos_oferecidos || '').trim() || null,
      locais_ids: locaisIds,
      locais_interesse: dados.locais_outro || null,
      tem_cupom: temCupom ? 'Sim' : 'Não',
      cupom_codigo: temCupom ? (dados.cupom_codigo || null) : null,
      cupom_desc: temCupom ? (dados.cupom_desc || null) : null,
    };

    // ----- Editando um perfil que já existe -----
    if (edicao) {
      if (fotoUrl) perfil.foto_url = fotoUrl;   // sem foto nova, a atual continua
      const { data: r, error } = await supabase.rpc('guia_enviar_edicao', {
        p_whatsapp: edicao.whatsapp, p_senha: edicao.senha, p_dados: perfil, p_mensagem: dados.mensagem || null,
      });
      btn.removeAttribute('disabled');
      if (error || !r) {
        status.textContent = 'Ops, algo deu errado. Tente novamente ou escreva para contato@climbeiros.com.br';
        return;
      }
      if (!r.ok) {
        status.textContent = r.motivo === 'nada_mudou'
          ? 'Nada mudou em relação ao seu perfil atual. Mude algum campo antes de enviar.'
          : r.motivo === 'travado'
            ? 'Muitas tentativas erradas: o acesso foi travado por segurança. Fale com a gente pelo Contato que a gente destrava.'
            : 'Não consegui conferir seu acesso. Feche e entre de novo em "Editar meu perfil".';
        return;
      }
      sairDaEdicao();
      status.textContent = 'Recebemos suas alterações! Assim que a equipe aprovar, elas aparecem no site. 🧗';
      return;
    }

    // ----- Inscrição nova -----
    const { error } = await supabase.from('inscricoes_guias').insert([{
      ...perfil,
      telefone,
      foto_url: fotoUrl,
      mensagem: dados.mensagem || null,
      senha_hash: campoSenha?.value,   // chega com os 6 números; o banco embaralha antes de gravar
    }]);
    if (error) {
      status.textContent = 'Ops, algo deu errado. Tente novamente ou escreva para contato@climbeiros.com.br';
      btn.removeAttribute('disabled');
      return;
    }
    form.reset();
    atualizarCupom();
    status.textContent = 'Recebemos sua inscrição! Em breve a gente entra em contato. 🧗';
    btn.removeAttribute('disabled');
  });
</script>

<style>
  #form-guia { scroll-margin-top: 110px; }
  .fg-editando { background: var(--creme-claro); border-left: 4px solid var(--laranja); border-radius: 0 8px 8px 0; padding: 12px 16px; margin-bottom: 16px; }
  .fg-editando p { margin: 0 0 6px; }
  .fg-editando[hidden], .fg-foto-atual[hidden], #fg-senha-campo[hidden], .fc-legenda[hidden], #fg-editando-pendente[hidden] { display: none; }
  .fg-cancelar { background: none; border: 0; padding: 0; color: var(--laranja); font: inherit; font-weight: 600; text-decoration: underline; cursor: pointer; }
  .fg-foto-atual { display: flex; align-items: center; gap: 10px; margin: 0 0 6px; font-size: .9rem; }
