  .fg-rev-foto { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; display: block; }
  .fg-rev-botoes { position: sticky; bottom: 0; background: #fffdf7; display: flex; justify-content: flex-end; gap: 10px; flex-wrap: wrap; padding: 14px 0 22px; margin: 0; border-top: 1px solid rgba(42,31,22,.12); }
