---
const links = [
  { href: '/', label: 'Home' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/beta', label: 'Beta' },
  { href: '/academias', label: 'Academias & Cursos' },
  { href: '/rotas', label: 'Rotas & Setores' },
  { href: '/parceiros', label: 'Parcerias & Cupons' },
  { href: '/contato', label: 'Contato' },
];
const path = Astro.url.pathname;
---
<header class="header">
  <div class="container header__linha">
    <a href="/" class="header__marca">
      <img src="/logo.png" alt="Climbeiros" class="header__logo" />
    </a>

    <nav class="header__nav" aria-label="Navegação principal">
      <ul class="header__lista header__lista--desktop">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['header__link', { 'header__link--ativo': path === link.href }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button class="header__menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu-lista-mobile">
      <span class="visually-hidden">Abrir menu</span>
      ☰
    </button>
  </div>

  <ul class="header__lista header__lista--mobile" id="menu-lista-mobile">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class:list={['header__link', { 'header__link--ativo': path === link.href }]}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</header>

<style>
  .header {
    background: var(--verde-escuro);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 2px 12px rgba(0,0,0,0.15);
  }
  .header__linha {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 24px;
    padding-top: 4px;
    padding-bottom: 4px;
  }
  .header__marca { flex-shrink: 0; }
  .header__logo {
    height: 60px;
    width: auto;
    display: block;
  }
  .header__nav { flex: 1; min-width: 0; }
  .header__menu-btn {
    display: none;
    background: none;
    border: none;
    color: var(--creme-claro);
    font-size: 1.5rem;
    cursor: pointer;
  }
  .header__lista {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
    flex-wrap: wrap;
  }
  .header__lista li {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 60px;
  }
  .header__lista--mobile { display: none; }
  .header__link {
    font-family: var(--fonte-display);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.85rem;
    color: var(--creme-claro);
    line-height: 1.25;
    white-space: nowrap;
  }
  .header__link:hover { color: var(--amarelo); text-decoration: none; }
  .header__link--ativo { color: var(--amarelo); }

  @media (max-width: 900px) {
    .header__nav { display: none; }
    .header__menu-btn { display: block; }
    .header__linha { justify-content: space-between; }
    .header__logo { height: 56px; }
    .header__lista--mobile {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--verde-escuro);
      flex-direction: column;
      gap: 0;
      padding: 8px 24px 20px;
    }
    .header__lista--mobile.header__lista--aberta { display: flex; }
    .header__lista--mobile .header__link { display: block; padding: 10px 0; white-space: normal; }
    .header__lista--mobile li { min-height: auto; justify-content: flex-start; text-align: left; }
  }
</style>

<script>
  const btn = document.getElementById('menu-btn');
  const lista = document.getElementById('menu-lista-mobile');
  btn?.addEventListener('click', () => {
    const aberto = lista?.classList.toggle('header__lista--aberta');
    btn.setAttribute('aria-expanded', aberto ? 'true' : 'false');
  });
</script>
