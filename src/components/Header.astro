---
const links = [
  { href: '/', label: 'Home' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/academias', label: 'Academias & Cursos' },
  { href: '/rotas', label: 'Rotas & Setores' },
  { href: '/guias', label: 'Guias & Dicas' },
  { href: '/parceiros', label: 'Parcerias & Cupons' },
  { href: '/contato', label: 'Contato' },
];
const path = Astro.url.pathname;
---
<header class="header">
  <div class="container header__linha">
    <a href="/" class="header__marca">
      <img src="/logo.png" alt="Climbeiros" class="header__logo" />
    </a>
    <nav class="header__nav" aria-label="Navegação principal">
      <button class="header__menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu-lista">
        <span class="visually-hidden">Abrir menu</span>
        ☰
      </button>
      <ul class="header__lista" id="menu-lista">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['header__link', { 'header__link--ativo': path === link.href }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    background: var(--verde-escuro);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 2px 12px rgba(0,0,0,0.15);
  }
  .header__linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 4px;
    padding-bottom: 4px;
  }
  .header__logo {
    height: 132px;
    width: auto;
  }
  .header__menu-btn {
    display: none;
    background: none;
    border: none;
    color: var(--creme-claro);
    font-size: 1.5rem;
    cursor: pointer;
  }
  .header__lista {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__link {
    font-family: var(--fonte-display);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 1.05rem;
    color: var(--creme-claro);
  }
  .header__link:hover { color: var(--amarelo); text-decoration: none; }
  .header__link--ativo { color: var(--amarelo); }

  @media (max-width: 760px) {
    .header__menu-btn { display: block; }
    .header__logo { height: 64px; }
    .header__lista {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--verde-escuro);
      flex-direction: column;
      gap: 0;
      padding: 8px 24px 20px;
    }
    .header__lista--aberta { display: flex; }
    .header__link { display: block; padding: 10px 0; }
  }
</style>

<script>
  const btn = document.getElementById('menu-btn');
  const lista = document.getElementById('menu-lista');
  btn?.addEventListener('click', () => {
    const aberto = lista?.classList.toggle('header__lista--aberta');
    btn.setAttribute('aria-expanded', aberto ? 'true' : 'false');
  });
</script>
