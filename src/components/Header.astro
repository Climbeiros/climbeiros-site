---
// Menu do site (opção 6 + 3 botões no celular, escolhida pelas sócias em 08/11/2026).
// Computador: 3 botões (Escalar, Comunidade, Os Climbeiros) na barra, todos em creme; cada um abre a sua lista.
// Celular: o ☰ abre os 3 grupos (Escalar, Comunidade, Os Climbeiros); cada grupo abre a sua lista.
// Ícones: Tabler Icons (licença MIT), copiados como SVG.

const icones: Record<string, string> = {
  book: '<path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0"/><path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0"/><path d="M3 6l0 13"/><path d="M12 6l0 13"/><path d="M21 6l0 13"/>',
  building: '<path d="M3 21l18 0"/><path d="M9 8l1 0"/><path d="M9 12l1 0"/><path d="M9 16l1 0"/><path d="M14 8l1 0"/><path d="M14 12l1 0"/><path d="M14 16l1 0"/><path d="M5 21v-16a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v16"/>',
  compass: '<path d="M8 16l2 -6l6 -2l-2 6l-6 2"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"/><path d="M12 3l0 2"/><path d="M12 19l0 2"/><path d="M3 12l2 0"/><path d="M19 12l2 0"/>',
  map: '<path d="M12 18.5l-3 -1.5l-6 3v-13l6 -3l6 3l6 -3v7.5"/><path d="M9 4v13"/><path d="M15 7v5.5"/><path d="M21.121 20.121a3 3 0 1 0 -4.242 0c.418 .419 1.125 1.045 2.121 1.879c1.051 -.89 1.759 -1.516 2.121 -1.879"/><path d="M19 18v.01"/>',
  calendar: '<path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12"/><path d="M16 3v4"/><path d="M8 3v4"/><path d="M4 11h16"/><path d="M11 15h1"/><path d="M12 15v3"/>',
  tag: '<path d="M6.5 7.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/><path d="M3 6v5.172a2 2 0 0 0 .586 1.414l7.71 7.71a2.41 2.41 0 0 0 3.408 0l5.592 -5.592a2.41 2.41 0 0 0 0 -3.408l-7.71 -7.71a2 2 0 0 0 -1.414 -.586h-5.172a3 3 0 0 0 -3 3"/>',
  ticket: '<path d="M15 5l0 2"/><path d="M15 11l0 2"/><path d="M15 17l0 2"/><path d="M5 5h14a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-3a2 2 0 0 0 0 -4v-3a2 2 0 0 1 2 -2"/>',
  photo: '<path d="M15 8h.01"/><path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12"/><path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5"/><path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3"/>',
  mountain: '<path d="M3 20h18l-6.921 -14.612a2.3 2.3 0 0 0 -4.158 0l-6.921 14.612"/><path d="M7.5 11l2 2.5l2.5 -2.5l2 3l2.5 -2"/>',
  users: '<path d="M5 7a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"/><path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/><path d="M21 21v-2a4 4 0 0 0 -3 -3.85"/>',
  info: '<path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M12 9h.01"/><path d="M11 12h1v4h1"/>',
};
const svg = (nome: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icones[nome]}</svg>`;

type Item = { href: string; label: string; curto?: string; desc: string; icone?: string };

// "Aprenda" leva pra página /beta (Escalada 101 + Crux); o endereço continua o mesmo.
const escalar: Item[] = [
  { href: '/beta', label: 'Aprenda', desc: 'comece do zero', icone: 'book' },
  { href: '/academias', label: 'Academias', desc: 'onde treinar', icone: 'building' },
  { href: '/cursos', label: 'Guias & Cursos', desc: 'quem te leva', icone: 'compass' },
  { href: '/rotas', label: 'Rotas & Setores', curto: 'Rotas', desc: 'onde escalar', icone: 'map' },
];
const comunidade: Item[] = [
  { href: '/acontece', label: 'Acontece', desc: 'agenda', icone: 'calendar' },
  { href: '/desapego', label: 'Desapego', desc: 'equipamento usado', icone: 'tag' },
  { href: '/parceiros', label: 'Cupons', desc: 'descontos', icone: 'ticket' },
  { href: '/galeria', label: 'Galeria', desc: 'fotos da galera', icone: 'photo' },
];
// Pela Rede fica dentro de Comunidade.
const comunidadeCelular: Item[] = [
  ...comunidade,
  { href: '/pela-rede', label: 'Pela Rede', desc: 'perfis que a gente curte' },
];
const climbeiros: Item[] = [
  { href: '/sobre', label: 'Sobre', desc: 'quem somos' },
  { href: '/contato', label: 'Contato', desc: 'fala com a gente' },
];

const grupos = [
  { id: 'escalar', titulo: 'Escalar', icone: 'mountain', itens: escalar },
  { id: 'comunidade', titulo: 'Comunidade', icone: 'users', itens: comunidadeCelular },
  { id: 'climbeiros', titulo: 'Os Climbeiros', icone: 'info', itens: climbeiros },
];

// O endereço publicado termina com barra ("/rotas/"), e as páginas de dentro
// ("/rotas/pedra-do-bau/") também devem acender o item do menu.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const ativo = (href: string) => path === href || path.startsWith(href + '/');
const grupoAtivo = (itens: Item[]) => itens.some((i) => ativo(i.href));
---
<header class="header">
  <div class="container header__linha">
    <a href="/" class="header__marca">
      <img src="/logo.png" alt="Climbeiros" class="header__logo" />
    </a>

    <!-- Computador: os mesmos 3 grupos, cada um abre a sua lista -->
    <nav class="header__nav" aria-label="Navegação principal">
      <ul class="header__lista">
        {grupos.map((g) => (
          <li class="header__dd">
            <button
              type="button"
              class:list={['header__dd-btn', `header__dd-btn--${g.id}`, { 'header__dd-btn--ativo': grupoAtivo(g.itens) }]}
              aria-expanded="false"
              aria-controls={`dd-${g.id}`}
            >
              <Fragment set:html={svg(g.icone)} /><span>{g.titulo}</span><span class="header__seta" aria-hidden="true">▾</span>
            </button>
            <ul class="header__dd-lista" id={`dd-${g.id}`} hidden>
              {g.itens.map((i) => (
                <li>
                  <a href={i.href} class:list={{ 'header__item--ativo': ativo(i.href) }}>
                    <strong>{i.label}</strong> · {i.desc}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
        <li data-instalar-item hidden>
          <button type="button" class="header__instalar" data-instalar>📲 Instalar app</button>
        </li>
      </ul>
    </nav>

    <!-- Celular: ☰ abre os 3 grupos -->
    <button class="header__menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="menu-celular">
      <span class="visually-hidden">Abrir menu</span>
      ☰
    </button>
  </div>

  <nav class="header__celular" id="menu-celular" aria-label="Menu" hidden>
    {grupos.map((g) => (
      <div class="header__grupo">
        <button
          type="button"
          class:list={['header__grupo-btn', `header__grupo-btn--${g.id}`]}
          aria-expanded={grupoAtivo(g.itens) ? 'true' : 'false'}
          aria-controls={`grupo-${g.id}`}
        >
          <Fragment set:html={svg(g.icone)} /><span>{g.titulo}</span><span class="header__seta" aria-hidden="true">▾</span>
        </button>
        <ul id={`grupo-${g.id}`} hidden={!grupoAtivo(g.itens)}>
          {g.itens.map((i) => (
            <li>
              <a href={i.href} class:list={{ 'header__item--ativo': ativo(i.href) }}>
                <strong>{i.label}</strong> · {i.desc}
              </a>
            </li>
          ))}
          {g.id === 'climbeiros' && (
            <li data-instalar-item hidden>
              <button type="button" class="header__item-instalar" data-instalar><strong>Instalar o app</strong></button>
            </li>
          )}
        </ul>
      </div>
    ))}
  </nav>
</header>

<style is:global>
  .header {
    background: var(--verde-escuro);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 2px 12px rgba(0,0,0,0.15);
  }
  .header__linha {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .header__marca { flex-shrink: 0; }
  .header__logo { height: 52px; width: auto; display: block; }

  /* ---------- Computador ---------- */
  .header__nav { flex: 1; min-width: 0; }
  .header__lista {
    display: flex;
    align-items: center;
    gap: 8px 36px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__lista > li[hidden] { display: none; }
  .header__dd { position: relative; }
  .header__dd-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 4px;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    font-family: var(--fonte-display);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 1rem;
    color: var(--creme-claro);
    cursor: pointer;
    white-space: nowrap;
  }
  .header__dd-btn svg { width: 22px; height: 22px; }
  .header__dd-btn:hover { color: var(--creme); }
  .header__dd-btn--ativo { border-bottom-color: currentColor; }
  .header__dd-btn .header__seta { font-size: 0.8em; transition: transform 0.2s; }
  .header__dd-btn[aria-expanded="true"] .header__seta { transform: rotate(180deg); }
  .header__dd-lista {
    position: absolute;
    top: calc(100% + 10px);
    left: -10px;
    min-width: 290px;
    list-style: none;
    margin: 0;
    padding: 6px 16px;
    background: #fffdf7;
    border: 1px solid var(--creme);
    border-radius: 10px;
    box-shadow: 0 10px 24px rgba(42, 31, 22, 0.2);
    z-index: 60;
  }
  .header__dd-lista[hidden] { display: none; }
  .header__dd-lista a {
    display: block;
    padding: 10px 0;
    border-bottom: 1px solid var(--creme-claro);
    font-size: 0.95rem;
    color: var(--marrom);
    white-space: nowrap;
  }
  .header__dd-lista li:last-child a { border-bottom: 0; }
  .header__dd-lista strong { font-weight: 600; }
  .header__dd-lista a:hover, .header__dd-lista .header__item--ativo { color: var(--laranja); text-decoration: none; }
  .header__instalar {
    font-family: var(--fonte-display);
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--creme-claro);
    background: none;
    border: 1px solid rgba(240, 226, 178, 0.45);
    border-radius: 999px;
    padding: 6px 12px;
    cursor: pointer;
  }
  .header__instalar:hover { color: var(--amarelo); border-color: var(--amarelo); }

  /* ---------- Celular ---------- */
  .header__menu-btn { display: none; }
  .header__celular { display: none; }

  @media (max-width: 980px) {
    .header__nav { display: none; }
    .header__linha { justify-content: space-between; }
    .header__logo { height: 48px; }
    .header__menu-btn {
      display: block;
      background: none;
      border: none;
      color: var(--creme-claro);
      font-size: 1.5rem;
      cursor: pointer;
    }
    .header__celular:not([hidden]) {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--verde-escuro);
      padding: 4px 24px 18px;
      max-height: calc(100vh - 70px);
      overflow-y: auto;
      box-shadow: 0 10px 20px rgba(42, 31, 22, 0.25);
    }
    .header__grupo { border-bottom: 1px solid rgba(240, 226, 178, 0.18); }
    .header__grupo:last-child { border-bottom: 0; }
    .header__grupo-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 14px 0;
      background: none;
      border: 0;
      font-family: var(--fonte-display);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      font-size: 1.05rem;
      color: var(--creme-claro);
      cursor: pointer;
      text-align: left;
    }
    .header__grupo-btn svg { width: 22px; height: 22px; flex-shrink: 0; }
    .header__seta { margin-left: auto; transition: transform 0.2s; }
    .header__grupo-btn[aria-expanded="true"] .header__seta { transform: rotate(180deg); }
    .header__grupo ul {
      list-style: none;
      margin: 0 0 12px;
      padding: 4px 14px;
      background: #fffdf7;
      border-radius: 8px;
    }
    .header__grupo ul[hidden] { display: none; }
    .header__grupo li[hidden] { display: none; }
    .header__grupo a,
    .header__item-instalar {
      display: block;
      width: 100%;
      text-align: left;
      padding: 10px 0;
      border: 0;
      border-bottom: 1px solid var(--creme-claro);
      background: none;
      font: inherit;
      font-size: 0.98rem;
      color: var(--marrom);
      cursor: pointer;
    }
    .header__grupo li:last-child a,
    .header__grupo li:last-child .header__item-instalar { border-bottom: 0; }
    .header__grupo strong { font-weight: 600; }
    .header__grupo a:hover, .header__item--ativo { color: var(--laranja); text-decoration: none; }
  }
</style>

<script>
  // Um único listener no #menu-btn (não duplicar em outro arquivo: o menu abriria e fecharia junto).
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu-celular');

  function fecharMenu() {
    if (!menu || menu.hidden) return;
    menu.hidden = true;
    btn?.setAttribute('aria-expanded', 'false');
  }

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!menu) return;
    menu.hidden = !menu.hidden;
    btn.setAttribute('aria-expanded', menu.hidden ? 'false' : 'true');
  });

  // Cada grupo abre e fecha a própria lista.
  document.querySelectorAll<HTMLButtonElement>('.header__grupo-btn').forEach((g) => {
    g.addEventListener('click', () => {
      const lista = document.getElementById(g.getAttribute('aria-controls') ?? '');
      if (!lista) return;
      lista.hidden = !lista.hidden;
      g.setAttribute('aria-expanded', lista.hidden ? 'false' : 'true');
    });
  });

  // Computador: cada botão abre a sua lista e fecha as outras.
  const ddBotoes = document.querySelectorAll<HTMLButtonElement>('.header__dd-btn');
  function fecharDropdowns(exceto?: HTMLButtonElement) {
    ddBotoes.forEach((b) => {
      if (b === exceto) return;
      b.setAttribute('aria-expanded', 'false');
      const l = document.getElementById(b.getAttribute('aria-controls') ?? '');
      if (l) l.hidden = true;
    });
  }
  ddBotoes.forEach((b) => {
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      fecharDropdowns(b);
      const l = document.getElementById(b.getAttribute('aria-controls') ?? '');
      if (!l) return;
      l.hidden = !l.hidden;
      b.setAttribute('aria-expanded', l.hidden ? 'false' : 'true');
    });
  });

  // Fecha ao clicar fora, ao apertar Esc ou ao mudar de tamanho de tela.
  document.addEventListener('click', (e) => {
    const alvo = e.target as HTMLElement;
    if (!alvo.closest('#menu-celular')) fecharMenu();
    if (!alvo.closest('.header__dd-lista')) fecharDropdowns();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { fecharMenu(); fecharDropdowns(); } });
  window.matchMedia('(min-width: 981px)').addEventListener('change', () => fecharDropdowns());
  window.matchMedia('(min-width: 981px)').addEventListener('change', (m) => { if (m.matches) fecharMenu(); });
</script>
